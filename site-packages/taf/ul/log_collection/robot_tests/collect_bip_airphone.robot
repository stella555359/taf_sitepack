*** Settings ***
Library    taf.ul.log_collection
Library    OperatingSystem
Resource   helper.robot


*** Test Cases ***
Collect AP BIP Logs

    ${log_config_string}=   Catenate       {"AirphoneBipLog":{"type": "bip", "scope": "ue_0"},
    ...                                     "LogsToCollect": {"type": "group",
    ...                                                       "members": "AirphoneBipLog"}}

    ${log_configuration}=    Evaluate   ${log_config_string}

    ${collector_configs}=    Create Collectors Using Testline Information    names=LogsToCollect
    ...                                                                      configuration=${log_configuration}

    Set Suite Alias              LogsToCollect

    ${target_dir}    Start And Stop With Alias    LogsToCollect

    @{bip_logs}=    Get Log File   log_type=BIP   target_dir=${target_dir}   network_element=ue_0

    Log To Console    Collected Logs:\n
    FOR     ${pcap_file}    IN    @{bip_logs}
        Log To Console              ${pcap_file}
        File Should Exist           ${pcap_file}
        File Should Not Be Empty    ${pcap_file}
    END
