*** Variables ***
${TARGET_DIR}         None
${USER_INTERRUPT}     False
${DURATION}           5s 

*** Keywords ***
Interrupt Test And Wait For User Interaction
    [Arguments]    ${target_dir}
    Log To Console   \nLogs are started. Hit ENTER to stop the logs and collect them!
    ${output}    Evaluate    input("")
    Log To Console   \nLogs are stopped and collected now to ${target_dir}/LogsToCollect....


Start And Stop With Alias
    [Arguments]    ${log_alias}

    IF    '${TARGET_DIR}'=='None'
        ${target_dir}=    Set Variable    ${OUTPUT_DIR}/${SUITE_NAME}/${TEST_NAME}/
    ELSE
        ${target_dir}=    Set Variable    ${TARGET_DIR}
    END

    Setup Collectors    names=${log_alias}
    Start Collectors    names=${log_alias}

    IF    '${USER_INTERRUPT}'=='True'
        Interrupt Test And Wait For User Interaction    target_dir=${target_dir}
    ELSE
        Sleep    ${DURATION}
    END

    Stop Collectors      names=${log_alias}
    Collect Collectors   names=${log_alias}    target_dir=${target_dir}
    Teardown Collectors  names=${log_alias}

    RETURN   ${target_dir}
