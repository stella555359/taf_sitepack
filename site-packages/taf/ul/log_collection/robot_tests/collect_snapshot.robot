*** Settings ***
Library    taf.ul.log_collection
Library    OperatingSystem

*** Test Cases ***
Collect Cloud Snapshot
    ${is_aic}   Evaluate  hasattr($tl.gnbs[0], 'cloud_deployment') and $tl.gnbs[0].cloud_deployment is not None

    IF   not ${is_aic}
        PASS Execution    Testcase is designed for all in cloud bts. Stopping Execution
    END

    ${snapshot_config}=    Create Dictionary    type=snapshot
    ${group_config}=       Create Dictionary    type=group   members=MyAsyncSnapshot

    ${collector_config}=   Create Dictionary    MyAsyncSnapshot=${snapshot_config}
    ...                                         SnapshotLogs=${group_config}

    ${collector_configs}=  Create Collectors Using Testline Information    names=SnapshotLogs
    ...                                                                    configuration=${collector_config}

    Setup Collectors   names=SnapshotLogs
    ${awaitables}=   Async Collect Collectors    names=SnapshotLogs    target_dir=/tmp
    Wait For Operations    ${awaitables}
    Teardown Collectors    names=SnapshotLogs

    ${snapshot_files}=   Get Log File   log_type=snapshot   network_element=gnb_0    target_dir=/tmp
    
    FOR   ${snapshot_file}   IN   @{snapshot_files}
        File Should Exist           ${snapshot_file}
        File Should Not Be Empty    ${snapshot_file}
    END


Collect classical Snapshot
    ${is_aic}   Evaluate  hasattr($tl.gnbs[0], 'cloud_deployment') and $tl.gnbs[0].cloud_deployment is not None

    IF  ${is_aic}
        PASS Execution    Testcase is designed for classical bts. Stopping Execution
    END

    ${target_dir}=    Set Variable   ${OUTPUT_DIR}/${SUITE_NAME}/${TEST_NAME}/

    ${snapshot_config}=    Create Dictionary    type=snapshot
    ${group_config}=       Create Dictionary    type=group   members=SnapshotLog

    ${collector_config}=   Create Dictionary     SnapshotLog=${snapshot_config}
    ...                                          TestLogs=${group_config}

    Create Collectors Using Testline Information    names=TestLogs
    ...                                             configuration=${collector_config}


    Setup Collectors       names=TestLogs
    Collect Collectors     names=TestLogs    target_dir=${target_dir}
    Teardown Collectors    names=TestLogs

    ${snapshot_files}=   Get Log File   log_type=snapshot   network_element=gnb_0    target_dir=${target_dir}

    Should Not Be Empty   ${snapshot_files}    No Snapshot files found!
    
    FOR   ${snapshot_file}   IN   @{snapshot_files}
        File Should Exist           ${snapshot_file}
        File Should Not Be Empty    ${snapshot_file}
    END

