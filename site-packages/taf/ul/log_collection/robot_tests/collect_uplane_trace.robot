*** Settings ***
Library    taf.ul.log_collection
Library    OperatingSystem
Library    String
Resource   helper.robot


*** Test Cases ***
Collect UplaneLogs

    ${log_config_string}=    Catenate       {"UplaneLogs":    {"type": "uplane_trace",
    ...                                                        "components": "L2Ps,L2Lo,l2hiPdcp",
    ...                                                        "l2ps_profile_filter_list": "PUCCH, CSI, PDSCH"},
    ...                                      "LogsToCollect": {"type": "group",
    ...                                                        "members": "UplaneLogs"}}
    ${log_configuration}=    Evaluate   ${log_config_string}

    ${collector_configs}=    Create Collectors Using Testline Information    names=LogsToCollect
    ...                                                                      configuration=${log_configuration}

    Set Suite Alias              LogsToCollect

    ${target_dir}   Start And Stop With Alias    LogsToCollect

    @{uplane_traces}=   Get Log File   log_type=uplane_trace   target_dir=${target_dir}   network_element=gnb_0
    Should Not Be Empty     ${uplane_traces}

    Log To Console    \nCollected Logs:
    FOR    ${uplane_trace}    IN   @{uplane_traces}
        File Should Exist           ${uplane_trace}
        File Should Not Be Empty    ${uplane_trace}
        Log To Console              ${uplane_trace}

        ${capinfo_result}=    Run   LC_ALL=C capinfos -c "${uplane_trace}"    # avoid separating commas, if >= 1000
        ${_}   ${_}   ${packet_count}    Split String   ${capinfo_result}   separator=:
        ${packet_count}=    Convert To Integer    ${packet_count}
        IF    ${packet_count} == 0
            Log    There was no uplane trace packet recorded!    WARN
        END
    END


