*** Settings ***
Library    taf.ul.log_collection
Library    OperatingSystem
Resource   helper.robot


*** Test Cases ***
Collect Emil Logs

    ${log_config_string}=    Catenate       {"EmilLogs":      {"type": "emil"},
    ...                                      "LogsToCollect": {"type": "group",
    ...                                                        "members": "EmilLogs"}}
    ${log_configuration}=    Evaluate   ${log_config_string}
    
    ${collector_configs}=    Create Collectors Using Testline Information    names=LogsToCollect
    ...                                                                      configuration=${log_configuration}

    Set Suite Alias              LogsToCollect

    ${target_dir}   Start And Stop With Alias    LogsToCollect

    ${emil_logs}=    Get Log File    log_type=Emil   network_element=gnb_0   target_dir=${target_dir}

    ${is_empty_log}   Run Keyword And Return Status   Should Be Empty   ${emil_logs}

    IF   ${is_empty_log}
        Log To Console    No Emil Logs have been collected!   WARN
    ELSE
        Log To Console    Collected Logs:
        FOR     ${emil_log}    IN    @{emil_logs}
            Log To Console              ${emil_log}
            File Should Exist           ${emil_log}
            File Should Not Be Empty    ${emil_log}
        END
    END


