# Set of post params used in procedure.
# More details, examples can find here: https://confluence.int.net.nokia.com/display/PerfTAF/Post
post_process:
    enabled:      no
    server:       local
    type:         background

process_logs:
    enabled:      no

generate_kpi_report:
    enabled:      no
    source_kpi_file: ~
    kpi_targets: ~
    skip_start:   0
    skip_end:     0

add_results_to_database:
    enabled:      no
    default_values:
        valid_run:  1
        status:     NOT ANALYZED

add_results_to_coop:
    enabled:      no
    business_line:  ~
    product:        ~
    test_hierarchy: ~

validate_test_results:
    enabled:      no
    TEB:
        enabled:  no
        validation_policies: []

remove_post_dir:
    enabled:      no

send_package_to_logstore:
    enabled:      no

send_mail_with_test_results:
    enabled:      no


