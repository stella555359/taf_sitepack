# Set of procedure params used in procedure.
# More details, examples can find here: https://confluence.int.net.nokia.com/display/PerfTAF/Procedure
scenario_name:  ~
duration:       300
require_bts: ~
tester_username: ~

adjust_start_scenario_time_to_stats_period:
    enabled:  no
    period:   15               # In minutes
    offset:   0                # In minutes

manual_test_check_interval:
    enabled:  no
    check_interval: 60

wait_for_last_bts_stats:
    enabled:  no

use_configurator:
    enabled:  no

bts_preparation:
    enabled:  no
    perform_commissioning:
        enabled:  no
        oam_type:  REST_API
        params: ~
    change_swconfig:
        enabled:  no
        swconfig_file: ~
    set_debug_flags:
        enabled:  no
        params: {}

ue_preparation:
    enabled:  no
    reconfigure:
        enabled:  no
        params: ~
        ue_db: ~
        ue_cap: ~
    restart:
        enabled:  no
        params: ~

core_preparation:
    enabled:  no
    reconfigure:
        enabled:  no
        config_file: ~
        require_files: []
    restart:
        enabled:  no
    configure_console_prints:
        enabled:  no
        params: ~

bts_recovery:
    enabled: no
    alarms: ~

test_recovery_observer:
    enabled: no
    break_test: no

collect_benchmark_stats:
    enabled:    no
    period:     30
    collect_dsp_stats:
        enabled:    no

collect_bts_stats:
    enabled: no
    type: pmstats           # Could be rtpm

monitor_cus_syslog:
    enabled: no
    patterns: []
    till_occurs_times: 1
    break_test: false

additional_cmds:
    enabled: no
    cmds_before_scenario: ~
    periodical_cmds: ~
    cmds_after_scenario: ~

fake_paging:
    enabled:  no
    params: ~

collect_tti_traces:
    enabled: no
    tti_collection_interval: 5
    tti_time_triggers: [180]
    tti_alias: 'sample'

logs_collecting:
    enabled:  no
    bts_debug_logs:
        enabled: no
    bts_configuration:
        enabled: no
    ue_debug_logs:
        enabled: no
    ue_configuration:
        enabled: no
