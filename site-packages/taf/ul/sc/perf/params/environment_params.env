# Set of environment params used in procedure.
# More details, examples can find here: https://confluence.int.net.nokia.com/display/PerfTAF/environment
environment:
    base_logstore_path: ~
    base_logstore_url: ~
    lab_proxy: ~
    teb_url: ~
    wft_url: ~
    coop_url: ~
    jenkins:
        host: ~
        login: ~
        password: ~
    logstore_server:
        host: ~
        login: ~
        password: ~
    test_params_file: ~
    test_case_dir: ~
    test_line_dir: ~
    common_dir: ~
