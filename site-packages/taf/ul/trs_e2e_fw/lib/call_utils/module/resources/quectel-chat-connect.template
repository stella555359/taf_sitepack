# /etc/ppp/peers/quectel-chat-connect
ABORT "BUSY"
ABORT "NO CARRIER"
ABORT "NO DIALTONE"
ABORT "ERROR"
ABORT "NO ANSWER"
TIMEOUT 30
"" AT
OK ATE0
OK ATI;+CSUB;+CSQ;+CPIN?;+COPS?;+CGREG?;&D2
# Insert the APN provided by your network operator, default apn is 3gnet
#OK AT+CGDCONT=1,"IPV6","alung",,0,0
OK AT+CGDCONT=1,"{{v4orv6}}","{{apn}}"
#OK AT+CGDCONT=1,"IPV4V6","xyz.nsn.com",,0,0
#OK AT+QICSGP=1,2,"alung","","",1
#OK AT+CGDCONT=1,"<v4orv6>","<apn>"

#OK AT+QIACT=1
#OK AT+QIACT?

OK ATD*99#
#OK ATDT*99#
CONNECT
