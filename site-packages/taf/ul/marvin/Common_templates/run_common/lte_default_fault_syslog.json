{
  "name": "Default LTE syslog fault filterset",
  "domain": "Syslog",
  "algorithm": "syslog-filter-analyzer",
  "tags": [
    {
      "name": "LTE",
      "type": "RAT"
    }
  ],
  "rule": {
    "result_label": "Faults",
    "filters": [
      {
        "name": "SET1",
        "description": "Unallowed OAM reported faults",
        "regex_pattern": "Detector (1806|4019|6706|6707|6708|6709|6711|4261|1868|6256|6253|4341|52 |4153|16 |9 |6292|4298|1811|4352|4383|7308|4539|6293|7701|1907|1900|1904|1981|7506|1815_CPRI_C1|6354|7506|6906|476 |475 |6257|6452|4244|4590|2087|4540|4665|4241|4076|6917|4663|4335|6918|243 |4684|6926|1815|4595|7001|4366).* active|Detector 10 .*BBMOD.* active|Reporting 1806",
        "ignore_regex_pattern": "becomes|Check case",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET2",
        "description": "Unallowed DSP reported faults",
        "regex_pattern": "handle\\_LomFaultReq faultId \\= (6706|6707|6708|6709|6711|4341|4019|6292|2074|6561|1809|7102|6906|476 |475 )",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET3",
        "description": "Unexpected OAM reported faults",
        "regex_pattern": "Detector (6450|4381|4741).* active",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET4",
        "description": "Unexpected DSP reported faults",
        "regex_pattern": "handle\\_LomFaultReq faultId \\= (6100|6555|6554|6553|6551|6552|6558|6559|475)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET5",
        "description": "Unexpected high CPU/memory consumption reported",
        "regex_pattern": "Detector (6500|6501|6502|4329|4330).* active",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET6",
        "description": "Potential Truck Roll issue",
        "regex_pattern": "Detector (10 |16 |1806|1868|4341|4352|4383).* active",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET7",
        "description": "Sleeping Cell Detection Triggered (NOTE! To avoid CNN, please double check your test scenario, UE simulator behaviour and SCF thresholds for detecting sleeping cells. Actual sleeping cell does not allow UEs to attach after test scenario is re-started without BTS reset",
        "regex_pattern": "Detector (4546|4599|4702|4601|4547|4548|4600|4463|4708|4709|4704|4703|4705).* active",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET8",
        "description": "Unexpected RF or Antenna Line reported faults",
        "regex_pattern": "Detector (1838|1837|4527|1936|4530|4525|4069|1933|2910|1905|3010).* active|Detector 10 .*RMOD_R.* active",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      }	  
    ]
  }
}
