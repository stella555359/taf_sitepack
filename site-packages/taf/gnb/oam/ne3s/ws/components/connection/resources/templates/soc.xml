<?xml version="1.0" encoding="UTF-8"?>
<soc:NE3SWSSOC xmlns:soc="http://www.nokiasiemens.com/ne3s/soc/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.nokiasiemens.com/ne3s/soc/1.0/NE3SSoC.1.xsd" patchLevel="01.001">
	<Adaptation href="3GPP.common#3GPP"/>
	<soc:common version="1.0">
		<soc:security type="tls"/>
		<soc:ruim supported="true" version="1.0"/>
		<soc:sdnFormat format="3gpp"/>
		<soc:fallback supported="true"/>
		<soc:compression format="tar_gzip"/>
		<soc:uploadTypes>
			<soc:uploadType type="configuration"/>
			<soc:uploadType type="configuration_with_attachments"/>
			<soc:uploadType type="topology"/>
			<soc:uploadType type="active_faults"/>
			<soc:uploadType type="acknowledged_faults"/>
			<soc:uploadType type="audit"/>
			<soc:uploadType type="measurement"/>
		</soc:uploadTypes>
		<soc:dataFormats>
			<soc:dataFormat type="raml21"/>
			<soc:dataFormat type="omes21"/>
			<soc:dataFormat type="ofas31"/>
			<soc:dataFormat type="oats10"/>
		</soc:dataFormats>
		<soc:providedOperations>
			<soc:providedOperation name="startRegistration"/>
			<soc:providedOperation name="completeRegistration"/>
			<soc:providedOperation name="unregister" supported="true"/>
			<soc:providedOperation name="startSession"/>
			<soc:providedOperation name="stopSession"/>
			<soc:providedOperation name="keepAliveSession"/>
			<soc:providedOperation name="get"/>
			<soc:providedOperation name="set"/>
			<soc:providedOperation name="download"/>
			<soc:providedOperation name="validate"/>
			<soc:providedOperation name="activate"/>
			<soc:providedOperation name="upload"/>
			<soc:providedOperation name="provision"/>
			<soc:providedOperation name="interruptOperation"/>
			<soc:providedOperation name="requestOperationStatus"/>
			<soc:providedOperation name="ping"/>
		</soc:providedOperations>
		<soc:usedOperations>
			<soc:usedOperation name="abortSession"/>
			<soc:usedOperation name="reportOperationInterrupt"/>
			<soc:usedOperation name="reportStatus"/>
			<soc:usedOperation name="reregister"/>
			<soc:usedOperation name="transferNotification" supported="true"/>
		</soc:usedOperations>
		<soc:notification notificationType="ne3s_common_changeNotification" queueId="common_queue" buffered="true" supported="true"/>
	</soc:common>
	<soc:fragment name="ConfigurationManagement" version="1.0">
		<soc:extension name="ne3s_common_supportedModel" supported="true">
			<soc:attribute name="adaptationIDs" value="NOKLTE,com.nokia.mrbts,com.nokia.srbts.eqm,com.nokia.srbts.eqmr,com.nokia.srbts.mnl"/>
			<soc:attribute name="adaptationIDs" value="NOKLTE,com.nokia.mrbts,com.nokia.srbts.eqm,com.nokia.srbts.eqmr,com.nokia.srbts.mnl,com.nokiasolutionandnetworks.ne3sws.diagnostics.DIAGSNAP"/>
		</soc:extension>
	</soc:fragment>
	<soc:fragment name="HardwareManagement" version="1"/>
	<soc:fragment name="SoftwareManagement" version="1">
		<soc:extension name="ne3s_common_supportedModel" supported="true"/>
	</soc:fragment>
	<soc:fragment name="ATL" version="1.0">
		<soc:notification notificationType="ne3s_atl_logUploadNotification" queueId="ne3s_atl_logUploadNotificationQueue" buffered="true" supported="true"/>
	</soc:fragment>
	<soc:fragment name="AuditTrail" version="1.0">
		<soc:notification notificationType="ne3s_atl_logUploadNotification" queueId="ne3s_atl_logUploadNotificationQueue" buffered="true" supported="true"/>
	</soc:fragment>
	<soc:fragment name="FaultManagement" version="1.0">
		<soc:notification notificationType="ne3s_fm_rebuildNotification" queueId="fm_queue" buffered="true" supported="true"/>
		<soc:notification notificationType="ne3s_fm_alarmEventNotification" queueId="fm_queue" buffered="true" supported="true"/>
		<soc:extension name="ne3s_fm_alarmLimitsExtension">
			<soc:attribute name="minValue" value="1"/>
			<soc:attribute name="maxValue" value="50"/>
		</soc:extension>
	</soc:fragment>
	<soc:fragment name="PerformanceManagement" version="1.0">
		<soc:notification notificationType="ne3s_pm_uploadNotification" queueId="pm_queue" buffered="true" supported="true"/>
		<soc:extension supported="true" name="pi_limit" value="500000"/>
	</soc:fragment>
	<soc:fragment name="CertificateManagement" version="1.0"/>
</soc:NE3SWSSOC>
