<init-configuration version=" 2.0 ">
        <NEType adaptation="com.nokia.srbts" version="{{version}}" class="MRBTS">
                <NEInstance agentAddress="{{agentAddress}}" integrationType="integration" httpPort="{{HTTP_port}}" httpsPort="{{HTTPS_port}}" ne3swsSecurityMode="{{NE3SWSSecurityMode}}">
                        <userInfos></userInfos>
                        <MR distName="{{MR}}">
                                <MO distName="{{MO_DN}}">
                                        <name>{{MO_Name}}</name>
                                        <version>{{version}}</version>
                                </MO>
                        </MR>
                        <MO distName="{{MO_DN}}/NE3SWS-1" rendered="#getNEInstanceCustomAttribute(ne3swsSecurityMode).match('0')" >
                                <hostName>{{agentAddress}}</hostName>
                                <securityMode>0</securityMode>
                                <httpPort>{{HTTP_port}}</httpPort>
                                <httpsPort>{{HTTPS_port}}</httpsPort>
                                <ipVersion>{{IP_version}}</ipVersion>
                        </MO>
                        <MO distName="{{MO_DN}}/NE3SWS-1" rendered="#getTLSAttribute(mode).match('Install via CMP')" >
                                <hostName>{{agentAddress}}</hostName>
                                <securityMode>0</securityMode>
                                <httpPort>{{HTTP_port}}</httpPort>
                                <httpsPort>{{HTTPS_port}}</httpsPort>
                                <ipVersion>{{IP_version}}</ipVersion>
                        </MO>
                        <MO distName="{{MO_DN}}/NE3SWS-1" rendered="#getTLSAttribute(mode).equals('Already installed')" >
                                <hostName>{{agentAddress}}</hostName>
                                <securityMode>1</securityMode>
                                <httpPort>{{HTTP_port}}</httpPort>
                                <httpsPort>{{HTTPS_port}}</httpsPort>
                                <ipVersion>{{IP_version}}</ipVersion>
                        </MO>
                        <MO distName="{{MO_DN}}/EM-1">
                                <hostName>{{agentAddress}}</hostName>
                        </MO>
                        <TLS mode="{{certificateType}}">
                                <serverHost>{{cmp.CMPserverHost}}</serverHost>
                                <serverPort>{{cmp.CMPserverPort}}</serverPort>
                                <serverPath>{{cmp.CMPserverPath}}</serverPath>
                                <caSubjectName>{{cmp.CAName}}</caSubjectName>
                                <preSharedKey>{{cmp.sharedKey}}</preSharedKey>
                                <refNum>{{cmp.referenceNo}}</refNum>
                                <caCertificateUpdateTime>{{cmp.CAUpdateTime}}</caCertificateUpdateTime>
                                <neCertificateUpdateTime>{{cmp.NEUpdateTime}}</neCertificateUpdateTime>
                                <provisionType>1</provisionType>
                        </TLS>
                </NEInstance>
        </NEType>
</init-configuration>
