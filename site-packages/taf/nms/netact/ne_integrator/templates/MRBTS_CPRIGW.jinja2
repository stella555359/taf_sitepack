<init-configuration>
  <NEType adaptation="com.nokia.cprigw" version="{{version}}" class="MRBTS">
    <NEInstance agentAddress="{{Host_Name}}" integrationType="integration">
      <userInfos></userInfos>
      <MR distName="{{MR}}">
        <MO distName="{{FQDN}}">
          <name>{{NE_Name}}</name>
          <version>{{version}}</version>
        </MO>
      </MR>
      <MO distName="{{FQDN}}/NE3SWS-1">
        <hostName>{{Host_Name}}</hostName>
        <httpPort>{{Http_Port}}</httpPort>
        <httpsPort>{{Https_Port}}</httpsPort>
        <ipVersion>{{Ip_Version}}</ipVersion>
        <securityMode>{{Tls}}</securityMode>
      </MO>
    </NEInstance>
  </NEType>
</init-configuration>
