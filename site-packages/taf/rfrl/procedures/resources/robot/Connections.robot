*** Settings ***
Library     taf.sbts.oam.coam.admin                             WITH NAME   admin

Library     ../python/timer/timer.py                            WITH NAME   timer
Library     ../python/webui/webui.py                            WITH NAME   webui
Library     ../python/connections.py
Library     ../python/testline/TestLine.py                      WITH NAME   hwpta_testline
Library     ../python/admin_info_model/admin_info_model.py      WITH NAME   admin_info_model

*** Keywords ***
Create admin session with default alias
    [Arguments]                    ${timeout}=1min
    ...                            ${logs_path}=/tmp/api_logs
    ...                            ${bts_type}=GNB

    ${connection}=                 connections.get_default_admin_connection_alias
    ...                            bts_type=${bts_type}
    Priv wait until connected to   connection=${connection}
    ...                            timeout=${timeout}
    ...                            logs_path=${logs_path}
    ...                            bts_type=${bts_type}

Create admin session with custom alias
    [Arguments]                    ${connection}
    ...                            ${timeout}=1min
    ...                            ${logs_path}=/tmp/api_logs
    ...                            ${bts_type}=GNB

    Priv wait until connected to   connection=${connection}
    ...                            timeout=${timeout}
    ...                            logs_path=${logs_path}
    ...                            bts_type=${bts_type}

Create Selenium Session
    [Arguments]                    ${admin_connection}
    ...                            ${download_dir}=${logs_path}
    ...                            ${timeout}=60
    ...                            ${bts_type}=GNB

    ${credentials}=                connections.get_http_connection_credentials
    ...                            bts_type=${bts_type}
    ${webui_url}=   Set Variable   ${credentials['ip']}
    ${username}=    Set Variable   ${credentials['username']}
    ${password}=    Set Variable   ${credentials['password']}
    ${sw_stream}=                  admin.get_sw_release_name    connection=${admin_connection}
    ${webui_obj}                   webui.configure
    ...                            sw_stream=${sw_stream}

    webui.enable_virtual_display
    webui.login                    url=https://${webui_url}
    ...                            username=${username}
    ...                            password=${password}
    ...                            screenshot_dir=${download_dir}
    ...                            download_dir=${download_dir}
    ...                            browser=Firefox
    run keyword and ignore error   webui.disable_screen_lock
    run keyword and ignore error   webui.close_start_up_view_window
    [Return]                       ${webui_obj}

Close Selenium Session
    Run keyword and ignore Error   timer.wait_until_keyword_succeeds_timer
    ...                            10s
    ...                            2s
    ...                            webui.logout
    Run Keyword And Ignore Error   webui.disable_virtual_display

Close connections
    Run Keyword And Ignore Error   admin.teardown_all_aliases_for_admin


Priv wait until connected to
    [Arguments]                    ${connection}
    ...                            ${timeout}
    ...                            ${logs_path}=/tmp/api_logs
    ...                            ${bts_type}=GNB

    ${credentials}=                connections.get_http_connection_credentials
    ...                            bts_type=${bts_type}
    ${bts_host}=    Set Variable   ${credentials['ip']}
    ${username}=    Set Variable   ${credentials['username']}
    ${password}=    Set Variable   ${credentials['password']}

	Wait Until Keyword Succeeds    ${timeout}    20s    admin.connect_to
	...                            bts_host=${bts_host}
	...                            username=${username}
	...                            password=${password}
    ...                            name=${connection}
    ...                            admin_api_log_dir=${logs_path}

Create admin client session to LTE via VM
    [Arguments]                    ${connection}=lte_vm
    ...                            ${timeout}=1min
    ...                            ${logs_path}=${logs_path}

    ${enb_vm}=                     hwpta_testline.get_bts_test_pc_credentials
    ...                            bts_type=ENB
    ...                            slave=${False}

    admin.setup_admin              remote_host=${enb_vm['host']}
    ...                            remote_host_username=${enb_vm['user']}
    ...                            remote_host_password=${enb_vm['password']}
    ...                            bts_host=192.168.255.129
    ...                            name=${connection}
    ...                            admin_api_log_dir=${logs_path}

Create admin client session to slave SMOD via VM
    [Arguments]                    ${ip}
    ...                            ${master_connection}
    ...                            ${connection}=slave_gnb_vm
    ...                            ${timeout}=1min
    ...                            ${logs_path}=${logs_path}
    ${commissioning_state}=        admin_info_model.get_bts_procedural_state
    ...                            connection=${master_connection}
    ${slave_vm_credentials}=       hwpta_testline.get_bts_test_pc_credentials
    ...                            bts_type=GNB
    ...                            slave=${True}
    ${slave_smod_credentials}=     connections.get_ssh_connection_credentials
    ...                            bts_type=GNB
    ...                            common_unit_id=1
    ${bts_host}=                   Set Variable If    '${commissioning_state}' == 'NotCommissioned'
    ...                            192.168.255.129
    ...                            ${ip}

    admin.setup_admin              remote_host=${slave_vm_credentials['host']}
    ...                            remote_host_username=${slave_vm_credentials['user']}
    ...                            remote_host_password=${slave_vm_credentials['password']}
    ...                            bts_host=${bts_host}
    ...                            name=${connection}
    ...                            admin_api_log_dir=${logs_path}

Create admin client session to second SMOD via VM
    [Arguments]                    ${connection}=second_gnb_vm
    ...                            ${timeout}=1min
    ...                            ${logs_path}=${logs_path}

    ${second_vm_credentials}=      hwpta_testline.get_bts_test_pc_credentials
    ...                            bts_type=GNB
    ...                            bts_id=1
    ${second_smod_credentials}=    connections.get_ssh_connection_credentials
    ...                            bts_type=GNB
    ...                            bts_id=1
    ${bts_host}=                   Set Variable
    ...                            ${second_smod_credentials['host']}

    admin.setup_admin              remote_host=${second_vm_credentials['host']}
    ...                            remote_host_username=${second_vm_credentials['user']}
    ...                            remote_host_password=${second_vm_credentials['password']}
    ...                            bts_host=${bts_host}
    ...                            name=${connection}
    ...                            admin_api_log_dir=${logs_path}

Check If ENB Is Pingable And Establish Proper Connection
    [Arguments]                    ${connection}=admin_lte
    ${credentials}=                connections.get_http_connection_credentials
    ...                            bts_type=ENB
    ${bts_host}=                   Set Variable    ${credentials['ip']}

    Robot Log Operation            Checking if ENB is reachable via M-plane

    ${enb_is_reachable}=           connections.wait_for_desired_site_state
    ...                            url=https://${bts_host}
    ...                            timeout=60
    ...                            should_be_reachable=${True}

    Run Keyword If                 ${enb_is_reachable}
    ...                            Create admin session with default alias
    ...                            bts_type=ENB
    ...                            ELSE
    ...                            Run Keyword And Ignore Error
    ...                            Create Admin Client Session To LTE Via VM
    ...                            connection=${connection}

Get Active Aliases
    [Documentation]
    ${connection_aliases}=         admin_info_model.get_connection_aliases
    ${all_variables}=              Get Variables
    ${collector_aliases}=          Evaluate    [(v.name, v) for k, v in $all_variables.items() if 'collectors::' in k and v.is_up]
    ${all_aliases}=                Create Dictionary    connection_aliases=${connection_aliases}    collector_aliases=${collector_aliases}
    [Return]                       ${all_aliases}
