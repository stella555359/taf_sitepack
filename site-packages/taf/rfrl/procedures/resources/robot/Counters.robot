Verify MCS Counters
    [Arguments]  ${counters_results}
    ...          ${non_zero_expectation_counters}
    ...          ${zero_expectation_counters}

    ${counters_results}=                               bts_counters.convert_counter_results_to_dictionary
    ...                                                counters_results=${counters_results}

    FOR  ${counter_id}    IN    @{non_zero_expectation_counters}
        ${all_counter_values}            bts_counters.get_counter_values_from_results_dictionary
        ...                              counters_results=${counters_results}
        ...                              counter_id=${counter_id}
        ${counter_value}                 Set variable
        ...                              ${all_counter_values[0]}

        Should be true                   ${counter_value} > 0
        ...  msg=Counter '${counter_id}' should be greater than zero, actual value is: ${counter_value}
    END

    FOR  ${counter_id}    IN    @{zero_expectation_counters}
        ${all_counter_values}            bts_counters.get_counter_values_from_results_dictionary
        ...                              counters_results=${counters_results}
        ...                              counter_id=${counter_id}
        ${counter_value}                 Set variable
        ...                              ${all_counter_values[0]}

        Should be true                   ${counter_value} == 0
        ...  msg=Counter '${counter_id}' should be equal zero, actual value is: ${counter_value}
    END


Verify Coverage Extension Counters
    [Arguments]  ${counters_results_enabled_feature}
    ...          ${counters_results_disabled_feature}
    ...          ${expected_equal_or_greater_counters}
    ...          ${expected_equal_or_lower_counters}

    ${counters_results_enabled_feature}=               bts_counters.convert_counter_results_to_dictionary
    ...                                                counters_results=${counters_results_enabled_feature}
    ${counters_results_disabled_feature}=              bts_counters.convert_counter_results_to_dictionary
    ...                                                counters_results=${counters_results_disabled_feature}

    FOR  ${counter}    IN    @{expected_equal_or_greater_counters}
        ${all_values_enabled_feature}                          bts_counters.get_counter_values_from_results_dictionary
        ...                                                    counters_results=${counters_results_enabled_feature}
        ...                                                    counter_id=${counter}
        ${all_values_disabled_feature}                         bts_counters.get_counter_values_from_results_dictionary
        ...                                                    counters_results=${counters_results_disabled_feature}
        ...                                                    counter_id=${counter}

        ${value_enabled_feature}         Set variable          ${all_values_enabled_feature[0]}
        ${value_disabled_feature}        Set variable          ${all_values_disabled_feature[0]}

        Should be true                   ${value_enabled_feature} >= ${value_disabled_feature}
        ...  msg=Value of counter '${counter}' with enabled feature is not equal or greater than value from disabled feature (condition '${value_enabled_feature} >= ${value_disabled_feature}' not met).
    END

    FOR  ${counter}    IN    @{expected_equal_or_lower_counters}
        ${all_values_enabled_feature}                          bts_counters.get_counter_values_from_results_dictionary
        ...                                                    counters_results=${counters_results_enabled_feature}
        ...                                                    counter_id=${counter}
        ${all_values_disabled_feature}                         bts_counters.get_counter_values_from_results_dictionary
        ...                                                    counters_results=${counters_results_disabled_feature}
        ...                                                    counter_id=${counter}

        ${value_enabled_feature}         Set variable          ${all_values_enabled_feature[0]}
        ${value_disabled_feature}        Set variable          ${all_values_disabled_feature[0]}

        Should be true                   ${value_enabled_feature} <= ${value_disabled_feature}
        ...  msg=Value of counter '${counter}' with enabled feature is not equal or lower than value from disabled feature (condition '${value_enabled_feature} <= ${value_disabled_feature}' not met).
    END


Verify Energy Saving Counters
    [Arguments]  ${counters_results}
    ...          ${should_be_equal_zero}

    FOR  ${counter_result}    IN    @{counters_results}
        ${counter_ids}             create list          ${counter_result.keys()}
        ${counter_values}          create list          ${counter_result.values()}

        ${counter_id}              Set variable         @{counter_ids[0]}
        ${counter_value_list}      Set variable         @{counter_values[0]}

        ${counter_id}              Convert To String    ${counter_id}
        ${counter_value}           Convert To Integer   ${counter_value_list[0]}

        Run Keyword if   ${should_be_equal_zero}
        ...    Run Keyword And Continue On Failure
        ...    Should be true               ${counter_value} == 0
        ...                                 msg=Counter '${counter_id}' should be equal zero, actual value is: ${counter_value}
        ...    ELSE
        ...    Run Keyword And Continue On Failure
        ...    Should be true               ${counter_value} != 0
        ...                                 msg=Counter '${counter_id}' should not be equal zero, actual value is: ${counter_value}
    END


