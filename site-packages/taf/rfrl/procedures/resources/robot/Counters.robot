Wait For Counters And Save Values to Dict
    [Documentation]  This keyword is responsible for waiting until counter frames generate for a given amount of time
    ...              and then saving the counters with given IDs to dict.
    ...              Important!! Please take into consideration that counters appear with delay equal to collecting
    ...              interval, so if interval = 15min and you want to save the value of the counter from 9:00
    ...              you need to wait until 9:15 to be able to read the value.
    ...              ARGS:
    ...              - counter_ids (list of str):  list of counters to collect when measurement has finished.
    ...              - time (int or str):  duration (in minutes) of overall measurement, provided as string or integer, e.g. '30min' or 30
    ...              - data_frame_interval (int or str):  data measurement interval defined in minutes, equal to single measurement frame duration.
    ...                                                   Related to SCF configuration. One of following values possible to set:
    ...                                                   5min, 15min, 30min, or 60min. Parameter can be provided also as integer, e.g. 15.
    ...                                                   Defaults to 15min.
    ...              - additional_time_for_counters_preparing (int or str): recommended additional waiting time (in seconds) for counters preparing.
    ...                                                                     Performed after counters data frame generation, directly before counters collection.
    ...                                                                     Defaults to 60.
    ...              - component_name (str): name of the component to collect counters, e.g. 'NRCELL-1' for counters related to particular NR cell;
    ...                                      Defaults to None (counters will be collected from all components)
    [Arguments]                                      ${counter_ids}
    ...                                              ${time}
    ...                                              ${data_frame_interval}=15min
    ...                                              ${additional_time_for_counters_preparing}=60
    ...                                              ${component_name}=${None}

    Wait For New Counters Data Frame Generation      data_frame_interval=${data_frame_interval}
    ${counters_verification_startpoint}=             Get Current Date   result_format=timestamp

    Wait For BTS Counter Data Frames Generation      start=${counters_verification_startpoint}
    ...                                              time=${time}
    ...                                              data_frame_interval=${data_frame_interval}
    ${counters_verification_endpoint}=               Get Current Date   result_format=timestamp

    Robot Log Operation                              Waiting additional ${additional_time_for_counters_preparing} seconds to prepare BTS counters...
    Sleep                                            ${additional_time_for_counters_preparing}s
    ...                                              reason=Waiting ${additional_time_for_counters_preparing} seconds to prepare BTS counters...

    ${counters}=                                     Save Counters Values
    ...                                              counters_verification_startpoint=${counters_verification_startpoint}
    ...                                              counters_verification_endpoint=${counters_verification_endpoint}
    ...                                              counter_ids=${counter_ids}
    ...                                              component_name=${component_name}

    [Return]                                         ${counters}

Save Counters Values
    [Arguments]                                      ${counters_verification_startpoint}
    ...                                              ${counters_verification_endpoint}
    ...                                              ${counter_ids}
    ...                                              ${component_name}=${None}

    IF  isinstance($counter_ids, str)
        ${counter_ids}=                              Evaluate  [item.strip() for item in $counter_ids.split(",")]
    END
    
    @{counters}=        Create List
    Robot Log Step                                   Saving counter values to list of dicts...
    bts_counters.load_counters                       counter_ids=${counter_ids}
    ...                                              wrap=True

    FOR    ${counter_id}  IN  @{counter_ids}
        &{all_counter_values}=                       bts_counters.get_counter_by_id
        ...                                          counter_id=${counter_id}
        ...                                          component_name=${component_name}
        FOR  ${counter}                              IN  @{all_counter_values}
            ${counters_from_timeperiod}=             bts_counters.get_counters_from_specific_time_period
            ...                                      startpoint=${counters_verification_startpoint}
            ...                                      endpoint=${counters_verification_endpoint}
            ...                                      all_counter_values=${all_counter_values}
            ...                                      counter_id=${counter}
            Append To List       ${counters}         ${counters_from_timeperiod}
        END
    END

    [Return]                                         ${counters}

