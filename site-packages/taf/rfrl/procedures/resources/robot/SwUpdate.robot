Private Upload Specified SW Version
    [Arguments]     ${sw_version}
    ...             ${bts_type}=GNB
    ...             ${use_proxy}=${False}
    ...             ${path}=/home/ute/
    ...             ${repeat_update_until_successful}=${False}
    Robot Log Operation                                       Getting setup mode and bts type before SW update
    ${setup_mode}=                                            hwpta_testline.get_bts_setup_mode
    ${is_remote_enb}=                                         Evaluate
    ...                                                      '${setup_mode}'=='NSA' and '${bts_type}'=='ENB'
    ${sw_update_timeout}                                      Run keyword if
    ...                                                       not ${is_remote_enb}
    ...                                                       Get Timeout Complete Sw Update
    ...                                                       ELSE
    ...                                                       Set Variable
    ...                                                       3000
    ${connection}                                             conn.get_default_admin_connection_alias
    ...                                                       bts_type=${bts_type}
