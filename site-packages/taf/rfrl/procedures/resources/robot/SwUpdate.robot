Download And Update SW
    [Arguments]                                 ${sw_version}
    ...                                         ${sw_target}
    ...                                         ${timeout}
    ...                                         ${path}
    ...                                         ${reset_time}=20
    ${alias}                                    conn.get_default_admin_connection_alias

    IF                                          """${sw_target}"""=="""basic_sw"""
        ${existing_sw_path}                     sw.check_if_sw_package_is_downloaded_already_and_get_filepath
        ...                                     sw_version=${sw_version}
        IF                                      """${existing_sw_path}"""!="""${None}"""
            Robot Log Result                    Skipping downloading, existing software package from ${existing_sw_path} will be used.
            ...                                 to_console=${True}
            ${path_to_sw_package}=              Set Variable
            ...                                 ${existing_sw_path}
        ELSE
            Robot Log Operation                 Starting downloading software...
            ${path_to_sw_package}=              sw.download_software
            ...                                 path=${path}
            ...                                 sw_version=${sw_version}
        END
    ELSE
        Robot Log Operation                     Starting downloading software...
        ${path_to_sw_package}=                  sw.download_software
        ...                                     path=${path}
        ...                                     sw_version=${sw_version}
        ...                                     sw_target=${sw_target}
    END

    Robot Log Operation                         Waiting for update to be possible...
    ${sw_stream}=                               sw_stream.get_sw_stream
    Run keyword if                              "${sw_stream}" != "5G21A"
    ...                                         sbts_admin.wait_sw_update_possible
    ...                                         bts_ready=True
    ...                                         readiness_timeout=600
    ...                                         timeout=700
    ...                                         connection=${alias}

    Robot Log Operation                         Starting software update from ${sw_version} to ${sw_target}

    sw.update_software                          connection=${alias}
    ...                                         path_to_sw_package=${path_to_sw_package}
    ...                                         timeout=${timeout}
    ...                                         reset_time=${reset_time}

    Robot Log Result                            Software update completed successfully


Get BMU Version From RMODs With FID23
    [Documentation]  Get BMU version from all RMODs with fault id 23.
    [Arguments]      ${connection}
    ...              ${bts_type}=GNB

    ${active_alarms}=                           Get active alarms
    ...                                         bts_type=${bts_type}
    ${rmod_ids_with_fid23}=                     Evaluate  [alarm.unit_path.split('-')[-1] for alarm in $active_alarms if alarm.fault_id=='23']
    ${rmods_bmu_version}=                       Get BMU Version From RMODs
    ...                                         rmod_ids=${rmod_ids_with_fid23}
    ...                                         connection=${connection}

    [Return]                                    ${rmods_bmu_version}


Check If RMOD Fault 4589 Occurred And Verify If Caused By BMU Update
    [Documentation]  Check if fault 4589 (Unit power reset), severity: Warning, is present on RMOD units in alarm history
    ...              and if so, check if it was caused by BMU updated. If not fail the test.
    [Arguments]      ${rmods_bmu_version_to_compare}
    ...              ${fid4589_check_from_time}
    ...              ${connection}

    ${alarm_history}=                           admin_info_model.get_bts_alarm_history
    ...                                         connection=${connection}
    ...                                         severity=warning
    ...                                         from_time=${fid4589_check_from_time}
    ${rmod_fid4589_alarms}=                     Evaluate  [alarm for alarm in $alarm_history if alarm['faultId']==4589 and 'RMOD' in alarm['hwPath']]

    IF  ${rmod_fid4589_alarms}
        Robot Log Operation                     RMOD fault id: 4589 is present in BTS alarm history. Checking if it was caused by BMU update...
        ${rmods_ids_with_fid4589}=              Evaluate  list({rmod['configObjectName'].split('-')[-1] for rmod in $rmod_fid4589_alarms})

        FOR    ${rmod_config_id}                IN  @{rmods_ids_with_fid4589}
            ${bmu_version}                      Run Keyword And Ignore Error
            ...                                 Get RMOD BMU Version
            ...                                 rmod_id=${rmod_config_id}
            ...                                 connection=${connection}
            IF       '${bmu_version}[0]' != 'PASS' or '${rmods_bmu_version_to_compare}[${rmod_config_id}]' == '${None}'
                ${msg}=                         Catenate    Could not get BMU version from RMOD id: ${rmod_config_id}\n
                ...                             Please check manually if fault 4589 was caused by the BMU update.
                Robot Log Warning               ${msg}
                CONTINUE
            ELSE IF  '${bmu_version}[1]' == '${rmods_bmu_version_to_compare}[${rmod_config_id}]'
                Fail                            Fault 4589 was not caused by BMU update on RMOD id: ${rmod_config_id}
            END
        END
    END


Download And Activate RMOD O-RAN Plugin
    [Documentation]  Download the RMOD plugin from WFT and activate it like a normal software update.
    ...              If custom plugin version is defined for particular rmod's product name under custom_plugin_versions argument,
    ...              it will be used instead of the latest one from WFT.
    [Arguments]      ${rmod_ids}
    ...              ${connection}
    ...              ${bts_type}=GNB
    ...              ${custom_plugin_versions}=${None}
    ...              ${plugin_save_path}=/home/ute/

    ${downloaded_plugins}                      Create List
    FOR    ${rmod_id}                          IN    @{rmod_ids}
        ${rmod_pc}=                            admin_info_model.get_product_code_for_rmod 
        ...                                    rmod_id=${rmod_id}
        ...                                    connection=${connection}
        ${is_rmod_enabled}=                    Run Keyword And Return Status
        ...                                    status_check.verify_specific_statuses_for_specific_rmods
        ...                                    connection=${connection}
        ...                                    rmod_ids=${rmod_id}
        ...                                    operational_state=enabled
        IF  ${is_rmod_enabled}
            Robot Log Result                   O-RAN RMOD ID: ${rmod_id} already has the plugin enabled.
            CONTINUE
        END

        IF                                     "${rmod_pc}" not in ${downloaded_plugins}
            Append To List                     ${downloaded_plugins}    ${rmod_pc}
            ${custom_plugin}=                  wft.get_custom_oran_plugin_version_for_rmod_product_code
            ...                                rmod_product_code=${rmod_pc}
            ...                                custom_plugin_versions=${custom_plugin_versions}
            ${target_plugin_version}=          Run Keyword If        '''${custom_plugin}'''=='''${None}'''
            ...                                wft.get_latest_oran_rmod_plugin_version
            ...                                rmod_product_code=${rmod_pc}
            ...                                allow_not_released_plugin=${True}
            ...                                ELSE
            ...                                Set Variable
            ...                                ${custom_plugin}
            ${abs_plugin_path}=                wft.download_oran_rmod_plugin
            ...                                plugin_version=${target_plugin_version}
            ...                                save_path=${plugin_save_path}
            
            Robot Log Result                   Activating O-RAN plugin for RMOD Id: ${rmod_id}...
            ${rmod_config_dist_name}=          admin_info_model.get_config_distname_for_rmod
            ...                                config_rmod_id=${rmod_id}
            ...                                connection=${connection}
            Alarms.Allow Alarm On Object       configuration_dist_name=${rmod_config_dist_name}
            ...                                bts_type=${bts_type}
            ...                                fault_id=4001
            ...                                alarm_id=7101
            ...                                fault_name=BTS site autonomous reset as recovery action
            ...                                severity=Warning
            
            Wait Until Keyword Succeeds        10min     20 sec
            ...                                sw.update_software
            ...                                connection=${connection}
            ...                                path_to_sw_package=${abs_plugin_path}
            
            Robot Log Step                     BTS reset was performed due to the upload of the O-RAN RMOD plugin.
            Wait Until Keyword Succeeds        1min     5 sec
            ...                                Check Ping To Local SMOD
            ...                                should_be_reachable=${False}
            Wait Until Keyword Succeeds        7min     20 sec
            ...                                status_check.verify_specific_statuses_for_specific_rmods
            ...                                connection=${connection}
            ...                                rmod_ids=${rmod_id}
            ...                                operational_state=enabled
            ...                                administrative_state=Unlocked
            ...                                procedural_status=configured

            Alarms.Disallow alarm              fault_id=4001
            ...                                alarm_id=7101
        ELSE                                   
            Robot Log Result                   O-RAN plugin for RMOD with product code '${rmod_pc}' has already been activated.
            CONTINUE
        END
        Robot Log Result                       O-RAN RMOD plugin for RMOD Id: ${rmod_id} has been activated successfully.
    END


Download And Activate RMOD O-RAN SW Package
    [Documentation]  Downloads and activates the O-RAN RMOD software package.
    [Arguments]      ${rmod_ids}
    ...              ${connection}
    ...              ${bts_type}=GNB
    ...              ${sw_save_path}=/home/ute/

    ${downloaded_sw_for_rmods}                 Create List
    FOR    ${rmod_id}                          IN    @{rmod_ids}
        ${update_needed}=                      Run Keyword And Return Status
        ...                                    Is Software Update Needed For 0-RAN RMOD
        ...                                    rmod_id=${rmod_id}
        ...                                    connection=${connection}
        IF  not ${update_needed}
            Robot Log Result                   O-RAN RMOD Id: ${rmod_id} does not require a software update.
            CONTINUE
        END
        
        ${rmod_name}=                          admin_info_model.get_product_name_for_rmod
        ...                                    rmod_id=${rmod_id}
        ...                                    connection=${connection}
        IF                                     "${rmod_name}" not in ${downloaded_sw_for_rmods}
            Append To List                     ${downloaded_sw_for_rmods}    ${rmod_name}
            ${active_rmod_sw}=                 admin_info_model.get_rmod_sw_version
            ...                                rmod_id=${rmod_id}
            ...                                connection=${connection}
            ${base_active_rmod_sw_for_wft}=    Evaluate  $active_rmod_sw.replace('NK.', '').replace('_', '.')
            ${rmod_sw_info}=                   wft.get_project_and_component_from_build_version
            ...                                version=${base_active_rmod_sw_for_wft}
            ${abs_sw_package_path}=            wft.download_oran_rmod_sw_package
            ...                                rmod_sw_component=${rmod_sw_info['component']}
            ...                                save_path=${sw_save_path}
            sw.update_software                 connection=${connection}
            ...                                path_to_sw_package=${abs_sw_package_path}
            ...                                should_reset_radios=${True}
            Wait Until Keyword Succeeds        7min     20 sec
            ...                                status_check.verify_specific_statuses_for_specific_rmods
            ...                                connection=${connection}
            ...                                rmod_ids=${rmod_id}
            ...                                operational_state=enabled
            ...                                administrative_state=Unlocked
            ...                                procedural_status=configured
        ELSE                               
            Robot Log Result                   O-RAN SW package for RMOD Id: ${rmod_id} has already been activated.
            CONTINUE
        END
        Robot Log Result                       O-RAN RMOD SW package for RMOD Id: ${rmod_id} has been activated successfully.
    END


Is Software Update Needed For 0-RAN RMOD
    [Documentation]  Checks if the O-RAN RMOD needs a software update.
    [Arguments]      ${rmod_id}
    ...              ${connection}

    ${rmod_config_dist_name}=                  admin_info_model.get_config_distname_for_rmod
    ...                                        connection=${connection}
    ...                                        config_rmod_id=${rmod_id}
    ${unit_path_for_watchdog}=                 admin_info_model.get_config_obj_name
    ...                                        connection=${connection}
    ...                                        configuration_dist_name=${rmod_config_dist_name}
    Sleep                                      30s    Sleep to allow O-RAN RMOD to indicate fault 23.
    ${fault_23_inactive}=                      Wait for inactive alarm
    ...                                        timeout=60
    ...                                        fault_id=23
    ...                                        fault_name=Incompatible SW version detected
    ...                                        unit_path=${unit_path_for_watchdog}
    
    ${result}=                                 Evaluate    False if ${fault_23_inactive} else True
    [Return]    ${result}