Rollback SW If Knife Build On Active Partition And Wait for OnAir State
    [Arguments]                                           ${connection}=${None}
    ...                                                   ${bts_type}=GNB
    ...                                                   ${timeout}=900

    ${active_sw_version}    ${passive_sw_version}         sw.get_active_and_passive_sw_version
    ...                                                   bts_type=${bts_type}

    Robot Log Variable                                    variable=Active Software Version: ${active_sw_version}
    Robot Log Variable                                    variable=Passive Software Version: ${passive_sw_version}

    ${is_knife_build_active}=                             sw.is_knife_build
    ...                                                   sw_version=${active_sw_version}
    ${is_knife_build_passive}=                            sw.is_knife_build
    ...                                                   sw_version=${passive_sw_version}

    IF                                                    ${is_knife_build_active} and not ${is_knife_build_passive}
        IF                                                not ${connection}
            Create admin session with default alias       bts_type=${bts_type}
            ${connection}=                                conn.get_default_admin_connection_alias
            ...                                           bts_type=${bts_type}
        END

        Robot Log Result                                  Active partition has knife build and passive partition hasn't, proceeding with SW rollback.
        ...                                               to_console=${True}
        Rollback SW and wait for OnAir State
        ...                                               connection=${connection}
        ...                                               bts_type=${bts_type}
        ...                                               timeout=${timeout}
    END


