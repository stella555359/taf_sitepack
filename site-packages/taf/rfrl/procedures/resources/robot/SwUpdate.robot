    Run keyword if                                            ${repeat_update_until_successful}
    ...                                                       timer.wait_until_keyword_succeeds_timer
    ...                                                       30min
    ...                                                       30s
    ...                                                       sw.update_software
    ...                                                       connection=${connection}
    ...                                                       path_to_sw_package=${sw_path}
    ...                                                       timeout=${sw_update_timeout}
    ...                                                       ELSE
    ...                                                       sw.update_software
    ...                                                       connection=${connection}
    ...                                                       path_to_sw_package=${sw_path}
    ...                                                       timeout=${sw_update_timeout}
