Block cells on RMOD and check statuses
    [Arguments]                  ${connection}
    ...                          ${rmod_internal_distname}
    ...                          ${bts_type}=GNB

    ${rmod_config_distname}=     admin_info_model.translate_rmod_distname
    ...                          rmod_distname=${rmod_internal_distname}
    ...                          output_distname_type=configuration
    ...                          connection=${connection}
    ${rmod_id}=                  Evaluate  int(str("""${rmod_config_distname}""").split('-')[-1])
    @{cells}=                    admin_info_model.get_cell_mapping_for_rmod
    ...                          rmod_internal_distname=${rmod_internal_distname}
    ...                          connection=${connection}

    ${timeout}=                  Get Timeout Cell Block

    Alarms.Allow Alarm           fault_name=Cell blocked
    ...                          fault_id=49
    ...                          bts_type=${bts_type}
    Alarms.Allow Alarm           fault_name=NgGnbInitPartialReset
    ...                          fault_id=7313
    ...                          bts_type=${bts_type}

    FOR  ${cell}  IN  @{cells}
          ${cell_id}=            Get From Dictionary  ${cell}  CELLID
          ${cell_rat}=           Get From Dictionary  ${cell}  RAT
          ${is_iot_cell}         admin_info_model.is_iot_cell
          ...                    connection=${connection}
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          Continue for loop if  ${is_iot_cell}==${True}
          ${dist_name}=          Get From Dictionary  ${cell}  runtimeDistName
          ${operation_succeed}=  admin.block_cell
          ...                    dist_name=${dist_name}
          ...                    connection=${connection}
          ...                    timeout=80s
          Run keyword if         ${operation_succeed}
          ...                    Robot Log Iteration  msg=Cell ${dist_name} is blocked
    END

    timer.wait_until_keyword_succeeds_timer
    ...                          ${timeout}
    ...                          65s
    ...                          Check statuses of cells for RMOD
    ...                          rmod_id=${rmod_id}
    ...                          connection=${connection}
    ...                          status_variant=blocked


Unblock cells on RMOD and check statuses
    [Arguments]                  ${connection}
    ...                          ${rmod_internal_distname}
    ...                          ${bts_type}=GNB

    ${rmod_config_distname}=     admin_info_model.translate_rmod_distname
    ...                          rmod_distname=${rmod_internal_distname}
    ...                          output_distname_type=configuration
    ...                          connection=${connection}
    ${rmod_id}=                  Evaluate  int(str("""${rmod_config_distname}""").split('-')[-1])
    @{cells}=                    admin_info_model.get_cell_mapping_for_rmod
    ...                          rmod_internal_distname=${rmod_internal_distname}
    ...                          connection=${connection}
    ...                          sort_cells_by_chbw=${True}
    ...                          reverse_order=${True}

    FOR  ${cell}  IN  @{cells}
          ${cell_id}=            Get From Dictionary  ${cell}  CELLID
          ${cell_rat}=           Get From Dictionary  ${cell}  RAT
          ${is_iot_cell}         admin_info_model.is_iot_cell
          ...                    connection=${connection}
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ${is_blocked}          status_check.is_cell_blocked
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ...                    connection=${connection}
          Continue for loop if   ${is_iot_cell}==${True} or ${is_blocked}==${False}
          ${dist_name}=          Get From Dictionary  ${cell}  runtimeDistName
          ${operation_succeed}=  admin.unblock_cell
          ...                    dist_name=${dist_name}
          ...                    connection=${connection}
          ...                    timeout=80s
          Run keyword if         ${operation_succeed}
          ...                    Robot Log Iteration  msg=Cell ${dist_name} is unblocked
    END

    timer.wait_until_keyword_succeeds_timer
    ...                          180
    ...                          15s
    ...                          Check statuses of cells for RMOD
    ...                          rmod_id=${rmod_id}
    ...                          connection=${connection}
    ...                          status_variant=online

    Alarms.Disallow alarm        fault_name=Cell blocked
    ...                          fault_id=49
    ...                          bts_type=${bts_type}
    Alarms.Disallow Alarm        fault_name=NgGnbInitPartialReset
    ...                          fault_id=7313
    ...                          bts_type=${bts_type}

Ensure Cells Are Unblocked
    [Arguments]                  ${connection}
    ...                          ${bts_type}=GNB
    @{cells}=                    admin_info_model.get_admin_cells_parameters
    ...                          connection=${connection}
    ...                          sort_cells_by_chbw=${True}
    ...                          reverse_order=${True}
    Robot Log Operation          Ensuring that all cells are unblocked...
    FOR  ${cell}  IN  @{cells}
          ${cell_id}=            Get From Dictionary  ${cell}  CELLID
          ${cell_rat}=           Get From Dictionary  ${cell}  RAT
          ${dist_name}=          Get From Dictionary  ${cell}  runtimeDistName
          ${conf_dist_name}=     Get From Dictionary  ${cell}  configurationDistName

          ${is_iot_cell}         admin_info_model.is_iot_cell
          ...                    connection=${connection}
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ${is_blocked}          status_check.is_cell_blocked
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ...                    connection=${connection}
          Continue for loop if  ${is_iot_cell} or not ${is_blocked}

          ${timeout}=            Get Timeout Cell Unblock
          ...                    cell_dist_name=${conf_dist_name}
          admin.unblock_cell
          ...                    dist_name=${dist_name}
          ...                    connection=${connection}
          ...                    timeout=80s
          @{cell_list}=          create list  ${cell_id}
          timer.wait_until_keyword_succeeds_timer
          ...                    ${timeout}
          ...                    5s
          ...                    Check statuses for specific cells
          ...                    cell_ids=${cell_list}
          ...                    cell_type=${cell_rat}
          ...                    connection=${connection}
          ...                    status_variant=online
          Robot Log Iteration    msg=Cell ${dist_name} is unblocked
    END
