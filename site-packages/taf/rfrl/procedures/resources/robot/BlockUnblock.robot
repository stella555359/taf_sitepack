*** Keywords ***
Block selected cells and check statuses
    [Documentation]              Blocks selected cells and checks if they are blocked.
    ...                          If cell is already blocked or is IoT cell, it will be skipped.
    ...                          Args:
    ...                          ${connection}: connection alias to the BTS
    ...                          ${cells_distname}: list of cells CONFIG distname
    ...                          ${bts_type}: BTS type (GNB or LTE)
    [Arguments]                  ${connection}
    ...                          ${cells_distname}
    ...                          ${bts_type}=GNB

    Alarms.Allow Alarm           fault_name=Cell blocked
    ...                          fault_id=49
    ...                          bts_type=${bts_type}
    Alarms.Allow Alarm           fault_name=NgGnbInitPartialReset
    ...                          fault_id=7313
    ...                          bts_type=${bts_type}

    FOR  ${cell_distname}  IN  @{cells_distname}
          ${cell_id}=            Evaluate  str("""${cell_distname}""").split('-')[-1]
          ${cell_class}=         Evaluate  str("""${cell_distname}""").split('/')[-1].split('-')[0]
          ${cell_rat}=           admin_info_model.get_rat_depending_on_class_name
          ...                    cell_class=${cell_class}
          ${timeout}=            Get Timeout Cell Block
          ...                    cell_dist_name=${cell_distname}
          ${is_iot_cell}         admin_info_model.is_iot_cell
          ...                    connection=${connection}
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ${is_blocked}          status_check.is_cell_blocked
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ...                    connection=${connection}
          Continue for loop if  ${is_iot_cell} or ${is_blocked}
          ${operation_succeed}=  admin.block_cell
          ...                    dist_name=${cell_distname}
          ...                    connection=${connection}
          ...                    timeout=80s
          @{cell_list}=          create list  ${cell_id}
          timer.wait_until_keyword_succeeds_timer
          ...                    ${timeout}
          ...                    5s
          ...                    Check statuses for specific cells
          ...                    cell_ids=${cell_list}
          ...                    cell_type=${cell_rat}
          ...                    connection=${connection}
          ...                    status_variant=blocked
          Run keyword if         ${operation_succeed}
          ...                    Robot Log Iteration
          ...                    msg=Cell ${cell_distname} is blocked
    END

Unblock selected cells and check statuses
    [Documentation]              Unblocks selected cells and checks if they are unblocked.
    ...                          If cell is already unblocked or is IoT cell, it will be skipped.
    ...                          Args:
    ...                          ${connection}: connection alias to the BTS
    ...                          ${cells_distname}: list of cells CONFIG distname
    ...                          ${bts_type}: BTS type (GNB or LTE)
    [Arguments]                  ${connection}
    ...                          ${cells_distname}
    ...                          ${bts_type}=GNB

    FOR  ${cell_distname}  IN  @{cells_distname}
          ${cell_id}=            Evaluate  str("""${cell_distname}""").split('-')[-1]
          ${cell_class}=         Evaluate  str("""${cell_distname}""").split('/')[-1].split('-')[0]
          ${cell_rat}=           admin_info_model.get_rat_depending_on_class_name
          ...                    cell_class=${cell_class}
          ${timeout}=            Get Timeout Cell Unblock
          ...                    cell_dist_name=${cell_distname}
          ${is_iot_cell}         admin_info_model.is_iot_cell
          ...                    connection=${connection}
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ${is_blocked}          status_check.is_cell_blocked
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ...                    connection=${connection}
          Continue for loop if  ${is_iot_cell} or not ${is_blocked}
          ${operation_succeed}=  admin.unblock_cell
          ...                    dist_name=${cell_distname}
          ...                    connection=${connection}
          ...                    timeout=80s
          @{cell_list}=          create list  ${cell_id}
          timer.wait_until_keyword_succeeds_timer
          ...                    ${timeout}
          ...                    5s
          ...                    Check statuses for specific cells
          ...                    cell_ids=${cell_list}
          ...                    cell_type=${cell_rat}
          ...                    connection=${connection}
          ...                    status_variant=online
          Run keyword if         ${operation_succeed}
          ...                    Robot Log Iteration
          ...                    msg=Cell ${cell_distname} is unblocked
    END

    Alarms.Disallow alarm        fault_name=Cell blocked
    ...                          fault_id=49
    ...                          bts_type=${bts_type}
    Alarms.Disallow Alarm        fault_name=NgGnbInitPartialReset
    ...                          fault_id=7313
    ...                          bts_type=${bts_type}


Block all cells and check statuses
    [Arguments]                  ${connection}
    ...                          ${bts_type}=GNB

    @{cells}=                    admin_info_model.get_admin_cells_parameters      connection=${connection}
    ${expected_active_alarms_count}  Get Length   ${cells}

    Alarms.Allow Alarm           fault_name=Cell blocked
    ...                          fault_id=49
    ...                          bts_type=${bts_type}
    Alarms.Allow Alarm           fault_name=NgGnbInitPartialReset
    ...                          fault_id=7313
    ...                          bts_type=${bts_type}

    FOR  ${cell}  IN  @{cells}
          ${cell_id}=            Get From Dictionary  ${cell}  CELLID
          ${cell_rat}=           Get From Dictionary  ${cell}  RAT
          ${dist_name}=          Get From Dictionary  ${cell}  runtimeDistName
          ${conf_dist_name}=     Get From Dictionary  ${cell}  configurationDistName
          ${timeout}=            Get Timeout Cell Block
          ...                    cell_dist_name=${conf_dist_name}
          ${is_iot_cell}         admin_info_model.is_iot_cell
          ...                    connection=${connection}
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ${is_blocked}          status_check.is_cell_blocked
          ...                    cell_id=${cell_id}
          ...                    cell_type=${cell_rat}
          ...                    connection=${connection}
          Continue for loop if  ${is_iot_cell} or ${is_blocked}
          ${operation_succeed}=  admin.block_cell
          ...                    dist_name=${dist_name}
          ...                    connection=${connection}
          ...                    timeout=80s
          @{cell_list}=          create list  ${cell_id}
          timer.wait_until_keyword_succeeds_timer
          ...                    ${timeout}
          ...                    5s
          ...                    Check statuses for specific cells
          ...                    cell_ids=${cell_list}
          ...                    cell_type=${cell_rat}
          ...                    connection=${connection}
          ...                    status_variant=blocked
          Run keyword if         ${operation_succeed}
          ...                    Robot Log Iteration  msg=Cell ${dist_name} is blocked
    END

