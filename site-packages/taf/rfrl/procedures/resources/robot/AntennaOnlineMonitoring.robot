Library     taf.sbts.oam.coam.admin                                                                   WITH NAME  admin

Library     taf.rfrl.procedures.resources.python.webui.webui                                          WITH NAME  webui
Library     taf.rfrl.procedures.resources.python.connections                                          WITH NAME  connections
Library     taf.rfrl.procedures.resources.python.admin_info_model.admin_info_model                    WITH NAME  admin_info_model
Library     taf.rfrl.procedures.resources.python.timer.timer                                          WITH NAME  timer
Library     taf.rfrl.procedures.resources.python.antenna_online_monitoring.antenna_online_monitoring  WITH NAME  ant_online_monitoring
Library     taf.rfrl.procedures.resources.python.antenna_online_monitoring.admin_antenna_online_monitoring  WITH NAME  adm_ant_online_monitoring

Resource    taf/rfrl/procedures/resources/robot/HWPTA_Logger.robot
Resource    taf/rfrl/procedures/resources/robot/StatusCheck.robot
Resource    taf/rfrl/procedures/resources/robot/BlockUnblock.robot
Resource    taf/rfrl/procedures/resources/robot/Alarms.robot


*** Keywords ***
Antenna Online Monitoring Teardown
    Robot Log Operation                                     Antenna Online Monitoring Teardown...
    Run keyword and ignore error                            webui.stop_antenna_line_monitoring
    Connections.Close Selenium Session
    Clean Up Environment


Get Monitored Values
    Robot Log Operation                                     Getting antenna online monitoring values...
    ${monitored_values}                                     webui.get_monitored_values

    Robot Log Result                                        Monitored values: ${monitored_values}
    ...                                                     console=${True}
    [Return]  ${monitored_values}


Get CSV File
    Robot Log Operation                                     Getting CSV file..
    ${path_to_csv}                                          webui.export_monitored_value_to_csv

    Robot Log Result                                        CSV path: ${path_to_csv}
    ...                                                     console=${True}
    [Return]  ${path_to_csv}


Verify Timestamps in Monitored Values
    [Arguments]  ${monitored_values}
    ...          ${expected_time_shift}=10

    ant_online_monitoring.verify_data_time_shift_in_webui_results
    ...                                                     webui_results=${monitored_values}
    ...                                                     expected_time_shift=${expected_time_shift}

    Robot Log Result                                        Timestamps verification succeeded.
    ...                                                     console=${True}


Verify CSV File content
    [Arguments]  ${path_to_csv_file}
    ...          ${monitored_values_from_webui}
    ...          ${runtime_rmod_id}

    ${converted_webui_results}                              ant_online_monitoring.convert_webui_results_to_csv_data_format
    ...                                                     webui_results=${monitored_values_from_webui}
    ...                                                     runtime_rmod_id=${runtime_rmod_id}

    ${monitored_values_from_csv}                            ant_online_monitoring.get_csv_data
    ...                                                     csv_file_path=${path_to_csv_file}

    Should Be Equal                                         """${converted_webui_results}"""  """${monitored_values_from_csv}"""
    ...                                                     msg=Monitored values from CSV file are different than readed from webui.

    Robot Log Result                                        CSV file verification succeeded.
    ...                                                     console=${True}


Verify Antenna Online Monitoring Measurements during L3Call
    [Arguments]  ${monitored_values}
    ...          ${cell_dist_name}
    ...          ${connection}
    ...          ${antenna_list}

    ant_online_monitoring.verify_measurements_during_l3_call
    ...                                                     webui_results=${monitored_values}
    ...                                                     cell_dist_name=${cell_dist_name}
    ...                                                     connection=${connection}
    ...                                                     antenna_list=${antenna_list}

    Robot Log Result                                        Antenna online measurements validation succeeded.
    ...                                                     console=${True}


Reset RMOD and Check Antenna Online Monitoring Unavailability
    [Arguments]  ${rmod_id}
    ...          ${connection}
    ...          ${csv_directory}

    Robot Log Iteration                                     Resetting RMOD-${rmod_id}...
    ${runtime_id}                                           admin_info_model.translate_rmod_index_to_runtime
    ...                                                     rmod_index=${rmod_id}
    ...                                                     connection=${connection}
    admin_info_model.reset_rmod                             connection=${connection}
    ...                                                     runtime_rmod_id=${runtime_id}

    Check If Measurements Are Unavailable                   csv_directory=${csv_directory}

    ${runtime_rmods_list}                                   Create list
    ...                                                     RMOD_R-${runtime_id}
    wait until keyword succeeds                             5min
    ...                                                     2 sec
    ...                                                     Check Statuses Of RMODs And Their Cells
    ...                                                     rmods=${runtime_rmods_list}
    Sleep                                                   20s


Block/Unblock Cells and Antenna Online Monitoring Unavailability
    [Arguments]     ${rmod_id}
    ...             ${connection}
    ...             ${bts_type}
    ...             ${csv_directory}
    ${rmod_config_distname}=                                admin_info_model.get_config_distname_for_rmod
    ...                                                     config_rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ${rmod_internal_distname}=                              admin_info_model.translate_rmod_distname
    ...                                                     rmod_distname=${rmod_config_distname}
    ...                                                     output_distname_type=internal
    ...                                                     connection=${connection}
    ${runtime_id}                                           admin_info_model.translate_rmod_index_to_runtime
    ...                                                     rmod_index=${rmod_id}
    ...                                                     connection=${connection}

    Robot Log Iteration                                     Blocking cells for RMOD-${rmod_id}...
    Block cells on RMOD and check statuses                  connection=${connection}
    ...                                                     rmod_internal_distname=${rmod_internal_distname}
    ...                                                     bts_type=${bts_type}

    Sleep                                                   20s

    Check If Measurements Are Unavailable                   csv_directory=${csv_directory}

    Robot Log Iteration                                     Unblocking cells for RMOD-${rmod_id}...
    Unblock cells on RMOD and check statuses                connection=${connection}
    ...                                                     rmod_internal_distname=${rmod_internal_distname}
    ...                                                     bts_type=${bts_type}

    ${runtime_rmods_list}                                   Create list
    ...                                                     RMOD_R-${runtime_id}
    wait until keyword succeeds                             5min
    ...                                                     2 sec
    ...                                                     Check Statuses Of RMODs And Their Cells
    ...                                                     rmods=${runtime_rmods_list}
    Sleep                                                   20s


Reset Rat and Antenna Online Monitoring Unavailability
    [Arguments]    ${rat_type}
    ...            ${connection}
    ...            ${bts_type}
    ...            ${csv_directory}
    Robot Log Operation                                     Performing reset ${rat_type} RAT...
    Allow X2 Link Alarms
    ${rat}=	                                                Set Variable If	    '${rat_type}'=='nr'
    ...                                                     NR
    ...                                                     LTE
    ${rat_reset_timeout}                                    Get Timeout Rat Reset
    ...                                                     rat=${rat_type}
    admin.rat_reset                                         rat_type=${rat}
    ...                                                     timeout=300
    ...                                                     connection=${connection}


    Check If Measurements Are Unavailable                   csv_directory=${csv_directory}

    timer.wait_until_keyword_succeeds_timer                 ${rat_reset_timeout}
    ...                                                     5 sec
    ...                                                     Check all BBMODs RMODs and cells states for all RATs
    ...                                                     bts_type=${bts_type}
    Disallow X2 Link Alarms
    Robot Log Operation                                     ${rat_type} RAT has been reset. OnAir State.


Reset Bbmods and Antenna Online Monitoring Unavailability
    [Arguments]    ${connection}
    ...            ${bts_type}
    ...            ${csv_directory}
    ${bbmods}=                                              admin_info_model.get_bbmods_distnames
    ...                                                     connection=${connection}

    FOR  ${bbmod_id}  IN   @{bbmods.keys()}
         Robot Log Operation                                Performing BBMOD-${bbmod_id} reset...
         admin_info_model.reset_bbmod                       connection=${connection}
         ...                                                bbmod_id=${bbmod_id}
    END

    Robot Log Operation                                     Checking if measurements are unavailable...
    Check If Measurements Are Unavailable                   csv_directory=${csv_directory}

    timer.wait_until_keyword_succeeds_timer                 300 sec
    ...                                                     5 sec
    ...                                                     Check all BBMODs RMODs and cells states for all RATs
    ...                                                     bts_type=${bts_type}

    Robot Log Operation                                     BBMODs have been reset. OnAir State.


Check If Measurements Are Unavailable
    [Arguments]  ${csv_directory}
    ${csv_file_path}                                        Get CSV File
    ${monitored_values_from_csv}                            ant_online_monitoring.get_csv_data
    ...                                                     csv_file_path=${csv_file_path}
    ${monitored_values}                                     ant_online_monitoring.convert_csv_results_to_webui_results_format
    ...                                                     monitored_values_from_csv=${monitored_values_from_csv}

    vm.move_file_to_target_directory                        origin_file_path=${csv_file_path}
    ...                                                     target_file_path=${csv_directory}/ANTLMonitoring_monitored_values_unavailable

    ${last_measurements_unavailability}                     ant_online_monitoring.verify_last_measured_values_unavailability
    ...                                                     webui_results=${monitored_values}

    Should Be True                                          ${last_measurements_unavailability}
    ...                                                     msg=Monitored values are available.
    Robot Log Result                                        Monitored results currently unavailable.
    ...                                                     console=${True}


Verify Antenna Online Monitoring Measurements Presence
    [Arguments]  ${monitored_values}
    ...          ${required_measurements}
    ...          ${antenna_list}

    ant_online_monitoring.verify_required_measurements_presence
    ...                                                     webui_results=${monitored_values}
    ...                                                     measurements=${required_measurements}
    ...                                                     antenna_list=${antenna_list}
    Robot Log Result                                        Antenna online measurements presence validation succeeded.
    ...                                                     console=${True}


Start CLI Antenna Online Monitoring
    [Arguments]                      ${target_dns}
    ...                              ${connection}
    Robot Log Operation              Starting admin antenna online monitoring...
    ${status}                        adm_ant_online_monitoring.start_antenna_online_monitoring
    ...                              target_dns=${target_dns}
    ...                              connection=${connection}
    Should Be Equal As Strings       ${status}     Succeeded


Stop CLI Antenna Online Monitoring
    [Arguments]                      ${output_file_path}
    ...                              ${connection}
    Robot Log Operation              Stopping admin antenna online monitoring...
    ${status}                        adm_ant_online_monitoring.stop_antenna_online_monitoring
    ...                              output_file_path=${output_file_path}
    ...                              connection=${connection}
    Should Be Equal As Strings       ${status}     Succeeded
