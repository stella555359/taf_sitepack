Library     taf.hw.optical_switch                                                             WITH NAME    optical_switch
Library     taf.rfrl.procedures.resources.python.optical_switch.optical_switch.OpticalSwitch  WITH NAME    rmod_optical_switch
Library     taf.rfrl.procedures.resources.python.testline.TestLine                            WITH NAME    hwpta_testline
Library     taf.rfrl.procedures.resources.python.admin_info_model.admin_info_model            WITH NAME    admin_info_model
Library     taf.rfrl.procedures.resources.python.connections                                  WITH NAME    connections
Library     taf.rfrl.procedures.resources.python.utilities                                    WITH NAME    utilities

Resource    taf/rfrl/procedures/resources/robot/HWPTA_Logger.robot


*** Variables ***

${OPTICAL_DEFAULT_CHANNEL}=                 1
${OPTICAL_BREAK_CHANNEL}=                   4
${FIRST_OPT_SWITCH_ID_IN_INIT}=             0


*** Keywords ***
Set Optical Switch Position
    [Documentation]
    ...    Connects to optical switch using TL configuration and sets switch into new position
    ...    ARGS:
    ...      :param int optical_switch_id: (Mandatory): Optical switch index serving the link in the tesline init file
    ...      :param int module_number: (Mandatory): Switch module number serving the optical link
    ...      :param int output_channel: (Mandatory): Module output channel to be set
    [Arguments]                    ${optical_switch_id}
    ...                            ${module_number}
    ...                            ${output_channel}
    optical_switch.setup_optical_switch           optical_switch=${tl.optical_switches[${optical_switch_id}].__class__.__name__}
    ...                                           model=${tl.optical_switches[${optical_switch_id}].model}
    ...                                           addr=${tl.optical_switches[${optical_switch_id}].addr}
    ...                                           port=${tl.optical_switches[${optical_switch_id}].port}
    ${in_port}=                                   convert to integer
    ...                                           ${module_number}
    ${out_port}=                                  convert to integer
    ...                                           ${output_channel}
    ${dict_in_out_ports}=                         create dictionary
    ...                                           ${in_port}=${out_port}

    Robot Log Operation                           Setting optical switch[id: ${optical_switch_id}] position to: module_number = ${module_number}, output_channel = ${output_channel}
    optical_switch.Set Optical Switch Channels    ${dict_in_out_ports}
    Robot Log Result                              Optical switch channels set to: ${dict_in_out_ports}
    [Teardown]                                    optical_switch.teardown


Set Optical Switches Positions
    [Documentation]
    ...    Sets switches into new positions according to given list of dictionaries or dictionary containing optical
    ...    switch settings like: optical_switch_id, module_number, output_channel.
    ...    ARGS:
    ...      :param dict or list[dict] optical_switch_settings: (Mandatory): List of dictionaries or dictionary containing
    ...                                                         optical switch settings, each dictionary must contain keys:
    ...                                                         "optical_switch_id", "module_number", "output_channel";
    ...                                                         e.g.:
    ...                                                         [{"optical_switch_id": 0, "module_number": 1, "output_channel": 2},
    ...                                                          {"optical_switch_id": 0, "module_number": 2, "output_channel": 3}]
    [Arguments]                                   ${optical_switch_settings}
    ${optical_switch_settings}=                   utilities.convert_to_list
    ...                                           data=${optical_switch_settings}

    FOR    ${optical_switch_setting}    IN    @{optical_switch_settings}
        Set Optical Switch Position
        ...                                       optical_switch_id=${optical_switch_setting["optical_switch_id"]}
        ...                                       module_number=${optical_switch_setting["module_number"]}
        ...                                       output_channel=${optical_switch_setting["output_channel"]}
    END


Reset optical link
    [Documentation]
    ...    Resets the link on given module by switching to the empty channel (4) and next to the given channel
    ...    ARGS:
    ...      :param int module_number: (Mandatory): Switch module number serving the optical link
    ...      :param str optical_break_time: (Optional): The time swich stays in the possition breaking the link, defaults to 5s
    ...      :param int output_channel: (Optional): Module output channel serving RU-BB optical connection, defaults to 1
    ...      :param int optical_switch_id: (Optional): Optical switch index serving the link in the tesline init file, defaults to 0
    [Arguments]                     ${module_number}
    ...                             ${optical_break_time}=5s
    ...                             ${output_channel}=${OPTICAL_DEFAULT_CHANNEL}
    ...                             ${optical_switch_id}=${FIRST_OPT_SWITCH_ID_IN_INIT}
    Set Optical Switch Position                    ${optical_switch_id}
    ...                                            ${module_number}
    ...                                            ${OPTICAL_BREAK_CHANNEL}
    Sleep                                          ${optical_break_time}
    Set Optical Switch Position                    ${optical_switch_id}
    ...                                            ${module_number}
    ...                                            ${output_channel}


Reset primary and secondary optical links
    [Documentation]
    ...    Resets primary and secondary links by switching to the empty channel (4) and next to the given channels
    ...    ARGS:
    ...      :param int primary_module_number: (Mandatory): Switch module number serving the primary optical link
    ...      :param int secondary_module_number: (Mandatory): Switch module number serving the secondary optical link
    ...      :param str optical_break_time: (Optional): The time swich stays in the possitions breaking links, defaults to 5s
    ...      :param int primary_output_channel: (Optional): Module output channel serving primary RU-BB optical connection, defaults to 1
    ...      :param int secondary_output_channel: (Optional): Module output channel serving secondary RU-BB optical connection, defaults to 1
    ...      :param int primary_optical_switch_id: (Optional): Optical switch index serving primary link in the tesline init file, defaults to 0
    ...      :param int secondary_optical_switch_id: (Optional): Optical switch index serving secondary link in the tesline init file, defaults to 0
    [Arguments]                     ${primary_module_number}
    ...                             ${secondary_module_number}
    ...                             ${optical_break_time}=5s
    ...                             ${primary_output_channel}=${OPTICAL_DEFAULT_CHANNEL}
    ...                             ${secondary_output_channel}=${OPTICAL_DEFAULT_CHANNEL}
    ...                             ${primary_optical_switch_id}=${FIRST_OPT_SWITCH_ID_IN_INIT}
    ...                             ${secondary_optical_switch_id}=${FIRST_OPT_SWITCH_ID_IN_INIT}
    Set Optical Switch Position                    ${primary_optical_switch_id}
    ...                                            ${primary_module_number}
    ...                                            ${OPTICAL_BREAK_CHANNEL}
    Reset optical link                             ${secondary_module_number}
    ...                                            ${optical_break_time}
    ...                                            ${secondary_output_channel}
    ...                                            ${secondary_optical_switch_id}
    Set Optical Switch Position                    ${primary_optical_switch_id}
    ...                                            ${primary_module_number}
    ...                                            ${primary_output_channel}

Disable Optical link for RMOD
    [Documentation]
    ...   Disables particular RMOD's optical link by set dedicated optical switch module ID to "blind" optical switch
    ...   channel ID for RMOD's optical switch channel.
    ...   Optical switch module id is defined in init under path:
    ...     -For GNB bts type:
    ...      "tl.gnbs[0].dus[0].rus[rmod_index].optical_switch_channels[rmod_link_id].switch_module.module_no"
    ...     -For ENB bts type:
    ...      "tl.enbs[0].rms[rmod_index].optical_switch_channels[rmod_link_id].switch_module.module_no"
    ...   "Blind" optical switch channel id is established as last channel on optical module and defined in
    ...   init under path:
    ...     -For GNB bts type:
    ...      "tl.gnbs[0].dus[0].rus[rmod_index].optical_switch_channels[rmod_link_id].switch_module.channel_amount"
    ...     -For ENB bts type:
    ...      "tl.enbs[0].rms[rmod_index].optical_switch_channels[rmod_link_id].switch_module.channel_amount"
    ...
    ...    ARGS:
    ...      :param str/int rmod_id: (Mandatory): Configuration ID of RMOD to set optical link
    ...      :param str/int rmod_link_id: (Mandatory): id of RMOD's optical link to set (from range 1 to n). Id number
    ...                      refers to order of optical_switch_channels list (n elements) defined in init under RMOD
    ...                      object. Value 1 means the first optical_switch_channel from defined list will be used to
    ...                      set optical switch channel.
    [Arguments]                     ${rmod_id}
    ...                             ${rmod_link_id}

    ${rmod_optical_links_config}                   Get Optical Links Config for RMOD
    ...                                            rmod_id=${rmod_id}
    ${optical_channel_index}                       Evaluate
    ...                                            int(${rmod_link_id})-1

    rmod_optical_switch.set_rmod_optical_link      rmod_optical_link_config=${rmod_optical_links_config[${optical_channel_index}]}
    ...                                            destination_channel_id=${rmod_optical_links_config[${optical_channel_index}]['channel_amount']}

    Robot Log Result                               Optical link ${rmod_link_id} on RMOD-${rmod_id} has been enabled.

Disable All Optical links for RMOD
    [Documentation]
    ...   Disables all optical links of particular RMOD by set dedicated optical switch modules IDs to "blind" optical switch
    ...   channel IDs for all RMOD's optical switch channels.
    ...   Optical switch module id is defined in init under path:
    ...     -For GNB bts type:
    ...      "tl.gnbs[0].dus[0].rus[rmod_index].optical_switch_channels[rmod_link_id].switch_module.module_no"
    ...     -For ENB bts type:
    ...      "tl.enbs[0].rms[rmod_index].optical_switch_channels[rmod_link_id].switch_module.module_no"
    ...   "Blind" optical switch channel id is established as last channel on optical module and defined in
    ...   init under path:
    ...     -For GNB bts type:
    ...      "tl.gnbs[0].dus[0].rus[rmod_index].optical_switch_channels[rmod_link_id].switch_module.channel_amount"
    ...     -For ENB bts type:
    ...      "tl.enbs[0].rms[rmod_index].optical_switch_channels[rmod_link_id].switch_module.channel_amount"
    ...
    ...    ARGS:
    ...      :param str/int rmod_id: (Mandatory): Configuration ID of RMOD to set optical link
    [Arguments]                     ${rmod_id}

    ${rmod_optical_links_config}                   Get Optical Links Config for RMOD
    ...                                            rmod_id=${rmod_id}

    FOR  ${rmod_optical_link_config}  IN  @{rmod_optical_links_config}
        rmod_optical_switch.set_rmod_optical_link      rmod_optical_link_config=${rmod_optical_link_config}
        ...                                            destination_channel_id=${rmod_optical_link_config['channel_amount']}
    END

    Robot Log Result                               All optical links on RMOD-${rmod_id} have been enabled.

