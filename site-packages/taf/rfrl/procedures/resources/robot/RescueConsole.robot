*** Settings ***
Library     taf.sbts.oam.coam.admin                             WITH NAME   admin

Library     ../python/rescue_console/RescueConsole.py           WITH NAME   rescue_console
Library     ../python/connections.py                            WITH NAME   connections
Library     ../python/timer/timer.py                            WITH NAME   timer

Resource    ../robot/Connections.robot
Resource    ../robot/StatusCheck.robot
Resource    ../robot/HWPTA_Logger.robot

*** Keywords ***
Handle Rescue Console And Open Admin Connection
    [Arguments]                    ${bts_type}
    ...                            ${bts_setup}
    ...                            ${is_full_rack}=${False}
    ...                            ${check_if_rmods_only_initialized}=${False}
    ...                            ${slave_smod_ip}=${None}

    ${master_connection}=          connections.get_default_admin_connection_alias
    ...                            bts_type=${bts_type}

    ${admin_connected}             Run Keyword If  """${bts_type}"""=='ENB' and """${bts_setup}"""=='NSA'
    ...                            Run Keyword And Return Status
    ...                            Create admin client session to LTE via VM
    ...                            ELSE IF  """${bts_type}"""=='GNB' and ${is_full_rack}
    ...                            Run Keyword And Return Status
    ...                            Create admin client session to slave SMOD via VM
    ...                            ip=${slave_smod_ip}
    ...                            master_connection=${master_connection}
    ...                            ELSE
    ...                            Run Keyword And Return Status
    ...                            Create admin session with default alias
    ...                            bts_type=${bts_type}
    ...                            timeout=2min

    ${log_msg}=                    Set Variable If  ${is_full_rack}
    ...                            slave${SPACE}
    ...                            ${EMPTY}

    Run Keyword If                 not ${admin_connected}
    ...                            Run Keywords
    ...                            Robot Log Operation
    ...                            Couldn't establish admin connection to ${log_msg}${bts_type}. Attempting to connect to Rescue Console ...
    ...                            AND
    ...                            Private Rollback To Active Sw Partition
    ...                            bts_type=${bts_type}

    Run Keyword If                 """${bts_type}"""=='ENB' and """${bts_setup}"""=='NSA' and not ${admin_connected}
    ...                            timer.wait_until_keyword_succeeds_timer
    ...                            10min
    ...                            2s
    ...                            Create admin client session to LTE via VM
    ...                            ELSE IF  not ${admin_connected} and ${is_full_rack}
    ...                            timer.wait_until_keyword_succeeds_timer
    ...                            10min
    ...                            2s
    ...                            Create admin client session to slave SMOD via VM
    ...                            ip=${slave_smod_ip}
    ...                            master_connection=${master_connection}
    ...                            ELSE IF  not ${admin_connected}
    ...                            timer.wait_until_keyword_succeeds_timer
    ...                            10min
    ...                            2s
    ...                            Create admin session with default alias
    ...                            bts_type=${bts_type}
    ...                            timeout=2min

    ${use_proxy}=                  Set Variable If   ("""${bts_type}"""=='ENB' and """${bts_setup}"""=='NSA') or ${is_full_rack}
    ...                            ${True}
    ...                            ${False}
    ${connection}                  connections.get_default_admin_connection_alias
    ...                            bts_type=${bts_type}
    ...                            use_proxy=${use_proxy}
    Run Keyword If                 ${admin_connected}
    ...                            Run Keywords
    ...                            Robot Log Operation
    ...                            Enabling SSH access on ${bts_type} ${log_msg}BTS ...
    ...                            AND
    ...                            admin.enable_ssh_access
    ...                            connection=${connection}
    ...                            timeout=60
    ...                            AND
    ...                            Robot Log Result 
    ...                            SSH access enabled on ${bts_type} ${log_msg}BTS!
    ...                            to_console=${True}

    Check Statuses Of BTS Components Depending On Commissioning State
    ...                            bts_type=${bts_type}
    ...                            use_proxy=${use_proxy}
    ...                            check_if_rmods_only_initialized=${check_if_rmods_only_initialized}

    [Teardown]                     Run Keyword If  ${is_full_rack}
    ...                            admin.teardown_admin
    ...                            connection=${connection}

Private Rollback To Active Sw Partition
    [Arguments]                    ${bts_type}=GNB

    Robot Log Operation            Rolling back to active SW partition ...
    rescue_console.connect         bts_type=${bts_type}
    rescue_console.enable_ssh_service
    rescue_console.rollback_to_active_sw_partition

    Robot Log Result               Succesfully rolled back to active SW partition!
