Generate Alarm And Check Blackbox Alarm History
    [Documentation]
    ...  Generates alarm and checks if it is stored in the blackbox alarm history.
    [Arguments]                                 ${path_to_bbox_file_before_alarm}
    ...                                         ${alarm_rmod_command}
    ...                                         ${expected_fault_id}
    ...                                         ${expected_fault_name}
    ...                                         ${rmod_id}
    ...                                         ${connection}
    ...                                         ${download_path}
    ...                                         ${rmod_blackbox_path}
    ...                                         ${blackbox_file_name}
    ...                                         ${bts_type}
    Robot Log Operation                         Verifying alarm history in blackbox file...
    Robot Log Operation                         Generating alarm FID: ${expected_fault_id}...
    rmod_operations.execute_ssh_command
    ...                                         rmod_id=${rmod_id}
    ...                                         command=${alarm_rmod_command}
    ...                                         connection=${connection}
    Robot Log Operation                         Waiting for FID: ${expected_fault_id} (${expected_fault_name}) to appear on RMOD-${rmod_id}...
    Alarms.Wait for active alarm                fault_id=${expected_fault_id}
    ...                                         fault_name=${expected_fault_name}
    ...                                         bts_type=${bts_type}
    ...                                         timeout=300s
    Sleep                                       5min
    ...                                         reason=Waiting for RMOD's blackbox to be updated after alarm triggering...

    ${alarm_bbox_filepath}=                     rmod_operations.get_file_from_rmod_with_rmod_index
    ...                                         rmod_index=${rmod_id}
    ...                                         download_path=${download_path}
    ...                                         connection=${connection}
    ...                                         rmod_path=${rmod_blackbox_path}
    ...                                         rmod_file_name=${blackbox_file_name}

    rmod_blackbox.set_blackbox_file             path_to_blackbox_file=${alarm_bbox_filepath}
    rmod_blackbox.verify_alarm_history          expected_fault_id=${expected_fault_id}
    ...                                         path_to_bbox_file_before_alarm=${path_to_bbox_file_before_alarm}
    ...                                         path_to_bbox_file_after_alarm=${alarm_bbox_filepath}


Get Internal Alarm Occurrences Count
    [Documentation]
    ...  Counts occurrences of the internal alarm (raw radio fault id) in BTS alarm history section in the blackbox file
    [Arguments]                                 ${path_to_blackbox_file}
    ...                                         ${fault_id}
    Robot Log Operation                         Getting count of ${fault_id} alarm's occurrences from ${path_to_blackbox_file}...
    rmod_blackbox.set_blackbox_file             path_to_blackbox_file=${path_to_blackbox_file}
    ${alarm_count}=                             rmod_blackbox.get_internal_alarm_occurrences_count
    ...                                         fault_id=${fault_id}
    Robot Log Result                            Alarm ${fault_id} occurrences count: ${alarm_count}
    ...                                         to_console=${True}

    [Return]                                    ${alarm_count}
