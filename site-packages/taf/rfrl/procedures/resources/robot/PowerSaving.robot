Get Power Usage On RU
    [Arguments]                                        ${bts_type}=GNB
    Robot log operation                                Getting power usage on RU...
    ${connection}                                      connections.get_default_admin_connection_alias
    ...                                                bts_type=${bts_type}

    ${runtime_ru_dist_names}                           admin_info_model.get_admin_rmod_runtime_distnames
    ...                                                connection=${connection}
    ${ru_power_usage}                                  admin_info_model.get_power_usage_for_rus
    ...                                                connection=${connection}
    ...                                                runtime_ru_dist_names=${runtime_ru_dist_names}

    [Return]                                           ${ru_power_usage}

Get Power Usage During L3 Call
    [Arguments]                                        ${called_cell}
    ...                                                ${direction}
    ...                                                ${call_duration}
    ...                                                ${throughput}
    ...                                                ${protocol}=udp
    ...                                                ${udp_buffer}=4M
    ...                                                ${bts_type}=GNB

    Start L3 Call In Background                        called_cell=${called_cell}
    ...                                                direction=${direction}
    ...                                                duration=${call_duration}
    ...                                                throughputs=${throughput}
    ...                                                protocol=${protocol}
    ...                                                udp_buffer=${udp_buffer}

    ${sleep_time}                                      Remove String Using Regexp   ${call_duration}  [a-zA-Z]
    ${sleep_time}=                                     Evaluate    int(${sleep_time})/2
    Sleep                                              ${sleep_time}  Reason=Waiting for change in power usage...
    ${ru_power_usage}                                  Get Power Usage On RU
    ...                                                bts_type=${bts_type}

    Verify Background L3 Call Results                  called_cell=${called_cell}

    [Return]                                           ${ru_power_usage}

Get Power Usage During L3 Call With Multiple Traffic Loads
    [Arguments]                                        ${throughputs}
    ...                                                ${called_cell}
    ...                                                ${direction}
    ...                                                ${call_duration_per_load}
    ...                                                ${protocol}=udp
    ...                                                ${udp_buffer}=4M
    ...                                                ${start_power_usage}=${None}
    ...                                                ${bts_type}=GNB
    @{power_usage_measurements}                        Create List
    FOR    ${throughput}    IN    @{throughputs}
        ${power_usage}                                 Get Power Usage During L3 Call
        ...                                            called_cell=${called_cell}
        ...                                            call_duration=${call_duration_per_load}
        ...                                            throughput=${throughput}
        ...                                            direction=${direction}
        ...                                            protocol=${protocol}
        ...                                            udp_buffer=${udp_buffer}
        ...                                            bts_type=${bts_type}
        Append To List    ${power_usage_measurements}  ${power_usage}
    END

    [Return]                                           ${power_usage_measurements}

Get Power Usage During L3 Call With ETWS/CMAS Broadcast
    [Arguments]                                        ${broadcast}
    ...                                                ${called_cell}
    ...                                                ${eutran_cell_id}
    ...                                                ${direction}
    ...                                                ${call_duration}
    ...                                                ${throughput}
    ...                                                ${protocol}=udp
    ...                                                ${udp_buffer}=4M
    ...                                                ${bts_type}=GNB

    ${sleep_time}                                      Remove String Using Regexp   ${call_duration}  [a-zA-Z]

    Start L3 Call In Background                        called_cell=${called_cell}
    ...                                                direction=${direction}
    ...                                                duration=${call_duration}
    ...                                                throughputs=${throughput}
    ...                                                protocol=${protocol}
    ...                                                udp_buffer=${udp_buffer}

    ${sleep_time_before_broadcast}=                    Evaluate    int(${sleep_time})/3
    Sleep                                              ${sleep_time_before_broadcast}  Reason=Waiting for change in power usage...
    ${ru_power_usage_before_broadcast}                 Get Power Usage On RU
    ...                                                bts_type=${bts_type}

    Set Up And Launch Broadcast                        broadcast=${broadcast}
    ...                                                eutran_cell_id=${eutran_cell_id}
    ${sleep_time_after_broadcast}=                     Evaluate    int(${sleep_time})/5
    Sleep                                              ${sleep_time_after_broadcast}  Reason=Waiting for change in power usage...
    ${ru_power_usage_after_broadcast}                  Get Power Usage On RU
    ...                                                bts_type=${bts_type}

    Verify Background L3 Call Results                  called_cell=${called_cell}

    [Return]       ${ru_power_usage_before_broadcast}  ${ru_power_usage_after_broadcast}

Get average power usage on RUs
    [Arguments]                                        ${iteration}=2

    Robot log operation                                Getting average power usage on RU
    ${connection}                                      connections.get_default_admin_connection_alias
    ${runtime_ru_dist_names}                           admin_info_model.get_admin_rmod_runtime_distnames
    ...                                                connection=${connection}
    ${ru_avg_power_usage}                              power_usage.calculate_avg_power_usage
    ...                                                connection=${connection}
    ...                                                runtime_ru_dist_names=${runtime_ru_dist_names}
    ...                                                iteration=${iteration}

    [Return]                                           ${ru_avg_power_usage}

Get Power Usage During ETWS/CMAS Broadcast
    [Arguments]                                        ${broadcast}
    ...                                                ${broadcast_time}
    ...                                                ${cell_dist_names}
    ...                                                ${eutran_cell_id}
    ...                                                ${bts_type}=GNB
    ...                                                ${sleep_time}=${None}

    ${sleep_time}=                                     Set Variable If    '${sleep_time}' == 'None'
    ...                                                ${broadcast_time}
    ...                                                ${sleep_time}

    Perform UE Attach                                  called_cell=${cell_dist_names["configuration"]}
    Sleep                                              ${sleep_time}  Reason=Waiting for change in power usage after attach...
    ${ru_power_usage_before_broadcast}                 Get Power Usage On RU
    ...                                                bts_type=${bts_type}

    Set Up And Launch Broadcast                        broadcast=${broadcast}
    ...                                                eutran_cell_id=${eutran_cell_id}
    ...                                                end_time=${broadcast_time}
    Sleep                                              ${sleep_time}  Reason=Waiting for change in power usage induced by broadcast message...
    ${ru_power_usage_during_broadcast}                 Get Power Usage On RU
    ...                                                bts_type=${bts_type}

    Sleep                                              ${sleep_time}  Reason=Waiting for change in power usage after broadcast...
    ${ru_power_usage_after_broadcast}                  Get Power Usage On RU
    ...                                                bts_type=${bts_type}

    [Teardown]                                         Perform UE Detach
    ...                                                called_cell=${cell_dist_names["configuration"]}

    [Return]   ${ru_power_usage_before_broadcast}  ${ru_power_usage_during_broadcast}  ${ru_power_usage_after_broadcast}
