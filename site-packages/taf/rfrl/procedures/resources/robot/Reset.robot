Library     taf.sbts.oam.coam.admin                                   WITH NAME  admin
Library     taf.rfrl.common_resources.python.reset_bts_configuration  WITH NAME  config_reset

Library     ../python/timer/timer.py                                  WITH NAME  timer
Library     ../python/connections.py                                  WITH NAME  connections
Library     ../python/SCF.py                                          WITH NAME  scf
Library     ../python/admin_info_model/admin_info_model.py            WITH NAME  admin_info_model
Library     ../python/testline/TestLine.py                            WITH NAME  hwpta_testline
Library     ../python/status_check/status_check.py                    WITH NAME  status_check

Resource    HWPTA_Logger.robot
Resource    StatusCheck.robot
Resource    Connections.robot
Resource    Alarms.robot
Resource    KPI.robot

*** Keywords ***
Perform Configuration Reset And Check State
    [Arguments]  ${config_reset_timeout}=1200
    ...          ${current_scf_dir}=/tmp/
    ...          ${current_scf_name}=current_BTS_configuration.xml
    ...          ${bts_type}=GNB
    ...          ${use_proxy}=${False}
    ...          ${reset_admin_connection}=${True}

    ${connection}                            connections.get_default_admin_connection_alias
    ...                                      bts_type=${bts_type}
    ...                                      use_proxy=${use_proxy}

    ${is_fullrack}=                          hwpta_testline.is_full_rack
    ${secondary_vm_ip}=    run keyword if    ${is_fullrack}
    ...                                      hwpta_testline.get_ip_of_secondary_vm_for_fullrack
    ...                                      ELSE
    ...                                      set variable
    ...                                      ${None}

    Run Keyword If                           not ${use_proxy}   Run Keywords
    ...  Robot Log Operation                 Saving current SCF file to ${current_scf_dir}${current_scf_name}
    ...                                      AND
    ...                                      scf.get_scf_file
    ...                                      local_dir_path=${current_scf_dir}
    ...                                      file_name=${current_scf_name}

    Robot Log Operation                      Performing configuration reset
    run keyword if                           ${is_fullrack}
    ...                                      config_reset.reset_bts_configuration
    ...                                      connection=${connection}
    ...                                      timeout=${config_reset_timeout}
    ...                                      secondary_remote_host=${secondary_vm_ip}
    ...                                      reset_admin_connection=${reset_admin_connection}
    ...                                      ELSE
    ...                                      config_reset.reset_bts_configuration
    ...                                      connection=${connection}
    ...                                      timeout=${config_reset_timeout}
    ...                                      reset_admin_connection=${reset_admin_connection}
    timer.wait_until_keyword_succeeds_timer  5m
    ...                                      10s
    ...                                      Check Status Of Uncomissioned BTS
    ...                                      bts_type=${bts_type}
    ...                                      use_proxy=${use_proxy}
    run keyword if                           """${bts_type}"""=='GNB'
    ...                                      Priv Check Rmod List Is Empty
    ...                                      connection=${connection}

    Robot Log Operation                      Configuration reset complete, waiting for baseband modules availability

    timer.wait_until_keyword_succeeds_timer  10m
    ...                                      2s
    ...                                      Check Baseband Module Statuses With Loner Change Detection
    ...                                      bts_type=${bts_type}
    ...                                      use_proxy=${use_proxy}

    Sleep                                    60s
    ...                                      reason=Waiting for baseband modules fully initialized

    Robot Log Result                         Baseband module is fully available
    ...                                      to_console=${True}


    Robot Log Operation                      Enabling SSH service account
    admin.enable_ssh_access                  connection=${connection}
    ...                                      timeout=60

Perform Site Reset And Wait On OnAir
    [Arguments]  ${bts_type}=GNB

    ${alias}=                                connections.get_default_admin_connection_alias
    ...                                      bts_type=${bts_type}
    ${setup_mode}=                           hwpta_testline.get_bts_setup_mode
    Allow DSS alarms
    Allow X2 Link Alarms
    Robot Log Operation                      Performing BTS Site Reset...
    ${is_remote_enb}=                        Evaluate
    ...                                      '${setup_mode}'=='NSA' and '${bts_type}'=='ENB'
    ${site_reset_timeout}                    Run keyword if
    ...                                      not ${is_remote_enb}
    ...                                      Get Timeout Site Reset
    ...                                      ELSE
    ...                                      Set Variable
    ...                                      1020
    admin.reset_site                         timeout=300s
    ...                                      connection=${alias}
    timer.wait_until_keyword_succeeds_timer  ${site_reset_timeout}
    ...                                      5 sec
    ...                                      Check all BBMODs RMODs and cells states for all RATs
    ...                                      bts_type=${bts_type}
    Check BTS state and all RATs states      bts_type=${bts_type}
    Disallow DSS alarms
    Disallow X2 Link Alarms

Reset RMOD in Background
    [Documentation]   Reset RMOD with given configuration index
    ...               Args:
    ...               ${rmod_id} - configuration index of RMOD to reset i.e. 1
    ...               ${connection} - admin connection alias
    ...               ${bts_type} - BTS type
    [Arguments]       ${rmod_id}
    ...               ${connection}
    ...               ${bts_type}

    Robot Log Iteration                      Resetting RMOD with index: ${rmod_id}
    ${runtime_id}                            admin_info_model.translate_rmod_index_to_runtime
    ...                                      rmod_index=${rmod_id}
    ...                                      connection=${connection}
    ${credentials}=                          connections.get_http_connection_credentials
    ...                                      bts_type=${bts_type}
    ${bts_host}=                             Set Variable   ${credentials['ip']}

    admin_info_model.reset_rmod_in_separate_process
    ...                                      connection=${connection}
    ...                                      runtime_rmod_id=${runtime_id}
    ...                                      connection_host=${bts_host}

Reset RMOD and wait for it to be available
    [Documentation]   Reset RMOD with given configuration index and wait for it to be available
    ...               Args:
    ...               ${rmod_id} - configuration index of RMOD to reset i.e. 1
    ...               ${connection} - admin connection alias
    ...               ${bts_type} - BTS type
    [Arguments]       ${rmod_id}
    ...               ${connection}
    ...               ${bts_type}
    Reset RMOD In Background                 rmod_id=${rmod_id}
    ...                                      connection=${connection}
    ...                                      bts_type=${bts_type}
    timer.wait_until_keyword_succeeds_timer
    ...                                      180
    ...                                      5 sec
    ...                                      status_check.verify_statuses_of_rmod
    ...                                      rmod_id=${rmod_id}
    ...                                      status_variant=disabled
    ...                                      connection=${connection}
    wait until keyword succeeds              3min
    ...                                      2 sec
    ...                                      Check statuses of cells for RMOD
    ...                                      rmod_id=${rmod_id}
    ...                                      status_variant=failed
    ...                                      connection=${connection}
    ...                                      bts_type=${bts_type}

Priv Check Rmod List Is Empty
    [Arguments]  ${connection}

    ${rmods}=                                admin_info_model.get_rmods
    ...                                      connection=${connection}

    should be empty                          ${rmods}
    ...                                      msg=After configuration reset radio object list ${rmods} should be empty

Perform RAT Reset In Background
    [Documentation]   Reset provided RAT
    ...               Args:
    ...               rat_type - name of RAT to reset;  defaults to ${None} which means that all RATs will be reset
    ...               rat_reset_option - type of RAT reset; defaults to soft; available options (soft/hard)
    ...               graceful_cell_shutdown - additional option when resetting RAT; defaults to ${False}
    ...               bts_type - BTS type; defaults to `GNB`; can be `GNB` or `ENB`
    [Arguments]                             ${rat}
    ...                                     ${reset_type}=Soft
    ...                                     ${graceful_cell_shutdown}=${False}
    ...                                     ${bts_type}=GNB

    Robot Log Operation                     Performing ${rat} ${reset_type} RAT reset in background ...
    ${reset_rat_task}                       admin_info_model.reset_rat_in_separate_process
    ...                                     rat=${rat}
    ...                                     reset_type=${reset_type}
    ...                                     graceful_cell_shutdown=${graceful_cell_shutdown}


    [Return]    ${reset_rat_task}
