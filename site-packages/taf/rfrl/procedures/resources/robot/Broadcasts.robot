Create SIB Object
    [Documentation]         Creates SIB objects based on given input. Works for one and more sibs. For more than one
    ...                     please use ";" separator. e.g sibs=SIB10;SIB11
    [Arguments]                                        ${config_cell_dist_name}
    ...                                                ${sibs}
    ...                                                ${bts_type}=GNB

    ${sib_list}                                        Create list
    ${sibs_split}                                      Split string  ${sibs}  ;
    FOR    ${sib}    IN    @{sibs_split}
        ${sib_params}      Create dictionary            siMessagePeriodicity=80ms
        ...                                             siMessageRepetition=1
        ...                                             siMessageSibType=${sib}
        Append to list  ${sib_list}  ${sib_params}
    END

    ${connection}                                      connections.get_default_admin_connection_alias
    ...                                                bts_type=${bts_type}
    config_operations.connect                          alias=${connection}
    ...                                                bts_type=${bts_type}
    config_operations.set_parameters_values            dist_name=${config_cell_dist_name}/SIB-0
    ...                                                sibSchedulingList=${sib_list}
