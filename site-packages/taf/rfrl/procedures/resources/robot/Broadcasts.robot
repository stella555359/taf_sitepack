*** Keywords ***
Set Up And Launch Broadcast
    [Arguments]                                        ${broadcast}
    ...                                                ${eutran_cell_id}
    ...                                                ${start_time}=0
    ...                                                ${end_time}=30
    ...                                                ${hostname}=10.42.194.52
    ...                                                ${username}=ute
    ...                                                ${password}=Ut3pa5s#1be1
    ...                                                ${script_path}=/home/ute/cbe.ksh

    tempere.open_connection                            hostname=${hostname}
    ...                                                username=${username}
    ...                                                password=${password}
    tempere.configure_broadcast_on_cbe_simulator       broadcast=${broadcast}
    ...                                                script_path=${script_path}

    Robot Log Operation                                Starting ${broadcast} broadcasting...
    tempere.start_broadcasting                         broadcast=${broadcast}
    ...                                                eutran_cell_id=${eutran_cell_id}
    ...                                                start_time=${start_time}
    ...                                                end_time=${end_time}

Disable Broadcasts
    [Arguments]                                        ${bts_type}=GNB

    Robot Log Operation                                Disabling ETWS & CMAS broadcasting...
    ${connection}                                      connections.get_default_admin_connection_alias
    ...                                                bts_type=${bts_type}
    ${mrbts_id}=                                       admin_info_model.get_mrbts_id_admin
    ...                                                connection=${connection}
    ${nrbts_lnbts_id}=                                 Run Keyword If  '${bts_type}'=='GNB'
    ...                                                admin_info_model.get_nrbts_id_admin
    ...                                                connection=${connection}
    ...                                                ELSE IF  '${bts_type}'=='ENB'
    ...                                                admin_info_model.get_lnbts_id_admin
    ...                                                connection=${connection}
    ${nrbts_lnbts_obj}=                                Set Variable If  '${bts_type}'=='GNB'
    ...                                                NRBTS
    ...                                                LNBTS

    config_operations.connect                          alias=${connection}
    ...                                                bts_type=${bts_type}
    config_operations.set_parameters_values            dist_name=MRBTS-${mrbts_id}/${nrbts_lnbts_obj}-${nrbts_lnbts_id}
    ...                                                actETWS=${False}
    ...                                                actCMAS=${False}

Configure And Enable CMAS
    [Arguments]                                        ${config_cell_dist_name}
    ...                                                ${bts_type}=GNB

    Robot Log Operation                                Configuring CMAS broadcasting...
    Create SIB Object                                  config_cell_dist_name=${config_cell_dist_name}
    ...                                                sibs=SIB12
    ...                                                bts_type=${bts_type}
    Set CMAS Parameters On BTS                         bts_type=${bts_type}


Configure And Enable ETWS
    [Arguments]                                        ${config_cell_dist_name}
    ...                                                ${bts_type}=GNB

    Robot Log Operation                                Configuring ETWS broadcasting...
    Create SIB Object                                  config_cell_dist_name=${config_cell_dist_name}
    ...                                                sibs=SIB10;SIB11
    ...                                                bts_type=${bts_type}
    Set ETWS Parameters On BTS                         bts_type=${bts_type}


Prepare UE For Receiving Broadcast
    [Arguments]                                        ${ue}
    ...                                                ${resolution}=${None}
    ...                                                ${pixel_density}=${None}
    ...                                                ${ue_reboot}=${True}
    ...                                                ${timeout}=120

    Robot Log Operation                                Preparing UE for broadcast receive...
    ue.setup                                           tl_ue=${ue}
    Run Keyword If                                     """${resolution}"""!='None'
    ...                                                ue.change_wm_resolution
    ...                                                resolution=${resolution}
    Run Keyword If                                     """${pixel_density}"""!='None'
    ...                                                ue.change_wm_density
    ...                                                pixel_density=${pixel_density}
    Run Keyword If                                     ("""${resolution}"""!='None' or """${pixel_density}"""!='None') and ${ue_reboot}
    ...                                                ue.reboot_ue_and_check_if_reachable
    ...                                                timeout=${timeout}

    ue.run_naa_app
    ue.press_home_button
    ue.run_naa_app
    Log Result                                         UE is ready for broadcast receive

Clear UE Settings After Broadcast
    [Arguments]                                        ${default_resolution}=${True}
    ...                                                ${default_density}=${True}
    ...                                                ${ue_reboot}=${True}

    Robot Log Operation                                Returning UE to default setting...
    Run Keyword If                                     ${default_resolution}
    ...                                                ue.change_to_default_wm_resolution
    Run Keyword If                                     ${default_density}
    ...                                                ue.change_to_default_wm_density
    Run Keyword If                                     (${default_resolution} or ${default_density}) and ${ue_reboot}
    ...                                                ue.reboot_ue_and_check_if_reachable
    ue.run_naa_app
    Robot Log Result                                   UE setting has been set successfully to default values

