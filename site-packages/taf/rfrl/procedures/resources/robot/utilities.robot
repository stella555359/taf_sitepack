*** Settings ***

Resource    taf/rfrl/bts/robot/gnb.robot
Resource    HWPTA_Logger.robot

Library     ../python/admin_info_model/admin_info_model.py
Library     ../python/hw_info/hw_info.py                    WITH NAME  hw_info
Library     ../python/connections.py                        WITH NAME  connections

*** Keywords ***
Rerun Test Case with BTS Reset
    [Arguments]    ${keyword}    ${gnb_id}=0    @{args}    &{kwargs}
    Reset gNB    gnb_id=${gnb_id}
    Log To Console    Waiting for onAir...
    Wait Until Keyword Succeeds     900 sec     15 sec   Verify gNB is onAir
    Verify Default Allowed Alarms on gNB
    Sleep  60s
    Run Keyword    ${keyword}    @{args}    &{kwargs}
    Fail    Main test failed!

Get and Save DHCP Configuration
    ${dhcp_dict} =      Get DHCP Config For All Radio Units
    Set Test Variable   ${dhcp_dict}

Wait Till Snapshot Saved
    Sleep    5s

Wait for Cell Status Change after RU Reboot
    Sleep    7s

Save Origin Interval Value
    [Arguments]    ${dist_name}    ${abbr_group_name}
    gnb_counter.Save PM Interval    dist_name=${dist_name}    abbr_group_name=${abbr_group_name}

Change PM Interval To
    [Arguments]    ${dist_name}    ${abbr_group_name}    ${interval}=5min
    gnb_counter.Set PM Interval gNB     dist_name=${dist_name}    abbr_group_name=${abbr_group_name}    interval=${interval}

Check all RMODs serial numbers and product codes

    [Arguments]                ${bts_type}

    ${connection}=             connections.get_default_admin_connection_alias
    ...                        bts_type=${bts_type}

    Robot Log Step             Comparison of serial numbers and product codes for radio modules started...
    ${init_rmods_info}         hw_info.get_rmod_serial_numbers_and_product_codes
    ...                        bts_type=${bts_type}

    ${admin_rmods_info}        admin_info_model.get_rmod_serial_numbers_and_product_codes
    ...                        connection=${connection}

    hw_info.compare_serial_numbers_and_product_codes_of_rmods
    ...                        init_rmods_info=${init_rmods_info}
    ...                        admin_rmods_info=${admin_rmods_info}

Get all RMODs index values
    [Arguments]                ${bts_type}=GNB

    ${connection}=             connections.get_default_admin_connection_alias
    ...                        bts_type=${bts_type}

    Robot Log Operation        Getting RMODs indexes via admin...
    ${rmods}=                  admin_info_model.get_rmod_indexes   connection=${connection}
    Robot Log Result           RMODs indexes got via admin: ${rmods}

    [Return]                   ${rmods}

Get all cells from RMOD
    [Arguments]                ${rmod_id}
    ...                        ${bts_type}=GNB
    ...                        ${to_console}=${True}
    ${connection}=             connections.get_default_admin_connection_alias
    ...                        bts_type=${bts_type}

    ${rats}=                   admin_info_model.get_rats            connection=${connection}
    Robot Log Operation        Getting all cells from RMODs via admin...    to_console=${to_console}
    ${cell_ids}=               admin_info_model.get_cell_ids_for_ru_from_specific_rats
    ...                                                             connection=${connection}
    ...                                                             rmod_id=${rmod_id}
    ...                                                             rats=${rats}
    Robot Log Result           RMODs cells' IDs got via admin: ${cell_ids}

    [Return]                   ${cell_ids}


Create Date Stamp
    ${date}             DateTime.Get Current Date
    ${formatted_date}   Convert Date    ${date}    result_format=_%H:%M:%S_%Y-%m-%d
    [Return]            ${formatted_date}
