Start Watching Cells Parameters On RMOD In Deep Sleep
    [Arguments]                               ${rmod_config_distname}

    ${bts_type}=                              hwpta_testline.get_type_of_setup
    ${connection}=                            connections.get_default_admin_connection_alias
    ...                                       bts_type=${bts_type}
    ${rmod_internal_distname}=                admin_info_model.translate_rmod_distname
    ...                                       rmod_distname=${rmod_config_distname}
    ...                                       output_distname_type=internal
    ...                                       connection=${connection}
    ${cells_statuses}=                        admin_info_model.get_statuses_of_cells_for_rmod
    ...                                       rmod_internal_distname=${rmod_internal_distname}
    ...                                       connection=${connection}
    &{rmod_statuses}=                         Evaluate  {"${rmod_internal_distname}": {"proceduralStatus": "initializing"}}

    &{cells_statuses_to_watch}=               Create Dictionary

    FOR  ${cell_internal_dist_name}  ${cell_statuses}  IN ZIP  ${cells_statuses.keys()}    ${cells_statuses.values()}
        ${energy_saving_state}=               admin_info_model.get_parameter_value_from_object
        ...                                   dist_name=${cell_internal_dist_name}
        ...                                   parameter_name=energySavingState
        ...                                   connection=${connection}

        &{selected_statuses}=                 Create Dictionary
        ...                                   operationalState=${cell_statuses['operationalState']}
        ...                                   availabilityStatus=${cell_statuses['availabilityStatus']}
        ...                                   administrativeState=${cell_statuses['administrativeState']}
        ...                                   energySavingState=${energy_saving_state}
        Set To Dictionary                     ${cells_statuses_to_watch}  ${cell_internal_dist_name}=&{selected_statuses}
    END

    status_watchdog.watch_statuses
    status_watchdog.expect_statuses_with_stop_conditions
    ...                                       statuses=${cells_statuses_to_watch}
    ...                                       stop_conditions=${rmod_statuses}

Stop Watching Cells Parameters On RMOD In Deep Sleep
    status_watchdog.check_unexpected_statuses

    [Teardown]                                status_watchdog.stop_watching_statuses

