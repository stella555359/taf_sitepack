Priv Unblock cells on RMOD
    [Arguments]                               ${connection}
    ...                                       ${rmod_config_distname}
    ...                                       ${bts_type}=GNB

    ${rmod_internal_distname}=                admin_info_model.translate_rmod_distname
    ...                                       rmod_distname=${rmod_config_distname}
    ...                                       output_distname_type=internal
    ...                                       connection=${connection}

    @{cells}=                                 admin_info_model.get_cell_mapping_for_rmod
    ...                                       rmod_internal_distname=${rmod_internal_distname}
    ...                                       connection=${connection}
    ...                                       sort_cells_by_chbw=${True}
    ...                                       reverse_order=${True}

    FOR  ${cell}  IN  @{cells}
        ${cell_id}=                            Get From Dictionary  ${cell}  CELLID
        ${cell_rat}=                           Get From Dictionary  ${cell}  RAT
        ${is_iot_cell}                         admin_info_model.is_iot_cell
        ...                                    connection=${connection}
        ...                                    cell_id=${cell_id}
        ...                                    cell_type=${cell_rat}
        ${is_blocked}                          status_check.is_cell_blocked
        ...                                    cell_id=${cell_id}
        ...                                    cell_type=${cell_rat}
        ...                                    connection=${connection}
        Continue for loop if  ${is_iot_cell}==${True} or ${is_blocked}==${False}
        ${dist_name}=                          Get From Dictionary  ${cell}  runtimeDistName
        ${operation_succeed}=                  admin.unblock_cell
        ...                                    dist_name=${dist_name}
        ...                                    connection=${connection}
        ...                                    timeout=80s
        Run keyword if   ${operation_succeed}
        ...                                    Robot Log Iteration
        ...                                    msg=Cell ${dist_name} is unblocked
    END

