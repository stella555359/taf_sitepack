Unblock Cells And Wait For AWAKE State On RMOD
    [Documentation]     This method unblocks all RMOD's cells and waits for powerState status AWAKE.
    ...                 ARGS:
    ...                 - rmod_config_distname: configuration dist name of radio module
    ...                 - expected_energy_saving: value of expected energy saving parameter (DEEPSLEEP, DEEPSLEEP_EXTREME_SFP or NORMAL);
    ...                                           defaults to DEEPSLEEP

    [Arguments]                               ${rmod_config_distname}
    ...                                       ${expected_energy_saving}=DEEPSLEEP

    ${bts_type}=                              hwpta_testline.get_type_of_setup
    ${connection}=                            connections.get_default_admin_connection_alias
    ...                                       bts_type=${bts_type}
    ${rmod_id}=                               Evaluate  int(str("""${rmod_config_distname}""").split('-')[-1])

    ${timeout}=                               Get Timeout Cell Unblock
    ${timeout}=                               Evaluate      ${timeout}*2

    Start Watching Cells Parameters On RMOD In Deep Sleep
    ...                                       rmod_config_distname=${rmod_config_distname}
    Priv Unblock cells on RMOD                connection=${connection}
    ...                                       rmod_config_distname=${rmod_config_distname}
    ...                                       bts_type=${bts_type}

    Priv Wait for AWAKE Power State on RMOD            rmod_id=${rmod_id}
    ...                                                expected_energy_saving=${expected_energy_saving}
    ...                                                rmod_config_distname=${rmod_config_distname}

    Stop Watching Cells Parameters On RMOD In Deep Sleep

    timer.wait_until_keyword_succeeds_timer
    ...                                       ${timeout}
    ...                                       5s
    ...                                       Check statuses of cells for RMOD
    ...                                       rmod_id=${rmod_id}
    ...                                       connection=${connection}
    ...                                       status_variant=online

    Alarms.Disallow alarm                     fault_name=Cell blocked
    ...                                       fault_id=49
    ...                                       bts_type=${bts_type}
    Alarms.Disallow DSS Alarms If DSS On Any RMOD
    ...                                       bts_type=${bts_type}

