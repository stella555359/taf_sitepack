Get Deep Sleep Time Schedule and RMOD Wake Up Time
        [Arguments]                                             ${deep_sleep_time}

        ${current_datetime}=                                    Get Current Date
        ...                                                     exclude_millis=yes
        ${start_datetime}=                                      Add Time to Date  ${current_datetime}  00:05:00
        ...                                                     exclude_millis=yes
        ${start_time}=                                          Convert Date  ${start_datetime}
        ...                                                     result_format=%H:%M
        ...                                                     exclude_millis=yes
        ${wake_datetime}=                                       Add Time to Date  ${start_datetime}  ${deep_sleep_time} minutes
        ...                                                     exclude_millis=yes

        [Return]     ${start_datetime}  ${start_time}  ${wake_datetime}

Enable Deep Sleep Time Schedule
    [Arguments]                               ${rmod_config_distname}
    ...                                       ${start_time}
    ...                                       ${window_duration}
    ...                                       ${time_for_ru_restore}

    ${bts_type}=                              hwpta_testline.get_type_of_setup
    ${connection}=                            connections.get_default_admin_connection_alias
    ...                                       bts_type=${bts_type}
    ${mrbts_id}=                              Evaluate  str("""${rmod_config_distname}""").split('/')[0].split('-')[1]

    Robot Log Operation                       Enabling Deep Sleep Time Schedule on ${rmod_config_distname}...

    ${delta_name}=                            Set Variable    deep_sleep
    admin.create_delta                        delta_id=${delta_name}

    admin.append_parameter_update_to_delta    dist_name=${rmod_config_distname}
    ...                                       parameter=advanceTimeForRURestore
    ...                                       value=${time_for_ru_restore}
    ...                                       delta_id=${delta_name}
    admin.append_complex_item_to_delta        dist_name=${rmod_config_distname}
    ...                                       list_name=deepSleepTimeSchedule
    ...                                       dayOfWeek=Every day
    ...                                       startTime=${start_time}
    ...                                       windowDuration=${window_duration}
    ...                                       delta_id=${delta_name}
    admin.append_parameter_update_to_delta    dist_name=MRBTS-${mrbts_id}/MNL-1/MNLENT-1/FEATCADM-1
    ...                                       parameter=actRadioDeepSleepTimeSchedule
    ...                                       value=${True}
    ...                                       delta_id=${delta_name}

    ${delta}=                                 admin.get_delta
    ...                                       delta_id=${delta_name}
    admin.perform_delta_recommissioning       delta_file=${delta}
    ...                                       connection=${connection}

    Robot Log Result                          Deep Sleep Time Schedule has been enabled successfully

Wait For The End Of Deep Sleep Window
        [Arguments]                                             ${rmod_config_distname}
        ...                                                     ${start_datetime}
        ...                                                     ${wake_datetime}
        ...                                                     ${deep_sleep_time}
        ...                                                     ${expected_energy_saving}=DEEPSLEEP

        Robot Log Operation                                     RMOD is expected to begin wake up procedure at ${wake_datetime}
        ${current_datetime}=                                    Get Current Date
        ...                                                     exclude_millis=yes
        ${timedelta}=                                           Subtract Date From Date  ${current_datetime}  ${start_datetime}
        ...                                                     result_format=verbose
        ...                                                     exclude_millis=yes
        ${remaining_sleep_time}=                                Subtract Time From Time  ${deep_sleep_time} minutes  ${timedelta}
        ...                                                     result_format=verbose
        ...                                                     exclude_millis=yes
        ${remaining_sleep_time_adjusted}=                       Add Time To Time  ${remaining_sleep_time}  60 seconds

        timer.wait_until_keyword_succeeds_timer                 ${remaining_sleep_time_adjusted}s
        ...                                                     20s
        ...                                                     Check If RMOD Is In Awake Mode
        ...                                                     rmod_config_distname=${rmod_config_distname}
        ...                                                     datetime=${wake_datetime}
        ...                                                     expected_energy_saving=${expected_energy_saving}
        timer.wait_until_keyword_succeeds_timer                 11min
        ...                                                     5s
        ...                                                     Check EnergySaving Parameter
        ...                                                     rmod_config_distname=${rmod_config_distname}
        ...                                                     expected_energy_saving=${expected_energy_saving}
        ...                                                     expected_power_state=AWAKE

Check If RMOD Is In Awake Mode
        [Arguments]                                             ${rmod_config_distname}
        ...                                                     ${datetime}
        ...                                                     ${expected_energy_saving}

        ${rmod_is_awake}=                                       Run Keyword And Return Status
        ...                                                     Check EnergySaving Parameter
        ...                                                     rmod_config_distname=${rmod_config_distname}
        ...                                                     expected_energy_saving=${expected_energy_saving}
        ...                                                     expected_power_state=AWAKE
        Run Keyword If                                          ${rmod_is_awake}
        ...                                                     Fail    msg=RMOD woke up during DeepSleep time window

        Time Is Reached                                         datetime=${datetime}

