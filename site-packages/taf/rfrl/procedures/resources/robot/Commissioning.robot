*** Keywords ***
Perform commissioning and achieve On Air
    [Documentation]
    ...          Performs commissioning with provided scf on repository, waits for SMOD and BBMOD startup,
    ...          handles GPS update if necessary and finally takes care of sw update to get rid of Fault 23 on BTS.
    ...          Keyword ends when BTS is in OnAir state (or after timeout). Still it is possible for it for fail after
    ...          reaching OnAir state due to watchdog's alarm checking during whole process.
    ...          Such fail is considered as expected fail and investigation needs to be performed.
    ...          Custom SCF file can be uploaded by providing full absolute path under scf_file_path parameter,
    ...          including xml extension. If scf_file_path is None, then SCF file name will be taken automatically
    ...          from TestLine repo directory, based on testline name and current SW stream on BTS.
    ...          Also RMODs which are not used in current configuration will be powered off. (content of global variables default_tl
    ...          and tl will be compared to get unused RMODs).
    ...          If remote_path_bsrpackage is not None, then BSR package will be uploaded to BTS by the use of
    ...          provided path. If there is no SCF uploaded on remote enb then use_proxy should be True - different
    ...          alias for admin connection will be used via VM. If repeat_commissioning_after_failure is False then
    ...          commissioning will be performed only once, if True then procedure will be repeated after failure
    ...          in commissioning for 15min with 30s intervals.
    [Arguments]         ${scf_file_path}=${None}
    ...                 ${remote_path_bsrpackage}=${None}
    ...                 ${bts_type}=GNB
    ...                 ${use_proxy}=${False}
    ...                 ${repeat_commissioning_after_failure}=${False}
    ...                 ${optical_switch_settings}=${None}
    ...                 ${oran_plugin_versions}=${None}

    ${is_full_scf_path}=                       scf.is_full_path_to_scf
    ...                                        scf=${scf_file_path}

    IF                                         """${optical_switch_settings}"""!="""None"""
        Alarms.Allow alarm                     fault_id=10
        ...                                    fault_name=No connection to unit
        Alarms.Allow alarm                     fault_id=1815
        ...                                    fault_name=Not able to synchronize baseband bus
        Alarms.Allow alarm                     fault_id=2002
        ...                                    fault_name=Receiving failure in Optical Interface

        Set Optical Switches Positions         optical_switch_settings=${optical_switch_settings}
    END

    IF                                         """${is_full_scf_path}"""=="""True"""
        Perform Commissioning                  bts_type=${bts_type}
        ...                                    use_proxy=${use_proxy}
        ...                                    scf_file_path=${scf_file_path}
        ...                                    repeat_commissioning_after_failure=${repeat_commissioning_after_failure}
        ...                                    oran_plugin_versions=${oran_plugin_versions}
    ELSE
        Perform Commissioning                  bts_type=${bts_type}
        ...                                    use_proxy=${use_proxy}
        ...                                    custom_scf_name=${scf_file_path}
        ...                                    repeat_commissioning_after_failure=${repeat_commissioning_after_failure}
        ...                                    oran_plugin_versions=${oran_plugin_versions}
    END

    Run keyword if                             '${remote_path_bsrpackage}'!='${None}'
    ...                                        Download And Upload BSR Package To BTS
    ...                                        remote_path=${remote_path_bsrpackage}
    ...                                        bts_type=${bts_type}

    Handle fault 23                            bts_type=${bts_type}

    timer.wait_until_keyword_succeeds_timer    10m
    ...                                        20s
    ...                                        Check all BBMODs RMODs and cells states for all RATs
    ...                                        bts_type=${bts_type}

    timer.wait_until_keyword_succeeds_timer    10m
    ...                                        20s
    ...                                        Check X2 link status
    ...                                        bts_type=${bts_type}
    ...                                        expected_state=available

    Robot Log Result                           Commissioning procedure has finished.

    Disallow X2 Link Alarms
    Alarms.Disallow alarm                      fault_id=23
    ...                                        bts_type=${bts_type}
    Alarms.Disallow alarm                      fault_id=4420
    ...                                        fault_name=GPS receiver alarm: firmware upgrade ongoing
    ...                                        bts_type=${bts_type}

    Alarms.Disallow alarm                      fault_name=No usable time reference available
    ...                                        fault_id=4405
    ...                                        bts_type=ENB

    IF                                         """${optical_switch_settings}"""!="""None"""
        Alarms.Disallow alarm                  fault_id=10
        ...                                    fault_name=No connection to unit
        Alarms.Disallow alarm                  fault_id=1815
        ...                                    fault_name=Not able to synchronize baseband bus
        Alarms.Disallow alarm                  fault_id=2002
        ...                                    fault_name=Receiving failure in Optical Interface
    END


Perform Commissioning
    [Arguments]         ${scf_file_path}=${None}
    ...                 ${remote_path_bsrpackage}=${None}
    ...                 ${bts_type}=GNB
    ...                 ${use_proxy}=${False}
    ...                 ${custom_scf_name}=${None}
    ...                 ${repeat_commissioning_after_failure}=${False}
    ...                 ${oran_plugin_versions}=${None}

    ${scf_path}         run keyword if
    ...                 """${custom_scf_name}"""!='None'
    ...                 scf.get_full_path_to_custom_scf
    ...                 bts_type=${bts_type}
    ...                 custom_scf_name=${custom_scf_name}
    ...                 ELSE
    ...                 scf.get_full_path_to_base_scf
    ...                 bts_type=${bts_type}
    ...                 scf_file_path=${scf_file_path}
    ${scf_file_name}    scf.get_scf_file_name_from_full_path
    ...                 scf_file_path=${scf_path}

    scf.prepare_scf     scf_path=${scf_path}
    ...                 bts_type=${bts_type}

    Copy file           source=${scf_path}
    ...                 destination=/home/ute/testline_init_results/config_files/SCFC.xml

    ${mrbts_id}=        scf.get_mrbts_id       scf_path=${scf_path}

    ${alias}                                   conn.get_default_admin_connection_alias
    ...                                        bts_type=${bts_type}
    ...                                        use_proxy=${use_proxy}

    ${oran_rmods}=                             Check If O-RAN RMODs Are Present
    ...                                        scf_path=${scf_path}

    Alarms.Allow X2 Link Alarms
    run keyword if                             """${scf_file_path}"""!='None'
    ...                                        Alarms.Allow alarm
    ...                                        fault_id=23
    ...                                        bts_type=${bts_type}
    Alarms.Allow alarm                         fault_id=4420
    ...                                        fault_name=GPS receiver alarm: firmware upgrade ongoing
    ...                                        bts_type=${bts_type}
    Alarms.Allow alarm                         fault_name=No usable time reference available
    ...                                        fault_id=4405
    ...                                        bts_type=ENB
    Alarms.Allow alarm                         fault_id=4589
    ...                                        fault_name=Unit power reset
    ...                                        bts_type=${bts_type}
    IF                                         ${oran_rmods}
        Alarms.Allow alarm                     fault_id=4641
        ...                                    fault_name=SSH client authentication failure
        ...                                    bts_type=${bts_type}
    END

    ${loner_initial_version}=                  Get loner version via DU
    ...                                        bts_type=${bts_type}
    Log DU config content                      bts_type=${bts_type}

    Run keyword if                             '${scf_file_path}'!='${None}'
    ...                                        Robot Log Warning
    ...                                        Custom SCF file ${scf_path} will be used as base BTS configuration file.

    Robot Log Operation                        Waiting for commissioning to be possible...
    admin.wait_sw_update_possible              bts_ready=True
    ...                                        readiness_timeout=600
    ...                                        timeout=700
    ...                                        connection=${alias}

    Robot Log Operation                        Performing commissioning with ${scf_file_name} on ${mrbts_id} BTS...
    Run Keyword If                             ${repeat_commissioning_after_failure}
    ...                                        timer.wait_until_keyword_succeeds_timer
    ...                                        15min
    ...                                        30s
    ...                                        admin.perform_commissioning
    ...                                        bts_id=${mrbts_id}
    ...                                        scf_file=${scf_path}
    ...                                        skip_parameter_relation_errors=${False}
    ...                                        timeout=600
    ...                                        connection=${alias}
    ...                                        ELSE
    ...                                        timer.robot_timer
    ...                                        admin.perform_commissioning
    ...                                        bts_id=${mrbts_id}
    ...                                        scf_file=${scf_path}
    ...                                        skip_parameter_relation_errors=${False}
    ...                                        timeout=600
    ...                                        connection=${alias}

    Power off unused RMODs                     bts_type=${bts_type}

    Robot Log Operation                        Sleep is being performed due to possibility of board configuration
    ...                                        update
    sleep                                      4min
    ...                                        reason=PR577587

    timer.wait until keyword succeeds timer    10 min    10 s
    ...                                        status_check.verify_statuses_of_all_smods
    ...                                        connection=${alias}
    ...                                        status_variant=online
    timer.wait until keyword succeeds timer    4 min 48 s    2s
    ...                                        Check Baseband Module Statuses With Loner Change Detection
    ...                                        loner_init_version=${loner_initial_version}
    ...                                        bts_type=${bts_type}
    ...                                        use_proxy=${use_proxy}

    Log DU config content                      bts_type=${bts_type}

    Handle GPS Firmware Update                 bts_type=${bts_type}
    ...                                        use_proxy=${use_proxy}

    IF  ${oran_rmods}
        Initialize O-RAN RMODs After Commissioning
        ...                                    rmod_ids=${oran_rmods}
        ...                                    bts_type=${bts_type}
        ...                                    custom_plugin_versions=${oran_plugin_versions}
        Alarms.Disallow alarm                  fault_id=4641
        ...                                    fault_name=SSH client authentication failure
        ...                                    bts_type=${bts_type}
    END

    timer.wait_until_keyword_succeeds_timer    10m
    ...                                        20s
    ...                                        status_check.verify_all_rmods_initialized
    ...                                        connection=${alias}

    sleep                                      1min
    Alarms.Disallow alarm                      fault_id=4589
    ...                                        fault_name=Unit power reset
    ...                                        bts_type=${bts_type}

