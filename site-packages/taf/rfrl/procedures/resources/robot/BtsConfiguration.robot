Private Add Cell Groups
    [Arguments]                             ${path_to_delta}
    ...                                     ${plan_to_copy_from}
    ...                                     ${delta_operation}

    ${added_cells_groups}                   delta_scraper.get_nrcellgroup_info_from_delta
    ...                                     json_delta_file=${path_to_delta}
    ...                                     operation=${delta_operation}

    ${bts_type}=                            hwpta_testline.get_type_of_setup
    ${connection}                           connections.get_default_admin_connection_alias
    ...                                     bts_type=${bts_type}
    config_operations.connect               alias=${connection}
    ...                                     bts_type=${bts_type}

    ${mrbts_id}=                            admin_info_model.get_mrbts_id_admin
    ...                                     connection=${connection}
    ${nrbts_id}=                            admin_info_model.get_nrbts_id_admin
    ...                                     connection=${connection}
    ${refNrCellGroup}                       config_operations.get_parameter_value
    ...                                     dist_name=MRBTS-${mrbts_id}/NRBTS-${nrbts_id}/NRDU-1
    ...                                     param_name=refNrCellGroup
    ${node_index}                           Get Length   ${refNrCellGroup}

    FOR  ${dist_name}  IN  @{added_cells_groups}
         webui.add_object                   object_name=${added_cells_groups['${dist_name}']['object_name']}
         ...                                object_class_name=${added_cells_groups['${dist_name}']['object_class']}
         ...                                plan_to_copy_from=${plan_to_copy_from}
         ...                                copy_from=${dist_name}
         ...                                include_subobject=${True}
         ...                                id_value=${added_cells_groups['${dist_name}']['id']}
         ...                                is_load_default_values=${False}
         ...                                timeout=120
         webui.add_element                  dist_name=${added_cells_groups['${dist_name}']['object_name']}/NRDU-1
         ...                                filter_param=Reference to cell group
         ...                                abbr=refNrCellGroup
         webui.set_parameter_value          dist_name=${added_cells_groups['${dist_name}']['object_name']}/NRDU-1
         ...                                filter_param=Reference to cell group
         ...                                abbr=refNrCellGroup
         ...                                node_index=${node_index}
         ...                                new_value=${added_cells_groups['${dist_name}']['id']}
         ${node_index}=                     Evaluate  ${node_index}+1
    END

