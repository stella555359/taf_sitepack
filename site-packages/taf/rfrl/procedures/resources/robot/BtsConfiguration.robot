Private Add Cell Object
    [Arguments]                             ${path_to_delta}
    ...                                     ${plan_to_copy_from}
    ...                                     ${delta_operation}

    ${bts_type}=                            hwpta_testline.get_type_of_setup
    ${connection}                           connections.get_default_admin_connection_alias
    ...                                     bts_type=${bts_type}

    config_operations.connect               alias=${connection}
    ...                                     bts_type=${bts_type}

    ${added_cells_objects}                  delta_scraper.get_cell_info_from_delta
    ...                                     json_delta_file=${path_to_delta}
    ...                                     operation=${delta_operation}

    FOR  ${dist_name}  IN  @{added_cells_objects}
         webui.add_object                   object_name=${added_cells_objects['${dist_name}']['object_name']}
         ...                                object_class_name=${added_cells_objects['${dist_name}']['object_class']}
         ...                                plan_to_copy_from=${plan_to_copy_from}
         ...                                copy_from=${dist_name}
         ...                                include_subobject=${True}
         ...                                id_value=${added_cells_objects['${dist_name}']['id']}
         ...                                is_load_default_values=${False}
         ...                                timeout=120
         Private Set Proper Resource ID Based On Cell Type
         ...                                path_to_delta=${path_to_delta}
         ...                                delta_operation=${delta_operation}
         ...                                dist_name=${dist_name}
         ...                                added_cells_objects=${added_cells_objects}
    END

Private Set Proper Resource ID Based On Cell Type
    [Arguments]                             ${path_to_delta}
    ...                                     ${delta_operation}
    ...                                     ${dist_name}
    ...                                     ${added_cells_objects}

    ${cell_class_object}                    Set Variable   ${added_cells_objects['${dist_name}']['object_class']}

    ${filter_param}=                        Run Keyword If    """${cell_class_object}"""=="""WNCEL"""
    ...                                     Set Variable      LCELW object reference
    ...                                     ELSE IF           """${cell_class_object}"""=="""GNCEL"""
    ...                                     Set Variable      LCELC Identifier
    ...                                     ELSE
    ...                                     Set Variable      Local cell resource ID

    ${abbr}=                                Run Keyword If    """${cell_class_object}"""=="""WNCEL"""
    ...                                     Set Variable      lCelwDN
    ...                                     ELSE IF           """${cell_class_object}"""=="""GNCEL"""
    ...                                     Set Variable      lcelcId
    ...                                     ELSE
    ...                                     Set Variable      lcrId

    ${new_value}=                           delta_scraper.get_object_param_values
    ...                                     json_delta_file=${path_to_delta}
    ...                                     operation=${delta_operation}
    ...                                     dist_name=${dist_name}
    ...                                     param_name=${abbr}

    webui.set_parameter_value               dist_name=${dist_name}
    ...                                     filter_param=${filter_param}
    ...                                     abbr=${abbr}
    ...                                     new_value=${new_value}

    Run Keyword If                          """${cell_class_object}"""=="""WNCEL"""
    ...                                     Private Add WCDMA Cell ID To List
    ...                                     path_to_delta=${path_to_delta}
    ...                                     delta_operation=${delta_operation}
    ...                                     dist_name=${dist_name}
    ...                                     added_cells_objects=${added_cells_objects}


Private Add WCDMA Cell ID To List
    [Arguments]                             ${path_to_delta}
    ...                                     ${delta_operation}
    ...                                     ${dist_name}
    ...                                     ${added_cells_objects}

    ${wncelIdList}                          config_operations.get_parameter_value
    ...                                     dist_name=${added_cells_objects['${dist_name}']['object_name']}/WNCELG-1
    ...                                     param_name=wncelIdList

    ${node_index}                           Get Length    ${wncelIdList}

    webui.add_element                       dist_name=${added_cells_objects['${dist_name}']['object_name']}/WNCELG-1
    ...                                     filter_param=Local cell identifier list
    ...                                     abbr=wncelIdList
    webui.set_parameter_value               dist_name=${added_cells_objects['${dist_name}']['object_name']}/WNCELG-1
    ...                                     filter_param=Local cell identifier list
    ...                                     abbr=wncelIdList
    ...                                     node_index=${node_index}
    ...                                     new_value=${added_cells_objects['${dist_name}']['id']}


