Private Remove Cell Groups
    [Arguments]                             ${path_to_delta}
    ...                                     ${delta_operation}

    ${removed_cells_groups}                 delta_scraper.get_nrcellgroup_info_from_delta
    ...                                     json_delta_file=${path_to_delta}
    ...                                     operation=${delta_operation}

    ${bts_type}=                            hwpta_testline.get_type_of_setup
    ${connection}                           connections.get_default_admin_connection_alias
    ...                                     bts_type=${bts_type}
    config_operations.connect               alias=${connection}
    ...                                     bts_type=${bts_type}

    ${mrbts_id}=                            admin_info_model.get_mrbts_id_admin
    ...                                     connection=${connection}
    ${nrbts_id}=                            admin_info_model.get_nrbts_id_admin
    ...                                     connection=${connection}
    ${refNrCellGroup}                       config_operations.get_parameter_value
    ...                                     dist_name=MRBTS-${mrbts_id}/NRBTS-${nrbts_id}/NRDU-1
    ...                                     param_name=refNrCellGroup
    ${copy_refNrCellGroup}                  Copy List    ${refNrCellGroup}

    FOR  ${dist_name}  IN  @{removed_cells_groups}
         webui.remove_object                object_name=${dist_name}
         ...                                timeout=120
         ${node_index}                      Get Index From List    
         ...                                ${refNrcellGroup}
         ...                                ${removed_cells_groups['${dist_name}']['id']}
         ${is_cellgroup_removed}=           Run Keyword And Return Status
         ...                                webui.remove_element
         ...                                dist_name=${removed_cells_groups['${dist_name}']['object_name']}/NRDU-1
         ...                                filter_param=Reference to cell group
         ...                                abbr=refNrCellGroup
         ...                                node_index=${node_index}
         IF   not ${is_cellgroup_removed}
              ${node_index}=                     Get Index From List    
              ...                                ${copy_refNrCellGroup}
              ...                                ${removed_cells_groups['${dist_name}']['id']}
              webui.remove_element               dist_name=${removed_cells_groups['${dist_name}']['object_name']}/NRDU-1
              ...                                filter_param=Reference to cell group
              ...                                abbr=refNrCellGroup
              ...                                node_index=${node_index}
         END
         Remove From List                   ${copy_refNrCellGroup}
         ...                                ${node_index}
    END

Set Power Saving Group Period List
    [Documentation]    This keyword sets `lbpsPeriodList` parameters for provided power saving period time.
    ...                Args:
    ...                ${power_group_distns} (list) - List of dist names to which the power saving period will be applied.
    ...                                      e.g. ['MRBTS-40612/LNBTS-40612/PSGRP-0', 'MRBTS-40612/NRBTS-50612/NRPGRP-0']
    ...                ${start_save_period} (datetime) - Datime object representing the start of the power saving period.
    ...                ${duration} (str)- Duration of the power saving period in minutes.
    ...                ${connection} (str) - Connection alias to the BTS.

    [Arguments]        ${power_group_distns}
    ...                ${start_save_period}
    ...                ${duration}
    
    ${lbpsPeriodList_structure}=            config_operations.create_lbps_period_list
    ...                                     start_time=${start_save_period}
    ...                                     duration=${duration}
    ${delta}=                               Evaluate  {p_group_distn: {'lbpsPeriodList': ${lbpsPeriodList_structure}} for p_group_distn in $power_group_distns}
    delta_configurator.set_parameters_for_dist_names_via_delta_recommissioning
    ...                                     objects_dict=${delta}
    Robot Log Result                        Power saving period list structure:\n${lbpsPeriodList_structure}\nhas been set for: ${power_group_distns}.

Check If BTS And VM Time Match
    [Documentation]    This keyword checks if the time on the BTS matches the time on the VM within a given tolerance.
    ...                It retrieves the current time from both the BTS and the VM, compares them, and logs the results.
    ...                If the times do not match within the specified tolerance, it raises an error.
    [Arguments]        ${bts_type}=GNB
    ...                ${tolerance}=2
    ${smod_time}=                           Get Time From Smod
    ...                                     bts_type=${bts_type}
    ${vm_time}=                             Get Current Date    
    ...                                     result_format=datetime
    ${time_difference}=                     Evaluate  abs(($smod_time - $vm_time).total_seconds())
    Should Be True                          ${time_difference} < ${tolerance}
    ...                                     msg=BTS time: ${smod_time} and VM time: ${vm_time.replace(microsecond=0)} differ. Timezone mismatch possible.
