Library     taf.ul.bts_components.Smod                          WITH NAME  smod

Resource    ../robot/HWPTA_Logger.robot

Library     ../python/connections.py                            WITH NAME  connections

*** Keywords ***
Get loner version via DU
    [Arguments]                                ${bts_id}=0
    ...                                        ${bts_type}=GNB
    ${credentials}=                            connections.get_ssh_connection_credentials
    ...                                        bts_type=${bts_type}
    ...                                        bts_id=${bts_id}
    smod.connect_to                            address=${credentials['host']}
    ...                                        username=${credentials['username']}
    ...                                        password=${credentials['password']}
    ${chk_version}=                            smod.get_loner_version
    ${chk_version}=                            Set variable if    "${chk_version}"=="${EMPTY}"   ${None}    ${chk_version}
    [Teardown]                                 smod.close_connection
    [Return]  ${chk_version}

Log DU config content
    [Arguments]                                ${bts_id}=0
    ...                                        ${bts_type}=GNB
    ${credentials}=                            connections.get_ssh_connection_credentials
    ...                                        bts_type=${bts_type}
    ...                                        bts_id=${bts_id}
    smod.connect_to                            address=${credentials['host']}
    ...                                        username=${credentials['username']}
    ...                                        password=${credentials['password']}
    ${content}=                                smod.execute  ls /rom/config/
    Robot Log Result                           ${content}  to_console=${False}
    [Teardown]                                 smod.close_connection

Get Time From Smod
    [Arguments]                                ${bts_type}=GNB
    ${credentials}=                            connections.get_ssh_connection_credentials
    ...                                        bts_type=${bts_type}
    smod.connect_to                            address=${credentials['host']}
    ...                                        username=${credentials['username']}
    ...                                        password=${credentials['password']}
    ${smod_time}=                              smod.get_smod_time
    Robot Log Result                           SMOD time is: ${smod_time}
    [Teardown]                                 smod.close_connection
    [Return]                                   ${smod_time}
