Wait for active IMS alarm
    [Documentation]  Waits for IMS alarm with given attributes to become active before timeout.
    ...              Returns dictionary with alarm information if alarm becomes active.
    ...              If alarm does not become active, fails the keyword.
    ...              At least one of alarm's attributes should be provided.
    [Arguments]      ${start_timestamp}
    ...              ${repeat_count}=5
    ...              ${alarm_id}=${None}
    ...              ${fault_id}=${None}
    ...              ${fault_severity}=${None}
    ...              ${fault_name}=${None}
    ...              ${hw_path}=${None}
    ...              ${fault_signature}=${None}
    ...              ${bts_type}=GNB
    ${alarm_instance}                                 alarms_watchdog.create_alarm
    ...                                               alarm_id=${alarm_id}
    ...                                               fault_id=${fault_id}
    ...                                               severity=${fault_severity}
    ...                                               fault_name=${fault_name}
    ...                                               hw_path=${hw_path}
    ...                                               fault_signature=${fault_signature}
    ${repeat_count}=                                  Convert To Integer    ${repeat_count}

    ${file_name}=                                     Set Variable  fault_${fault_id}_active
    ${directory_name}=                                Set Variable  ${bts_type}_ims_active_alarms

    Robot Log Operation                               Waiting for alarm ${alarm_instance} to become active in IMS...
    FOR    ${repeat}  IN RANGE  ${repeat_count}
        ${ims_file_path}=                             Collect IM Snapshot With Custom Name And Directory
        ...                                           directory_name=${directory_name}
        ...                                           file_name=${file_name}
        ...                                           bts_type=${bts_type}
        ${end_timestamp}=                             utilities.get_datetime_with_utc_tz
        ${alarm_info}                                 ims_alarm_verifier.was_alarm_set
        ...                                           alarm=${alarm_instance}
        ...                                           ims_file_path=${ims_file_path}
        ...                                           start=${start_timestamp}
        ...                                           end=${end_timestamp}
        Run Keyword If                                ${alarm_info}
        ...                                           Run Keywords
        ...                                           Robot Log Result
        ...                                           Alarm ${alarm_instance} is active in IMS.
        ...                                           AND
        ...                                           Return From Keyword
        ...                                           ${alarm_info}
        ...  ELSE IF  ${repeat} < ${repeat_count-1}
        ...                                           Sleep
        ...                                           30 sec
        ...                                           msg=Waiting for alarm to become active in IMS.
    END

    Fail                                              msg=Alarm ${alarm_instance} is not active in IMS.

Wait for inactive IMS alarm
    [Documentation]  Waits for IMS alarm with given attributes to become inactive before timeout.
    ...              If alarm does not become inactive, fails the keyword.
    [Arguments]      ${start_timestamp}
    ...              ${alarm_dist_name}
    ...              ${repeat_count}=5
    ...              ${bts_type}=GNB

    ${repeat_count}=                                  Convert To Integer    ${repeat_count}
    ${alarm_id}=                                      Evaluate   str("""${alarm_dist_name}""").rsplit('/', 1)[-1]
    ${file_name}=                                     Set Variable  ${alarm_id}_inactive
    ${directory_name}=                                Set Variable  ${bts_type}_ims_inactive_alarms

    Robot Log Operation                               Waiting for alarm ${alarm_dist_name} to become inactive in IMS...
    FOR    ${repeat}  IN RANGE  ${repeat_count}
        ${ims_file_path}=                             Collect IM Snapshot With Custom Name And Directory
        ...                                           directory_name=${directory_name}
        ...                                           file_name=${file_name}
        ...                                           bts_type=${bts_type}
        ${end_timestamp}=                             utilities.get_datetime_with_utc_tz
        ${alarm_inactive}                             ims_alarm_verifier.was_alarm_removed
        ...                                           alarm_dist_name=${alarm_dist_name}
        ...                                           ims_file_path=${ims_file_path}
        ...                                           start=${start_timestamp}
        ...                                           end=${end_timestamp}
        Run Keyword If                                ${alarm_inactive}
        ...                                           Run Keywords
        ...                                           Robot Log Result
        ...                                           Alarm ${alarm_dist_name} is inactive in IMS.
        ...                                           AND
        ...                                           Return From Keyword
        ...  ELSE IF  ${repeat} < ${repeat_count-1}
        ...                                           Sleep
        ...                                           30 sec
        ...                                           msg=Waiting for alarm to become inactive in IMS.
    END

    Fail                                              msg=${alarm_id} is active in IMS.


Was Alarm Active In IMS Alarm History Beetween Timestamps
    [Documentation]  Checks whether alarm with given attributes was active in IMS alarm history between given timestamps.
    ...              At least one of alarm's attributes should be provided.
    ...              If end timestamp is not provided, current time will be used.
    [Arguments]      ${start_timestamp}
    ...              ${end_timestamp}=${None}
    ...              ${alarm_id}=${None}
    ...              ${fault_id}=${None}
    ...              ${fault_severity}=${None}
    ...              ${fault_name}=${None}
    ...              ${hw_path}=${None}
    ...              ${fault_signature}=${None}
    ...              ${bts_type}=GNB

    ${alarm_instance}                                 alarms_watchdog.create_alarm
    ...                                               alarm_id=${alarm_id}
    ...                                               fault_id=${fault_id}
    ...                                               severity=${fault_severity}
    ...                                               fault_name=${fault_name}
    ...                                               hw_path=${hw_path}
    ...                                               fault_signature=${fault_signature}

    ${end_timestamp}    Set Variable If               """${end_timestamp}"""=="""${None}"""
    ...                                               utilities.get_datetime_with_utc_tz
    ...                                               ${end_timestamp}

    ${file_name}=                                     Set Variable  fault_check_IMS
    ${directory_name}=                                Set Variable  ${bts_type}_ims_alarms
    ${ims_file_path}=                                 Collect IM Snapshot With Custom Name And Directory
    ...                                               directory_name=${directory_name}
    ...                                               file_name=${file_name}
    ...                                               bts_type=${bts_type}

    Robot Log Operation                               Checking if alarm was active in IMS alarm history...
    ${alarm_info}                                     ims_alarm_verifier.was_alarm_set
    ...                                               alarm=${alarm_instance}
    ...                                               ims_file_path=${ims_file_path}
    ...                                               start=${start_timestamp}
    ...                                               end=${end_timestamp}

    IF    """${alarm_info}"""=="""${None}"""
        Robot Log Result                              Alarm ${alarm_instance} was not active between ${start_timestamp} and ${end_timestamp}.
        Return From Keyword                           ${False}    ${alarm_instance}
    ELSE
        Robot Log Result                              Alarm ${alarm_instance} was active between ${start_timestamp} and ${end_timestamp}.
        Return From Keyword                           ${True}    ${alarm_instance}
    END


