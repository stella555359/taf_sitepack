Allow 4003 Alarm On Shared Cells
    [Documentation]  Allows alarm FID: 4003 (Transmission path failure) on shared cells.
    ...              The alarm appears when one of the RMODs creating the shared cell is unavailable (power Off, reset).
    [Arguments]      ${rmod_ids}
    ...              ${bts_name}=${None}
    ...              ${bts_type}=GNB

    ${connection}                                           connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}
    IF  '${bts_name}' == '${None}'
        ${bts_name}                                         admin_info_model.get_bts_name_from_bts_info
        ...                                                 connection=${connection}
    END

    ${rmod_ids}                                             utilities.convert_to_list  ${rmod_ids}
    ${conf_cell_distnames}                                  admin_info_model.get_configuration_distnames_of_all_cells_for_rmods
    ...                                                     rmod_ids=${rmod_ids}
    ...                                                     connection=${connection}

    FOR    ${conf_cell_distname}                            IN  @{conf_cell_distnames}
        ${cell_type}                                        admin_info_model.get_cell_type_from_distname
        ...                                                 distname=${conf_cell_distname}
        ${is_shared}                                        admin_info_model.is_cell_shared
        ...                                                 connection=${connection}
        ...                                                 cell_id=${conf_cell_distname.split('-')[-1]}
        ...                                                 cell_type=${cell_type}
        IF  ${is_shared}
            Alarms.Allow alarm                              fault_id=4003
            ...                                             alarm_id=7115
            ...                                             fault_name=Transmission path failure
            ...                                             severity=Minor
            ...                                             unit_path=[${bts_name}] ${conf_cell_distname}
            ...                                             bts_type=${bts_type}
        END
    END

