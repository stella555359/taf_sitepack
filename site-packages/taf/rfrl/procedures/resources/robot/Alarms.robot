Verify Date and Reset Counter in Fault Signature Not Empty
    [Arguments]                                     ${fault_id}
    ...                                             ${fault_name}=${None}
    ${setup_type}=                                  hwpta_testline.get_type_of_setup
    ${active_alarms}=                               Alarms.Get active alarms
    ...                                             bts_type=${setup_type}
    FOR  ${alarm}               IN                  @{active_alarms}
        ${is_correct_fid}=                          Evaluate
        ...                                         ${alarm.fault_id} == ${fault_id}
        ${is_correct_name}=                         Evaluate
        ...                                         "${alarm.fault_name}" == "${fault_name}" if "${fault_name}" != "None" else True
        run keyword if                              ${is_correct_fid} and ${is_correct_name}
        ...                                         Alarms.Verify fields in fault signature not empty
        ...                                         ${alarm}
        ...                                         date
        ...                                         resetCounter
    END

