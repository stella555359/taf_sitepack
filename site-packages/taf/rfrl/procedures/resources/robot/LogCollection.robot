Verify L1 IQ Data Archives
    [Documentation]
    ...  Verifies L1 IQ data archives. Checks if all mandatory archives are present and not empty.
    ...
    ...  :param str l1_iq_data_directory: (Mandatory) : path to the directory where L1 IQ Data is stored,
    ...                                                  e.g.: /home/ute/Desktop/result/TEST_2024-10-14/[1]CB001111_results
    ...  :param str l1_iq_data_archive: (Mandatory) : name of the archive with L1 IQ Data logs, e.g.: l1_iq_logs.tgz
    ...  :param list of str mandatory_l1_iq_data_archives: (Mandatory) : list of mandatory L1 IQ data archives that should be
    ...                                                                  in collected L1 IQ Data logs; e.g.:
    ...                                                                  ['BTS50123_L343564_L1BBIQCapture.tgz.xz', 'BTS50123_123_RMOD_L_123_2011_l1radio_fcpTriggeredCapture_thor.tar.gz']
    [Arguments]                                             ${l1_iq_data_directory}
    ...                                                     ${l1_iq_data_archive}
    ...                                                     ${mandatory_l1_iq_data_archives}
    ${l1_iq_data_archive_dir_name}                          Set Variable
    ...                                                     l1_iq_logs_archives

    Robot Log Step                                          Verifying L1 IQ Data Archives...
    vm.copy_file_with_new_name                              src_path=${l1_iq_data_directory}/${l1_iq_data_archive}
    ...                                                     dst_path=${l1_iq_data_directory}/${l1_iq_data_archive_dir_name}.zip

    snapshot.set_snapshot_path
    ...                                                     snapshot_dir=${l1_iq_data_directory}
    ...                                                     snapshot_file_name=${l1_iq_data_archive_dir_name}.zip
    ${archieves_components}=                                snapshot.get_list_of_snapshot_components_from_snapshot_file_list

    logs.unpack_logs_archive                                path=${l1_iq_data_directory}
    ...                                                     file_name=${l1_iq_data_archive_dir_name}.zip
    ...                                                     recursively=${False}

    FOR     ${mandatory_l1_iq_data_archive}    IN    @{mandatory_l1_iq_data_archives}
        ${main_archive}    ${archive}=                      vm.get_dict_key_and_value_if_regex_matches_dict_value_from_list
        ...                                                 list_data=${archieves_components}
        ...                                                 value_regex=${mandatory_l1_iq_data_archive}

        IF    '''${archive}'''=='''${None}'''
            ${main_archive}=                                vm.verify_if_file_was_found                     
            ...                                             directory_path=${l1_iq_data_directory}/${l1_iq_data_archive_dir_name}
            ...                                             filename_regex=${mandatory_l1_iq_data_archive}
            vm.verify_if_file_is_not_empty                  file_path=${l1_iq_data_directory}/${l1_iq_data_archive_dir_name}/${main_archive}
        ELSE
            logs.unpack_logs_archive                        path=${l1_iq_data_directory}/${l1_iq_data_archive_dir_name}
            ...                                             file_name=${main_archive}
            ...                                             recursively=${False}

            ${main_archive_wo_extension}=                   Evaluate  str("""${main_archive}""").split('.')[-2]
            vm.move_file_to_target_directory                origin_file_path=${l1_iq_data_directory}/${l1_iq_data_archive_dir_name}/${main_archive_wo_extension}/${archive}
            ...                                             target_file_path=${l1_iq_data_directory}/${l1_iq_data_archive_dir_name}/${archive}
            vm.verify_if_file_is_not_empty                  file_path=${l1_iq_data_directory}/${l1_iq_data_archive_dir_name}/${archive}
        END
    END


Verify L1 IQ Data In Snapshot
    [Documentation]
    ...  Verifies L1 IQ Data in snapshot logs. Checks if all mandatory files are present and not empty.
    ...
    ...  ARGS:
    ...  :param str snapshot_dir_path: (Mandatory) : path to the directory where snapshot is stored,
    ...                                              e.g.: /home/ute/Desktop/result/TEST_2024-10-14/[1]CB001111_results
    ...  :param str snapshot_file_name: (Mandatory) : name of the snapshot file,
    ...                                              e.g.: snapshot_l1_iq_blind_data.zip
    ...  :param list of str mandatory_snapshot_l1_iq_data_files: (Mandatory) : list of mandatory L1 IQ data files that should be
    ...                                                                        in collected L1 IQ Data Snapshot logs; e.g.:
    ...                                                                        ['HBNrUlReqAntBlindSnapshotFA5', '5G_UL_124D_Events.bin', '5G_UL_124D_IqSamples.bin',
    ...                                                                         '124D_IqSamples.bin', '5G_UL_124D_Fcp.bin', 'PSMLog_ctrl.bin', 'PSMLog_entries.bin']
    ...  :param str bts_type: (Mandatory) : type of the BTS, e.g.: GNB
    [Arguments]                                             ${snapshot_dir_path}
    ...                                                     ${snapshot_file_name}
    ...                                                     ${mandatory_snapshot_l1_iq_data_files}
    ...                                                     ${bts_type}
    ${l1_iq_data_snapshot}                                  Set Variable
    ...                                                     ${logs_path}/l1_iq_data_snapshot
    logs.create_dir_if_doesnt_exist                         dir_path=${l1_iq_data_snapshot}

    ${sw_version}=                                          Get Software Version
    ...                                                     bts_type=${bts_type}
    ${credentials}                                          connections.get_http_connection_credentials
    ...                                                     bts_type=${bts_type}

    snapshot.setup_snapshot_settings
    ...                                                     snapshot_dir=${snapshot_dir_path}
    ...                                                     coverage=Full
    ...                                                     sw_version=${sw_version}
    ...                                                     connection_host=${credentials['ip']}
    ...                                                     connection_port=${credentials['port']}
    ...                                                     snapshot_file_name=${snapshot_file_name}

    FOR   ${mandatory_file}    IN    @{mandatory_snapshot_l1_iq_data_files}
        ${archive_name_regex}=	                            Get From Dictionary     ${mandatory_file}       archive_name_regex
        ${filename}=	                                    Get From Dictionary     ${mandatory_file}       filename
        ${internal_path_to_file}=	                        Get From Dictionary     ${mandatory_file}       internal_path_to_file
        ${snapshot_archive_path}                            snapshot.find_file_in_snapshot_file_list
        ...                                                 filename=${archive_name_regex}
        Should Be True                                      """${snapshot_archive_path}"""!="""${False}"""
        ...                                                 msg= File path with given regex: ${archive_name_regex} not found in snapshot.

        ${archive_name}                                     Evaluate
        ...                                                 str("""${snapshot_archive_path}""").split('/')[-1]
        ${unpacked_archive_name}                            Evaluate
        ...                                                 str("""${archive_name}""").split('.')[0]
        ${l1_iq_data_extracted_dir}                         snapshot.extract_shapshot_file_based_on_internal_path
        ...                                                 internal_snapshot_path=${snapshot_archive_path}
        ...                                                 raise_exception=${False}
        Set To Dictionary                                   ${mandatory_file}
        ...                                                 archive_name_regex=${archive_name}
        IF    """${filename}"""!="""${None}"""
            logs.unpack_logs_archive                        path=${l1_iq_data_extracted_dir}
            ...                                             file_name=${archive_name}

            ${unpacked_log_path}                            Set Variable If     '${internal_path_to_file}'!='${None}'
            ...                                             ${l1_iq_data_extracted_dir}/${unpacked_archive_name}/${internal_path_to_file}
            ...                                             ${l1_iq_data_extracted_dir}/${unpacked_archive_name}

            ${filename}=                                    vm.find_file_in_directory_by_regex
            ...                                             directory_path=${unpacked_log_path}
            ...                                             filename_regex=${filename}
            Should Be True                                  """${filename}"""!="""${None}"""
            ...                                             msg= File with given regex: ${filename} not found in snapshot.
            Set To Dictionary                               ${mandatory_file}
            ...                                             filename=${filename}

            ${unpacked_log_file}=                           Set Variable
            ...                                             ${unpacked_log_path}/${filename}
            vm.move_file_to_target_directory                origin_file_path=${unpacked_log_file}
            ...                                             target_file_path=${l1_iq_data_snapshot}/${filename}
        ELSE
            ${snapshot_tmp_extract_dir}=                    snapshot.get_snapshot_tmp_extract_dir
            ${l1_iq_data_extracted_dir}                     Set Variable If
            ...                                             """${l1_iq_data_extracted_dir}"""=="""${False}"""
            ...                                             ${snapshot_tmp_extract_dir}
            ...                                             ${l1_iq_data_extracted_dir}

            ${unpacked_log_path}=                           Set Variable
            ...                                             ${l1_iq_data_extracted_dir}/${archive_name}  

            vm.move_file_to_target_directory                origin_file_path=${unpacked_log_path}
            ...                                             target_file_path=${l1_iq_data_snapshot}/${archive_name}
        END

        snapshot.teardown
    END
    Remove File                                             path=${snapshot_dir_path}/${snapshot_file_name}

    FOR     ${mandatory_file}       IN      @{mandatory_snapshot_l1_iq_data_files}
        ${filename}=	                                    Get From Dictionary     ${mandatory_file}       filename
        ${archive_name}=	                                Get From Dictionary     ${mandatory_file}       archive_name_regex
        ${path}=    Set Variable If                         """${filename}"""!="""${None}"""
        ...                                                 ${l1_iq_data_snapshot}/${filename}
        ...                                                 ${l1_iq_data_snapshot}/${archive_name}

        vm.verify_if_file_is_existing                       file_path=${path}
        vm.verify_if_file_is_not_empty                      file_path=${path}
    END

    [Teardown]                                              Run keywords
    ...                                                     snapshot.teardown
    ...                                                     AND
    ...                                                     snapshot.disconnect

