*** Keywords ***
Prepare logs path
    [Documentation]      Sets path and creates directory where collected log files will be saved.
    ...                  logs_path is unique per test suite run and accessible from Test Suite scope.
    [Arguments]          ${testcase_name}=${TEST_NAME}
    ${date}              DateTime.Get Current Date
    ${tc_name}           String.Replace String
    ...                  string=${testcase_name}
    ...                  search_for=${SPACE}
    ...                  replace_with=_
    Set Global Variable  ${logs_path}
    ...                  ${OUTPUT DIR}/TEST_${date[0:10]}/${date[11:19]}_${tc_name}
    Run                  mkdir -p ${logs_path}


Collect Logs If Needed
    [Documentation]  Collects all possible logs from all sources and stores them under logs_path.
    ...              Collection of all logs can be forced (even despite passing test) by using flag:
    ...              force_logs_collection=True.
    ...              Individual log type must be toggled on to be affected by force_collection.
    ...              Flag rmod=True supports only GNB BTS
    ...              When snapshot is collected then common blackbox.txt file with the content of all blackbox files
    ...              is created to the same folder as snapshot. Depends on snapshot flags. By default, logs
    ...              collected by this function contain added date stamp in log name.
    [Arguments]      ${collect}
    ...              ${bts_type}=GNB
    ...              ${execution_status}=${TEST STATUS}
    ...              ${force_logs_collection}=${False}
    ...              ${snapshot}=${True}
    ...              ${lte_snapshot}=${True}
    ...              ${manual_snapshot}=${False}
    ...              ${im_snapshot}=${True}
    ...              ${swconfig}=${True}
    ...              ${scf_file}=${True}
    ...              ${btslog}=${True}
    ...              ${tcpdump}=${False}
    ...              ${btslog_slave}=${False}
    ...              ${btslog_enb}=${False}
    ...              ${rmod}=${True}
    ...              ${is_second_log_collection_needed}=${False}
    ${collect_logs}=     Evaluate     'FAIL' in '${execution_status}' or ${collect} or ${force_logs_collection}
    ${connection}=       connections.get_default_admin_connection_alias
    ...                  bts_type=${bts_type}
    ${setup_mode}=       hwpta_testline.get_bts_setup_mode
    ${date_stamp}=       utilities.Create Date Stamp
    Run keyword if  ${collect_logs} and ${snapshot}     Run keyword and continue on failure   Collect snapshots
    ...                                                                                       snapshot=${snapshot}
    ...                                                                                       manual_snapshot=${manual_snapshot}
    ...                                                                                       bts_type=${bts_type}
    ...                                                                                       date_stamp=${date_stamp}
    Run keyword if  ${collect_logs} and ${snapshot}     Run keyword and continue on failure   Extract blackbox files from snapshot
    ...                                                                                       bts_type=${bts_type}
    ...                                                                                       date_stamp=${date_stamp}
    Run keyword if  ${collect_logs} and ${im_snapshot}  Run keyword and continue on failure   Collect IM Snapshot
    ...                                                                                       bts_type=${bts_type}
    ...                                                                                       date_stamp=${date_stamp}
    Run keyword if  ${collect_logs} and ${lte_snapshot} and """${setup_mode}"""=='NSA'
    ...                                                 Run keyword and continue on failure   Collect snapshot
    ...                                                                                       bts_type=ENB
    ...                                                                                       date_stamp=${date_stamp}
    Run keyword if  ${collect_logs} and ${lte_snapshot} and """${setup_mode}"""=='NSA'
    ...                                                 Run keyword and continue on failure   Extract blackbox files from snapshot
    ...                                                                                       bts_type=ENB
    ...                                                                                       date_stamp=${date_stamp}
    Run keyword if  ${collect_logs} and ${scf_file}     Run keyword and continue on failure   Collect SCF file
    ...                                                                                       bts_type=${bts_type}
    Run keyword if  ${collect_logs} and ${swconfig}     Run keyword and continue on failure   Collect Swconfig file
    ...                                                                                       bts_type=${bts_type}
    Run keyword and continue on failure                                                       vm.add_suffix_to_files_with_specific_extension
    ...                                                                                       path=/tmp/btslog2
    ...                                                                                       extension=.LOG
    ...                                                                                       suffix=${date_stamp}
    Run keyword if  ${btslog}       Collect and Teardown Btslogs
    ...                                                           gnb_slave=${btslog_slave}
    ...                                                           enb=${btslog_enb}
    ...                                                           collect=${collect_logs}
    ...                                                           name_on_testvm=${name_on_testvm}
    Run keyword if  ${tcpdump}                          Run keyword and continue on failure   Collect tcpdump
    ...                                                                                       bts_type=${bts_type}
    Run keyword if  ${collect_logs} and ${rmod}         Run keyword and ignore error          Collect Rmod Logs
    ...                                                                                       bts_type=${bts_type}
    Run keyword if  '${is_second_log_collection_needed}' == '${True}'    Run keywords
    ...                                                 Robot Log Operation    Second snapshots collection will be triggered in 15 minutes
    ...                                                 AND
    ...                                                 Sleep       15 minutes
    ...                                                 reason=Waiting for second snapshot trigger after possible BTS recovery
    ...                                                 AND
    ...                                                 Private Collect Second Snapshot
    ...                                                 bts_type=${bts_type}
    ...                                                 collect_logs=${collect_logs}
    ...                                                 setup_mode=${setup_mode}
    ...                                                 snapshot=${snapshot}
    ...                                                 manual_snapshot=${manual_snapshot}
    ...                                                 lte_snapshot=${lte_snapshot}


