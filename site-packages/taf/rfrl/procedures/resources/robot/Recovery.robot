Perform Reset Site And Wait For OnAir

    ${bts_type}                              hwpta_testline.get_type_of_setup
    ${connection}                            conn.get_default_admin_connection_alias
    ...                                      bts_type=${bts_type}

    Allow X2 Link Alarms

    Robot Log Operation                      Performing reset site due to recovery action

    timer.robot_timer                        admin.reset_site  timeout=300s  connection=${connection}

    Robot Log Result                         Reset site has been performed.
    timer.wait_until_keyword_succeeds_timer  300s
    ...                                      5s
    ...                                      Verify BTS states
    ...                                      bts_type=${bts_type}
    ...                                      status=OnAir
    Confirm RFSW Compability                 bts_type=${bts_type}

    Disallow X2 Link Alarms

Perform Device Unit Power Reset Recovery
    [Arguments]                              ${du_id}=0
    ...                                      ${time_interval}=60
    ...                                      ${bts_type}=GNB
    ${alias}                                 conn.get_default_admin_connection_alias
    ...                                      bts_type=${bts_type}
    Allow X2 Link Alarms

    Robot Log Operation                      Performing SMOD power reset due to recovery action...
    ${du_sn}=                                hwpta_testline.get_smod_serial_number   smod_id=${du_id}
    ...                                                                              bts_type=${bts_type}
    power.reset_device                       serial_number=${du_sn}
    Boot Device Unit After Power Reset

    Robot Log Result                         Power reset has been performed, waiting for OnAir state...
    timer.wait_until_keyword_succeeds_timer  600 sec   15 sec
    ...                                      Verify BTS states
    ...                                      bts_type=${bts_type}
    ...                                      status=OnAir

    Disallow X2 Link Alarms

Perform Fault 10 Recovery
    [Arguments]                         ${power_reset_bts}=${False}
    ...                                 ${time_interval_for_power_reset}=60
    ...                                 ${du_id}=0
    ...                                 ${bts_type}=GNB
    run keyword if                      ${power_reset_bts}
    ...                                 Perform Device Unit Power Reset Recovery
    ...                                 du_id=${du_id}
    ...                                 time_interval=${time_interval_for_power_reset}
    ...                                 bts_type=${bts_type}
    ${alarm_exists}=                    Alarms.Is alarm active  fault_id=10
    ...                                                         bts_type=${bts_type}
    run keyword if                      ${alarm_exists}  Restore BTS With Fault 10

Restore BTS With Fault 10
    [Arguments]                         ${bts_type}=GNB
    ${alias}                            conn.get_default_admin_connection_alias
    ...                                 bts_type=${bts_type}

    Alarms.Allow alarm                  fault_id=10
    ...                                 fault_name=No connection to unit
    ...                                 bts_type=${bts_type}
    Allow X2 Link Alarms

    Robot Log Operation                 Performing RMODs' power reset due to recovery action...
    Run keyword if                      """${bts_type}"""=='GNB'
    ...                                 power.reset_all_gnb_rmods
    ...                                 ELSE
    ...                                 power.reset_all_enb_rmods
    Robot Log Result                    RMODs' Power resets have been performed.

    timer.wait_until_keyword_succeeds_timer  300 sec  5 sec    status_check.verify_procedural_state_of_bts
    ...                                                        connection=${alias}
    Confirm RFSW Compatibility          bts_type=${bts_type}

    Alarms.Disallow alarm               fault_id=10
    ...                                 fault_name=No connection to unit
    ...                                 bts_type=${bts_type}
    Disallow X2 Link Alarms

Perform Reset Site Recovery
    [Arguments]                         ${bts_type}=GNB
    ${connection}=                      conn.get_default_admin_connection_alias
    ...                                 bts_type=${bts_type}
    ${procedural_state}                 admin_info_model.get_bts_procedural_state
    ...                                 connection=${connection}
    run keyword if                      """${procedural_state}"""!='OnAir'  Perform Site Reset And Wait On OnAir
    ...                                                                     bts_type=${bts_type}

Boot Device Unit After Power Reset
    [Arguments]                         ${time_interval}=1min
    sleep                               ${time_interval}

Private Detect BTS Configuration Error
    [Arguments]                         ${bts_type}=GNB
    ${is_f1868_active}                  Alarms.Is alarm active
    ...                                 fault_id=1868
    ...                                 bts_type=${bts_type}
    [Return]                            ${is_f1868_active}

Wait for Radio autonomous reset Action
    [Arguments]    ${rmod_id}
    ...            ${connection}
    ...            ${timeout}=30
    ...            ${recovery_reset_delay}=0

    ${timeout}                                              Evaluate
    ...                                                     ${timeout}+${recovery_reset_delay}
    ${rmod_ids}                                             Create list
    ...                                                     ${rmod_id}

    Robot Log Operation                                     Waiting for autonomous radio reset on RMOD-${rmod_id}

    Wait Until Keyword Succeeds                             ${timeout}
    ...                                                     10s
    ...                                                     status_check.verify_specific_statuses_for_specific_rmods
    ...                                                     rmod_ids=${rmod_ids}
    ...                                                     connection=${connection}
    ...                                                     operational_state=disabled
    Robot Log Result                                        RMOD-${rmod_id} goes reset, waiting for startup...

Check status of RMOD and cells during RMOD startup after recovery action
    [Arguments]    ${rmod_id}
    ...            ${connection}
    ...            ${rmod_startup_time}
    ...            ${radio_status_variant}=online
    ...            ${cells_status_variant}=online

    Robot Log Operation                                     Waiting for radio startup after autonomous reset and checking RMOD and cells statuses.

    Wait Until Keyword Succeeds                             ${rmod_startup_time}
    ...                                                     30s
    ...                                                     status_check.verify_statuses_of_rmod
    ...                                                     rmod_id=${rmod_id}
    ...                                                     status_variant=${radio_status_variant}
    ...                                                     connection=${connection}
    Wait Until Keyword Succeeds                             120s
    ...                                                     30s
    ...                                                     Check statuses of cells for RMOD
    ...                                                     rmod_id=${rmod_id}
    ...                                                     status_variant=${cells_status_variant}
    ...                                                     connection=${connection}
    Robot Log Result                                        RMOD-${rmod_id} recovery action is succeeded.

Get Recovery Reset Delay
    [Documentation]  Gets value of recoveryResetDelay scf parameters using admin api.
    [Arguments]    ${connection}

    ${mnlent_obj}                                           admin_info_model._get_managed_objects_for_class
    ...                                                     connection=${connection}
    ...                                                     object_class_name=MNLENT_A
    [Return]                                                ${mnlent_obj[0]["parameters"]['recoveryResetDelay']}

Wait for recovery alarm with RMOD recovery reset and startup
    [Arguments]    ${recovery_fault_id}
    ...            ${rmod_id}
    ...            ${connection}
    ...            ${bts_type}=GNB
    ...            ${timeout_for_recovery_alarm}=120
    ...            ${retry_interval_for_recovery_alarm}=10
    ...            ${rmod_startup_time}=300

    ${recovery_reset_delay}                                 Get Recovery Reset Delay
    ...                                                     connection=${connection}

    Alarms.Allow alarm                                      fault_id=${recovery_fault_id}
    Alarms.Allow additional alarms if recovery delay is longer than 30s
    ...                                                     recovery_reset_delay=${recovery_reset_delay}

    Robot Log Operation                                     Waiting for alarm 'Radio autonomous reset as recovery action' (fault id: '${recovery_fault_id}') to become active...
    Wait Until Keyword Succeeds                             ${timeout_for_recovery_alarm}
    ...                                                     ${retry_interval_for_recovery_alarm}
    ...                                                     Check if alarm is active
    ...                                                     fault_name=Radio autonomous reset as recovery action
    ...                                                     fault_id=${recovery_fault_id}
    ...                                                     bts_type=${bts_type}
    Robot Log Result                                        Alarm 'Radio autonomous reset as recovery action' (fault id: '${recovery_fault_id}') is active.

    Wait for Radio autonomous reset Action                  rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ...                                                     recovery_reset_delay=${recovery_reset_delay}

    Check status of RMOD and cells during RMOD startup after recovery action
    ...                                                     rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ...                                                     rmod_startup_time=${rmod_startup_time}

    Alarms.Disallow alarm                                   fault_id=${recovery_fault_id}
    Alarms.Disallow additional alarms if recovery delay is longer than 30s
    ...                                                     recovery_reset_delay=${recovery_reset_delay}

Kill Process on RMOD and Wait for RMOD Autonomous Reset
    [Arguments]    ${rmod_id}
    ...            ${process_name}
    ...            ${connection}
    ...            ${root_process}=${False}
    ...            ${signal_number}=9

    Robot Log Step                                          Killing process '${process_name}' on RMOD-${rmod_id}...
    ${killed_pid}                                           rmod_ops.kill_rmod_process_by_name
    ...                                                     rmod_id=${rmod_id}
    ...                                                     process_name=${process_name}
    ...                                                     signal_number=${signal_number}
    ...                                                     root_process=${root_process}
    ...                                                     connection=${connection}

    Robot Log Result                                        PID: ${killed_pid} has been killed on RMOD-${rmod_id}
    ...                                                     to_console=${True}

    Robot Log Step                                          Waiting for RMOD-${rmod_id} autonomous reset after process kill...
    Wait for Radio autonomous reset Action                  rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ...                                                     timeout=120
    ...                                                     recovery_reset_delay=60

    Robot Log Result                                        RMOD-${rmod_id} autonomous reset has been performed.
    ...                                                     to_console=${True}

Kill Process on BBMOD and Wait for BBMOD Autonomous Reset
    [Arguments]    ${bbmod_id}
    ...            ${process_name}
    ...            ${connection}
    ...            ${bbmod_cpu}=0

    Robot Log Step                                          Killing process '${process_name}' on BBMOD-${bbmod_id}...
    ${killed_pid}                                           bbmod_ops.kill_bbmod_process_by_name
    ...                                                     bbmod_id=${bbmod_id}
    ...                                                     bbmod_cpu=${bbmod_cpu}
    ...                                                     process_name=${process_name}
    ...                                                     connection=${connection}

    Robot Log Result                                        PID: ${killed_pid} has been killed on BBMOD-${bbmod_id}
    ...                                                     to_console=${True}

    Robot Log Step                                          Waiting for BBMOD-${bbmod_id} autonomous reset after process kill...

    Wait Until Keyword Succeeds                             30s
    ...                                                     5s
    ...                                                     Verify Statuses of BBMOD
    ...                                                     bbmod_id=${bbmod_id}
    ...                                                     status_variant=degraded
    ...                                                     alternative_status_variant=failed
    ...                                                     connection=${connection}

    Robot Log Result                                        BBMOD-${bbmod_id} autonomous reset has been performed.
    ...                                                     to_console=${True}
