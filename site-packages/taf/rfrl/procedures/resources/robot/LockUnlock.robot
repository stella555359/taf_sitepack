Library     taf.sbts.oam.coam.admin                             WITH NAME  admin
Library     ../python/admin_info_model/admin_info_model.py      WITH NAME  admin_info_model
Library     ../python/connections.py                            WITH NAME  connections
Library     ../python/status_check/status_check.py              WITH NAME  status_check
Library     ../python/timer/timer.py                            WITH NAME  timer

Resource    HWPTA_Logger.robot
Resource    StatusCheck.robot
Resource    KPI.robot

*** Keywords ***
Lock RMOD
    [Arguments]                                 ${runtime_rmod_id}
    ...                                         ${bts_type}=GNB
    ${connection}=                              connections.get_default_admin_connection_alias
    ...                                         bts_type=${bts_type}

    Robot Log Operation                         Locking RMOD with runtime id: ${runtime_rmod_id}...
    ${runtime_rmod_distname}=                   admin_info_model.get_runtime_distname_for_rmod
    ...                                         runtime_rmod_id=${runtime_rmod_id}
    ...                                         connection=${connection}

    admin.lock                                  dist_name=${runtime_rmod_distname}
    ...                                         connection=${connection}
    ...                                         timeout=120s

    Robot Log Result                            RMOD with runtime id: ${runtime_rmod_id} is locked

Unlock RMOD
    [Arguments]                                 ${runtime_rmod_id}
    ...                                         ${bts_type}=GNB
    ${connection}=                              connections.get_default_admin_connection_alias
    ...                                         bts_type=${bts_type}

    Robot Log Operation                         Unlocking RMOD with runtime id: ${runtime_rmod_id}...
    ${runtime_rmod_distname}=                   admin_info_model.get_runtime_distname_for_rmod
    ...                                         runtime_rmod_id=${runtime_rmod_id}
    ...                                         connection=${connection}

    admin.unlock                                dist_name=${runtime_rmod_distname}
    ...                                         connection=${connection}
    ...                                         timeout=120s

    Robot Log Result                            RMOD with runtime id: ${runtime_rmod_id} is unlocked

Ensure RMODs Are Unlocked
    [Arguments]                                 ${bts_type}
    ...                                         ${wait_for_rmod_online_status}=${False}
    Robot Log Operation                         Ensuring that all RMODs are unlocked...
    ${connection}                               connections.get_default_admin_connection_alias
    ...                                         bts_type=${bts_type}
    ${rmods}=                                   admin_info_model.get_rmod_indexes
    ...                                         connection=${connection}

    FOR  ${rmod}  IN   @{rmods}
        Unlock RMOD Unit If Locked              rmod_id=${rmod}
        ...                                     timeout=180sec
        ...                                     connection=${connection}
        ...                                     bts_type=${bts_type}
        ...                                     wait_for_rmod_online_status=${wait_for_rmod_online_status}
    END

Unlock RMOD Unit If Locked
    [Arguments]                                 ${rmod_id}
    ...                                         ${timeout}
    ...                                         ${connection}
    ...                                         ${bts_type}
    ...                                         ${wait_for_rmod_online_status}=${False}

    ${is_locked}=                               status_check.is_rmod_locked
    ...                                         connection=${connection}
    ...                                         rmod_id=${rmod_id}

    ${runtime_id}                               admin_info_model.translate_rmod_index_to_runtime
    ...                                         rmod_index=${rmod_id}
    ...                                         connection=${connection}

    Run Keyword If                              ${is_locked}
    ...                                         Unlock RMOD
    ...                                         runtime_rmod_id=${runtime_id}
    ...                                         bts_type=${bts_type}

    Run Keyword If                              ${wait_for_rmod_online_status}
    ...                                         timer.wait_until_keyword_succeeds_timer
    ...                                         5m
    ...                                         10s
    ...                                         status_check.verify_statuses_of_rmod
    ...                                         connection=${connection}
    ...                                         status_variant=online
    ...                                         rmod_id=${rmod_id}
    ...                                         ELSE
    ...                                         status_check.verify_statuses_of_rmod
    ...                                         connection=${connection}
    ...                                         status_variant=online
    ...                                         rmod_id=${rmod_id}


Lock All RMODs
    [Arguments]                                 ${bts_type}
    Robot Log Operation                         Locking all RMOD units...
    ${connection}                               connections.get_default_admin_connection_alias
    ...                                         bts_type=${bts_type}
    ${rmods}=                                   admin_info_model.get_rmods
    ...                                         connection=${connection}
    FOR  ${rmod}  IN   @{rmods}
         timer.robot_timer                      admin.lock
         ...                                    dist_name=${rmod}
         ...                                    connection=${connection}
         ...                                    timeout=${120}
    END

    Robot Log Result                            RMODs have been locked

Unlock All RMODs
    [Arguments]                                 ${bts_type}
    Robot Log Operation                         Unlocking all RMOD units...
    ${connection}                               connections.get_default_admin_connection_alias
    ...                                         bts_type=${bts_type}
    ${rmods}=                                   admin_info_model.get_rmods
    ...                                         connection=${connection}
    FOR  ${rmod}  IN   @{rmods}
         timer.robot_timer                      admin.unlock
         ...                                    dist_name=${rmod}
         ...                                    connection=${connection}
         ...                                    timeout=${120}
    END

    Robot Log Result                            RMODs have been unlocked

Lock cells on RMOD and check statuses
    [Arguments]                                 ${connection}
    ...                                         ${rmod_internal_distname}
    ...                                         ${bts_type}=GNB
    ${rmod_config_distname}=                    admin_info_model.translate_rmod_distname
    ...                                         rmod_distname=${rmod_internal_distname}
    ...                                         output_distname_type=configuration
    ...                                         connection=${connection}
    ${rmod_id}=                                 Evaluate  int(str("""${rmod_config_distname}""").split('-')[-1])
    @{cells}=                                   admin_info_model.get_cell_mapping_for_rmod
    ...                                         rmod_internal_distname=${rmod_internal_distname}
    ...                                         connection=${connection}
    ${timeout}=                                 Get Timeout Cell Lock

    Alarms.Allow Alarm                          fault_name=NgGnbInitPartialReset
    ...                                         fault_id=7313
    ...                                         bts_type=${bts_type}

    FOR  ${cell}  IN  @{cells}
          ${cell_id}=                           Get From Dictionary  ${cell}  CELLID
          ${cell_rat}=                          Get From Dictionary  ${cell}  RAT
          ${is_iot_cell}                        admin_info_model.is_iot_cell
          ...                                   connection=${connection}
          ...                                   cell_id=${cell_id}
          ...                                   cell_type=${cell_rat}
          Continue for loop if                  ${is_iot_cell}==${True}
          ${dist_name}=                         Get From Dictionary  ${cell}  runtimeDistName
          ${operation_succeed}=                 admin.lock
          ...                                   dist_name=${dist_name}
          ...                                   connection=${connection}
          ...                                   timeout=80s
          Run keyword if                        '${operation_succeed}'=='completed'
          ...                                   Robot Log Iteration  msg=Cell ${dist_name} is locked
    END

    timer.wait_until_keyword_succeeds_timer     ${timeout}
    ...                                         65s
    ...                                         Check statuses of cells for RMOD
    ...                                         rmod_id=${rmod_id}
    ...                                         connection=${connection}
    ...                                         status_variant=locked

Unlock cells on RMOD and check statuses
    [Arguments]                                ${connection}
    ...                                        ${rmod_internal_distname}
    ...                                        ${bts_type}=GNB
    ${rmod_config_distname}=                   admin_info_model.translate_rmod_distname
    ...                                        rmod_distname=${rmod_internal_distname}
    ...                                        output_distname_type=configuration
    ...                                        connection=${connection}
    ${rmod_id}=                                Evaluate  int(str("""${rmod_config_distname}""").split('-')[-1])
    @{cells}=                                  admin_info_model.get_cell_mapping_for_rmod
    ...                                        rmod_internal_distname=${rmod_internal_distname}
    ...                                        connection=${connection}
    ...                                        sort_cells_by_chbw=${True}
    ...                                        reverse_order=${True}
    ${cell_unlock_timeout}=                    Get Timeout Cell Unlock

    FOR  ${cell}  IN  @{cells}
          ${cell_id}=                          Get From Dictionary  ${cell}  CELLID
          ${cell_rat}=                         Get From Dictionary  ${cell}  RAT
          ${is_iot_cell}                       admin_info_model.is_iot_cell
          ...                                  connection=${connection}
          ...                                  cell_id=${cell_id}
          ...                                  cell_type=${cell_rat}
          Continue for loop if                 ${is_iot_cell}==${True}
          ${dist_name}=                        Get From Dictionary  ${cell}  runtimeDistName
          ${operation_succeed}=                admin.unlock
          ...                                  dist_name=${dist_name}
          ...                                  connection=${connection}
          ...                                  timeout=80s
          Run keyword if                       '${operation_succeed}'=='completed'
          ...                                  Robot Log Iteration  msg=Cell ${dist_name} is unlocked
    END

    timer.wait_until_keyword_succeeds_timer    ${cell_unlock_timeout}
    ...                                        15s
    ...                                        Check statuses of cells for RMOD
    ...                                        rmod_id=${rmod_id}
    ...                                        connection=${connection}
    ...                                        status_variant=online

    Alarms.Disallow Alarm                      fault_name=NgGnbInitPartialReset
    ...                                        fault_id=7313
    ...                                        bts_type=${bts_type}

Unlock Each Cell
    [Arguments]                                 ${bts_type}
    ${connection}=                              connections.get_default_admin_connection_alias
    ...                                         bts_type=${bts_type}
    @{cells}=                                   admin_info_model.get_admin_cells_parameters
    ...                                         connection=${connection}
    ...                                         sort_cells_by_chbw=${True}
    ...                                         reverse_order=${True}

    FOR  ${cell}  IN  @{cells}
        ${cell_id}=                             Get From Dictionary  ${cell}  CELLID
        ${cell_rat}=                            Get From Dictionary  ${cell}  RAT
        ${is_iot_cell}                          admin_info_model.is_iot_cell
        ...                                     connection=${connection}
        ...                                     cell_id=${cell_id}
        ...                                     cell_type=${cell_rat}
        Continue for loop if                    ${is_iot_cell}
        ${runtime_dist_name}=                   Get From Dictionary  ${cell}  runtimeDistName
        ${cell_unlock_timeout}=                 Get Timeout Cell Unlock
        ${operation_succeed}=                   admin.unlock
        ...                                     dist_name=${runtime_dist_name}
        ...                                     connection=${connection}
        ...                                     timeout=80s
        ${adjusted_cell_id}=                    Convert To String   ${cell_id}
        @{list_of_adjusted_cell_id}=            Create list   ${adjusted_cell_id}
                                                timer.wait_until_keyword_succeeds_timer
        ...                                     ${cell_unlock_timeout}
        ...                                     5s
        ...                                     Check statuses for specific cells
        ...                                     cell_ids=${list_of_adjusted_cell_id}
        ...                                     cell_type=${cell_rat}
        ...                                     connection=${connection}
        ...                                     status_variant=online
        Run keyword if                          '${operation_succeed}'=='completed'
        ...                                     Robot Log Iteration  msg=Cell ${runtime_dist_name} is unlocked.
    END
