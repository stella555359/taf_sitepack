*** Keywords ***
Turn the Power On For All Devices
    [Documentation]  Sets PDU ports ON for all devices defined in testline configuration.
    ...              Warning message prints in case of problem during device power turning on.

    Robot Log Operation        Ensuring that all devices are powered on ...

    ${kw_status}=              Run Keyword And Return Status        power.turn_on_all_enb_smods
    Run Keyword If     ${kw_status}==False     Robot Log Warning    msg=PDU action for enb_smod FAILED!
    ${kw_status}=              Run Keyword And Return Status        power.turn_on_all_enb_rmods
    Run Keyword If     ${kw_status}==False     Robot Log Warning    msg=PDU action for enb_rmod FAILED!
    ${kw_status}=              Run Keyword And Return Status        power.turn_on_all_gnb_smods
    Run Keyword If     ${kw_status}==False     Robot Log Warning    msg=PDU action for gnb_smod FAILED!
    ${kw_status}=              Run Keyword And Return Status        power.turn_on_all_gnb_rmods
    Run Keyword If     ${kw_status}==False     Robot Log Warning    msg=PDU action for gnb_rmod FAILED!
    ${kw_status}=              Run Keyword And Return Status        power.turn_on_all_attenuators
    Run Keyword If     ${kw_status}==False     Robot Log Warning    msg=PDU action for attenuator FAILED!
    ${kw_status}=              Run Keyword And Return Status        power.turn_on_all_optical_switches
    Run Keyword If     ${kw_status}==False     Robot Log Warning    msg=PDU action for optical switch FAILED!

Perform Power Reset For All Radio Units And All System Modules For Enb And Gnb
    [Arguments]                                     ${bts_type}=GNB
    ${connection}=                                  connections.get_default_admin_connection_alias
    ...                                             bts_type=${bts_type}
    ${setup_mode}=                                  admin_info_model.get_bts_setup_mode
    ...                                             connection=${connection}
    ${bts_status}=                                  Get BTS Procedural State
    ...                                             bts_type=${bts_type}
    ${bts_status_remote_enb}=                       Run keyword if       """${setup_mode}"""=='NSA'
    ...                                             Get BTS Procedural State
    ...                                             bts_type=ENB
    ...                                             use_proxy=${True}
    ${full_rack}                                    hwpta_testline.is_full_rack

    ${startup_timeout}=                             Get Timeout Cold Start Up

    Run keyword if  ${full_rack}                    Alarms.Allow Smods Desynchronization Alarms on Full Rack BTS
    Alarms.Allow alarm                              fault_id=10
    ...                                             fault_name=No X2 link available
    Alarms.Allow alarm                              fault_id=7319
    ...                                             fault_name=No X2 link available for a specific LTEENB
    Alarms.Allow alarm                              fault_id=10
    ...                                             fault_name=No connection to unit
    Alarms.Allow alarm                              fault_id=7308
    ...                                             fault_name=Transport layer connection failure in X2 interface
    Alarms.Allow alarm                              fault_id=4589
    ...                                             fault_name=Unit power reset
    Alarms.Allow alarm                              fault_id=1815

    Robot Log Operation                             msg=Performing power reset for all RMODs and SMODs of ENB and GNB
    power.reset_all_enb_smods
    power.reset_all_enb_rmods
    power.reset_all_gnb_smods
    power.reset_all_gnb_rmods
    Robot Log Result                                Power reset for all modules from test line complete

    Run keyword if                                  '${bts_status}' == 'NotCommissioned'
    ...                                             Priv Wait For BTS Operability After Power Reset
    ...                                             ELSE
    ...                                             timer.wait_until_keyword_succeeds_timer
    ...                                             ${startup_timeout}
    ...                                             20s
    ...                                             Check all BBMODs RMODs and cells states for all RATs

    Run keyword if                                  '${bts_status_remote_enb}' == 'NotCommissioned'
    ...                                             Priv Wait For BTS Operability After Power Reset
    ...                                             ELSE
    ...                                             timer.wait_until_keyword_succeeds_timer   20m    20s
    ...                                             Check all BBMODs RMODs and cells states for all RATs
    ...                                             bts_type=ENB
    ...                                             use_proxy=${True}

    Run keyword if  ${full_rack}                    Alarms.Disallow Smods Desynchronization Alarms on Full Rack BTS
    Disallow X2 Link Alarms
    Alarms.Disallow alarm                           fault_id=10
    ...                                             fault_name=No connection to unit
    Alarms.Disallow alarm                           fault_id=7308
    ...                                             fault_name=Transport layer connection failure in X2 interface
    Alarms.Disallow alarm                           fault_id=4589
    ...                                             fault_name=Unit power reset
    Alarms.Disallow alarm                           fault_id=1815


Priv Wait For BTS Operability After Power Reset
    [Arguments]                              ${bts_type}=GNB
    ...                                      ${setup_mode}=NSA
    ${connection}                            connections.get_default_admin_connection_alias
    ...                                      bts_type=${bts_type}

    Robot Log Operation                      msg=Waiting for BTS to be available to establish admin CLI connection
    timer.wait_until_keyword_succeeds_timer  5m    1min
    ...                                      Create admin session with default alias  bts_type=${bts_type}

    Robot Log Operation                      msg=Waiting for SMODs to be available after power reset
    timer.wait_until_keyword_succeeds_timer  5m    1min
    ...                                      status_check.verify_statuses_of_all_smods
    ...                                      connection=${alias}

    Robot Log Operation                      msg=Waiting for BBMODs to be available after power reset
    timer.wait_until_keyword_succeeds_timer  5m    2s
    ...                                      Check Baseband Module Statuses With Loner Change Detection
    ...                                      AND
    ...                                      Run keyword if       """${setup_mode}"""=='NSA'
    ...                                      Check Baseband Module Statuses With Loner Change Detection
    ...                                      bts_type=ENB
    ...                                      use_proxy=${True}

    Sleep                                    60s
    ...                                      reason=Waiting for baseband modules fully initialized

    Robot Log Result                         msg=We are ready to go after power reset!


Power off unused RMODs
    [Arguments]    ${bts_type}=GNB
    ${serial_numbers_of_unused_rmods}=       custom_config.get_serial_numbers_of_unused_rmods
    ...                                      bts_type=${bts_type}
    run keyword if  ${serial_numbers_of_unused_rmods}
    ...                                      Robot Log Step
    ...                                      Turning off RMODs with serial numbers: ${serial_numbers_of_unused_rmods} (not used in custom config)
    FOR    ${serial_number}    IN    @{serial_numbers_of_unused_rmods}
        power.turn_off_device
        ...                                  serial_number=${serial_number}
    END


Power off all rmods
    [Arguments]     ${bts_type}=GNB
    run keyword if    '${bts_type}'=='GNB'   run keywords
    ...                                      Robot Log Operation
    ...                                      Turning OFF all GNB RMODs...
    ...                                      AND
    ...                                      power.turn_off_all_gnb_rmods
    run keyword if    '${bts_type}'=='ENB'   run keywords
    ...                                      Robot Log Operation
    ...                                      Turning OFF all ENB RMODs...
    ...                                      AND
    ...                                      power.turn_off_all_enb_rmods

Power on all rmods
    [Arguments]     ${bts_type}=GNB
    run keyword if    '${bts_type}'=='GNB'   run keywords
    ...                                      Robot Log Operation
    ...                                      Turning ON all GNB RMODs...
    ...                                      AND
    ...                                      power.turn_on_all_gnb_rmods
    run keyword if    '${bts_type}'=='ENB'   run keywords
    ...                                      Robot Log Operation
    ...                                      Turning ON all ENB RMODs...
    ...                                      AND
    ...                                      power.turn_on_all_enb_rmods

Power off selected rmods
    [Documentation]  Turns off selected RMODs on PDU.
    ...              *${list_of_ru_ids} - list of configuration RMOD IDs to power off
    [Arguments]      ${list_of_ru_ids}
    ...              ${bts_type}=GNB
    ${connection}                                             connections.get_default_admin_connection_alias
    ...                                                       bts_type=${bts_type}
    FOR  ${ru_id}  IN  @{list_of_ru_ids}
        Robot Log Iteration                                   Power-off ru_id: ${ru_id}
        ${rmod_sn}=                                           admin_info_model.get_serial_number_for_rmod
        ...                                                   connection=${connection}
        ...                                                   rmod_id=${ru_id}
        power.turn_off_device                                 serial_number=${rmod_sn}
    END

Power on selected rmods
    [Documentation]  Turns on selected RMODs on PDU.
    ...              *${list_of_ru_ids} - list of configuration RMOD IDs to power on
    [Arguments]      ${list_of_ru_ids}
    ...              ${bts_type}=GNB
    ${connection}                                             connections.get_default_admin_connection_alias
    ...                                                       bts_type=${bts_type}
    FOR  ${ru_id}  IN  @{list_of_ru_ids}
        Robot Log Iteration                                   Power-on ru_id: ${ru_id}
        ${rmod_sn}=                                           admin_info_model.get_serial_number_for_rmod
        ...                                                   connection=${connection}
        ...                                                   rmod_id=${ru_id}
        power.turn_on_device                                  serial_number=${rmod_sn}
    END

Power Off All RMODs And Check Status
    [Arguments]                                         ${bts_type}

    Allow Alarms Before Power Off All Rmods             bts_type=${bts_type}
    Power off all rmods                                 bts_type=${bts_type}
    Robot Log Step                                      Waiting for 'No connection to unit' alarms to become active...
    ${is_alarm_active}                                  Wait for active alarm
    ...                                                 timeout=300
    ...                                                 fault_name=No connection to unit
    ...                                                 fault_id=10
    ...                                                 bts_type=${bts_type}
    Should Be True                                      ${is_alarm_active}
    ...                                                 msg='No connection to unit' alarm is not active
    ${count_of_rus}                                     hwpta_testline.get_count_of_radios
    ...                                                 bts_type=${bts_type}
    Wait for number of active alarms                    expected_number_of_alarms=${count_of_rus}
    ...                                                 timeout=80s
    ...                                                 fault_name=No connection to unit
    ...                                                 fault_id=10
    ...                                                 bts_type=${bts_type}

    Robot Log Step                                      Checking if all RMODs are disabled...
    ${connection}=                                      connections.get_default_admin_connection_alias
    ...                                                 bts_type=${bts_type}
    status_check.verify_statuses_of_all_rmods           connection=${connection}
    ...                                                 status_variant=disabled
    @{all_rmod_ids}=                                    Get all RMODs index values
    ...                                                 bts_type=${bts_type}
    Check statuses of all cells for powered off RMODs   all_rmod_ids=@{all_rmod_ids}
    ...                                                 bts_type=${bts_type}

Power On All RMODs And Check Status
    [Arguments]                                         ${bts_type}

    Power on all rmods                                  bts_type=${bts_type}
    Robot Log Step                                      Waiting for 'No connection to unit' alarms to become inactive...
    ${is_alarm_inactive}                                Wait for inactive alarm    timeout=360
    ...                                                 fault_name=No connection to unit
    ...                                                 fault_id=10
    ...                                                 bts_type=${bts_type}
    Should Be True                                      ${is_alarm_inactive}
    ...                                                 msg='No connection to unit' alarm is still active
    Alarms.Disallow alarm                               fault_name=No connection to unit
    ...                                                 fault_id=10
    ...                                                 bts_type=${bts_type}
    Alarms.Disallow alarm                               fault_id=2002
    ...                                                 bts_type=${bts_type}
    Alarms.Disallow alarm                               fault_id=1972
    ...                                                 bts_type=${bts_type}
    Alarms.Disallow alarm                               fault_id=1815
    ...                                                 bts_type=GNB
    Alarms.Disallow alarm                               fault_id=1815
    ...                                                 bts_type=ENB
    Robot Log Step                                      Waiting for all RMODs to become operational...
    Wait Until Keyword Succeeds    5min    10s          Check all BBMODs RMODs and cells states for all RATs
    ...                                                 bts_type=${bts_type}
    Wait Until Keyword Succeeds    2min    10s          Check BTS state and all RATs states
    ...                                                 bts_type=${bts_type}
    Disallow Alarms After RMOD Power ON                 bts_type=${bts_type}

Reset selected RMODs via PDU
    [Documentation]       Reset selected RMODs via PDU.
    ...                   *${list_of_rus_ids} - list of configuration RMODs IDs to reset
    [Arguments]       ${list_of_rus_ids}

    ${bts_type}=                                                hwpta_testline.get_type_of_setup
    Alarms.Allow alarm                                          fault_id=4589
    ...                                                         fault_name=Unit power reset
    Alarms.Allow alarm                                          fault_id=10
    ...                                                         fault_name=No connection to unit
    FOR  ${ru_id}  IN  @{list_of_rus_ids}
        Robot Log Iteration                                     PDU reset ru_id: ${ru_id}
        ${rmod_sn}                                              hwpta_testline.get_radio_serial_number
        ...                                                     ru_id=${ru_id}
        power.reset_device                                      serial_number=${rmod_sn}
        Wait Until Keyword Succeeds    5min    10s              Check all BBMODs RMODs and cells states for all RATs
    END
    Alarms.Disallow alarm                                       fault_id=4589
    ...                                                         fault_name=Unit power reset
    Alarms.Disallow alarm                                       fault_id=10
    ...                                                         fault_name=No connection to unit