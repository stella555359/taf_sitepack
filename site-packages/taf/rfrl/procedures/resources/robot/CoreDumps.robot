    ...                                                     fault_id=4527
    ...                                                     alarm_id=7115

    Run keyword if                                          not ${is_fault_10_active} and (${is_fault_4590_active} or ${is_fault_4527_active})
    ...                                                     Run keywords
    ...                                                     Robot Log Operation
    ...                                                     Additional Site Reset is performing due to unexpected alarms detection...
    ...                                                     AND
    ...                                                     Perform Site Reset And Wait On OnAir
    ...                                                     bts_type=${bts_type}
    ...                                                     ELSE
    ...                                                     Wait Until Keyword Succeeds
    ...                                                     5min
    ...                                                     20sec
    ...                                                     Check BTS state and all RATs states
    ...                                                     bts_type=${bts_type}

Priv Verfy if Snapshot Contains Core Dumps Logs and Create File Copy
    [Arguments]    ${rmod_serial_number}
    ...            ${rmod_snapshot_id}
    ...            ${name_of_process}

    ${core_dump_archive_name_regex}                         Set variable
    ...                                                     BTS[0-9]*_${rmod_serial_number}_RMOD_L_${rmod_snapshot_id}_.*-core.*\.tar\.gz.*

    ${snapshot_part_path}                                   snapshot.find_file_in_snapshot_file_list
    ...                                                     filename=${core_dump_archive_name_regex}

    ${core_dump_sub_archive_name}                           Evaluate
    ...                                                     str("""${snapshot_part_path}""").split('/')[-1].replace('.gz.gz', '.gz')

    ${internal_snapshot_path}                               Set variable if
    ...                                                     ".gz.gz" in """${snapshot_part_path}"""
    ...                                                     ${snapshot_part_path}/${core_dump_sub_archive_name}
    ...                                                     ${snapshot_part_path}

    ${extracted_file_dir}                                   snapshot.extract_shapshot_file_based_on_internal_path
    ...                                                     internal_snapshot_path=${internal_snapshot_path}

    ${core_dump_filename}                                   vm.find_file_in_directory_by_regex
    ...                                                     directory_path=${extracted_file_dir}
    ...                                                     filename_regex=core.*\.p7b

    Run keyword if                                          """${core_dump_filename}"""=="""${None}"""
    ...                                                     Fail
    ...                                                     msg=Core dump with .p7b extension was not found in extracted snapshot.

    ${core_dump_process_name}                               Evaluate
    ...                                                     str("""${core_dump_filename}""").split('-')[1]

    Run keyword if                                          """${core_dump_process_name}""" not in """${name_of_process}"""
    ...                                                     Robot Log Warning
    ...                                                     Core dump filename does not contain killed process name: ${core_dump_filename} (see more in PR775561)
    ...                                                     console=${True}
    ...                                                     ELSE
    ...                                                     Robot Log Result
    ...                                                     Core dump filename contains killed process name: ${core_dump_filename}

    Copy file                                               source=${extracted_file_dir}/${core_dump_filename}
    ...                                                     destination=${logs_path}/${core_dump_filename}
    Robot Log Operation                                     Snapshot RMOD's core dump file has been copied into: ${logs_path}/${core_dump_filename}

    [Return]    ${logs_path}/${core_dump_filename}

Priv Get Snapshot SOAP file for Particular RMOD
    [Arguments]    ${rmod_id}
    ...            ${rmod_serial_number}
    ...            ${rmod_snapshot_id}

    Robot Log Step                                          Getting Snapshot SOAP for RMOD-${rmod_id} (SN: ${rmod_serial_number})...
    @{rmod_soap_archive_name_regexes}                       Create List
    ...                                                     BTS.*${rmod_serial_number}_RMOD_${rmod_snapshot_id}_SOAPCFG.xml.gz
    ...                                                     BTS.*${rmod_serial_number}_RMOD_L_${rmod_snapshot_id}_SOAPMessageTraceCFG.xml.gz

    ${snapshot_part_path}                                   snapshot.find_file_in_snapshot_file_list
    ...                                                     filename=${rmod_soap_archive_name_regexes}[0]
    ...                                                     raise_exception=${False}

    IF  """${snapshot_part_path}"""=="""${False}"""
        ${snapshot_part_path}                               snapshot.find_file_in_snapshot_file_list
        ...                                                 filename=${rmod_soap_archive_name_regexes}[1]
    END

    ${rmod_soap_filename}                                   Evaluate
    ...                                                     str("""${snapshot_part_path}""").split('/')[-1].replace('.gz', '')

    ${extracted_file_dir}                                   snapshot.extract_shapshot_file_based_on_internal_path
    ...                                                     internal_snapshot_path=${snapshot_part_path}/${rmod_soap_filename}

    Copy file                                               source=${extracted_file_dir}/${rmod_soap_filename}
    ...                                                     destination=${logs_path}/${rmod_soap_filename}
    Robot Log Operation                                     Snapshot RMOD's SOAP file has been copied into: ${logs_path}/${rmod_soap_filename}

    [Return]    ${logs_path}/${rmod_soap_filename}

