*** Keywords ***
Get Rfmod List From Admin API
    [Arguments]                                ${start_from_1}=${False}
    ...                                        ${bts_type}=GNB

    Create admin session with default alias    bts_type=${bts_type}
    ${connection}                              connections.get_default_admin_connection_alias
    ...                                        bts_type=${bts_type}
    ${radios_and_serials_from_init}            hwpta_testline.get_rus_id_and_serial
    ...                                        bts_type=${bts_type}
    ${all_rmods}                               admin_info_model.get_init_ru_ids_ordered_with_admin_api
    ...                                        connection=${connection}
    ...                                        init_radio_info=${radios_and_serials_from_init}
    ...                                        start_from_1=${start_from_1}
    [Return]                                   ${all_rmods}

Confirm RFSW Compability
    [Arguments]                                ${bts_type}=GNB

    Create admin session with default alias    bts_type=${bts_type}
    ${connection}                              connections.get_default_admin_connection_alias   bts_type=${bts_type}
    Run keyword if      '${bts_type}'=='GNB'   sw_guard.compare_rus_sw_version
    ...                                        connection=${connection}
    ...    ELSE IF      '${bts_type}'=='ENB'   sw_guard.compare_enb_rus_sw_version
    ...                                        connection=${connection}

Get DateTime of Last RMOD Startup
    [Arguments]                                ${rmod_id}
    ...                                        ${connection}

    ${last_rmod_startup}                       rmod_ops.get_date_of_last_rmod_startup
    ...                                        rmod_id=${rmod_id}
    ...                                        connection=${connection}
    ${last_rmod_startup}                       Convert Date
    ...                                        ${last_rmod_startup}

    [Return]     ${last_rmod_startup}

Verify If RMOD Has Been Reset
    [Arguments]                                ${reference_startup_datetime}
    ...                                        ${actual_startup_datetime}
    ...                                        ${expect_rmod_reset}=${True}

    ${timedelta}                               Subtract Date From Date
    ...                                        ${actual_startup_datetime}
    ...                                        ${reference_startup_datetime}

    Robot Log Result                           Initial RMOD startup time: ${reference_startup_datetime}, actual RMOD startup time: ${actual_startup_datetime}.

    Run keyword if                             ${expect_rmod_reset}
    ...                                        Should be true
    ...                                        ${timedelta} > 10
    ...                                        msg=RMOD has not been reset. Time delta between reference and actual time is ${timedelta}seconds.
    ...                                        ELSE
    ...                                        Should be true
    ...                                        ${timedelta} <= 1
    ...                                        msg=RMOD has been reset. Time delta between reference and actual time is ${timedelta}seconds.

Get impacted RMODs For Impacted BBMOD
    [Arguments]    ${impacted_bbmod_id}
    ...            ${connection}

    ${bbmod_id}                                Convert To Integer
    ...                                        ${impacted_bbmod_id}

    ${rmod_ids_for_impacted_bbmod}             admin_info_model.get_rmod_ids_by_link_modes_for_bbmod_ids
    ...                                        bbmod_ids=${bbmod_id}
    ...                                        connection=${connection}


    ${impacted_rmods}                          Evaluate
    ...                                        ${rmod_ids_for_impacted_bbmod[${bbmod_id}]["synchronization"]}+${rmod_ids_for_impacted_bbmod[${bbmod_id}]["configuration"]}

    ${impacted_rmods}                          Remove Duplicates
    ...                                        ${impacted_rmods}

    [Return]    ${impacted_rmods}

Get BBMOD ID Connected to RMOD by Configuration Link
    [Arguments]    ${rmod_id}
    ...            ${connection}

    ${rmod_ids_for_impacted_bbmod}             admin_info_model.get_bbmod_ids_for_all_rmods_links
    ...                                        connection=${connection}

    ${bbmod_id}                                Set variable
