Get RMOD BMU Version
    [Documentation]  Gets BMU version from RMOD.
    [Arguments]      ${rmod_id}
    ...              ${connection}

    ${rsc_obj}=                                Get Library Instance
    ...                                        rsc_ops
    ${bmu_version}=                            rmod_ops.get_bmu_version
    ...                                        rmod_id=${rmod_id}
    ...                                        connection=${connection}
    ...                                        rsc_ops=${rsc_obj}

    [Return]  ${bmu_version}


Get BMU Version From RMODs
    [Documentation]  Gets BMU version on provided RMOD ids. If BMU version cannot be retrieved, None is returned.
    ...              Returns dictionary with RMOD id (str) as key and BMU version as value (str).
    ...              e.g. {'1': '0x4_0x0_0x1', '2': '0x3_0x0_0x1', '3': None}
    [Arguments]      ${rmod_ids}
    ...              ${connection}

    ${rmod_ids}=                               Evaluate    [str(id) for id in $rmod_ids]
    ${rmods_bmu_version}=                      Create Dictionary

    FOR  ${rmod_id}  IN                        @{rmod_ids}
        ${bmu_version}=                        Run Keyword And Ignore Error
        ...                                    Get RMOD BMU Version
        ...                                    rmod_id=${rmod_id}
        ...                                    connection=${connection}
        IF  '${bmu_version}[0]' != 'PASS'
            Robot Log Warning                  Could not get BMU version from RMOD id: ${rmod_id}
            Set To Dictionary                  ${rmods_bmu_version}  ${rmod_id}  ${None}
            CONTINUE
        ELSE
            Set To Dictionary                  ${rmods_bmu_version}  ${rmod_id}  ${bmu_version}[1]
        END
    END
    Robot Log Result                           BMU versions on all RMODs: ${rmods_bmu_version}

    [Return]  ${rmods_bmu_version}
