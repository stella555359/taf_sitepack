# Suite Teardown
Common Suite Teardown For eNB Testing
    Teardown Logs Collectors For eNB Testing

Save Current eNB Configuration
    [Arguments]    ${enb_id}=0
    ${scf_local_path}    Download eNB Configuration File    local_dir=${LOG_PATH}    enb_id=${enb_id}
    Set Suite Variable    ${scf_local_path}
################################################## OTHER KEYWORDS ######################################################

Save Current gNB Configuration
    [Arguments]    ${gnb_id}=0
    ${IS_ASIR_CONFIGURATION}   Get Variable Value  ${IS_ASIR_CONFIGURATION}
    ${scf_local_path}        Download gNB Configuration File    local_dir=${LOG_PATH}    gnb_id=${gnb_id}
    Set Suite Variable       ${scf_local_path}
    ${ASIR_SCF_LOCAL_PATH}   Run Keyword If    ${IS_ASIR_CONFIGURATION}    gnb_asir.get_current_scf_file
    ...                                                                    local_dir_path=${LOG_PATH}
    ...                                                                    bts_id=${gnb_id}
    Set Suite Variable       ${ASIR_SCF_LOCAL_PATH}

Verify Default Allowed Alarms on gNB
    ${additional_allowed_alarms}   Get Variable Value  ${additional_allowed_alarms}
    ${IS_ASIR_CONFIGURATION}   Get Variable Value  ${IS_ASIR_CONFIGURATION}
    Run Keyword If  ${additional_allowed_alarms}    Append To List  ${allowed_alarms}  @{additional_allowed_alarms}
    Verify Allowed Alarms on gNB    allowed_alarms=@{allowed_alarms}
    Run Keyword If    ${IS_ASIR_CONFIGURATION}    gnb_asir.verify_only_allowed_alarms_are_active  ${ASIR_ALLOWED_ALARMS}

Restore gNB Configuration After Test
    [Arguments]    ${gnb_id}=0    ${restore_only_if_not_onair}=${True}
    ${IS_ASIR_CONFIGURATION}   Get Variable Value    ${IS_ASIR_CONFIGURATION}
    ${gnb_is_onair}   Run Keyword And Return Status  Verify gNB is onAir  gnb_id=${gnb_id}
    ${asir_is_onair}  Run Keyword If  ${IS_ASIR_CONFIGURATION}
    ...               Run Keyword And Return Status  gnb_asir.Wait For Asir To Be Onair  timeout=${60}  bts_id=${gnb_id}
    Run Keyword If    not (${restore_only_if_not_onair} and ${gnb_is_onair})  Restore gNB Configuration  gnb_id=${gnb_id}
    Run Keyword If    ${IS_ASIR_CONFIGURATION}
    ...               Run Keyword If  not (${restore_only_if_not_onair} and ${asir_is_onair})
    ...               gnb_asir.Perform Asir Commissioning       scf_path=${ASIR_SCF_LOCAL_PATH}    bts_id=${gnb_id}
    BuiltIn.Log To Console    Waiting for onAir and proper states...
    Wait Until Keyword Succeeds     900 sec     15 sec      Verify gNB is onAir
    Wait Until Keyword Succeeds     600 sec     15 sec      gnbru.Verify All Radio Units are Online    bts_id=${gnb_id}
    Wait Until Keyword Succeeds     600 sec     15 sec      gnbcell.Verify All Cells are OnAir    bts_id=${gnb_id}
    Run Keyword If          ${IS_ASIR_CONFIGURATION}        gnb_asir.Wait For Asir To Be Onair    bts_id=${gnb_id}
    Run Keyword If          ${IS_ASIR_CONFIGURATION}        Wait Until Keyword Succeeds     600 sec     15 sec
    ...                                                     gnb_asir.Verify All Antennas Are Enabled    bts_id=${gnb_id}
    Run Keyword If          ${IS_ASIR_CONFIGURATION}        Wait Until Keyword Succeeds     600 sec     15 sec
    ...                                                     gnb_asir.Verify Status Of All Asir Cells Is Operational
    ...                                                         bts_id=${gnb_id}

Restore gNB Configuration
    [Arguments]    ${gnb_id}=0
    BuiltIn.Log To Console    gNB is not in proper state: restoring gNB configuration after test
    Perform Full Commissioning on gNB
    ...                                 scf_file=${scf_local_path}
    ...                                 gnb_id=${gnb_id}

Perform Full Commissioning and Wait for onAir
    [Arguments]    ${prefix_tag}    ${custom_config}=${False}    ${asir_hub}=${False}
    ...            ${build_directory}=/tmp    ${remove_build}=${False}    ${update_timeout}=${600}    ${bts_id}=${0}
    ${Is_Cloud} =    taf.rfrl.utilities.tl_config.Is Testline of Cloud Type
    Run Keyword If    ${Is_Cloud}
    ...      Perform Full Commissioning on Cloud gNB    prefix_tag=${prefix_tag}    custom_config=${custom_config}
    ...                                               build_directory=${build_directory}    remove_build=${remove_build}
    ...  ELSE
    ...      Perform Full Commissioning on Classical gNB    prefix_tag=${prefix_tag}    custom_config=${custom_config}
    ...                                               build_directory=${build_directory}    remove_build=${remove_build}
    ...                                               update_timeout=${update_timeout}    bts_id=${bts_id}
    Run Keyword If    ${asir_hub}
    ...      Perform Full Commissioning on gNB ASIR hub     prefix_tag=${prefix_tag}
    Sleep    30    reason=Delay before checking if gNB is onAir - the HUB/BTS may not have restarted yet
    Wait for onAir on all DUs
    Wait Until Keyword Succeeds     900 sec     10 sec   gnbcell.Verify All Cells are OnAir
    Set Global Variable    ${current_config}    ${prefix_tag}

Verify Mandatory Configuration Params Enabled
    ${IS_ASIR_CONFIGURATION}   Get Variable Value  ${IS_ASIR_CONFIGURATION}
    Run Keyword And Ignore Error    common_verify_mandatory_configuration_for_all_gnbs
    Run Keyword If          ${IS_ASIR_CONFIGURATION}  gnb_asir.check_if_parallel_sessions_are_active
    Verify On-Air

Verify On-Air
    ${IS_ASIR_CONFIGURATION}    Get Variable Value   ${IS_ASIR_CONFIGURATION}
    Wait Until Keyword Succeeds     180 sec     10 sec   gnbru.Verify All Radio Units are Online
    Wait Until Keyword Succeeds     180 sec     10 sec   gnbcell.Verify All Cells are OnAir
    Verify gNB is onAir
    Run Keyword If       ${IS_ASIR_CONFIGURATION}     Wait Until Keyword Succeeds     180 sec     10 sec
    ...                                                 gnb_asir.verify_all_antennas_are_enabled
    Run Keyword If       ${IS_ASIR_CONFIGURATION}     Wait Until Keyword Succeeds     180 sec     10 sec
    ...                                                 gnb_asir.verify_status_of_all_asir_cells_is_operational

Check TRUCK ROLL alarms and Stop Execution If TRUCK ROLL alarms detected
    Check TRUCK ROLL alarms    skip_if_not_commissioned=${True}
    ${TRUCK_ROLL_ALARMS}   Get Variable Value  ${TRUCK_ROLL_ALARMS}
    Run Keyword and Ignore Error    Run Keyword If    ${TRUCK_ROLL_ALARMS}    Collect Mandatory Logs
