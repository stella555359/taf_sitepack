Library     taf.rfrl.procedures.resources.python.webui.webui                          WITH NAME  webui
Library     taf.rfrl.procedures.resources.python.rf_scan                              WITH NAME  rf_scan
Library     taf.rfrl.procedures.resources.python.config_operations.ConfigOperations   WITH NAME  config_operations
Library     taf.rfrl.procedures.resources.python.LogCollection                        WITH NAME  logs

*** Keywords ***
Create Input Data For RF Scan
    [Documentation]
    ...  Prepares the entry data for RF Scanning procedure. For every radio KW prepares a dictionary with capture type,
    ...  technology, local cell id, antenna, antenna panel info. Values for keys: 'radio', 'technology', 'local_cell',
    ...  'antenna',  'antenna panel' are taken from admin bts info. Values for key: 'capture_type' are taken from
    ...  argument - radio_supported_capture_types.
    [Arguments]                                         ${connection}
    ...                                                 ${radio_supported_capture_types}
    Robot Log Operation                                 Rf scan custom parameters not provided.
    Robot Log Operation                                 Preparing the entry data for RF Scanning procedure...
    ${rf_scan_input_data}=                              rf_scan.prepare_rf_scan_input_data
    ...                                                 connection=${connection}
    ...                                                 radio_supported_capture_types=${radio_supported_capture_types}
    Robot Log Operation                                 Prepared input data for RF Scan: ${rf_scan_input_data}
    [Return]                                            ${rf_scan_input_data}


Check If RF Scanning Is Not Available
    [Documentation]
    ...  Checks if starting RF Scanning procedure is not available.
    [Arguments]                                         ${rf_scan_parameters_dict}
    ...                                                 ${webui_obj}

    Robot Log Operation                                 Checking if starting RF Scan is not available...
    rf_scan.verify_rf_scan_unavailability               rf_scan_parameters_dict=${rf_scan_parameters_dict}
    ...                                                 webui_obj=${webui_obj}


Start RF Scanning And Validate Result File
    [Documentation]
    ...  Starts RF Scanning for given parameters and validates downloaded result file name.
    [Arguments]                                         ${rf_scan_parameters_dict}
    ...                                                 ${RF_Scan_path}
    ...                                                 ${RF_Scan_path_download}

    Robot Log Operation                                 Starting RF Scan with parameters...:
    Robot Log Operation                                 ${rf_scan_parameters_dict}
    Start RF Scanning And Download Result               rf_scan_parameters_dict=${rf_scan_parameters_dict}
    Validate Result File                                RF_Scan_path=${RF_Scan_path}
    ...                                                 RF_Scan_path_download=${RF_Scan_path_download}


Start RF Scanning And Download Result
    [Documentation]
    ...  Starts RF Scanning for given parameters and downloads result files.
    [Arguments]                                         ${rf_scan_parameters_dict}
    webui.start_rf_scan                                 technology=${rf_scan_parameters_dict}[technology]
    ...                                                 radio=${rf_scan_parameters_dict}[radio]
    ...                                                 capture_type=${rf_scan_parameters_dict}[capture_type]
    ...                                                 antenna=${rf_scan_parameters_dict}[antenna]
    ...                                                 antenna_panel=${rf_scan_parameters_dict}[antenna_panel]
    ...                                                 local_cell=${rf_scan_parameters_dict}[local_cell]
    webui.download_rf_scan_files


Validate Result File
    [Documentation]
    ...  Verifies name and size of downloaded RF Scan result file.
    ...  The name should begin with 'RFMonitoring' and the size should not be equal zero.
    [Arguments]                                         ${RF_Scan_path}
    ...                                                 ${RF_Scan_path_download}
    Robot Log Operation                                 Verifying name and size of downloaded RF Scan result file...
    rf_scan.verify_rf_scan_result_file                  rf_scan_path=${RF_Scan_path}
    ...                                                 rf_scan_path_download=${RF_Scan_path_download}


Get RF Scan Feature Parameter
    [Documentation]
    ...  Gets value of actRfiTesting parameter.
    ${param_value}=                                     config_operations.get_parameter_value
    ...                                                 dist_name=MRBTS-{}/MNL-1/MNLENT-1/FEATCADM-1
    ...                                                 param_name=actRfiTesting
    Robot Log Operation                                 Getting RF Scan parameter value actRfiTesting: ${param_value}
    [Return]                                            ${param_value}


Set RF Scan Feature Parameter To True/False
    [Documentation]
    ...  Sets value of actRfiTesting parameter.
    [Arguments]                                         ${param_value}
    config_operations.set_parameter_value               dist_name=MRBTS-{}/MNL-1/MNLENT-1/FEATCADM-1
    ...                                                 param_name=actRfiTesting
    ...                                                 param_value=${param_value}
    Robot Log Operation                                 Setting RF Scan parameter value actRfiTesting to ${param_value}


Create RF Scan Files Directory
    [Documentation]
    ...  Prepares directories for downloaded and checked RF Scan result files.
    [Arguments]                                         ${RF_Scan_path}
    ...                                                 ${RF_Scan_path_download}
    Robot Log Operation                                 Creating path for RF Scan files...
    ...                                                 ${RF_Scan_path}
    logs.create_dir_if_doesnt_exist                     dir_path=${RF_Scan_path}
    logs.create_dir_if_doesnt_exist                     dir_path=${RF_Scan_path_download}
