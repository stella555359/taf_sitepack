*** Settings ***
Library     OperatingSystem

Resource    ../../resources/robot/StatusCheck.robot
Resource    ../../resources/robot/HWPTA_Logger.robot
Resource    ../../resources/robot/BtsConfiguration.robot

Library     taf.rfrl.procedures.resources.python.simulator.airphone.Airphone            WITH NAME  simulator

*** Keywords ***
Achieve On Air on BTS with simulator
    [Arguments]  ${commission}
    ...          ${scf_file_path}
    ...          ${iphy_configs}
    ...          ${lua_file_path}
    ...          ${logs_path}
    ...          ${bts_type}

    Robot log operation                                   Starting simulator configuration...
    Configure simulator network interfaces
    ${vlan_id}=                                           hwpta_testline.get_vlan_id
    scf.set_vlan_id_in_scf                                scf_file=${scf_file_path}
    ...                                                   new_scf_file=${scf_file_path}
    ...                                                   new_vlan_id=${vlan_id}
    Run keyword if                                        ${iphy_configs}
    ...                                                   Upload Iphy Files
    ...                                                   iphy_configs=${iphy_configs}
    Run keyword if                                        ${commission} and '${scf_file_path}' != 'None'
    ...                                                   Commission
    ...                                                   scf_path=${scf_file_path}
    Run keyword if                                        '${lua_file_path}' != 'None'
    ...                                                   simulator.reach_onair
    ...                                                   lua_file_path=${lua_file_path}
    ...                                                   output_dir_path=${logs_path}
    Check BTS state and all RATs states                   bts_type=${bts_type}
    Alarms.Disallow alarms after simulator configuration

Upload Iphy Files
    [Arguments]  ${iphy_configs}

    FOR    ${config}    IN    @{iphy_configs}
            simulator.upload_iphy_file                    iphy_lmp_ip=${config['ip']}
            ...                                           remote_host=${config['remote_host']}
            ...                                           iphy_file_path=${config['iphy_file']}
    END

Configure simulator network interfaces
    Run and return rc and output  sudo ip addr add 10.0.1.131/24 dev eth3
    Run and return rc and output  sudo ip addr add 10.0.1.132/24 dev eth3
    Run and return rc and output  sudo ip addr add 10.0.1.133/24 dev eth3
    Run and return rc and output  sudo ip addr add 10.0.1.134/24 dev eth3
    Run and return rc and output  sudo ip addr add 10.0.1.135/24 dev eth3
    Run and return rc and output  sudo ip addr add 10.0.1.136/24 dev eth3
    Run and return rc and output  sudo ip addr add 10.0.1.99/24 dev eth3
    Run and return rc and output  sudo ip addr add 10.0.1.121/24 dev eth3
    Run and return rc and output  sudo ifconfig eth3:xn 10.0.1.101/24 up
    Run and return rc and output  sudo ifconfig eth3:ng 10.0.1.102/24 up
    Run and return rc and output  sudo ifconfig eth3:x2 10.0.1.3/24 up