Library     taf.rfrl.procedures.resources.python.rmod_operations.RmodOperations.RmodOperations    WITH NAME  rmod_ops

Resource    taf/rfrl/procedures/resources/robot/Alarms.robot
Resource    taf/rfrl/procedures/resources/robot/StatusCheck.robot
Resource    taf/rfrl/procedures/resources/robot/HWPTA_Logger.robot
Resource    taf/rfrl/procedures/resources/robot/LogCollection.robot


*** Keywords ***
Enable Fail Safe Mode and Reboot RMOD
    [Arguments]    ${rmod_id}
    ...            ${bts_type}
    ...            ${connection}

    Robot Log Step                                          Executing ResetControl action via FRMON on RMOD-${rmod_id}.
    ${action_create_result}                                 rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/ action create ResetControl /CI/ResetControl/module /module
    ...                                                     connection=${connection}
    Should Contain Any                                      ${action_create_result}
    ...                                                     done ok    Path already taken
    ...                                                     msg=ResetControl create action is not completed.
    Robot Log Result                                        ResetControl create action is completed.

    Robot Log Step                                          Enabling Fail Safe Mode via FRMON on RMOD-${rmod_id}.
    ${enable_fail_safe_mode_result}                         rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/CI/ResetControl/module action enable_fail_safe_mode
    ...                                                     connection=${connection}
    Should Contain                                          ${enable_fail_safe_mode_result}
    ...                                                     done ok
    ...                                                     msg=Enabling of Fail Safe Mode is not completed.
    Set test variable                                       ${is_fail_safe_mode_enabled}
    ...                                                     ${True}
    Robot Log Result                                        Enabling of Fail Safe Mode is completed.

    Alarms.Allow alarm                                      fault_id=2934
    ...                                                     bts_type=${bts_type}
    # Fault 1850 will not be gegenerated after CNI-113670 implementation
    Alarms.Allow alarm                                      fault_id=1850
    ...                                                     bts_type=${bts_type}

    Robot Log Operation                                     Performing reset of RMOD-${rmod_id} to activate fail safe mode feature...
    Priv Perform RMOD Reboot                                rmod_id=${rmod_id}
    ...                                                     bts_type=${bts_type}
    ...                                                     expected_rmod_status_after_reset=failed
    ...                                                     connection=${connection}

Disable Fail Safe Mode and Reboot RMOD
    [Arguments]    ${rmod_id}
    ...            ${bts_type}
    ...            ${connection}

    Robot Log Step                                          Executing ResetControl action via FRMON on RMOD-${rmod_id}.
    ${action_create_result}                                 rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/ action create ResetControl /CI/ResetControl/module /module
    ...                                                     connection=${connection}
    Should Contain Any                                      ${action_create_result}
    ...                                                     done ok    Path already taken
    ...                                                     msg=ResetControl create action is not completed.
    Robot Log Result                                        ResetControl create action is completed.

    Robot Log Step                                          Disabling Fail Safe Mode via FRMON on RMOD-${rmod_id}.
    ${disable_fail_safe_mode_result}                        rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/CI/ResetControl/module action disable_fail_safe_mode
    ...                                                     connection=${connection}
    Should Contain                                          ${disable_fail_safe_mode_result}
    ...                                                     done ok
    ...                                                     msg=Disabling of Fail Safe Mode is not completed.
    Set test variable                                       ${is_fail_safe_mode_enabled}
    ...                                                     ${False}
    Robot Log Result                                        Disabling of Fail Safe Mode is completed.

    Robot Log Operation                                     Performing reset of RMOD-${rmod_id} to deactivate fail safe mode feature...
    Priv Perform RMOD Reboot                                rmod_id=${rmod_id}
    ...                                                     bts_type=${bts_type}
    ...                                                     expected_rmod_status_after_reset=online
    ...                                                     connection=${connection}

    Alarms.Disallow alarm                                   fault_id=2934
    ...                                                     bts_type=${bts_type}
    # Fault 1850 will not be gegenerated after CNI-113670 implementation
    Alarms.Disallow alarm                                   fault_id=1850
    ...                                                     bts_type=${bts_type}

Check Fail Safe Mode Status on RMOD
    [Arguments]    ${rmod_id}
    ...            ${bts_type}
    ...            ${connection}
    Robot Log Step                                          Creating of action ResetControl via FRMON on RMOD-${rmod_id}.
    ${action_create_result}                                 rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/ action create ResetControl /CI/ResetControl/module /module
    ...                                                     connection=${connection}
    Should Contain Any                                      ${action_create_result}
    ...                                                     done ok    Path already taken
    ...                                                     msg=ResetControl create action is not completed.
    Robot Log Result                                        ResetControl create action is completed.

    Robot Log Step                                          Checking Fail Safe Mode status via FRMON on RMOD-${rmod_id}.
    ${check_fail_safe_mode_status_result}                   rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/CI/ResetControl/module get fail_safe_mode
    ...                                                     connection=${connection}
    Should Contain Any                                      ${check_fail_safe_mode_status_result}
    ...                                                     ENABLED    ACTIVE
    ...                                                     msg=Status of Fail Safe Mode is not ENABLED.
    Robot Log Result                                        Status of Fail Safe Mode is ENABLED.

    Alarms.Check if alarm is active                         fault_id=2934
    ...                                                     bts_type=${bts_type}

    status_check.verify_statuses_of_rmod
    ...                                                     rmod_id=${rmod_id}
    ...                                                     status_variant=failed
    ...                                                     connection=${connection}

Check if Fail Safe Mode Fault is Active in RMOD's Fault History Log
    [Arguments]      ${rmod_id}
    ...              ${connection}
    ...              ${fail_safe_mode_fault_name}=EFaultId_FailSafeMode (1462)
    ...              ${fault_history_log_path}=/ram/fault_history_log_temp.txt

    Robot Log Step                                          Checking if fault Fail Safe Mode is active in foult history log on RMOD-${rmod_id}.
    ${is_active_fault}                                      rmod_ops.check_if_fault_exists_in_faults_history_log_on_rmod
    ...                                                     rmod_id=${rmod_id}
    ...                                                     fault_type=Active faults
    ...                                                     expected_fault=${fail_safe_mode_fault_name}
    ...                                                     connection=${connection}
    ...                                                     fault_history_log_path=${fault_history_log_path}

    Should be true                                          ${is_active_fault}
    ...                                                     msg=Fail Safe Mode Fault not found in fault history log on RMOD-${rmod_id}.
    Robot Log Result                                        Fault Fail Safe Mode is active in foult history log on RMOD-${rmod_id}.


Fail Safe Mode Activation Teardown
    [Arguments]      ${is_fail_safe_mode_enabled}
    ...              ${rmod_id}
    ...              ${connection}
    ...              ${bts_type}

    Run keyword if                                          ${is_fail_safe_mode_enabled}
    ...                                                     Disable Fail Safe Mode and Reboot RMOD
    ...                                                     rmod_id=${rmod_id}
    ...                                                     bts_type=${bts_type}
    ...                                                     connection=${connection}

Priv Perform RMOD Reboot
    [Arguments]    ${rmod_id}
    ...            ${bts_type}
    ...            ${expected_rmod_status_after_reset}
    ...            ${connection}

    ${runtime_rmod_id}                                      admin_info_model.translate_rmod_index_to_runtime
    ...                                                     rmod_index=${rmod_id}
    ...                                                     connection=${connection}

    admin_info_model.reset_rmod                             connection=${connection}
    ...                                                     runtime_rmod_id=${runtime_rmod_id}

    Wait Until Keyword Succeeds                             3min
    ...                                                     10sec
    ...                                                     status_check.verify_statuses_of_rmod
    ...                                                     rmod_id=${rmod_id}
    ...                                                     status_variant=${expected_rmod_status_after_reset}
    ...                                                     connection=${connection}
