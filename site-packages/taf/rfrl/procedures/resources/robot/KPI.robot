Library     taf.sbts.oam.coam.admin                           WITH NAME   admin
Library     taf.ul.kpi_selector                               WITH NAME   kpi_selector

Library     taf.rfrl.procedures.resources.python.utilities     WITH NAME   utilities

Resource    HWPTA_Logger.robot


*** Keywords ***
Get Timeout Site Reset
    robot log operation                      Getting KPI for reset site
    ${kpi_reset_site}=                       kpi_selector.get_kpi
    ...                                      operation=site_reset
    ...                                      tl=${tl}
    robot log result                         ${kpi_reset_site}
    ...                                      to_console=${True}
    ${kpi_reset_site['Timeout']}=            Private Increase KPI Timeout
    ...                                      kpi_timeout=${kpi_reset_site['Timeout']}
    [Teardown]                               kpi_selector.close_connections
    [Return]                                 ${kpi_reset_site['Timeout']}

