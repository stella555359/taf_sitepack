Check statuses of cells from all chained RMODs
    [Arguments]                     ${runtime_id}
    ...                             ${bts_type}=GNB
    ...                             ${status_variant}=online

    ${connection}=                  connections.get_default_admin_connection_alias
    ...                             bts_type=${bts_type}
    ${dependent_rmods}              admin_info_model.get_dependent_rmods
    ...                             connection=${connection}
    ...                             runtime_rmod_id=${runtime_id}

    Robot Log Operation             Checking statuses for RMOD with runtime id ${runtime_id} and all chained RMODs if present...
    FOR  ${rmod}  IN  @{dependent_rmods}
        ${rmod_runtime_id}=                  Evaluate  int(str("""${rmod}""").split('-')[-1])
        ${translated_rmod_id}=               admin_info_model.translate_rmod_index_from_runtime
        ...                                  connection=${connection}
        ...                                  runtime_id=${rmod_runtime_id}
        wait until keyword succeeds          10min  20 sec
        ...                                  Check statuses of cells for RMOD
        ...                                  rmod_id=${translated_rmod_id}
        ...                                  status_variant=${status_variant}
        ...                                  connection=${connection}
        ...                                  bts_type=${bts_type}
    END

