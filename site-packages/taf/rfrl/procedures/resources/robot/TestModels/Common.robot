*** Keywords ***
Enter Test Dedicated State
    [Arguments]                                          ${download_dir}=/tmp/
    ${bts_type}=                                         hwpta_testline.get_type_of_setup
    ${connection}=                                       connections.get_default_admin_connection_alias
    ...                                                  bts_type=${bts_type}
    Create admin session with default alias              bts_type=${bts_type}
    Create Selenium Session                              admin_connection=${connection}
    ...                                                  bts_type=${bts_type}

    Robot Log Operation                                  Getting into Test Dedicated State
    Allow X2 Link Alarms

    ${bts_status}=                                       admin_info_model.get_bts_statuses
    ...                                                  connection=${connection}
    Run Keyword If                                       '${bts_status["proceduralState"]}'=='Test'
    ...                                                  Run Keywords
    ...                                                  Robot Log Warning   BTS procedural state is already Test.
    ...                                                  AND
    ...                                                  Return From Keyword

    Login To WebUI And Setup Conformance State           url=${url}
    ...                                                  download_dir=${download_dir}
    ...                                                  bts_type=${bts_type}
    Robot Log Result                                     Test Dedicated State has been reached.

    [Teardown]                                           Connections.Close Selenium Session

Enter Test Dedicated State And Start Pcap Collection During BTS Startup
    [Arguments]    ${pcap_remote_path}
    ...            ${pcap_filename}
    ...            ${selenium_download_dir}=/tmp/

    ${bts_type}=                                            hwpta_testline.get_type_of_setup
    ${connection}=                                          connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}

    Create admin session with default alias                 bts_type=${bts_type}
    Create Selenium Session                                 admin_connection=${connection}
    ...                                                     bts_type=${bts_type}

    Robot Log Operation                                     Getting into Test Dedicated State and Starting PCAP colllection during BTS startup...
    Allow X2 Link Alarms
    ${tcpdump_pid}      ${start_tcpdump_timestamp}          Private Setup TDS And Start Pcap Collection After BTS Startup
    ...                                                     pcap_remote_path=${pcap_remote_path}
    ...                                                     pcap_filename=${pcap_filename}
    ...                                                     url=${url}
    ...                                                     download_dir=${selenium_download_dir}
    ...                                                     connection=${connection}
    ...                                                     bts_type=${bts_type}
    Robot Log Operation                                     Test Dedicated State has been reached.

    [Return]                                                ${tcpdump_pid}      ${start_tcpdump_timestamp}

    [Teardown]                                              Connections.Close Selenium Session

Private Setup TDS And Start Pcap Collection After BTS Startup
    [Arguments]    ${pcap_remote_path}
    ...            ${pcap_filename}
    ...            ${url}
    ...            ${connection}
    ...            ${download_dir}=/tmp/
    ...            ${bts_type}=GNB

    webui.enable_test_dedicated_state

    Check If BTS Is Reachable                               bts_type=${bts_type}

    ${tcpdump_pid}                                          Start NODECPRT Pcap Collection
    ...                                                     remote_path=${pcap_remote_path}
    ...                                                     tcpdump_filename=${pcap_filename}
    ...                                                     bts_type=${bts_type}
    ${start_tcpdump_timestamp}                              Get Current Date
    ...                                                     result_format=%H:%M:%S.%f

    Private Wait for RMODs Online Status                    connection=${connection}
    Private Verify TDS Status on BTS                        connection=${connection}

    run keyword and ignore error                            webui.close_start_up_view_window

    [Return]                                                ${tcpdump_pid}      ${start_tcpdump_timestamp}

Private Wait for SMODs and BBMODs Online Status
    [Arguments]    ${connection}
    timer.wait_until_keyword_succeeds_timer                 10m
    ...                                                     20s
    ...                                                     status_check.verify_statuses_of_all_smods
    ...                                                     connection=${connection}
    ...                                                     status_variant=online
    Robot Log Result                                        Verification completed, all SMODs are in correct 'Online' status.
    timer.wait_until_keyword_succeeds_timer                 5m
    ...                                                     20s
    ...                                                     status_check.verify_statuses_of_all_bbmods
    ...                                                     connection=${connection}
    ...                                                     status_variant=online
    Robot Log Result                                        Verification completed, all BBMODs are in correct 'Online' status.

Private Verify TDS Status on BTS
    [Arguments]    ${connection}
    timer.wait_until_keyword_succeeds_timer                 60s
    ...                                                     5s
    ...                                                     status_check.verify_statuses_of_bts
    ...                                                     connection=${connection}
    ...                                                     status_variant=Test
    Robot Log Result                                        Verification completed, BTS is in correct Test state.

Login To WebUI And Setup Conformance State
    [Arguments]                                          ${url}
    ...                                                  ${download_dir}=/tmp/
    ...                                                  ${bts_type}=GNB

    webui.enable_test_dedicated_state
    megazone_client.Wait for site unavailability         url=${url}
    ...                                                  timeout=60
    ...                                                  interval=5
    timer.wait_until_keyword_succeeds_timer              10m
    ...                                                  20s
    ...                                                  Check BTS Test Dedicated State
    ...                                                  bts_type=${bts_type}
    run keyword and ignore error                         webui.close_start_up_view_window

Get Parameters To Setup Analyzer
    [Arguments]                                          ${cell_id}=1
    ...                                                  ${nrbts_id}=1
    ...                                                  ${local_dir_path_to_save_scf}=/tmp
    ...                                                  ${local_dir_path_to_load_scf}=/tmp/scf.xml
    ...                                                  ${file_name}=scf.xml
    ${bts_type}=                                         hwpta_testline.get_type_of_setup
    ${connection}=                                       connections.get_default_admin_connection_alias
    ...                                                  bts_type=${bts_type}
    Create admin session with default alias              bts_type=${bts_type}
    ${bts_id}=                                           hw_info.get_mrbts_id
    admin.get_current_scf_file                           local_dir_path=${local_dir_path_to_save_scf}
    ...                                                  file_name=${file_name}
    ...                                                  timeout=30s
    ...                                                  connection=${connection}
    taf_scf.load_scf                                     file_path=${local_dir_path_to_load_scf}
    ${channel_int_bandwidth}=                            Get Channel Integration Bandwidth
    ...                                                  bts_id=${bts_id}
    ...                                                  cell_id=${cell_id}
    ...                                                  nrbts_id=${nrbts_id}
    ${pmax}=                                             taf_scf.get_value_from_scf
    ...                                                  dist_name=MRBTS-${bts_id}/NRBTS-${nrbts_id}/NRCELL-${cell_id}
    ...                                                  p_name=pMax
    ${pmax}=            evaluate                         ${pmax} / ${10}
    ${signal_analyzer_config}                            tl_info.Get signal analyzer
    ...                                                  ${tl.gnbs[0].dus[0].rus[0]}
    [Return]  ${channel_int_bandwidth}  ${pmax}  ${signal_analyzer_config}

Get Channel Integration Bandwidth
    [Arguments]                                          ${bts_id}
    ...                                                  ${nrbts_id}=1
    ...                                                  ${cell_id}=1
    ...                                                  ${fdd_cell_id}=1
    ${is_tdd_radio}=                                     taf_scf.is_element_in_object
    ...                                                  dist_name=MRBTS-${bts_id}/NRBTS-${nrbts_id}/NRCELL-${cell_id}
    ...                                                  p_name=chBw
    ${channel_int_bandwidth}=  Run keyword if            ${is_tdd_radio}
    ...                                                  taf_scf.get_value_from_scf
    ...                                                  dist_name=MRBTS-${bts_id}/NRBTS-${nrbts_id}/NRCELL-${cell_id}
    ...                                                  p_name=chBw
    ...                                                  ELSE
    ...                                                  taf_scf.get_value_from_scf
    ...                         dist_name=MRBTS-${bts_id}/NRBTS-${nrbts_id}/NRCELL-${cell_id}/NRCELL_FDD-${fdd_cell_id}
    ...                                                  p_name=chBwDl
    ${channel_int_bandwidth}=  Get Substring             ${channel_int_bandwidth}    0    -3
    ${channel_int_bandwidth}=  convert to number         ${channel_int_bandwidth}
    [Return]  ${channel_int_bandwidth}

Setup And Configure Signal Analyzer
    [Arguments]                                          ${cell_id}
    ...                                                  ${connection}
    ...                                                  ${signal_analyzer_alias}=KeysightN9935A
    ...                                                  ${ext_gain}=-30

    ${nrbts_id}                                          admin_info_model.get_nrbts_id_admin
    ...                                                  connection=${connection}

    ${channel_int_bandwidth}  ${pmax}  ${signal_analyzer_config}
    ...                                                  Get Parameters To Setup Analyzer
    ...                                                  cell_id=${cell_id}
    ...                                                  nrbts_id=${nrbts_id}
    ${analyzer}=  Setup Keysight N9935A signal analyzer  alias=${signal_analyzer_alias}
    ...                                                  ip=${signal_analyzer_config.ip}
    ...                                                  channel_integrating_bandwidth=${channel_int_bandwidth}
    ...                                                  center_frequency=3.5
    ...                                                  external_gain=${ext_gain}
    [Return]  ${analyzer}  ${pmax}

Remove All Test Modules Result Files
