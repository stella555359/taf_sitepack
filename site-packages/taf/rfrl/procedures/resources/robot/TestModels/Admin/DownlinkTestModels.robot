LTE DL Test Model Activation Teardown
    [Arguments]  ${distname_realtime}
    ...          ${test_model}
    ...          ${connection}
    ...          ${timeout}=60
    ${active_tm}                                            tm_common_adm.get_active_tests
    ...                                                     connection=${connection}
    ...                                                     timeout=${timeout}
    Run keyword if        "${active_tm}"!="[]"              Run keyword and ignore error
    ...                                                     Stop LTE Downlink Test
    ...                                                     distname_realtime=${distname_realtime}
    ...                                                     test_model=${test_model}
    ...                                                     timeout=${timeout}
    ...                                                     connection=${connection}
    ...  ELSE                                               Return From Keyword
    ${active_tm}                                            tm_common_adm.get_active_tests
    ...                                                     connection=${connection}
    ...                                                     timeout=${timeout}
    Run keyword if        "${active_tm}"!="[]"              Perform Reset Site And Wait For OnAir


Start NR Downlink Test Model
    [Documentation]  Starts Downlink Test Model via Admin API.
    [Arguments]      ${connection}
    ...              ${cell_distname}
    ...              ${test_model}
    ...              ${phys_cell_id}
    ...              ${nrarfcn_dl}=${None}
    ...              ${power_backoff}=0
    ...              ${ru_mode}=NR_Only
    ...              ${mimo_rank}=1
    ...              ${codebook_2_antports}=0
    ...              ${vswr_monitoring}=False
    ...              ${nrarfcn_ul}=${None}
    ...              ${beam_pattern_id}=0
    ...              ${polarization}=P_plus45_or_0
    ...              ${pmax}=30
    ...              ${i11_codebook_4_antports}=0
    ...              ${i2_codebook_4_antports}=0
    ...              ${i13_codebook_4_antports}=0
    ...              ${timeout}=30

    ${beam_pattern_id}                                      tm_startup.prepare_beam_id_parameter
    ...                                                     ${beam_pattern_id}

    Robot Log Operation                                     Starting NR Downlink ${test_model} Test Model...
    ${start_test_result}                                    nr_conformance_adm.start_5g_downlink_test
    ...                                                     connection=${connection}
    ...                                                     distname_realtime=${cell_distname}
    ...                                                     test_model=${test_model.split("-")[-1].replace(".", "_").upper()}
    ...                                                     phys_cell_id=${phys_cell_id}
    ...                                                     beam_id=${beam_pattern_id}
    ...                                                     power_backoff=${power_backoff}
    ...                                                     polarization=${polarization}
    ...                                                     ru_mode=${ru_mode}
    ...                                                     codebook_2_antports=${codebook_2_antports}
    ...                                                     mimo_rank=${mimo_rank}
    ...                                                     nrarfcn_dl=${nrarfcn_dl}
    ...                                                     nrarfcn_ul=${nrarfcn_ul}
    ...                                                     vswr_monitoring=${vswr_monitoring}
    ...                                                     pmax=${pmax}
    ...                                                     i11_codebook_4_antports=${i11_codebook_4_antports}
    ...                                                     i2_codebook_4_antports=${i2_codebook_4_antports}
    ...                                                     i13_codebook_4_antports=${i13_codebook_4_antports}
    ...                                                     timeout=${timeout}

    Should Be Equal As Strings                              ${start_test_result['status']}    Succeeded
    ...                                                     msg=NR Downlink ${test_model} Test start failed: ${start_test_result['msg']}


Stop NR Downlink Test Model
    [Documentation]  Stops NR Downlink Test Model via admin API.
    [Arguments]      ${cell_distname}
    ...              ${connection}
    ...              ${test_model}
    ...              ${admin_test_name}
    ...              ${timeout}=30

    Robot Log Operation                                     Stopping NR Downlink ${test_model} Test Model...
    ${terminate_result}                                     nr_conformance_adm.stop_5g_downlink_test
    ...                                                     connection=${connection}
    ...                                                     distname_realtime=${cell_distname}
    ...                                                     timeout=${timeout}

    Should Be Equal As Strings                              ${terminate_result['status']}
    ...                                                     Succeeded
    ...                                                     msg=NR DL ${test_model} Test Model termination failed: ${terminate_result['msg']}
    Check If Test Model Is Active                           admin_test_name=${admin_test_name}
    ...                                                     connection=${connection}
    ...                                                     should_be_active=False


NR Downlink Test Model Teardown
    [Documentation]  Terminates NR Downlink Test Models and checks if any Test Model is active.
    [Arguments]      ${connection}
    ...              ${cell_r_distnames}
    ...              ${timeout}=60

    ${cell_r_distnames}                                     utilities.convert_to_list    ${cell_r_distnames}
    ${active_tests}                                         tm_common_adm.get_active_tests
    ...                                                     connection=${connection}
    IF    ${active_tests} != []
        FOR   ${runtime_distname}                           IN    @{cell_r_distnames}
            ${terminate_result}                             nr_conformance_adm.stop_5g_downlink_test
            ...                                             connection=${connection}
            ...                                             distname_realtime=${runtime_distname}
            ...                                             timeout=${timeout}
            Run Keyword And Ignore Error                    Should Be Equal As Strings
            ...                                             ${terminate_result['status']}
            ...                                             Succeeded
            ...                                             msg=NR DL Test Model termination failed for Cell ${runtime_distname}: ${terminate_result['msg']}
        END
    END
    Check If Any Test Model Is Active                       should_be_active=${False}
    ...                                                     connection=${connection}