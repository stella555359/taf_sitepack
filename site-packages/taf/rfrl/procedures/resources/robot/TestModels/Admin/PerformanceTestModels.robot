LTE PUSCH Performance Test Teardown
    [Arguments]  ${distname_realtime}
    ...          ${pusch_format}
    ...          ${connection}
    ...          ${timeout}=120
    ${active_tm}                                            tm_common_adm.get_active_tests
    ...                                                     connection=${connection}
    ...                                                     timeout=${timeout}
    Run keyword if        "${active_tm}"!="[]"              tm_lte_adm.stop_lte_pusch_performance_test
    ...                                                     distname_realtime=${distname_realtime}
    ...                                                     pusch_format=${pusch_format}
    ...                                                     timeout=${timeout}
    ...                                                     connection=${connection}
    ...  ELSE                                               Return From Keyword
    ${active_tm}                                            tm_common_adm.get_active_tests
    ...                                                     connection=${connection}
    ...                                                     timeout=${timeout}
    Run keyword if        "${active_tm}"!="[]"              Perform Reset Site And Wait For OnAir

