*** Settings ***
Documentation
...   author: Marta Koc
...   contact: I_5G_SISO_CRT_GMS <I_5G_SISO_CRT@internal.nsn.com>

Library     taf.sbts.oam.coam.admin                                                   WITH NAME  admin

Library     taf.rfrl.procedures.resources.python.webui.webui                          WITH NAME  webui
Library     taf.rfrl.procedures.resources.python.rf_diagnostic                        WITH NAME  rf_diagnostic
Library     taf.rfrl.procedures.resources.python.admin_info_model.admin_info_model    WITH NAME  admin_info_model

Resource    taf/rfrl/procedures/resources/robot/HWPTA_Logger.robot

*** Keywords ***
Configure Statistics Diagnostic Test
    Robot Log Operation                                     Configuring statistics diagnostic test...
    webui.configure_statistics_diagnostic_test


Start Statistics Diagnostic Test
    Robot Log Operation                                     Starting statistics diagnostic test...
    webui.start_statistics_diagnostic_test


Get Statistics Test Information
    [Arguments]                                             ${rmod_id}
    ${statistics_result}                                    webui.get_statistics_general_test_information
    ...                                                     radio_id=RMOD-${rmod_id}
    Robot Log Result                                        RMOD-${rmod_id} Statistics general result: ${statistics_result}
    ...                                                     console=${True}

    ${temperature_result}                                   webui.get_rf_temperature_supervision
    ...                                                     radio_id=RMOD-${rmod_id}
    Robot Log Result                                        RMOD-${rmod_id} Statistics temperature result: ${temperature_result}
    ...                                                     console=${True}

    ${ethernet_packet_result}                               webui.get_rf_ethernet_packet_monitoring
    ...                                                     radio_id=RMOD-${rmod_id}
    Robot Log Result                                        RMOD-${rmod_id} Statistics ethernet packet monitoring result: ${ethernet_packet_result}
    ...                                                     console=${True}
    &{rmod_statistics_result}=      Create Dictionary       general_result=${statistics_result}
    ...                                                     temperature_result=${temperature_result}
    ...                                                     ethernet_packet_result=${ethernet_packet_result}
    [Return]  ${rmod_statistics_result}


Validate Statistics Test Result
    [Arguments]                                             ${rmod_statistics_result}
    ...                                                     ${rmod_id}
    ...                                                     ${rmods_protocol}
    Robot Log Result                                        ${rmod_statistics_result}
    rf_diagnostic.validate_statistics_result                rmod_statistics_result=${rmod_statistics_result}
    ...                                                     rmod_id=${rmod_id}
    ...                                                     rmods_protocol=${rmods_protocol}


Configure RF Diagnostic Test
    [Arguments]                                             ${cell_id}
    ...                                                     ${cell_type}
    ...                                                     ${custom_cell_name}

    ${cell_name}=                                           Run Keyword if      """${custom_cell_name}"""!='None'
    ...                                                     Set variable
    ...                                                     ${custom_cell_name}
    ...                                                     ELSE
    ...                                                     rf_diagnostic.get_cellname_for_diagnostic_test
    ...                                                     cell_id=${cell_id}
    ...                                                     cell_type=${cell_type}

    ${cell_type}=                                           Convert To Uppercase        ${cell_type}

    Robot Log Operation                                     Configuring RF Diagnostic Test...
    webui.configure_rf_diagnostic_test                      cell=${cell_name}
    ...                                                     technology=${cell_type}
    ...                                                     timeout=30


Configure RF Diagnostic Test For All Cells Of Type
    [Arguments]                                             ${cell_type}
    ${cell_type}=                                           Convert To Uppercase        ${cell_type}

    Robot Log Operation                                     Configuring RF Diagnostic Test for all cells...
    webui.configure_rf_diagnostic_test                      cell=All cells
    ...                                                     technology=${cell_type}
    ...                                                     timeout=30


Start RF Diagnostic Test
    Robot Log Operation                                     Starting RF Diagnostic Test...
    webui.start_rf_diagnostic_test                          timeout=180
    Robot Log Result                                        RF Diagnostic Test is done.
    sleep                                                   10s
    ...                                                     reason=Waiting for diagnostic test results to be available


Get RF Diagnostic General Result
    [Arguments]                                             ${cell_id}
    Robot Log Operation                                     Collecting RF Diagnostic General Test result...
    ${diagnostic_general_result}                            webui.get_general_test_information
    ...                                                     cell_id=${cell_id}
    Should Not Be Empty                                     ${diagnostic_general_result}
    ...                                                     msg= There is empty list of rf diagnostic result (RFRES parameters). Cannot validate RFRES result.
    Robot Log Operation                                     General Test result for CELL-${cell_id}: ${diagnostic_general_result}
    [Return]  ${diagnostic_general_result}


Get RF Diagnostic Detailed Result
    [Arguments]                                             ${cell_id}
    Robot Log Operation                                     Collecting RF Diagnostic Detailed Test result...
    ${diagnostic_detailed_result}                           webui.get_detailed_result_for_each_antenna
    ...                                                     cell_id=${cell_id}
    Should Not Be Empty                                     ${diagnostic_detailed_result}
    ...                                                     msg= There is empty list of rf diagnostic result (RFRES parameters). Cannot validate RFRES result.
    Robot Log Operation                                     Detailed Test result for CELL-${cell_id}: ${diagnostic_detailed_result}
    [Return]  ${diagnostic_detailed_result}


Get RF Diagnostic Rfres Result
    [Arguments]                                             ${cell_id}
    ...                                                     ${connection}
    Robot Log Operation                                     Collecting RF Diagnostic Test result from RFRES instance...
    ${diagnostic_rfres_result}                              admin.get_managed_objects
    ...                                                     class_name=RFRES_R
    ...                                                     timeout=180
    ...                                                     connection=${connection}
    Should Not Be Empty                                     ${diagnostic_rfres_result}
    ...                                                     msg= There is empty list of rf diagnostic result (RFRES parameters). Cannot validate RFRES result.
    [Return]  ${diagnostic_rfres_result}


Clear RF Diagnostic Test results
    Robot Log Operation                                     Clearing finished RF Diagnostic Test results...
    webui.clear_finished_results
    Robot Log Result                                        RF Diagnostic Test results removed.


Validate RF Diagnostic General Result
    [Arguments]                                             ${diagnostic_general_result}
    Robot Log Operation                                     Validating RF Diagnostic general result...
    rf_diagnostic.validate_rf_diagnostic_general_result     general_result=${diagnostic_general_result}


Validate RF Diagnostic Detailed Result
    [Arguments]                                             ${diagnostic_detailed_result}
    ...                                                     ${cell_type}
    Robot Log Operation                                     Validating RF Diagnostic detailed result...
    rf_diagnostic.validate_rf_diagnostic_detailed_result
    ...                                                     detailed_result=${diagnostic_detailed_result}
    ...                                                     cell_type=${cell_type}


Validate RF Diagnostic Rfres General Result
    [Arguments]                                             ${diagnostic_rfres_result}
    Robot Log Operation                                     Validating RF Diagnostic Rfres object general result...
    rf_diagnostic.validate_rf_diagnostic_rfres_general_result
    ...                                                     rfres_result=${diagnostic_rfres_result}


Validate RF Diagnostic Rfres Detailed Result
    [Arguments]                                             ${diagnostic_rfres_result}
    ...                                                     ${antenna_name}
    Robot Log Operation                                     Validating RF Diagnostic Rfres object detailed result...
    rf_diagnostic.validate_rf_diagnostic_rfres_detailed_result
    ...                                                     rfres_result=${diagnostic_rfres_result}
    ...                                                     antenna_name=${antenna_name}


Get Cell Ids For Specific Rat
    [Arguments]                                             ${connection}
    ...                                                     ${cell_type}
    ${cell_ids}=                                            admin_info_model.get_cell_ids_from_specific_rat
    ...                                                     connection=${connection}
    ...                                                     cell_type=${cell_type}
    [Return]  ${cell_ids}


Get RF Diagnostic Rfres Result For Specific Cell
    [Arguments]                                             ${diagnostic_rfres_result}
    ...                                                     ${cell_id}
    ${rf_diag_cell_result}=                                 rf_diagnostic.get_rf_diag_rfres_cell_result
    ...                                                     rfres_results=${diagnostic_rfres_result}
    ...                                                     cell_id=${cell_id}
    Should Not Be Empty                                     ${rf_diag_cell_result}
    ...                                                     msg= There is empty list of rf diagnostic result (RFRES parameters). Cannot validate RFRES result.
    Robot Log Operation                                     RFRES Instance Test result for CELL-${cell_id}: ${rf_diag_cell_result}
    [Return]  ${rf_diag_cell_result}


Get And Validate RF Diagnostic Result For Specific Cell
    [Arguments]                                             ${cell_id}
    ...                                                     ${cell_type}
    ...                                                     ${connection}
    ${diagnostic_general_result}=                           Get RF Diagnostic General Result
    ...                                                     cell_id=${cell_id}
    ${diagnostic_detailed_result}=                          Get RF Diagnostic Detailed Result
    ...                                                     cell_id=${cell_id}
    ${diagnostic_rfres_result}=                             Get RF Diagnostic Rfres Result
    ...                                                     connection=${connection}
    ...                                                     cell_id=${cell_id}
    ${diagnostic_rfres_result}=                             Get RF Diagnostic Rfres Result For Specific Cell
    ...                                                     diagnostic_rfres_result=${diagnostic_rfres_result}
    ...                                                     cell_id=${cell_id}

    Validate RF Diagnostic General Result                   diagnostic_general_result=${diagnostic_general_result}
    Validate RF Diagnostic Detailed Result                  diagnostic_detailed_result=${diagnostic_detailed_result}
    ...                                                     cell_type=${cell_type}
    Validate RF Diagnostic Rfres General Result             diagnostic_rfres_result=${diagnostic_rfres_result}

    ${diag_result}=                                         Get From List    ${diagnostic_detailed_result}     0
    ${antenna_name}=             Get From Dictionary        ${diag_result}     Antenna/Port
    Validate RF Diagnostic Rfres Detailed Result            diagnostic_rfres_result=${diagnostic_rfres_result}
    ...                                                     antenna_name=${antenna_name}


Get And Validate RF Diagnostic Result For All Of The Cells From RAT
    [Arguments]                                             ${cell_type}
    ...                                                     ${connection}
    ${cell_ids}=                                            Get Cell Ids For Specific Rat
    ...                                                     connection=${connection}
    ...                                                     cell_type=${cell_type}

    FOR    ${cell_id}    IN    @{cell_ids}
        Robot Log Operation                                 Getting CELL-${cell_id} results for diagnostic test...
        ${cell_id}=                                         Convert To String       ${cell_id}
        ${diagnostic_general_result}=                       Get RF Diagnostic General Result
        ...                                                 cell_id=${cell_id}
        ${diagnostic_detailed_result}=                      Get RF Diagnostic Detailed Result
        ...                                                 cell_id=${cell_id}
        ${diagnostic_rfres_result}=                         Get RF Diagnostic Rfres Result
        ...                                                 connection=${connection}
        ...                                                 cell_id=${cell_id}
        ${diagnostic_rfres_result}=                         Get RF Diagnostic Rfres Result For Specific Cell
        ...                                                 diagnostic_rfres_result=${diagnostic_rfres_result}
        ...                                                 cell_id=${cell_id}

        Robot Log Operation                                 Validating CELL-${cell_id} RF Diagnostic result...
        Validate RF Diagnostic General Result               diagnostic_general_result=${diagnostic_general_result}
        Validate RF Diagnostic Detailed Result              diagnostic_detailed_result=${diagnostic_detailed_result}
        ...                                                 cell_type=${cell_type}
        Validate RF Diagnostic Rfres General Result         diagnostic_rfres_result=${diagnostic_rfres_result}

        ${diag_result}=                                     Get From List    ${diagnostic_detailed_result}     0
        ${antenna_name}=             Get From Dictionary    ${diag_result}     Antenna/Port
        Validate RF Diagnostic Rfres Detailed Result        diagnostic_rfres_result=${diagnostic_rfres_result}
        ...                                                 antenna_name=${antenna_name}
    END
