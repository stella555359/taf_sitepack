Library     Collections

Library     taf.rfrl.procedures.resources.python.config_operations.ConfigOperations     WITH NAME   config_operations
Library     ../../resources/python/admin_info_model/admin_info_model.py                 WITH NAME   admin_info_model
Library     ../../resources/python/utilities.py                                         WITH NAME   utilities
Library     ../../resources/python/status_check/status_check.py                         WITH NAME  status_check

Resource    HWPTA_Logger.robot
Resource    Recovery.robot


*** Keywords ***
Compare Cells Distnames From Dicts
    [Arguments]                                                 ${initial_nrarfcns}
    ...                                                         ${band_mode_changing_nrarfcns}

    ${initial_nrarfcns_cells}                                   Get Dictionary Keys
    ...                                                         ${initial_nrarfcns}
    ${changing_nrarfcns_cells}                                  Get Dictionary Keys
    ...                                                         ${band_mode_changing_nrarfcns}
    Lists Should Be Equal                                       ${initial_nrarfcns_cells}   ${changing_nrarfcns_cells}
    ...                                                         ignore_order=${True}
    ...                                                         msg=Different cells in provided dictionaries: ${initial_nrarfcns_cells} != ${changing_nrarfcns_cells}!

Get Rmod Id For Cells
    [Arguments]                                                 ${cells_distnames_list}
    ...                                                         ${connection}

    @{rmods_ids_for_cells}                                      Create List
    FOR  ${cell_distname}  IN  @{cells_distnames_list}
         ${cell_id}                                             Evaluate  int(str("""${cell_distname}""").split('-')[-1])
         ${rmod_id}                                             admin_info_model.get_rmod_ids_for_cell_id
         ...                                                    cell_id=${cell_id}
         ...                                                    connection=${connection}
         ...                                                    rmod_distname_type=configuration
         Append To List                                         ${rmods_ids_for_cells}     ${rmod_id}
    END

    ${list_of_rmods_ids}                                        utilities.remove_duplicates_and_preserve_order
    ...                                                         items=${rmods_ids_for_cells}
    ${len_of_rmods_ids_list}=                                   Get Length    ${list_of_rmods_ids}
    Should Be Equal As Integers                                 ${len_of_rmods_ids_list}    1
    ...                                                         msg=Cells are assigned to different radios!
    [Return]                                                    ${list_of_rmods_ids[0]}

Get Previous ActBandModeSwitch Value
      [Arguments]                                               ${dist_name}
      ...                                                       ${connection}
      Robot Log Operation                                       Getting actBandModeSwitch value...
      config_operations.connect                                 alias=${connection}
      ${previous_actBandModeSwitch_value}                       config_operations.get_parameter_value
      ...                                                       dist_name=${dist_name}
      ...                                                       param_name=actBandModeSwitch
      [Return]                                                  ${previous_actBandModeSwitch_value}

Get Previous Nrarfcn Value
      [Arguments]                                               ${cells_distnames_list}
      ...                                                       ${connection}

      &{previous_nrarfcn_values}                                Create Dictionary
      FOR  ${dist_name}  IN  @{cells_distnames_list}
         Robot Log Operation                                    Getting nrarfcn value for cell ${dist_name}...
         config_operations.connect                              alias=${connection}
         ${nrarfcn_value}                                       config_operations.get_parameter_value
         ...                                                    dist_name=${dist_name}
         ...                                                    param_name=nrarfcn
         Set To Dictionary                                      ${previous_nrarfcn_values}    ${dist_name}=${nrarfcn_value}
      END
      [Return]                                                  ${previous_nrarfcn_values}

Set Nrarfcn Value For Cells
    [Arguments]                                                 ${cells_nrarfcns_values}
    ...                                                         ${connection}

    FOR  ${cell_distname}  ${nrarfcn_value}  IN ZIP  ${cells_nrarfcns_values.keys()}  ${cells_nrarfcns_values.values()}
        Robot Log Operation                                     Setting nrarfcn parameter for cell: ${cell_distname}...
        config_operations.connect                               alias=${connection}
        Wait Until Keyword Succeeds                             2min  5s
        ...                                                     config_operations.set_parameter_value
        ...                                                     dist_name=${cell_distname}
        ...                                                     param_name=nrarfcn
        ...                                                     param_value=${nrarfcn_value}
    END

Set ActBandModeSwitch For RMOD
    [Arguments]                                                 ${rmod_config_distname}
    ...                                                         ${connection}
    ...                                                         ${param_value}

    Robot Log Operation                                         Setting actBandModeSwitch value for RU: ${rmod_config_distname}
    config_operations.connect                                   alias=${connection}
    Wait Until Keyword Succeeds                                 2min  5s
    ...                                                         config_operations.set_parameter_value
    ...                                                         dist_name=${rmod_config_distname}
    ...                                                         param_name=actBandModeSwitch
    ...                                                         param_value=${param_value}
    
Check Band Rmod Operation Mode
    [Arguments]                                                 ${rmod_runtime_distname}
    ...                                                         ${expected_band_rmod_mode}
    ...                                                         ${connection}

    Robot Log Operation                                         Checking bandRadioOperationModeIndicator value for RU: ${rmod_runtime_distname}
    config_operations.connect                                   alias=${connection}
    ${band_rmod_mode}                                           config_operations.get_parameter_value
    ...                                                         dist_name=${rmod_runtime_distname}
    ...                                                         param_name=bandRadioOperationModeIndicator
    Should Be Equal As Strings                                  ${band_rmod_mode}   ${expected_band_rmod_mode}
    ...                                                         msg=bandRadioOperationMode value for RU ${rmod_runtime_distname} different than expected: ${band_rmod_mode} != ${expected_band_rmod_mode}.

Wait For RMOD Reset And Check Status
    [Arguments]                                                 ${rmod_id}
    ...                                                         ${connection}
    ...                                                         ${radio_status_variant}=online

    Wait for Radio autonomous reset Action                      rmod_id=${rmod_id}
    ...                                                         connection=${connection}

    Robot Log Operation                                         Waiting for radio startup after autonomous reset and checking RMOD status.

    Wait Until Keyword Succeeds                                 300s
    ...                                                         30s
    ...                                                         status_check.verify_statuses_of_rmod
    ...                                                         rmod_id=${rmod_id}
    ...                                                         status_variant=${radio_status_variant}
    ...                                                         connection=${connection}

    Robot Log Result                                            RMOD-${rmod_id} recovery action is succeeded.