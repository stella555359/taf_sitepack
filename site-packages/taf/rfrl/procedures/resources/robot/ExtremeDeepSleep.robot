Check if RU stays in EDSM after specific time
        [Arguments]                                     ${rmod_config_distname}
        ...                                             ${config_rmod_id}
        ...                                             ${bts_type}
        ...                                             ${connection}
        ...                                             ${scheduled_time}=10min
        ${current_datetime}=                            Get Current Date
        wait.wait_until_specific_time_passed            start=${current_datetime}
        ...                                             time=${scheduled_time}
        Check operational state of cells for RU         operational_state=disabled
        ...                                             bts_type=${bts_type}
        ...                                             connection=${connection}
        ...                                             config_rmod_id=${config_rmod_id}
        Check EnergySaving Parameter                    rmod_config_distname=${rmod_config_distname}
        ...                                             expected_energy_saving=DEEPSLEEP_EXTREME_SFP
        ...                                             expected_power_state=SLEEP_EXTREME

Check if RU in EDSM is not reachable via LMI board
        [Arguments]                                     ${config_rmod_id}
        ...                                             ${connection}
        ...                                             ${custom_rmod_setup_yaml_path}=${None}
        ${edsm_ru_log_dir}=                             Set variable    ${logs_path}/EDSM_RU_${config_rmod_id}_logs
        logs.create_dir_if_doesnt_exist                 dir_path=${edsm_ru_log_dir}
        ${ru_serial_number}=                            admin_info_model.get_serial_number_for_rmod
        ...                                             rmod_id=${config_rmod_id}
        ...                                             connection=${connection}
        ${ru_config}                                    hwpta_testline.get_rmod_config_by_serial_number
        ...                                             ru_serial_number=${ru_serial_number}
        ${is_connection_impossible}=                    lmi.confirm_serial_console_connection_is_not_possible_in_edsm_state
        ...                                             logs_path=${edsm_ru_log_dir}
        ...                                             init_radio_id=${config_rmod_id}
        ...                                             ru_config=${ru_config}
        ...                                             number_of_retries=3
        ...                                             custom_rmod_setup_yaml_path=${custom_rmod_setup_yaml_path}
        Should Be True                                  condition=${is_connection_impossible}
        ...                                             msg=RU ${config_rmod_id} in EDSM State should not be reachable via LMI board.

        Robot Log Result                                RU ${config_rmod_id} in EDSM State is not reachable via LMI board.

Exit EDSM via Radio Autonomus Reset
        [Arguments]                                     ${config_rmod_id}
        ...                                             ${connection}
        ...                                             ${cells_status_variant}=online
        Alarms.Allow alarm                              fault_id=7101
        ...                                             fault_name=BTS site autonomous reset as recovery action
        Wait for Radio autonomous reset Action          rmod_id=${config_rmod_id}
        ...                                             connection=${connection}
        Check status of RMOD and cells during RMOD startup after recovery action
        ...                                             rmod_id=${config_rmod_id}
        ...                                             connection=${connection}
        ...                                             cells_status_variant=${cells_status_variant}
        ...                                             rmod_startup_time=300
        Alarms.Disallow alarm                           fault_id=7101
        ...                                             fault_name=BTS site autonomous reset as recovery action

Set EDSM Timer
        ${current_time}=                                Get Current Date
        Set Global Variable                             ${EDSM_TIMER}              ${current_time}
        Robot Log Operation                             EDSM timer set to: ${current_time}

Wait For EDSM Timer If Needed
        ${timer_exists}=                                Run Keyword And Return Status
        ...                                             Variable Should Exist      ${EDSM_TIMER}
    
        Run Keyword If                                  ${timer_exists}
        ...                                             Priv Wait For EDSM Timer Delay

Priv Get Cell Status Variant
        [Arguments]                                     ${cell_disable_method}
        IF  ${cell_disable_method}=='block'
            ${cells_status_variant}   Set Variable      blocked
        ELSE IF  ${cell_disable_method}=='lock'
            ${cells_status_variant}   Set Variable      locked
        END
        [Return]                                        ${cells_status_variant}

Priv Wait For EDSM Timer Delay   
        ${current_time}=                                Get Current Date
        ${time_diff}=                                   Subtract Date From Date    ${current_time}    ${EDSM_TIMER}    
        ${two_hours_in_seconds}=                        Evaluate                   2 * 60 * 60
        ${remaining_time}=                              Evaluate                   ${two_hours_in_seconds} - ${time_diff}
    
        IF                                              ${remaining_time} > 0                                 
            Sleep                                       ${remaining_time}s
            ...                                         EDSM Delay
            Robot Log Operation                         Waiting ${remaining_time} seconds for 2-hour EDSM delay...
        ELSE
            Robot Log Operation                         2-hour EDSM delay already passed, continuing...
        END
