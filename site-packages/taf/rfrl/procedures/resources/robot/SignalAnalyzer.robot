Library    taf.hw.signal_analyzer
Library    taf.rfrl.procedures.resources.python.sign_analyzer    WITH NAME  sign_analyzer


*** Keywords ***
Setup Keysight N9935A signal analyzer
    [Arguments]                                          ${alias}
    ...                                                  ${ip}
    ...                                                  ${channel_integrating_bandwidth}
    ...                                                  ${center_frequency}
    ...                                                  ${external_gain}
    ${Analyzer}=  Create Keysight N9935A signal analyzer
    ...                                                  ${alias}
    ...                                                  ${ip}
    Configure Keysight N9935A signal analyzer            ${alias}
    ...                                                  ${channel_integrating_bandwidth}
    ...                                                  ${center_frequency}
    ...                                                  ${external_gain}
    [Return]                                             ${Analyzer}

Create Keysight N9935A signal analyzer
    [Arguments]                                          ${alias}
    ...                                                  ${ip}
    ${analyzer_object}=                                  Setup signal analyzer
    ...                                                  alias=${alias}
    ...                                                  model=KeysightN9935A
    ...                                                  ip=${ip}
    ...                                                  unlock_timeout=${600}
    [Return]                                             ${analyzer_object}

Configure Keysight N9935A signal analyzer
    [Arguments]                                          ${alias}
    ...                                                  ${channel_integrating_bandwidth}
    ...                                                  ${center_frequency}
    ...                                                  ${external_gain}
    Set mode                                             alias=${alias}
    ...                                                  mode=SA
    Set channel power measurement                        alias=${alias}
    Set channel integrating bandwidth                    alias=${alias}
    ...                                                  frequency=${channel_integrating_bandwidth}
    ...                                                  unit=MHz
    Set center frequency                                 alias=${alias}
    ...                                                  frequency=${center_frequency}
    ...                                                  unit=GHz
    Set frequency span                                   alias=${alias}
    ...                                                  frequency=300
    ...                                                  unit=MHz
    Set resolution bandwidth                             alias=${alias}
    ...                                                  frequency=1
    ...                                                  unit=MHz
    Set video bandwidth                                  alias=${alias}
    ...                                                  frequency=1
    ...                                                  unit=MHz
    Set sweep acquisition                                alias=${alias}
    ...                                                  acquisition=200
    Set sweep points                                     alias=${alias}
    ...                                                  points=401
    Set external gain                                    alias=${alias}
    ...                                                  power_level=${external_gain}
    Set attenuation                                      alias=${alias}
    ...                                                  power_level=0

Unlock signal analyzer
    [Arguments]                                          ${analyzer}=${None}
    sign_analyzer.unlock_sa                              analyzer=${analyzer}
