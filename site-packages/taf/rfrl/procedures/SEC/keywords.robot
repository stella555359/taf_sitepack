Check If Fingerprint Is Stored
    [Arguments]         ${issuer}
    [Documentation]     This keyword checks if fingerprint is stored
    ${cert_list}=       Get Certificates List    cert_type=TA
    Log                 ${cert_list}             console=${TRUE}
    FOR  ${list}  IN  @{cert_list}
        Log                        ${list}                                 console=${TRUE}
        ${fingerprint}=            Set Variable                            ${list}[fingerPrint]
        Return From Keyword If    '${list}[issuer]'=='${issuer}'           ${fingerprint}
    END

Check ECDSA And RSA Synchronization By SSH
    [Documentation]     This keyword checks certificates RSA and ECDSA synchronization between active/passive partition
    ${connection}=      Connect To BTS With SSH
    ${active_ecdsa}=    Execute
    ...  openssl x509 -in /rom/trs_data/active/keystorage/certs/ec_cert.pem -text | grep "Serial Number:" -A1
    ...                 connection=${connection}
    ${active_rsa}=      Execute
    ...  openssl x509 -in /rom/trs_data/active/keystorage/certs/cert.pem -text | grep "Serial Number:" -A1
    ...                 connection=${connection}
    Log                 Active ECDSA: ${active_ecdsa}     console=${TRUE}
    Log                 Active RSA: ${active_rsa}         console=${TRUE}
    ${output}=          Execute
    ...  encfs --public --crakey "/etc/keys.d/private/sok.crk&enc.crk" ${CERTIFICATE_SYNC_PATHS} -o nonempty,allow_other
    ...                 connection=${connection}
    ${passive_ecdsa}=   Execute
    ...  openssl x509 -in /ffs/stb/trs_data/active/keystorage/certs/ec_cert.pem -text | grep "Serial Number:" -A1
    ...                 connection=${connection}
    ${passive_rsa}=     Execute
    ...  openssl x509 -in /ffs/stb/trs_data/active/keystorage/certs/cert.pem -text | grep "Serial Number:" -A1
    ...                 connection=${connection}
    Log                 Passive ECDSA: ${passive_ecdsa}    console=${TRUE}
    Log                 Passive RSA: ${passive_rsa}        console=${TRUE}
    Should Be Equal As Strings       ${active_ecdsa}       ${passive_ecdsa}
    Should Be Equal As Strings       ${active_rsa}         ${passive_rsa}
    [Teardown]          Disconnect From BTS With SSH

Get Available BSH Sessions
    ${connection}=  Connect To BTS With SSH
    ${available_bsh_sessions}=  Create List
    FOR  ${bsh_session}  IN  ${BSH_SESSIONS}
    	${console_output}=   ssh.Execute  command=bsh ${bsh_session} echo ping_test
        ...                               connection=${connection}
        ${status}=  Run Keyword And Return Status  Should Contain   ${console_output}  ping_test
        Run Keyword If  ${status}==${TRUE}  Evaluate  ${available_bsh_sessions}.append(${bsh_session})
    END
    [Return]  ${available_bsh_sessions}
    [Teardown]    Disconnect From BTS With SSH  ${connection}

