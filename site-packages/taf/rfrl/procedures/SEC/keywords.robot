*** Settings ***
Resource    ./variables.robot
Library     taf.transport.ssh          WITH NAME   ssh
Library     taf.sbts.oam.coam.admin    WITH NAME   coam_admin
Library     taf.config.scf             WITH NAME   scf
Library     resources/python/common_operations.py
Library     resources/python/certificate_operations.py
Library     OperatingSystem

*** Keywords ***
Connect To Admin
    [Arguments]       ${ip_address}=${LMP_IP}          ${alias}=admin
    ...               ${username}=${WEBEM_USERNAME}    ${password}=${WEBEM_PASSWORD}
    ${connection}=    coam_admin.connect_to
    ...               bts_host=${ip_address}
    ...               username=${username}
    ...               password=${password}
    ...               name=${alias}
    [Return]          ${connection}

Disconnect From Admin
    [Arguments]       ${connection}=admin
    coam_admin.teardown    connection=${connection}

Connect To BTS With SSH
    [Documentation]   SSH connection to BTS, by default with BTS LMP IP address.
    [Arguments]       ${ip_address}=${LMP_IP}         ${username}=${ROOT_USERNAME}
    ...               ${password}=${ROOT_PASSWORD}    ${port}=22
    ...               ${key_path}=None                ${alias}=cOAM_toor4nsn
    ${connection}=    ssh.connect_to    ${ip_address}
    ...                                 ${username}
    ...                                 ${password}
    ...                                 port=${port}
    ...                                 key_path=${key_path}
    ...                                 alias=${alias}
    Log               Successfully connected with BTS
    ...               console=${TRUE}
    [Return]          ${connection}

Disconnect From BTS With SSH
    [Arguments]       ${connection}=cOAM_toor4nsn
    ssh.disconnect    ${connection}

Change Parameter on BTS
    [Documentation]   Update single BTS parameter value.
    [Arguments]       ${dist_name}      ${param_name}
    ...               ${param_value}    ${skip_parameter_relation_errors}=${FALSE}
    ...               ${timeout}=900    ${should_activate}=${TRUE}
    ...               ${retry}=2        ${connection}=${NONE}
    ${connection}=    create_connection_if_not_exist
    ...               connection=${connection}
    ...               alias=temporaryAdminConnection
    ${output}=        recommission_parameter    dist_name=${dist_name}
    ...                                         param_name=${param_name}
    ...                                         param_value=${param_value}
    ...                                         operation=update
    ...                                         timeout=${timeout}
    ...                                         skip_parameter_relation_errors=${skip_parameter_relation_errors}
    ...                                         should_activate=${should_activate}
    ...                                         retry=${retry}
    ...                                         connection=${connection}
    [Teardown]        Run Keyword And Ignore Error    Disconnect From Admin
    ...                                               connection=temporaryAdminConnection
    [Return]          ${output}

Change Multiple Parameters on BTS
    [Documentation]     Change multiple parameters values within object dist name with only one recommissioning.
    ...
    ...                 This keyword accepts free named arguments and should be used like this:
    ...                 Change Multiple Parameters on BTS    dist_name=<dist_name value>
    ...                 ...                                  <parameter1 name>=<parameter1 value>
    ...                 ...                                  <parameter2 name>=<parameter2 value>
    ...                 ...                                  <parameter3 name>=<parameter3 value>
    ...
    ...                 It is important to place parameters name-value pairs as absolutely last arguments.
    ...                 NOTE: `connection` argument is optional (more in Documentation section)

    [Arguments]            ${dist_name}
    ...                    ${skip_parameter_relation_errors}=${FALSE}
    ...                    ${should_activate}=${TRUE}
    ...                    ${timeout}=900
    ...                    ${retry}=2
    ...                    ${connection}=${NONE}
    ...                    &{kwargs}

    ${connection}=         create_connection_if_not_exist
    ...                    connection=${connection}
    ...                    alias=temporaryAdminConnection

    recommission_object    dist_name=${dist_name}
    ...                    operation=update
    ...                    skip_parameter_relation_errors=${skip_parameter_relation_errors}
    ...                    should_activate=${should_activate}
    ...                    timeout=${timeout}
    ...                    retry=${retry}
    ...                    connection=${connection}
    ...                    &{kwargs}
    [Teardown]             Run Keyword And Ignore Error    Disconnect From Admin
    ...                                                    connection=temporaryAdminConnection

Commission SCF
    [Arguments]                    ${scf_file}       ${skip_parameter_relation_errors}=${TRUE}
    ...                            ${timeout}=300    ${connection}=${NONE}
    ${connection}=                 create_connection_if_not_exist
    ...                            connection=${connection}
    ...                            alias=temporaryAdminConnection
    Wait Until Keyword Succeeds    20 min    30 sec
    ...                            coam_admin.perform_commissioning
    ...                            scf_file=${scf_file}
    ...                            skip_parameter_relation_errors=${skip_parameter_relation_errors}
    ...                            timeout=${timeout}
    ...                            connection=${connection}
    [Teardown]                     Run Keyword And Ignore Error
    ...                            Disconnect From Admin
    ...                            connection=temporaryAdminConnection

Download SCF
    [Arguments]            ${filename}=scf.xml   ${local_path}=.  ${timeout}=15s   ${connection}=${NONE}
    ${connection}=         create_connection_if_not_exist
    ...                    connection=${connection}
    ...                    alias=temporaryAdminConnection
    ${scf_filepath}=       coam_admin.get_current_scf_file    local_dir_path=${local_path}
    ...                                                       file_name=${filename}
    ...                                                       timeout=${timeout}
    ...                                                       connection=${connection}
    [Teardown]             Run Keyword And Ignore Error
    ...                    Disconnect From Admin
    ...                    connection=temporaryAdminConnection
    [Return]               ${scf_filepath}

Get Current Parameter Value
    [Documentation]      This keyword check current BTS parameter value from SCF.
    [Arguments]          ${param_name}    ${dist_name}=${NONE}
    ...                  ${filename}=/tmp/full_scf.xml    ${local_path}=.
    ...                  ${timeout}=900    ${connection}=${NONE}
    ${connection}=                     create_connection_if_not_exist
    ...                                connection=${connection}
    ...                                alias=temporaryAdminConnection
    coam_admin.get_current_scf_file    local_dir_path=${local_path}
    ...                                file_name=${filename}
    ...                                export_type=configurationAndRuntimeObjects
    ...                                timeout=${timeout}
    ...                                connection=${connection}
    scf.load_scf                       /tmp/full_scf.xml
    ${value}=                          scf.get_all_values_from_scf         dist_name=${dist_name}
    ...                                                                    p_name=${param_name}
    Log                                ${param_name} value is: ${value}    console=${TRUE}
    [Return]      ${value}
    [Teardown]    Run Keyword And Ignore Error    Disconnect From Admin
    ...                                           connection=temporaryAdminConnection

Start Tcpdump
    [Arguments]    ${measurement_point}=NE_Terminated
    ...            ${uplane_capturing}=${TRUE}
    ...            ${password}=${EMPTY}
    ...            ${timeout}=120
    ...            ${bts_host}=${LMP_IP}

    Log                                 Starting tcpdump    console=${TRUE}
    ${connection}=                      Connect To Admin    ip_address=${bts_host}
    coam_admin.start_ip_capture_file    measurement_point=${measurement_point}
    ...                                 uplane_capturing=${uplane_capturing}
    ...                                 password=${password}
    ...                                 timeout=${timeout}
    ...                                 connection=${connection}
    [Teardown]    Disconnect From Admin    ${connection}

Stop Tcpdump And Download Pcap
    [Arguments]    ${tcpdump_filename}=test.pcap    ${bts_host}=${LMP_IP}
    ${tcpdump_filepath}=    Set Variable                   ${OUTPUT DIR}/${tcpdump_filename}
    ${connection}=          Connect To Admin               ip_address=${bts_host}
    Run Keywords    coam_admin.stop_ip_capture_file        connection=${connection}
    ...    AND      coam_admin.generate_ip_capture_file    connection=${connection}
    ...    AND      coam_admin.download_ip_capture_file    target_file_name=${tcpdump_filepath}
    ...    timeout=300                                     connection=${connection}
    Log    Tcpdump stopped and ${tcpdump_filename} file downloaded    console=${TRUE}
    [Teardown]    Disconnect From Admin    ${connection}
    [Return]      ${tcpdump_filepath}

PCAP Should Contain Message
    [Documentation]        Checks if PCAP file contains packets matching given `tshark_filter`.
    [Arguments]            ${tshark_filter}    ${pcap_file}
    ${output}              Run    tshark -r ${pcap_file} -Y '${tshark_filter}' 2>/dev/null | wc -l
    Should Not Be Equal    ${output}    0
    ...                    msg=Packets matching filter "${tshark_filter}" not found in PCAP
    Log                    Packets matching filter "${tshark_filter}" found in PCAP
    ...                    console=${TRUE}
    [Return]               ${output}

PCAP Should Be Empty
    [Documentation]        Checks if PCAP file contains no packets matching given `tshark_filter`.
    [Arguments]            ${tshark_filter}    ${pcap_file}
    ${output}              Run     tshark -r ${pcap_file} -Y "${tshark_filter}" 2>/dev/null | wc -l
    Should Be Equal        ${output}    0
    ...                    msg=Packets matching filter "${tshark_filter}" found in PCAP.
    Log                    Packets matching filter "${tshark_filter}" not found in PCAP.
    ...                    console=${TRUE}

Convert Pcap To XML
    [Arguments]    ${filename}    ${filters}    ${xml_name}
    Run    tshark -r ${filename} -Y "${filters}" -T pdml > ${xml_name}

TCPDump Teardown
    [Arguments]                     ${bts_host}=${LMP_IP}
    ${connection}=                  Connect To Admin                   ip_address=${bts_host}
    Run Keyword And Ignore Error    coam_admin.stop_ip_capture_file    connection=${connection}
    [Teardown]                      Disconnect From Admin              connection=${connection}

