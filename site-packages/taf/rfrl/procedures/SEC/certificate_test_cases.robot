BTS As Client Authentication With NMS LDAP Using ECDSA Operator Certificate
    Configure CMP                            subject_name=${ECDSA_SUBJECT_NAME}
    ...                                      server_type=ECDSA
    Initialize Certificates                  cert_type=ECDSA
    Set Certification Type                   cert_type=ECDSA
    Set MPLANENW Parameter                   actEnableTLSv13    true
    Setup Environment For EMSSIM             enable_tls=1       cert_type=ECDSA
    Run                                      sudo chmod 777 /etc/emssim.conf
    Run                                      sudo echo ldap_sec_port = 636 >> /etc/emssim.conf
    ${emssim_connection}=                    Activate EMSSIM    enable_tls=1
    Wait Until Keyword Succeeds              5x    1min    execute_command_on_emssim
    ...                                      command=ldap_user_add agaaga ${NETOOPER_PASSWORD} -a RW
    ...                                      connection=${emssim_connection}
    execute_command_on_emssim
    ...           command=user_info_update -username agaaga -password ${NETOOPER_PASSWORD} -type app_adm -status enabled
    ...                                      connection=${emssim_connection}
    Change Parameter On BTS                  dist_name=MRBTS-${BTS_ID}/MNL-1/AMGR-1/LUAC-1
    ...                                      param_name=actRestrictLoginToCnum
    ...                                      param_value=false
    login_via_webem_with_ldap_credentials    https://${LMP_IP}   agaaga    YT_xk39b    actRestrictLoginToCnum
    [Teardown]                               Run Keywords        TCPDump Teardown
    ...                                      AND                 Run Keyword And Ignore Error
    ...                                                          Disconnect From EMSSIM
    ...                                                          connection=${emssim_connection}
    ...                                      AND                 Run Keyword And Ignore Error
    ...                                                          Disconnect From Admin
    ...                                                          connection=${connection}
    ...                                      AND                 Change Parameter On BTS
    ...                                                          dist_name=MRBTS-${BTS_ID}/MNL-1/AMGR-1/LUAC-1
    ...                                                          param_name=actRestrictLoginToCnum
    ...                                                          param_value=false

RSA And Elliptic Curve Certificate Support For TLS
    Configure CMP                           ${RSA_ST46_SUBJECT_NAME}
    ...                                     server_type=RSA
    Initialize Certificates                 cert_type=RSA
    Set MPLANENW Parameter                  tls12Enabled       true
    Set MPLANENW Parameter                  actEnableTLSv13    false
    Set MPLANENW Parameter                  oamTls             forced
    FOR  ${port}  IN  @{PORTS}
        Set Certification Type              cert_type=RSA
        Start Tcpdump
        Sleep                               20s
         ...                                reason=Wait until tcpdump stars
        Run                                 openssl s_client -connect ${MPLANE_IPV4}:${port} -tls1_2
        Sleep                               20s
        Sleep                               30s    reason=Wait for capturing tcpdump logs
        ${tcpdump_path}=                    Stop Tcpdump And Download Pcap    tcpdump_filename=rsa_${port}.pcap
        PCAP Should Contain Message         tshark_filter=tls.handshake.type == 11 && ip.src == ${MPLANE_IPV4}
        ...                                 pcap_file=${tcpdump_path}
        Convert Pcap To XML                 filename=${tcpdump_path}
        ...                                 filters=tls.handshake.type == 11 && ip.src == ${MPLANE_IPV4}
        ...                                 xml_name=${CURDIR}/rsa_${port}.xml
        ${rsa}=                             find_certificate_in_extracted_pcap    ${CURDIR}/rsa_${port}.xml
        Log                                 ${rsa}[1]                             console=${TRUE}
        Should Contain                      ${rsa}[1]                             ST46_RSA
        Configure CMP                       ${ECDSA_ST46_SUBJECT_NAME}
        ...                                 server_type=ECDSA
        Initialize Certificates             cert_type=ECDSA
        Set Certification Type              cert_type=ECDSA
        Start Tcpdump
        Run                                 openssl s_client -connect ${MPLANE_IPV4}:${port} -tls1_2
        ${tcpdump_path}=                    Stop Tcpdump And Download Pcap    tcpdump_filename=ecdsa_${port}.pcap
        PCAP Should Contain Message         tshark_filter=tls.handshake.type == 11 && ip.src == ${MPLANE_IPV4}
        ...                                 pcap_file=${tcpdump_path}
        Convert Pcap To XML                 filename=${tcpdump_path}
        ...                                 filters=tls.handshake.type == 11 && ip.src == ${MPLANE_IPV4}
        ...                                 xml_name=${CURDIR}/ecdsa_${port}.xml
        ${ecdsa}=                           find_certificate_in_extracted_pcap    ${CURDIR}/ecdsa_${port}.xml
        Log                                 ${ecdsa}[1]                           console=${TRUE}
        Should Contain                      ${ecdsa}[1]                           ST46_ECDSA
    END
    [Teardown]                              Run Keywords    TCPDump Teardown
    ...                                     AND             Clear Certificates
