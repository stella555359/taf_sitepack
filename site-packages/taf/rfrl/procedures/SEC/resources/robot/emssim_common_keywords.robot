*** Settings ***
Resource    ../../keywords.robot
Resource    ./certificate_common_keywords.robot
Library     ../python/tls_operations.py
Library     taf.sbts.oam.coam.admin    WITH NAME   coam_admin
Library     OperatingSystem

*** Variables ***
${ECDSA_CERT_PATH}=      ${CURDIR}/certificates/ECDSA
${EMSSIM_SSL_PATH}=      /opt/emssim/proxy/ssl/
${EMSSIM_APACHE_KEY}=    /etc/apache2/ssl.key/
${EMSSIM_APACHE_CRT}=    /etc/apache2/ssl.crt/

*** Keywords ***
Add EMSSIM User On VM
    [Documentation]  Keyword is responsible for add emssim user on VM
    [Arguments]      ${mplane_ipv4}
    Log    Creating user flexi${BTS_ID} on EMSSIM VM    console=${TRUE}
    Run    sudo /opt/emssim/util/add_user.pl -u flexi${BTS_ID} -ip ${mplane_ipv4}
    Log    Creating user flexi${BTS_ID} done    console=${TRUE}

Activate EMSSIM
	[Arguments]              ${enable_tls}=0
	${vm_ip}=                Get VM IPv4 Address
    Log                      Connecting with EMSSIM    console=${TRUE}
    ${emssim_connection}=    integrate_emssim_with_bts
    ...                      bts_id=${BTS_ID}
    ...                      host=${vm_ip}
    ...                      user=flexi${BTS_ID}
    ...                      tls=${enable_tls}
    Run Keyword If           ${enable_tls} == 1    Wait Until NMS in Secured Status
    [Return]                 ${emssim_connection}

Disconnect From EMSSIM
    [Arguments]                     ${connection}
    close_connection_with_emssim    bts_id=${BTS_ID}    connection=${connection}

Setup Environment For EMSSIM
	[Documentation]    Keyword including emssim configurations on VM.
    [Arguments]              ${enable_tls}=0    ${mplane_ipv4_addr}=${MPLANE_IPV4}    ${cert_type}=RSA
    Run                      /opt/emssim/util/upgrade_emssim.pl -t
    Log                      Emssim updated    console=${TRUE}
    Run Keyword If           ${enable_tls} == 1
    ...                      Run Keywords    Copy Certificates To VM    cert_type=${cert_type}
    ...                      AND             Replace Strings In Certificate Files On VM
    ...                      AND             Restart Apache
    Add EMSSIM User On VM    mplane_ipv4=${mplane_ipv4_addr}

Wait Until NMS In Secured Status
    ${connection}=                Connect To Admin
    Log                           Waiting until NMS reach Secured state...
    ...                           console=${TRUE}
    Wait Until Keyword Succeeds   10 min   20 sec
    ...                           Check If NMS In Expected Status
    ...                           manager_id=${EMSSIM_MANAGER_ID}
    ...                           expected_status=secured
    ...                           connection=${connection}
    [Teardown]                    Run Keyword And Ignore Error
    ...                           Disconnect From Admin    connection=${connection}

Check If NMS In Expected Status
    [Arguments]       ${manager_id}    ${expected_status}    ${connection}=${NONE}
    ${connection}=    create_connection_if_not_exist
    ...               connection=${connection}
    ...               alias=temporary_admin_connection
    ${status}=        Get NMS Status By Manager ID
    ...               manager_id=${manager_id}
    ...               connection=${connection}
    Should Be Equal   "${status}"  "${expected_status}"
    [Teardown]        Run Keyword And Ignore Error
    ...               Disconnect From Admin
    ...               connection=temporary_admin_connection

Get NMS Status By Manager ID
    [Arguments]       ${manager_id}  ${connection}=${NONE}
    ${connection}=    create_connection_if_not_exist
    ...               connection=${connection}
    ...               alias=temporary_admin_connection
    ${nms_list}=      coam_admin.get_nms_state
    ...               connection=${connection}
    ${status}=        get_nms_status
    ...               nms_list=${nms_list}
    ...               manager_id=${manager_id}
    [Return]          ${status}
    [Teardown]        Run Keyword And Ignore Error
    ...               Disconnect From Admin
    ...               connection=temporary_admin_connection

Copy Certificates To VM
    [Documentation]  Keyword is responsible for copying unpleasant certificates on VM.
    [Arguments]      ${cert_type}
    ${cert_filepath}=    Get From Dictionary    ${CERTS_PATH}   ${cert_type}
    Log                  Copying certificates    console=${TRUE}
    Run                  sudo cp ${cert_filepath}/*.pem ${EMSSIM_SSL_PATH}
    Run                  sudo cp ${cert_filepath}/*.pem ${EMSSIM_APACHE_KEY}
    Run                  sudo cp ${cert_filepath}/*.pem ${EMSSIM_APACHE_CRT}

Restart Apache
    [Documentation]  Keyword is responsible for restarting Apache.
    Log    Restart apache2    console=${TRUE}
    Run    sudo systemctl restart apache2

Replace Strings In Certificate Files On VM
    [Documentation]  Keyword is responsible for replacing necessary string in files on VM.
    Log    Replacing strings in files    console=${TRUE}
    Run    sed -i 's/CipherString = DEFAULT@SECLEVEL=[0-9]/CipherString = DEFAULT@SECLEVEL=1/g' /etc/ssl/openssl.cnf
    Run    sed -i '34i\ SSLCertificateChainFile /etc/apache2/ssl.crt/cacert.pem' /home/ute/default-ssl.conf
