    ...                         username=${ROOT_USERNAME}
    ...                         event=${event_key}
    ...                         ssh_key=${private_ssh_key_path}
    ...                         auto_logout=${TRUE}
    ...                         idle_time=${DEFAULT_IDLE_TEST_TIME}
