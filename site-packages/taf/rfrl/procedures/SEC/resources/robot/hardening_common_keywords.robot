Check Unencrypted Private Keys
	${connection}=    Connect To BTS With SSH
    ${pem_files}=     ssh.Execute    command=find / -name *.pem | grep -v cert
    ...                              connection=${connection}
    ...                              timeout=10s
    @{certifiactes_paths_list}=      prepare_list_from_console    ${pem_files}
    FOR  ${cert}  IN  @{certifiactes_paths_list}
       Exit For Loop If    '''${cert}''' == '''${EMPTY}'''
       ${cert_output}=     ssh.execute        command=cat ${cert}    connection=${connection}
       Run Keyword If      '''${cert_output}''' != '''${EMPTY}'''    Should Contain Any    ${cert_output}
       ...                                                                                 -----BEGIN
       ...                                                                                 No such file
       Log                 ${cert}                console=${TRUE}
    END
    [Teardown]    Disconnect From BTS With SSH    ${connection}

Check If SSH User Is Automatically Logged Out After Reach Set Period Of Inactivity
    Change Parameter On BTS     dist_name=MRBTS-${BTS_ID}/MNL-1/MNLENT-1/SECADM-1
    ...                         param_name=sshSessionIdleTimer
    ...                         param_value=${IDLE_TIME_FOR_AUTOLOGOUT}
    ${token}=                   String.Generate Random String    length=8    chars=[NUMBERS]
    ${event_pwd}=               Set variable                     echo autologout_tc_login_with_password_${token}
    Log                         Perform ssh cmd: ${event_pwd}    console=${TRUE}
    perform_ssh_event           hostname=${LMP_IP}
    ...                         username=${ROOT_USERNAME}
    ...                         event=${event_pwd}
    ...                         password=${ROOT_PASSWORD}
    ...                         auto_logout=${TRUE}
    ...                         idle_time=${DEFAULT_IDLE_TEST_TIME}
    ...                         log_output=${FALSE}
    ${private_ssh_key_path}=    Create SSH Keys And Upload On BTS
    ${token}=                   String.Generate Random String    length=8    chars=[NUMBERS]
    ${event_key}=               Set Variable                     echo autologout_tc_login_with_key_${token}
    Log                         Perform ssh cmd: ${event_key}    console=${TRUE}
