Check If Owner Of File Is Root
	[Arguments]           ${file}
    ${connection}=        Connect To BTS With SSH
    ${console_output}=    ssh.execute                          command=ls -la /etc/${file}
    ...                                                        connection=${connection}
    Log                   Console output: ${console_output}    console=${TRUE}
    Should Contain        ${console_output.split()[2]}         root
    [Teardown]            Disconnect From BTS With SSH         ${connection}

Check File Premissions
    [Arguments]  ${file}
    ${connection}=        Connect To BTS With SSH
    ${console_output}=    ssh.Execute                     command=stat -c "%a %n" /etc/${file}
    ...                                                   connection=${connection}
    ${message}=           Catenate    File: ${file} should have ${dict_file_names_to_permissions["${file}"]} permissions
    ...                               (but have ${console_output})
    Should Contain        ${console_output.split()[0]}    ${dict_file_names_to_permissions["${file}"]}
    ...                   msg=${message}
    [Teardown]            Disconnect From BTS With SSH    ${connection}

Check /etc/ Files Permissions And Root Ownership
	Log    Check files permissions rules    console=${TRUE}
    @{files_to_check_their_permissions}=    Evaluate    ${dict_file_names_to_permissions}.keys()
    ${connection}=                          Connect To BTS With SSH
    FOR  ${file}  IN  @{files_to_check_their_permissions}
       Log                         Currently checking file ${file}            console=${TRUE}
       ${console_output}=          ssh.execute                                command=ls -la /etc/${file}
       ...                                                                    connection=${connection}
       ${check_is_file_exists}=    Should Not Contain    ${console_output}    No such file or directory
       Run Keyword If              '${check_is_file_exists}'=='${TRUE}'
       ...                         Run Keywords    Check If Owner Of File Is Root  ${file}
       ...                         AND             Check File Premissions  ${file}
       ...    ELSE                 Log             File ${file} not exists!   console=${TRUE}
    END
    [Teardown]    Disconnect From BTS With SSH  ${connection}

