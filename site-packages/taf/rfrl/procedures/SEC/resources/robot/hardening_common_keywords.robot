Check If Counters Are Collected On BTS
    [Arguments]                 ${counter}
    ${connection}=              Connect To Admin
    ${counters}=                coam_admin.get_counters_info
    ...                         dist_name=TRS/MRBTS-${BTS_ID}/TNLSVC-1/TNL-1/IPNO-1/IP_filtering_Stats/${counter}
    ...                         connection=${connection}
    ${counter_measurements}=    get_counter_measurements       ${counters}
    ${raw_measurements}=        Get Dictionary Values          ${counter_measurements}
    ${measurements_sum}=        Convert To Integer             0
    FOR  ${measurement}  IN  @{raw_measurements}
        Log                     Measurement: ${measurement}    console=${TRUE}
        ${item}=                Convert To Integer             ${measurement}
        ${measurements_sum}=    Evaluate                       ${measurements_sum} + ${item}
    END
    Log                         Sum of measurements: ${measurements_sum}    console=${TRUE}
    Should Be True              ${measurements_sum} > 0
    [Teardown]                  Disconnect From Admin          ${connection}

