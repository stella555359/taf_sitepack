Generate Private And Public SSH Keys For SSH Login
    [Arguments]    ${private_and_public_keys_location}=/home/ute
    ${private_rsa_key_path}=        Set Variable    ${private_and_public_keys_location}/id_rsa
    Run Keyword And Ignore Error    Run             rm -f ${private_and_public_keys_location}/id_rsa*
    Log                             Removed RSA keys (id_rsa*) from: ${private_and_public_keys_location}
    ...                             console=${TRUE}
    Run                             ssh-keygen -P "" -t rsa -b 4096 -f ${private_rsa_key_path}
    ${console_output}=              Run                  ls ${private_rsa_key_path}
    Should Not Contain              ${console_output}    No such file or directory
    ${console_output}=              Run                  cat ${private_rsa_key_path} | wc -l
    Should Not Be Equal             ${console_output}    0
    ${console_output}=              Run                  ls ${private_rsa_key_path}.pub
    Should Not Contain              ${console_output}    No such file or directory
    ${console_output}=              Run                  cat ${private_rsa_key_path}.pub | wc -l
    Should Not Be Equal             ${console_output}    0
    Log                             Generated new RSA private key (id_rsa*) at: ${private_and_public_keys_location}
    ...                             console=${TRUE}
    [Return]    ${private_rsa_key_path}    ${private_rsa_key_path}.pub

