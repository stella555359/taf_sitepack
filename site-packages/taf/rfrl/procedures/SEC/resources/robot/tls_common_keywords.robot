*** Settings ***
Resource    ../../keywords.robot
Resource    ../../variables.robot
Resource    ../../resources/robot/emssim_common_keywords.robot
Library     taf.sbts.oam.coam.admin    WITH NAME    coam_admin
Library     ../python/TLSHandshakeTests.py
Library     ../python/tls_operations.py
Library     taf.transport.ssh    WITH NAME    ssh
Library     Collections
Library     String
Library     SSHLibrary

*** Keywords ***
Renegotiate TLS1.3
	[Arguments]                ${mplane_adress}
	${bts_connection}=         Connect To BTS With SSH
	Log                        Checking TLS1.3 renegotiation
	...                        console=${TRUE}
	${output}=                 Run          openssl s_client -connect ${mplane_adress}:443 -tls1_3
	Should Match Regexp        ${output}    Renegotiation IS NOT supported
	[Teardown]                 Disconnect From BTS With SSH

Set TLS 1.1
    [Arguments]               ${mode}=true
    ${is_tls11_available}=    Check If Parameter Exists On BTS    dist_name=MRBTS-${BTS_ID}/MNL-1/MNLENT-1/MPLANENW-1
    ...                                                           param_name=tls11Enabled
    Run Keyword If            ${is_tls11_available}               Set MPLANENW Parameter    tls11Enabled
    ...                                                                                     ${mode}
    [Return]                  ${is_tls11_available}

Set MPLANENW Parameter
	[Arguments]                ${parameter}    ${value}
	${connection}=             Connect To Admin
	Log                        Changing ${parameter} parameter to ${value}
	...                        console=${TRUE}
	Change Parameter On BTS    dist_name=MRBTS-${BTS_ID}/MNL-1/MNLENT-1/MPLANENW-1
    ...                        param_name=${parameter}
    ...                        param_value=${value}
    ...                        connection=${connection}
    Log                        ${parameter} parameter is changed to ${value}
    ...                        console=${TRUE}
    [Teardown]                 Disconnect From Admin    ${connection}

Check If MPLANENW Parameter Is Set
	[Arguments]          ${parameter}    ${expected_value}
	${connection}=       Connect To Admin
	Log                  Checking MPLANENW ${parameter} parameter value
	...                  console=${TRUE}
	${current_value}=    Get Current Parameter Value      param_name=${parameter}
	...                                                   dist_name=MRBTS-${BTS_ID}/MNL-1/MNLENT-1/MPLANENW-1
	...                                                   connection=${connection}
	${value}=            Get From List                    ${current_value}    0
	Log                  Current value: ${value}, expected value: ${expected_value}
	...                  console=${TRUE}
	Should Be Equal      ${value}    ${expected_value}    ignore_case=${TRUE}
	[Teardown]           Disconnect From Admin    ${connection}

Check If Ciphersuits Are Stored
    [Arguments]          ${ciphersuite_list}    ${ciphersuites}
    FOR  ${ciphersuite}  IN  @{ciphersuite_list}
        Log                        Ciphersuite: ${ciphersuite}
        ...                        console=${TRUE}
        Should Contain Any         ${ciphersuite}    @{ciphersuites}
    END

Verify TLS1.3 Handshake In PCAP
    [Arguments]  ${pcap_file}
    Convert pcap to XML                       filename=${pcap_file}
    ...                                       filters=tls and ip.addr == ${MPLANE_IPV4}
    ...                                       xml_name=${CURDIR}/ecdsa_NMS.xml
    Load XML file                             xml_filepath=${CURDIR}/ecdsa_NMS.xml
    Test TLS Handshake process

Check ECDSA TLS Authentication
    [Arguments]    ${ports}
    ${vm_ipv4}=    Get VM IPv4 Address
    FOR  ${port}  IN  @{ports}
        Setup Environment For EMSSIM    enable_tls=1       cert_type=ECDSA
        Start TCPDump
        ${emssim_connection}=           Activate EMSSIM    enable_tls=1
        Sleep                           30s                reason=Wait for capturing tcpdump logs
        ${tcpdump_path}=                Stop TCPDump And Download PCAP    tcpdump_filename=tls_${port}.pcap
        PCAP Should Contain Message
        ...    tshark_filter=tls.handshake.type == 2 && ip.src == ${MPLANE_IPV4} && ip.dst == ${vm_ipv4}
        ...    pcap_file=${tcpdump_path}
        Convert Pcap To XML             filename=${tcpdump_path}
        ...    filters=tls.handshake.type == 2 && ip.src == ${MPLANE_IPV4} && ip.dst == ${vm_ipv4}
        ...    xml_name=${OUTPUT DIR}/tls_auth_pcap_${port}.xml
        ${certificates_from_pcap}=      get_certificates_from_tls_handshake    ${OUTPUT DIR}/tls_auth_pcap_${port}.xml
        Should Contain                  ${certificates_from_pcap}[1]           commonName=${ECDSA_COMMON_NAME}
    END
    [Teardown]                          Run Keywords    Disconnect From EMSSIM    connection=${emssim_connection}
    ...                                 AND             TCPDump Teardown

Check RSA TLS Authentication
    [Arguments]    ${ports}
    ${vm_ipv4}=    Get VM IPv4 Address
    FOR  ${port}  IN  @{ports}
        Setup Environment For EMSSIM    enable_tls=1
        Start TCPDump
        ${emssim_connection}=         Activate EMSSIM    enable_tls=1
        Sleep                         30s    reason=Wait for capturing tcpdump logs
        ${tcpdump_path}=              Stop TCPDump And Download PCAP    tcpdump_filename=tls_${port}.pcap
        PCAP Should Contain Message
        ...    tshark_filter=tls.handshake.type == 11 && ip.src == ${MPLANE_IPV4} && ip.dst == ${vm_ipv4}
        ...    pcap_file=${tcpdump_path}
        Convert Pcap To XML           filename=${tcpdump_path}
        ...    filters=tls.handshake.type == 11 and ip.src == ${MPLANE_IPV4} && ip.dst == ${vm_ipv4}
        ...    xml_name=${OUTPUT DIR}/tls_auth_pcap_${port}.xml
        ${certificates_from_pcap}=    get_certificates_from_tls_handshake    ${OUTPUT DIR}/tls_auth_pcap_${port}.xml
        Should Contain                ${certificates_from_pcap}[1]    commonName=${RSA_COMMON_NAME}
        Should Contain                ${certificates_from_pcap}[1]    organizationName=${RSA_ORGANIZATION_NAME}
        Should Contain                ${certificates_from_pcap}[1]    countryName=${RSA_COUNTRY_NAME}
    END
    [Teardown]                        Run Keywords    Disconnect From EMSSIM    connection=${emssim_connection}
    ...                               AND             TCPDump Teardown

Create CRL Object
    ${connection}=          Connect To Admin
    ${dist_name}=           Set Variable        MRBTS-${BTS_ID}/MNL-1/CERTH-1/CRLH-1/CRLDPCONFIG-1
    ${params_list}=         get_list_of_params_for_crldpconfig_object    ${CMP_SERVER_IP}
    Log                     Creating CRL object
    ...                     console=${TRUE}
    coam_admin.perform_object_recommissioning    dist_name=${dist_name}
    ...                                          parameter=${params_list}
    ...                                          operation=create
    ...                                          skip_parameter_relation_errors=${FALSE}
    ...                                          should_activate=${TRUE}
    ...                                          connection=${connection}
    Log                     CRL object created
    ...                     console=${TRUE}
    [Teardown]              Disconnect From Admin    ${connection}

Configure CRLH Object
    ${connection}=                       Connect To Admin
    Log                                  Changing CRLH object
    ...                                  console=${TRUE}
    Change Multiple Parameters on BTS    dist_name=MRBTS-${BTS_ID}/MNL-1/CERTH-1/CRLH-1
    ...                                  connection=${connection}
    ...                                  distributionPointSource=Configuration_parameter
    ...                                  crlDownloadProtocol=LDAP_OR_HTTP
    Log                                  CRLH object changed
    ...                                  console=${TRUE}
    Log                                  Updating certificate revocation list
    ...                                  console=${TRUE}
    Wait Until Keyword Succeeds          5 min    20sec    coam_admin.update_certificate_revocation_list
    ...                                                    domain_type=3GPP
    ...                                                    timeout=300
    ...                                                    connection=${connection}
    Log                                  Certificate revocation list updated
    ...                                  console=${TRUE}
    [Teardown]                           Disconnect From Admin    ${connection}

Add Mplane To Hosts
    [Arguments]    ${name}    ${mplane_ipv4}
    SSHLibrary.Open Connection    ${NETOOPER_IP}
    SSHLibrary.Login              ${NETOOPER_LOGIN}    ${NETOOPER_PASSWORD}
    SSHLibrary.Write              sudo su
    Sleep                         5
    ${sudo_response}=             SSHLibrary.Read
    Should Contain                ${sudo_response}     password
    SSHLibrary.Write              ${NETOOPER_PASSWORD}
    SSHLibrary.Write              echo ${mplane_ipv4} ${name} >> /etc/hosts
    SSHLibrary.Read

Delete Mplane From Hosts
    SSHLibrary.Open Connection    ${NETOOPER_IP}
    SSHLibrary.Login              ${NETOOPER_LOGIN}    ${NETOOPER_PASSWORD}
    SSHLibrary.Write              sudo su
    Sleep                         5
    ${sudo_response}=             SSHLibrary.Read
    Should Contain                ${sudo_response}     password
    SSHLibrary.Write              ${NETOOPER_PASSWORD}
    SSHLibrary.Write              sed -i '/${MPLANE_IPV4}/d' /etc/hosts
    SSHLibrary.Read

Check TLS ECDHE Cipher Support
    ${vm_ip}=                 Get VM IPv4 Address
    Set MPLANENW Parameter    tls12CbcCipherDisabled    true
    FOR  ${port}  IN  @{PORTS}
        Set Certification Type            cert_type=ECDSA
        Start TCPDump
        ${output}=    Run
        ...           openssl s_client -cipher 'ECDHE-ECDSA-AES256-GCM-SHA384' -connect ${MPLANE_IPV4}:${port} -tls1_2
        Log           ${output}
        ...           console=${TRUE}
        ${tcpdump_path}=          Stop TCPDump And Download PCAP    tcpdump_filename=ecdsa_${port}.pcap
        PCAP Should Contain Message
        ...         tshark_filter=tls.record.content_type == 22 && ip.dst==${vm_ip} && ip.src==${MPLANE_IPV4}
        ...         pcap_file=${tcpdump_path}
        Convert Pcap To XML       filename=${tcpdump_path}
        ...                       filters=tls.record.content_type == 22 && ip.dst==${vm_ip} && ip.src==${MPLANE_IPV4}
        ...                       xml_name=${CURDIR}/ecdsa_${port}.xml
        ${ecdhe_ciphersuites}=    find_ciphersuites    ${CURDIR}/ecdsa_${port}.xml
        Log                       ECDHE ciphers: ${ecdhe_ciphersuites}[0]
        ...                       console=${TRUE}
        Should Contain            ${ecdhe_ciphersuites}[0]    TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        Set Certification Type    cert_type=RSA
        Start TCPDump
        ${rsa_openssl}=    Run
        ...                openssl s_client -cipher 'DHE-RSA-AES256-GCM-SHA384' -connect ${MPLANE_IPV4}:${port} -tls1_2
        Log                ${rsa_openssl}
        ...                console=${TRUE}
        ${tcpdump_path}=          Stop TCPDump And Download PCAP    tcpdump_filename=rsa_${port}.pcap
        PCAP Should Contain Message
        ...         tshark_filter=tls.record.content_type == 22 && ip.dst==${vm_ip} && ip.src==${MPLANE_IPV4}
        ...         pcap_file=${tcpdump_path}
        Convert Pcap to XML       filename=${tcpdump_path}
        ...                       filters=tls.record.content_type == 22 && ip.dst==${vm_ip} && ip.src==${MPLANE_IPV4}
        ...                       xml_name=${CURDIR}/rsa_${port}.xml
        ${ecdhe_ciphersuites}=    find_ciphersuites    ${CURDIR}/rsa_${port}.xml
        Log                       ${ecdhe_ciphersuites}[0]
        ...                       console=${TRUE}
        Should Contain            ${ecdhe_ciphersuites}[0]    TLS_DHE_RSA_WITH_AES_256_GCM_SHA384
    END
    [Teardown]    Run Keywords    TCPDump Teardown
    ...           AND             Set MPLANENW Parameter    tls12CbcCipherDisabled    false

Get Fingerprint
    ${ssh_index}=     SSHLibrary.Open Connection    host=${NETOOPER_IP}
    ${output}=        SSHLibrary.Login              ${NETOOPER_LOGIN}    ${NETOOPER_PASSWORD}
    SSHLibrary.Set Client Configuration             prompt=$
    SSHLibrary.Set Client Configuration             timeout=20
    ${command}=    Catenate    openssl x509 -fingerprint -noout -in /home/trssec/NetConf/certy_rsa/ca256.pem
    ...                        | sed -e"s/SHA1 Fingerprint//; s/=//; s/=//p"
    SSHLibrary.Write           ${command}
    ${fingerprint}=            SSHLibrary.Read Until    t
    ${cert_fingerprint}=       Split String             ${fingerprint}
    [Return]                   ${cert_fingerprint}[0]
