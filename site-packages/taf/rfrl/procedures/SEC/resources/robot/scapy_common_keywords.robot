*** Settings ***
Resource    ../../variables.robot

*** Keywords ***
Send Incorrect Packet Set Ipv6
    [Arguments]    ${ip_address}
    Send ICMPv6EchoRequest     ${ip_address}
    Send ICMPv6DestUnreach     ${ip_address}
    Send ICMPv6TimeExceeded    ${ip_address}
    Send ICMPv6ParamProblem    ${ip_address}
    Send ICMPv6PacketTooBig    ${ip_address}
    Send ICMPv6ND_NA           ${ip_address}

Send ICMPv6EchoRequest
    [Arguments]    ${ip_address}
    ${scapy_imports}=      Set Variable
    ...    import scapy.all as scapy; from scapy.layers.inet6 import IPv6, ICMPv6EchoRequest;
    ${scapy_command}=      Set Variable
    ...    scapy.sr(IPv6(dst="${ip_address}") / ICMPv6EchoRequest(type=129, data="text" * 50), timeout=5)
    ${python_location}=    Run    which python
    Log                    Sending ICMPv6EchoRequest packet with Scapy    console=${TRUE}
    Run                    sudo -E ${python_location} -c '${scapy_imports} ${scapy_command}'

