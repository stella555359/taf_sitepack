Send Packets For M51328C15 Counter To BTS
    [Arguments]    ${ip_address}
    ${raw_pps}=            Evaluate    ${M51328C15_LIMIT} + (${M51328C15_LIMIT} * ${M51328C15_INCREASE_PERCENT})
    ${raw_loop}=           Evaluate    ${M51328C15_LOOP} * ${raw_pps}
    ${pps}=                Convert To Integer    ${raw_pps}
    ${loop}=               Convert To Integer    ${raw_loop}
    ${python_location}=    Run                   which python
    ${scapy_imports}=      Set Variable          import scapy.all as scapy;
    ${scapy_command}=      Catenate              scapy.sendpfast((scapy.Ether() / scapy.IP(dst="${ip_address}")
    ...   / scapy.ICMP(type=8, code=0)), pps=${pps}, iface="eth0", loop=${loop}, parse_results=1)
    Log                    Sending M51328C15 Counter packet with Scapy    console=${TRUE}
    Run                    sudo -E ${python_location} -c '${scapy_imports} ${scapy_command}'
