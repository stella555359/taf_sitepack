*** Settings ***
Resource    ../../keywords.robot
Resource    ../../variables.robot
Resource    emssim_common_keywords.robot
Library     ../python/certificate_operations.py
Library     taf.sbts.oam.coam.admin    WITH NAME   coam_admin
Library     SSHLibrary

*** Keywords ***
Configure CMP
	[Arguments]    ${subject_name}=${RSA_SUBJECT_NAME}
	...            ${server_host}=${CMP_SERVER_IP}
	...            ${server_path}=${CMP_SERVER_PATH}
	...            ${server_port}=${CMP_DEFAULT_PORT}
	...            ${server_type}=RSA
    ${connection}=                         Connect To Admin
    ${cmp_object}=                         Run Keyword If    '${server_type}'=='RSA'      Set Variable    CMP
    ...                                    ELSE IF           '${server_type}'=='ECDSA'    Set Variable    CMPECDSA
    ...                                    ELSE              Fail    Wrong server type
    Log                                    Actual object: ${cmp_object}
    ...                                    console=${TRUE}
    Change Multiple Parameters on BTS      dist_name=MRBTS-${BTS_ID}/MNL-1/CERTH-1/${cmp_object}-1
    ...                                    connection=${connection}
    ...                                    serverHost=${server_host}
    ...                                    serverPath=${server_path}
    ...                                    serverPort=${server_port}
    ...                                    caSubjectName=${subject_name}
    [Teardown]    Disconnect From Admin    ${connection}

Initialize Certificates
    [Arguments]       ${cert_type}=RSA    ${timeout}=300
    ${connection}=    Connect To Admin
    Log               ${cert_type} certificates initialization request sent
    ...               console=${TRUE}
    FOR  ${attempt}  IN RANGE  10
    	${output}=    Run Keyword And Ignore Error     coam_admin.cmp_initialize_certificate    key_pool_type=${cert_type}
        ...                                                                                connection=${connection}
        ...                                                                                timeout=${timeout}
        ${status}=    Run Keyword And Return Status    Should Contain    ${output}
        ...                                                              Succeeded
        ...                                                              ignore_case=True
        Exit For Loop If                               '${status}'=='${TRUE}'
    END
    [Teardown]        Disconnect From Admin    ${connection}

Set Certification Type
	[Arguments]       ${cert_type}=RSA
	${connection}=    Connect To Admin
	Log               Setting ${cert_type} certification type
	...               console=${TRUE}
	Change Parameter On BTS    dist_name=MRBTS-${BTS_ID}/MNL-1/MNLENT-1/MPLANENW-1
    ...                        param_name=certTypeForTlsAuth
    ...                        param_value=${cert_type}
    ...                        connection=${connection}
    [Teardown]        Disconnect From Admin    ${connection}

Set CMP Server Settings
    [Arguments]       ${key_pool_type}=RSA
    ...               ${reference_number}=5330
    ...               ${preshared_key}=fnAR-zMMi-4pVz-mwrG
    ...               ${connection}=${NONE}
    ${connection}=    create_connection_if_not_exist
    ...               connection=${connection}
    ...               alias=temporary_admin_connection
    Log               Key pool type: ${key_pool_type}, reference number: ${reference_number}, key: ${preshared_key}
    ...               console=${TRUE}
    ${output}=        coam_admin.set_certificate_automatic_management
    ...               key_pool_type=${key_pool_type}
    ...               reference_number=${reference_number}
    ...               preshared_key=${preshared_key}
    ...               detailed_output=${TRUE}
    ...               connection=${connection}
    Log               CMP RefNum and PresharedKey set
    ...               console=${TRUE}
    [Teardown]        Run Keyword And Ignore Error
    ...               Disconnect From Admin
    ...               connection=temporary_admin_connection

Get Certificates List
    [Arguments]       ${cert_type}=All
    ...               ${connection}=${NONE}
    ${connection}=    create_connection_if_not_exist
    ...               connection=${connection}
    ...               alias=temporary_admin_connection
    Log               Getting certificate list
    ...               console=${TRUE}
    ${certs_list}=    coam_admin.get_certificate_list
    ...               cert_type=${cert_type}
    ...               connection=${connection}
    Log               Certificate list: ${certs_list}
    ...               console=${TRUE}
    [Return]          ${certs_list}
    [Teardown]        Run Keyword And Ignore Error
    ...               Disconnect From Admin
    ...               connection=temporary_admin_connection

Clear Certificates
    [Arguments]       ${connection}=${NONE}
    ${connection}=    create_connection_if_not_exist
    ...               connection=${connection}
    ...               alias=temporary_admin_connection
    Log                                 Clearing certificates
    ...                                 console=${TRUE}
    coam_admin.restore_vendor_certificate    connection=${connection}
    FOR  ${attempt}  IN RANGE  30
        ${output}=    Run Keyword And Ignore Error     coam_admin.restore_vendor_certificate    connection=${connection}
        ${status}=    Run Keyword And Return Status    Should Contain    ${output}
        ...                                                              Succeeded
        ...                                                              ignore_case=True
        Exit For Loop If                               '${status}'=='${TRUE}'
    END
    Remove Additional Certificates
    Log               All certificates deleted
    ...               console=${TRUE}
    [Teardown]        Run Keyword And Ignore Error
    ...               Disconnect From Admin
    ...               connection=temporary_admin_connection

Remove Additional Certificates
    [Documentation]  Delete additional certificates from BTS.
    ${connection}=                  Connect To Admin
    Log                             Removing additional certificates
    ...                             console=${TRUE}
    ${cert_list}                    coam_admin.get_certificate_list
    ...                             cert_type=All
    ...                             connection=${connection}
    ${cert_list}                    get_operator_certificates           cert_list=${cert_list}
    ${fingerprints}                 get_certificates_fingerprints       cert_list=${cert_list}
    delete_multiple_certificates    fingerprints=${fingerprints}
    ...                             connection=${connection}
    [Teardown]                      Disconnect From Admin               ${connection}

Initialize Certificates From NetAct
    [Arguments]       ${cert_type}=RSA    ${timeout}=300
    Setup Environment For EMSSIM    ${cert_type}
    ${emssim_connection}=           Activate EMSSIM
    Log               ${cert_type} certificates initialization request sent
    ...               console=${TRUE}
    Wait Until Keyword Succeeds     20s
    ...               coam_admin.cmp_initialize_certificate    key_pool_type=${cert_type}
    ...                                                   connection=${emssim_connection}
    ...                                                   timeout=${timeout}
    [Teardown]        Disconnect From EMSSIM              connection=${emssim_connection}

Get Operator Certificates List
    ${connection}=          Connect To Admin
    Log                     Getting operator certificates
    ...                     console=${TRUE}
    ${certs_list}=          Get Certificates List
    ${operator_certs}=      get_operator_certificates    cert_list=${certs_list}
    Log                     Operator certificates: ${operator_certs}
    ...                     console=${TRUE}
    [Return]                ${operator_certs}

Install Certificate On BTS
    [Documentation]
    ...              Certificate type, one of: ["BtsTrustChain", "AdditionalCa", "CBRSVendorChain", "CBRSAdditionalCa"
    ...              Certificate format, one of: ["PEM", "P12", "DER"]
    [Arguments]      ${cert_file}
    ...              ${cert_type}
    ...              ${cert_format}
    ...              ${p12password}=${NONE}
    ...              ${key_pool_type}=RSA
    ...              ${connection}=${NONE}
    ${connection}=          create_connection_if_not_exist
    ...                     connection=${connection}
    ...                     alias=temporaryAdminConnection
    ${output}               coam_admin.install_certificate
    ...                     cert_file=${cert_file}
    ...                     cert_type=${cert_type}
    ...                     cert_format=${cert_format}
    ...                     password=${p12password}
    ...                     connection=${connection}
    ...                     key_pool_type=${key_pool_type}
    Log                     ${cert_type} certificate installed       console=${TRUE}
    [Teardown]              Run Keyword And Ignore Error             Disconnect From Admin
    ...                                                              connection=temporaryAdminConnection

Get KeyPoolType From BTS Certificate
    [Arguments]  ${issuer}
    ${cert_list}=           Get Certificates List  TA
    Log                     ${cert_list}                              console=true
    FOR  ${list}  IN  @{cert_list}
        Log   ${list}  console=true
        ${keyPoolType}=   Set variable  ${list}[keyPoolType]
        Return From Keyword If  '${list}[issuer]'==${issuer}  ${keyPoolType}
    END

Check If Certificate File Is Present On BTS
    [Arguments]  ${keyPoolType}
    ${connection}=           Connect To BTS With SSH
    ${output}=               Execute  openssl x509 -in ${CERT_PATHS}[${keyPoolType}] -text    connection=${connection}
    Log                      ${output}                                                        console=true
    Should Not Contain Any   ${output}  No such file or directory  unable to load certificate
    [Teardown]               Disconnect From BTS With SSH

Delete Certificate From BTS
    [Arguments]      ${fingerprint}
    ${connection}=   Connect To Admin
    ${output}        coam_admin.delete_certificate
    ...              fingerprint=${fingerprint}
    ...              connection=${connection}
    Log              Certificate ${fingerprint} deleted.            console=${TRUE}
    [Teardown]       Run Keyword And Ignore Error                   Disconnect From Admin

Remove Certificate by WebEM
    ${FPRINT_ECDSA}=               Check if fingerprint is stored         issuer=${ECDSA_ISSUER}
    ${FPRINT_RSA}=                 Check if fingerprint is stored         issuer=${RSA_ISSUER}
    Delete Certificate From BTS    ${FPRINT_ECDSA}
    ${FPRINT_ECDSA}=               Check if fingerprint is stored         issuer=${ECDSA_ISSUER}
    Should be equal as strings     ${FPRINT_ECDSA}                        None
    Delete Certificate From BTS    ${FPRINT_RSA}
    ${FPRINT_ECDSA}=               Check if fingerprint is stored         issuer=${RSA_ISSUER}
    Should be equal as strings     ${FPRINT_ECDSA}                        None

Create CRLDP Object if doesn't Exist or Change Parameter
    [Documentation]      This keyword creates CRLDPCONFIG objects if it doesn't exists. If oject exists keyword changes
    ...                  CRLDP parameter value.
    [Arguments]          ${parameter}        ${param_value}
    ${connection}=       Connect To Admin
    ${object_status}     Check if Object Exists in Scf File
    ...                  dist_name=MRBTS-${BTS_ID}/MNL-1/CERTH-1/CRLH-1
    ...                  object_name=CRLDPCONFIG-1
    ...                  timeout=900
    Run Keyword if       ${object_status}==False    coam_admin.perform_object_recommissioning
    ...                  dist_name=MRBTS-${BTS_ID}/MNL-1/CERTH-1/CRLH-1/CRLDPCONFIG-1
    ...                  parameter=${parameter}
    ...                  operation=create
    ...                  skip_parameter_relation_errors=${FALSE}
    ...                  should_activate=${True}
    ...                  connection=${connection}
    ...    ELSE          coam_admin.perform_parameter_recommissioning
    ...                  dist_name=MRBTS-${BTS_ID}/MNL-1/CERTH-1/CRLH-1/CRLDPCONFIG-1
    ...                  parameter=primaryCRLDP
    ...                  operation=update
    ...                  value=${param_value}
    ...                  skip_parameter_relation_errors=${FALSE}
    ...                  timeout=300
    ...                  connection=${connection}
    [Teardown]           Run Keyword And Ignore Error    Disconnect From Admin
    ...                                                  connection=temporaryAdminConnection

Get CRL from BTS
    [Documentation]      This keyword gets the CRL from BTS. Fails when no CRL is found.
    ${connection}=       Connect To Admin
    ${value}=            coam_admin.Get Certificate Revocation List  domain_type=3GPP   timeout=900  connection=${connection}
    ${type}=             Evaluate    type($value).__name__
    Run Keyword If       '${type}'=='str'     Fail  msg=No CRL
    Log                  value is: ${value}   console=true
    [Return]             ${value}
    [Teardown]           Run Keyword And Ignore Error    Disconnect From Admin
    ...                                                  connection=${connection}

Update CRL and Wait for Download
    [Documentation]      This keyword updates CRL and waits for CRL to appear.
    ${connection}=       Connect To Admin
    Run Keyword and Ignore Error
    ...                  coam_admin.update_certificate_revocation_list
    ...                  domain_type=3GPP  timeout=900  connection=${connection}
    Wait Until Keyword Succeeds
    ...                  5min  10s    Get CRL from BTS
    ${crl}=              Get CRL from BTS
    [Return]             ${crl}
    [Teardown]                             Run Keyword And Ignore Error    Disconnect From Admin
    ...                                                                    connection=${connection}

Set Cert Update Time Boundary Values
    ${cert_list}=           Get Certificates List             cert_type=BTS
    ${sw_release}=   Get Software Release Name
    ${validity}=            get_cert_validity                 ${cert_list}          ${sw_release}
    Set Global Variable     ${first_invalid}                  ${validity}
    Set Global Variable     ${last_valid}                     ${${first_invalid}-${1}}

Set Cert Update Time Param
    [Arguments]    ${param_value}
    Change Parameter on BTS    dist_name=MRBTS-${BTS_ID}/MNL-1/CERTH-1/CMP-1
    ...                        param_name=neCertificateUpdateTime
    ...                        param_value=${param_value}

Check CMP And BTS Trust Chain Certificates Validities
    ${cert_list_ta}=           Get Certificates List                    cert_type=TA
    ${FPRINT_RSA}=             Check if fingerprint is stored           issuer=CN = CB008154
    ${sw_release}=             Get Software Release Name
    ${add_cert_validity}=      get_cert_validity                        cert_list=${cert_list_ta}
    ...                                                                 sw_release_name=${sw_release}
    ...                                                                 fingerprint=${FPRINT_RSA}
    check_add_cert_validity    ${add_cert_validity}
    ${tc_cert}=                check_certs_validity                     ${add_cert_validity}            ${first_invalid}
    ${fail_optional_message}=  Catenate                                 Validity of End Entity cert from p12 file (${add_cert_validity}
    ...                                                                 days) is longer or equal to validity of End Entity cert
    ...                                                                 from CMP init (${first_invalid} days). \n Please use cert from
    ...                                                                 p12 file with validity less than ${first_invalid} days.
    Should Be True             ${add_cert_validity} < ${first_invalid}  msg=${fail_optional_message}

Is Alarm Active in Admin
   [Arguments]             ${fault_id}
   ${connection}=          Connect To Admin
   ${active_alarms}=       coam_admin.get_active_alarms    connection=${connection}
   ${is_alarm_present}=    check_fault_in_alarm_list       ${active_alarms}                ${fault_id}
   [Teardown]              Run Keyword And Ignore Error    Disconnect From Admin
   ...                                                     connection=${connection}
   [Return]   ${is_alarm_present}

Check If Fault Is Active
    Wait Until Keyword Succeeds    10 min  30s    Alarm Should Be Active In BTS        fault_id=${fault_id}

Check If Fault Is Not Active
    Wait Until Keyword Succeeds    10 min  30s    Alarm Should Not Be Active In BTS    fault_id=${fault_id}

Alarm Should Be Active In BTS
   [Arguments]             ${fault_id}
   ${is_alarm_present}=    Is Alarm Active In Admin    ${fault_id}
   Should Be True          ${is_alarm_present}         msg=Alarm with Fault Id ${fault_id} not present in gnb.

Alarm Should Not Be Active in BTS
   [Arguments]   ${fault_id}
   ${is_alarm_present}=    Is Alarm Active In Admin    ${fault_id}
   Should Not Be True      ${is_alarm_present}         msg=Alarm with Fault Id ${fault_id} present in gnb.

Copy Certificates To Emssim
    Log    ${TOO_SHORT}    console=${TRUE}
    Run    sudo cp ${TOO_SHORT}/cacert.pem /opt/emssim/proxy/ssl/cacert.pem
    Run    sudo cp ${TOO_SHORT}/servercert.pem /opt/emssim/proxy/ssl/servercert.pem
    Run    sudo cp ${TOO_SHORT}/serverprivkey.pem /opt/emssim/proxy/ssl/serverprivkey.pem
    Run    sudo cp ${TOO_SHORT}/cacert.pem /etc/apache2/ssl.crt/cacert.pem
    Run    sudo cp ${TOO_SHORT}/servercert.pem /etc/apache2/ssl.crt/servercert.pem
    Run    sudo cp ${TOO_SHORT}/serverprivkey.pem /etc/apache2/ssl.key/serverprivkey.pem
    Run    sudo systemctl restart apache2
    Run    sudo systemctl restart fbox

Expected Failure Reason Should be Present on BTS
    [Documentation]      This keyword checks if given CRL failure reason matches CRL failure reason on BTS.
    ...                  Fails when failure reasons don't match.
    [Arguments]          ${messages}
    ${connection}=       Connect To Admin
    ${crl}=              Get CRL from BTS
    ${failure_reason}=   Set Variable        ${crl}[0][stateInfo][reasoningStatus][0]
    Should Be Equal      ${failure_reason}   ${messages}
    [Teardown]           Run Keyword And Ignore Error    Disconnect From Admin
    ...                                                  connection=${connection}

Create Issuers List
    ${connection}=    Connect To Admin
    ${cert_list}=     Get Certificates List
    @{issuers}=       Create List    ${EMPTY}
    FOR  ${list}  IN  @{cert_list}
        Log    ${list}    console=${TRUE}
        Append To List    ${issuers}    ${list}[issuer]
    END
    [Return]      @{issuers}
    [Teardown]    Run Keyword And Ignore Error    Disconnect From Admin
    ...                                           connection=${connection}

Get Hostname From BTS Certificate Subject
    [Arguments]       ${cert_filepath}
    ${connection}=    Connect To BTS With SSH
    ${hostname}=      Decode Hostname From Certificate File    ${cert_filepath}
    ...                                                        ${connection}
    [Return]          ${hostname}
    [Teardown]        Disconnect From BTS With SSH             ${connection}

Decode Hostname From Certificate File
    [Arguments]       ${cert_filepath}
    ...               ${connection}
    ${subject}=       Execute         openssl x509 -in ${cert_filepath} -text | grep Subject:
    ...                               connection=${connection}
    @{hostname}=      Split String    ${subject}
    [Return]          ${hostname}[9]
