TLS Key Renegotiation
    ${vm_ip}=                        Get VM IPv4 Address
    Set CMP Server Settings
    Configure CMP
    Set Certification Type
    Initialize Certificates
    Set MPLANENW Parameter           tls12Enabled                true
    Set MPLANENW Parameter           actEnableTLSv13             false
    Set MPLANENW Parameter           oamTls                      forced
    Set MPLANENW Parameter           tlsRenegotiationInterval    300
    Setup Environment For EMSSIM     enable_tls=1
    Start TCPDump
    ${emssim_connection}=            Activate EMSSIM    enable_tls=1
    Log                              Waiting 320 seconds to capture packets from interval
    Sleep                            320s               reason=Wait for capturing tcpdump logs
    ${tcpdump_path}=                 Stop TCPDump And Download PCAP    tcpdump_filename=key_renegotiation.pcap
    @{pcap_list}=                    Create List
    ${pcap_filters_before}=          Set Variable
    ...    tls.record.content_type == 22 && ip.src == ${MPLANE_IPV4} && ip.dst == ${vm_ip} && frame.time_relative < 300
    ${pcap_filters_after}=           Set Variable
    ...    tls.record.content_type == 22 && ip.src == ${MPLANE_IPV4} && ip.dst == ${vm_ip} && frame.time_relative > 300
    ${output_before}=    Run    tshark -r ${tcpdump_path} -Y "${pcap_filters_before}" -Tfields -e frame.time_relative
    ${output_after}=     Run    tshark -r ${tcpdump_path} -Y "${pcap_filters_after}" -Tfields -e frame.time_relative
    @{pcap_list_before}=             Split String          ${output_before}       \n
    @{pcap_list_after}=              Split String          ${output_after}        \n
    ${last_packet_before}=           Get From List         ${pcap_list_before}    -1
    ${first_packet_after}=           Get From List         ${pcap_list_after}      0
    ${last_packet_before_number}=    Convert To Number     ${last_packet_before}
    ${first_packet_after_number}=    Convert To Number     ${first_packet_after}
    ${time_interval}=                Evaluate              ${first_packet_after_number} - ${last_packet_before_number}
    Log                              Time interval: ${time_interval}    console=${TRUE}
    Should Be True                   ${time_interval} > 300
    [Teardown]       Run Keywords    Disconnect From EMSSIM    connection=${emssim_connection}
    ...              AND             Set MPLANENW Parameter    oamTls    off
    ...              AND             TCPDump Teardown
    ...              AND             Clear Certificates

TLS Cipher Selection During The TLS
    ${vm_ip}=                       Get VM IPv4 Address
    Set CMP Server Settings
    Configure CMP
    Set Certification Type
    Initialize Certificates
    Set MPLANENW Parameter          actEnableTLSv13    true
    Set MPLANENW Parameter          tls12Enabled       false
    Set MPLANENW Parameter          oamTls             forced
    Setup Environment For EMSSIM    enable_tls=1
    Start TCPDump
    ${emssim_connection}=           Activate EMSSIM    enable_tls=1
    Sleep                           30s                reason=Wait for capturing tcpdump logs
    ${tcpdump_path}=                Stop TCPDump And Download PCAP    tcpdump_filename=cipher_selection.pcap
    PCAP Should Contain Message
    ...    tshark_filter=tls.record.content_type == 22 && ip.src == ${MPLANE_IPV4} && ip.dst == ${vm_ip}
    ...    pcap_file=${tcpdump_path}
    Convert Pcap To XML    filename=${tcpdump_path}
    ...                    filters=tls.record.content_type == 22 && ip.src == ${MPLANE_IPV4} && ip.dst == ${vm_ip}
    ...                             xml_name=${OUTPUT DIR}/cipher_selection_server.xml
    ${cipher_server_list}=          find_ciphersuites    ${OUTPUT DIR}/cipher_selection_server.xml
    Log                             Cipher server: ${cipher_server_list}[0]    console=${TRUE}
    Convert Pcap To XML    filename=${tcpdump_path}
    ...                    filters=tls.record.content_type == 22 && ip.src == ${vm_ip} && ip.dst == ${MPLANE_IPV4}
    ...                    xml_name=${OUTPUT DIR}/cipher_selection_client.xml
    ${cipher_client_list}=          find_ciphersuites    ${OUTPUT DIR}/cipher_selection_client.xml
    Log                             Cipher client: ${cipher_client_list}[0]    console=${TRUE}
    Should Be Equal                 ${cipher_server_list}[0]                   ${cipher_client_list}[0]
    @{client_ciphers}=              Create List
    FOR   ${cipher_client}   IN   @{cipher_client_list}
        ${name_part1}=    Fetch From Right     ${cipher_client}    :
        ${name_part2}=    Fetch From Left      ${name_part1}       (
        ${full_name}=     Strip String         ${name_part2}
        Append To List    ${client_ciphers}    ${full_name}
    END
    Log                 ${client_ciphers}    console=${TRUE}
    Remove From List    ${client_ciphers}    -1
    Log                 ${client_ciphers}    console=${TRUE}
    sequence_list_for_cipher_selection       ${client_ciphers}    ${CIPHER_SUITES_1_3_SELECTION}
    [Teardown]          Run Keywords    Disconnect From EMSSIM    connection=${emssim_connection}
    ...                 AND             Set MPLANENW Parameter    oamTls    off
    ...                 AND             TCPDump Teardown
    ...                 AND             Clear Certificates

