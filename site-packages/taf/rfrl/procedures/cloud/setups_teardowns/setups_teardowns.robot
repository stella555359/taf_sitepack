*** Keywords ***
Cloud Suite Setup
    [Documentation]           :param cus_scf_paths: dictionary with absolute paths to SCF files which will be used for
    ...                                             commissioning of each CU (specified by its name);
    ...                                             if CU is omitted in the dictionary, it will not be commissioned;
    ...                                             i.e. {'CU_8463': '/home/ute/scf/MRBTS-1/CU_8463.xml',
    ...                                                   'CU_8464': '/home/ute/scf/MRBTS-1/CU_8464.xml'}
    ...                                             defaults to None (CUs will not be commissioned at all)
    ...                       :param dus_scf_paths: dictionary with absolute paths to SCF files which will be used for
    ...                                             commissioning of each DU (specified by its name);
    ...                                             if DU is omitted in the dictionary, it will not be commissioned;
    ...                                             i.e. {'NRDU-1': '/home/ute/scfs/nrdu_1_scf.xml',
    ...                                                   'NRDU-2': '/home/ute/scfs/nrdu_2_scf.xml'}
    ...                                             defaults to None (DUs will not be commissioned at all)
    ...                       :custom_tl: overrides testline (tl) definition from default init file with testline
    ...                                   definition from custom init file for the duration of entire test suite execution;
    ...                                   defaults to None (testline from default init file will be used)
    ...                                   user should also provide compatible SCF files for CUs and DUs (cus_scf_paths and dus_scf_paths);
    ...                       :param check_bts_state: defines whether current state of BTS(s) should be checked against
    ...                                               standard state expected after suite setup;
    ...                                               defaults to True (BTS(s) state will be checked)
    ...                       :param collect_syslog: defines whether syslog should be collected during suite setup;
    ...                                              defaults to True (syslog will be collected)
    ...                       :param collect_snapshot: defines whether snapshots from all CUs and DUs should be collected after suite setup;
    ...                                                defaults to True (snapshots will be collected)
    ...                       :param collect_rmod_logs: defines whether LMI should be used to collect serial logs from all RMODs during suite setup 
    ...                                                 and to collect snapshot from all RMODs after suite setup;
    ...                                                 defaults to True (RMOD logs will be collected)
    ...                       :param rmod_logs_config_path: absolute path to YAML file with custom configuration of RMOD logs collection;
    ...                                                     takes effect only if RMOD logs collection via LMI is enabled;
    ...                                                     example of YAML file content can be found in taf.hw.rf_diagnostic_card.examples.custom_setup_example.yaml;
    ...                                                     defaults to None (default configuration will be used)
    [Arguments]               ${cus_scf_paths}=${None}
    ...                       ${dus_scf_paths}=${None}
    ...                       ${custom_tl}=${None}
    ...                       ${check_bts_state}=${True}
    ...                       ${collect_syslog}=${True}
    ...                       ${collect_snapshot}=${True}
    ...                       ${collect_rmod_logs}=${True}
    ...                       ${rmod_logs_config_path}=${None}

    Log To Console            Suite Setup
    vm.show_virtual_environment
    Set global variable       ${tl_suite_config}
    ...                       ${tl}

    IF                        ${custom_tl}
        Run Keyword If        """${cus_scf_paths}"""=="""${None}""" or """${dus_scf_paths}"""=="""${None}"""
        ...                   logger.log_warning
        ...                   msg=Custom init file is provided, but no SCF paths are specified for DU or CU. Please always provide SCF paths if any BTS components are changed by custom init.
        Set global variable   ${tl_suite_config}
        ...                   ${custom_tl}
        logger.log_info       msg=Switching to custom testline configuration for the entire suite duration
        ...                   to_console=${True}
    END

    ${testing_env}=           create_testing_env
    ...                       tl=${tl_suite_config}
    ...                       output_dir_path=${OUTPUT DIR}
    Set Global Variable       ${testing_env}
    ...                       ${testing_env}

    Configure Log Collection  tl=${tl_suite_config}
    ...                       test_case_name=Cloud_Suite_Setup
    ...                       collect_syslog=${collect_syslog}
    ...                       collect_snapshot=${collect_snapshot}
    ...                       collect_rmod_logs=${collect_rmod_logs}
    ...                       rmod_logs_config_path=${rmod_logs_config_path}
    prepare_testing_env       testing_env=${testing_env}
    ...                       tl=${tl_suite_config}
    ...                       cus_scf_paths=${cus_scf_paths}
    ...                       dus_scf_paths=${dus_scf_paths}
    ...                       check_bts_state=${check_bts_state}

    logger.log_info           msg=Saving suite SCF configuration files
    ...                       to_console=${True}
    ${scf_suite_config}=      save_initial_configs
    ...                       testing_env=${testing_env}
    Set Global Variable       ${scf_suite_config}
    ...                       ${scf_suite_config}

    [Teardown]                cleanup_testing_env
    ...                       testing_env=${testing_env}
    ...                       test_result=${KEYWORD STATUS}


Cloud Suite Teardown
    Log To Console            ${\n}
    Log To Console            IMPORTANT!
    Log To Console            Standard log.html has been saved to ${OUTPUT DIR}/log.html.
    Log To Console            However, if you would like to have better formatted and more readable log, do the following:
    Log To Console            1. Open NEW terminal
    Log To Console            2. Activate Python virtual environment which was used to execute this test suite
    Log To Console            3. Run command: prettylog ${OUTPUT DIR}
    Log To Console            4. Open log using command: firefox ${OUTPUT DIR}/pretty_log.html
    Log To Console            NOTE: to be able to generate pretty log, test suite must be executed with TRACE log level enabled (-L TRACE)
    Log To Console            ${\n}


Cloud Test Setup
    [Documentation]           :param cus_scf_paths: dictionary with absolute paths to SCF files which will be used for
    ...                                             commissioning of each CU (specified by its name);
    ...                                             if CU is omitted in the dictionary, it will not be commissioned;
    ...                                             i.e. {'CU_8463': '/home/ute/scf/MRBTS-1/CU_8463.xml',
    ...                                                   'CU_8464': '/home/ute/scf/MRBTS-1/CU_8464.xml'}
    ...                                             defaults to None (CUs will not be commissioned at all)
    ...                       :param dus_scf_paths: dictionary with absolute paths to SCF files which will be used for
    ...                                             commissioning of each DU (specified by its name);
    ...                                             if DU is omitted in the dictionary, it will not be commissioned;
    ...                                             i.e. {'NRDU-1': '/home/ute/scfs/nrdu_1_scf.xml',
    ...                                                   'NRDU-2': '/home/ute/scfs/nrdu_2_scf.xml'}
    ...                                             defaults to None (DUs will not be commissioned at all)
    ...                       :custom_tl: overrides testline (tl) definition from suite init file with testline
    ...                                   definition from custom init file for the duration of test execution;
    ...                                   user should also provide compatible SCF files for CUs and DUs (cus_scf_paths and dus_scf_paths);
    ...                                   during test teardown suite testline configuration will be restored
    ...                                   (if this is not desired behaviour, please look at restore_suite_config_in_teardown argument);
    ...                                   defaults to None (testline from suite init file will be used)
    ...                       :param check_bts_state: defines whether current state of BTS(s) should be checked against
    ...                                               standard state expected before starting test execution;
    ...                                               defaults to True (BTS(s) state will be checked)
    ...                       :param restore_suite_config_in_teardown: defines whether suite testline configuration should be restored
    ...                                                                after test execution if custom init was provided;
    ...                                                                defaults to True (suite testline configuration will be restored)
    ...                       :param collect_syslog: defines whether syslog should be collected during test execution;
    ...                                              defaults to True (syslog will be collected)
    ...                       :param collect_snapshot: defines whether snapshots from all CUs and DUs should be collected after test execution;
    ...                                                defaults to True (snapshots will be collected)
    ...                       :param collect_rmod_logs: defines whether LMI should be used to collect serial logs from all RMODs during test execution
    ...                                                 and to collect snapshot from all RMODs after test execution;
    ...                                                 defaults to True (RMOD logs will be collected)
    ...                       :param rmod_logs_config_path: absolute path to YAML file with custom configuration of RMOD logs collection;
    ...                                                     takes effect only if RMOD logs collection via LMI is enabled;
    ...                                                     example of YAML file content can be found in taf.hw.rf_diagnostic_card.examples.custom_setup_example.yaml;
    ...                                                     defaults to None (default configuration will be used)
    ...                       :param ues: configurations of UEs from init file which will be used during test execution;
    ...                                   defaults to None (no UEs will be used, L3 call will not be executed during test)
    ...                       :param ue_reboot: defines whether UEs should be rebooted before test execution;
    ...                                         defaults to False (UEs will not be rebooted)
    ...                       :param ue_network_modes: UE serial numbers paired with desired network modes;
    ...                                                i.e. {'HZQN1876AAK90100042': 'NR_only',
    ...                                                      'M6AIKN009217SWX': 'LTE_only'}
    ...                                                possible UE network modes: 'NR_only', 'LTE_only', 'NR_LTE';
    ...                                                when using more than one UE please make sure that modes you choose are either all
    ...                                                with '_only' suffix or all are 'NR_LTE' as it is not yet possible to mix those.
    ...                                                this param is mandatory for SA+NSA mode;
    ...                                                defaults to None (network mode will not be changed on any UE))
    [Arguments]               ${cus_scf_paths}=${None}
    ...                       ${dus_scf_paths}=${None}
    ...                       ${custom_tl}=${None}
    ...                       ${check_bts_state}=${True}
    ...                       ${restore_suite_config_in_teardown}=${True}
    ...                       ${collect_syslog}=${True}
    ...                       ${collect_snapshot}=${True}
    ...                       ${collect_rmod_logs}=${True}
    ...                       ${rmod_logs_config_path}=${None}
    ...                       ${ues}=${None}
    ...                       ${ue_reboot}=${False}
    ...                       ${ue_network_modes}=${None}

    Log To Console            Test Setup

    Set global variable       ${tl_test_config}
    ...                       ${tl_suite_config}

    IF                        ${custom_tl}
        Run Keyword If        """${cus_scf_paths}"""=="""${None}""" or """${dus_scf_paths}"""=="""${None}"""
        ...                   logger.log_warning
        ...                   msg=Custom init file is provided, but no SCF paths are specified for DU or CU. Please always provide SCF paths if any BTS components are changed by custom init.
        logger.log_info       msg=Switching to new custom testline configuration
        ...                   to_console=${True}
        Set global variable   ${tl_test_config}
        ...                   ${custom_tl}

        update_testing_env    testing_env=${testing_env}
        ...                   tl=${tl_test_config}

        Set Test Variable     ${restore_suite_config_in_teardown}
        ...                   ${restore_suite_config_in_teardown}
    ELSE
        Set Test Variable     ${restore_suite_config_in_teardown}
        ...                   ${False}
    END
    logger.log_debug          msg=Restoring main suite testline configuration in Test Teardown is set to: ${restore_suite_config_in_teardown}
    
    Configure Log Collection  tl=${tl_test_config}
    ...                       collect_syslog=${collect_syslog}
    ...                       collect_snapshot=${collect_snapshot}
    ...                       collect_rmod_logs=${collect_rmod_logs}
    ...                       rmod_logs_config_path=${rmod_logs_config_path}
    prepare_testing_env       testing_env=${testing_env}
    ...                       tl=${tl_test_config}
    ...                       cus_scf_paths=${cus_scf_paths}
    ...                       dus_scf_paths=${dus_scf_paths}
    ...                       check_bts_state=${check_bts_state}
    ...                       ues=${ues}
    ...                       ue_reboot=${ue_reboot}
    ...                       ue_network_modes=${ue_network_modes}


Cloud Test Teardown
    Log To Console            Test Teardown

    IF                        ${restore_suite_config_in_teardown}
        logger.log_info       msg=Restoring suite testline configuration
        ...                   to_console=${True}
        restore_initial_configs
        ...                   testing_env=${testing_env}
        ...                   config_info=${scf_suite_config}
        Set global variable   ${tl_test_config}
        ...                   ${tl_suite_config}
    END

    cleanup_testing_env       testing_env=${testing_env}
    ...                       test_result=${TEST STATUS}

    IF                        ${restore_suite_config_in_teardown}
        update_testing_env    testing_env=${testing_env}
        ...                   tl=${tl_test_config}
    END


Configure Log Collection
    [Arguments]               ${tl}
    ...                       ${test_case_name}=${TEST NAME}
    ...                       ${collect_syslog}=${True}
    ...                       ${collect_snapshot}=${True}
    ...                       ${collect_rmod_logs}=${True}
    ...                       ${rmod_logs_config_path}=${None}

    ${log_group_name}=        Set Variable
    ...                       syslogs

    ${logs_config}=           Call Method
    ...                       ${testing_env.log_collector}
    ...                       configure_log_collection
    ...                       tl_config=${tl}
    ...                       btss=${testing_env.btss}
    ...                       test_case_name=${test_case_name}
    ...                       logs_path=${OUTPUT DIR}
    ...                       group_name=${log_group_name}
    ...                       syslog=${collect_syslog}
    ...                       snapshot=${collect_snapshot}
    ...                       rmod_logs=${collect_rmod_logs}
    ...                       rmod_logs_config_path=${rmod_logs_config_path}

    Run Keyword If            ${collect_syslog}
    ...                       Run Keywords
    ...                       ul_log_collection.create_collectors_using_testline_information
    ...                       names=${log_group_name}
    ...                       configuration=${logs_config}
    ...                       AND
    ...                       ul_log_collection.set_suite_alias
    ...                       ${log_group_name}
