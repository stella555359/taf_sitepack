*** Keywords ***
CNI_130230_Configuration_with_a_redundant_link_and_switching_between_them_in_a_loop
    [Documentation]
    ...    Purpose of this test case is to verify BTS behavior when switched to a configuration with a redundant
    ...    link in a loop.
    ...
    ...    ARGS:
    ...    :param dict redundant_cablink: (Mandatory) : dictionary with id and JSON delta which is needed to create
    ...                                                 redundant CABLINK object in BTS, example:
    ...                     redundant_cablink = {
    ...                                             'id': (int) id of redundant cablink,
    ...                                             'delta': (list) JSON delta needed to create CABLINK object in BTS
    ...                                         }
    ...    :param dict primary_cablink: (Mandatory) : dictionary with id and JSON delta which is needed to recreate
    ...                                               primary CABLINK object in BTS, example:
    ...                     primary_cablink = {
    ...                                           'id': (int) id of redundant cablink,
    ...                                           'delta': (list) JSON delta needed to create CABLINK object in BTS
    ...                                       }
    ...    :param int iterations: (Optional) : number of iterations in loop, default is 20
    ...    :param str bts_type: (Optional) : type of BTS, default is gnb, possible values: gnb, enb
    ...    :param int bts_id: (Optional) : BTS id, default is 0

    [Arguments]    ${redundant_cablink}
    ...            ${primary_cablink}
    ...            ${iterations}=${20}
    ...            ${bts_type}=gnb
    ...            ${bts_id}=${0}

    FOR  ${iter}    IN RANGE    ${iterations}
        logger.Log Info To Console                   msg=Loop iteration=${iter}
        ...                                          log_hierarchy=${1}
        logger.Log Info To Console                   msg=Creating `redundant` link
        ...                                          log_hierarchy=${2}
        Run Keyword                                  ${bts_type}cable.Create Cablink Instance
        ...                                          delta=${redundant_cablink}[delta]
        ...                                          bts_id=${bts_id}
        logger.Log Info To Console                   msg=Waiting for all cells to be Onair after `redundant` link creation
        ...                                          log_hierarchy=${2}
        Wait Until Keyword Succeeds                  600 sec
        ...                                          30 sec
        ...                                          ${bts_type}cell.Verify All Cells Are Onair
        ...                                          bts_id=${bts_id}
        logger.Log Info To Console                   All cells are Onair
        ...                                          log_hierarchy=${2}
        logger.Log Info To Console                   msg=Deleating `primary` link
        ...                                          log_hierarchy=${2}
        Run Keyword                                  ${bts_type}cable.Delete Cablink Instance
        ...                                          cablink_id=${primary_cablink}[id]
        ...                                          bts_id=${bts_id}
        logger.Log Info To Console                   msg=Waiting for all cells to be Onair after `primary` link deletion
        ...                                          log_hierarchy=${2}
        Wait Until Keyword Succeeds                  600 sec
        ...                                          30 sec
        ...                                          ${bts_type}cell.Verify All Cells Are Onair
        ...                                          bts_id=${bts_id}
        logger.Log Info To Console                   All cells are Onair
        ...                                          log_hierarchy=${2}
        logger.Log Info To Console                   msg=Recreating `primary` link
        ...                                          log_hierarchy=${2}
        Run Keyword                                  ${bts_type}cable.Create Cablink Instance
        ...                                          delta=${primary_cablink}[delta]
        ...                                          bts_id=${bts_id}
        logger.Log Info To Console                   msg=Waiting for all cells to be Onair after `primary` link recreation
        ...                                          log_hierarchy=${2}
        Wait Until Keyword Succeeds                  600 sec
        ...                                          30 sec
        ...                                          ${bts_type}cell.Verify All Cells Are Onair
        ...                                          bts_id=${bts_id}
        logger.Log Info To Console                   All cells are Onair
        ...                                          log_hierarchy=${2}
        logger.Log Info To Console                   msg=Deleating `redundant` link
        ...                                          log_hierarchy=${2}
        Run Keyword                                  ${bts_type}cable.Delete Cablink Instance
        ...                                          cablink_id=${redundant_cablink}[id]
        ...                                          bts_id=${bts_id}
        logger.Log Info To Console                   msg=Waiting for all cells to be Onair after `redundant` link deletion
        ...                                          log_hierarchy=${2}
        Wait Until Keyword Succeeds                  600 sec
        ...                                          30 sec
        ...                                          ${bts_type}cell.Verify All Cells Are Onair
        ...                                          bts_id=${bts_id}
        logger.Log Info To Console                   All cells are Onair
        ...                                          log_hierarchy=${2}
    END
