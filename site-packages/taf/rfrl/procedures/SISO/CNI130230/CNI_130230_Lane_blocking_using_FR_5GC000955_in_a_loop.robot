*** Settings ***
Library    taf.rfrl.procedures.resources.python.sfp.GnbSFP                              WITH NAME    gnbsfp
Library    taf.rfrl.procedures.resources.python.sfp.EnbSFP                              WITH NAME    enbsfp

*** Keywords ***
CNI_130230_Lane_blocking_using_FR_5GC000955_in_a_loop
    [Documentation]
    ...    Purpose of this test case is to verify BTS behavior when LANE is locked and unlocked in a loop.
    ...    ARGS:
    ...    :param dict sfp_records: (Mandatory) : tuple/list in format:
    ...            sfp_record = {
    ...                'lane_dist_name': 'MRBTS-{}/EQM-1/APEQM-1/CABINET-1/BBMOD-1/SFP-1LANE-1',   # mandatory
    ...                'cells_affected_by_alarms': [1, 2, 3, 4],                                   # mandatory
    ...                'need_unlock_to_on_air': False,                                             # optional
    ...                'timeout_for_cells_initialization': '20 min',                               # optional
    ...                'timeout_for_cells_to_be_on_air': '6min'                                    # optional
    ...                'reset_site_after_lane_locking': 'False'                                    # optional
    ...                'time_for_site_available': '600'                                            # optional
    ...            }
    ...    :param int iterations: (Optional) : number of iterations in loop, default is 20
    ...    :param str bts_type: (Optional) : type of BTS, default is gnb, possible values: gnb, enb
    ...    :param int bts_id: (Optional) :BTS id, default is 0

    [Arguments]    ${sfp_records}
    ...            ${iterations}=${20}
    ...            ${bts_type}=gnb
    ...            ${bts_id}=${0}
    FOR    ${sfp_record}    IN    @{sfp_records}
        ${sfp_record}=                           Run Keyword
        ...                                      ${bts_type}sfp.verify_sfp_record_data
        ...                                      sfp_record=${sfp_record}
        ...                                      bts_id=${bts_id}
        Run Keyword                              ${bts_type}sfp.lock_sfp_with_alarm_verification
        ...                                      sfp_lock_record=${sfp_record}
        ...                                      bts_id=${bts_id}
        Run Keyword                              ${bts_type}sfp.unlock_sfp_with_alarm_verification
        ...                                      sfp_unlock_record=${sfp_record}
        ...                                      bts_id=${bts_id}
    END
