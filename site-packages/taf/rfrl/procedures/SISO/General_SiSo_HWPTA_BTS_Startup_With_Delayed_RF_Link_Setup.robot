*** Keywords ***
General_SiSo_HWPTA_BTS_Startup_With_Delayed_RF_Link_Setup
    [Documentation]  This test case verifies if BTS recovers to operational state after following scenario:
    ...              - all radios and smods are powered off
    ...              - SMODs are powered on
    ...              - radios are powered on one by one
    ...              ARGS:
    ...              - throughputs: dict with throughput and deviation values for each cell identified by
    ...                             it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells;
    ...                             defaults to None (L3 call will not be executed).
    ...                             Example:
    ...                             {
    ...                                 '827736065':
    ...                                      {
    ...                                          'throughput':
    ...                                              {
    ...                                                  'downlink': '100 Mbits/sec',
    ...                                                  'uplink': '15 Mbits/sec'
    ...                                              },
    ...                                          'deviation': '90%'
    ...                                      },
    ...                             }
    ...              - protocol: data transfer protocol; defaults to UDP.
    ...              - udp_buffer: monitoring data buffer; defaults to 4M.
    ...              - ue_network_modes: dict with UE serial numbers and desired network modes e.g. {"SN1234": "NR_only"}
    ...                                  possible UE network modes: NR_only, LTE_only, NR_LTE
    ...                                  when using more than one UE please make sure that the modes you choose are either all
    ...                                  with "_only" suffix or all "NR_LTE" as it is not yet possible to mix those.
    ...                                  mandatory for SA+NSA setups, defaults to None
    ...              - ues_and_cells: dict with UE serial numbers and lists of configuration distnames of cells to which they
    ...                               can be attached e.g. {"SN1234": ["MRBTS-50146/NRBTS-1/NRCELL-1", "MRBTS-50146/NRBTS-1/NRCELL-3"],
    ...                                                     "SN5678": ["MRBTS-50146/NRBTS-1/NRCELL-5"]}
    ...                               defaults to ${None} which means that all UEs will be attached to all cells.
    ...                               when given, listed cells will be called in pairs with specified UEs, if there are more
    ...                               cells on the setup that were not mentioned in the list, they will be called with all UEs
    ...              - tput_verification_via_btslog: True - throughput verification will be performed using btslog
    ...                                              False - throuput verification will be performed using iperf; defaults to False
    ...              - called_cells_distnames: CONFIGURATION distnames of cells that will be called, if not given,
    ...                                        list of all cells on testline will be determined and called
    ...              - ignored_cells_on_preparation: SHOULD BE USED WITH `prepare_cells_to_call` set to True!
    ...                                              list of cells CONFIGURATION distnames that should be ignored during
    ...                                              L3 Call not called cells preparation procedure and not be blocked/barred

    [Arguments]                              ${throughputs}=${None}
    ...                                      ${protocol}=udp
    ...                                      ${udp_buffer}=4M
    ...                                      ${ue_network_modes}=${None}
    ...                                      ${ues_and_cells}=${None}
    ...                                      ${tput_verification_via_btslog}=${False}
    ...                                      ${called_cells_distnames}=${None}
    ...                                      ${ignored_cells_on_preparation}=${None}

    ${bts_type}=                             hwpta_testline.get_type_of_setup
    ${connection}                            connections.get_default_admin_connection_alias
    ...                                      bts_type=${bts_type}
    Allow X2 Link Alarms
    Turn off power for all SMODs and RMODs
    Wait for BTS to become unavailable
    Turn on power for all SMODs
    Allow DSS Alarms If DSS On Any RMOD
    Wait for BTS to become available
    Wait for all SMODs to reach correct states
    ...                                      connection=${connection}
    Wait for all BBMODs to reach correct states
    Wait for fault 10 to become active on all RUs
    ...                                      bts_type=${bts_type}
    Turn on power for RMODs and wait for correct state
    ...                                      connection=${connection}
    Wait until keyword succeeds              5min
    ...                                      10s
    ...                                      Check all BBMODs RMODs and cells states for all RATs
    ...                                      bts_type=${bts_type}
    Check BTS state and all RATs states      bts_type=${bts_type}
    Alarms.Disallow X2 Link Alarms
    run keyword if                           ${throughputs}
    ...                                      Execute L3 call
    ...                                      cells_distnames=${called_cells_distnames}
    ...                                      throughputs=${throughputs}
    ...                                      protocol=${protocol}
    ...                                      udp_buffer=${udp_buffer}
    ...                                      ue_network_modes=${ue_network_modes}
    ...                                      ues_and_cells=${ues_and_cells}
    ...                                      tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                      ignored_cells_on_preparation=${ignored_cells_on_preparation}
    [Teardown]                               Run Keywords
    ...                                      power.turn_on_all_gnb_smods
    ...     AND                              power.turn_on_all_gnb_rmods
    ...     AND                              Disallow DSS Alarms If DSS On Any RMOD


Turn off power for all SMODs and RMODs
    Alarms.Allow alarm                       fault_name=No connection to unit
    ...                                      fault_id=10
    Alarms.Allow alarm                       fault_id=1815
    Alarms.Allow alarm                       fault_id=4589
    Alarms.Allow alarm                       fault_id=4590

    Robot Log Step                           Powering off all SMODs...
    power.turn_off_all_gnb_smods
    Robot Log Step                           Powering off all RMODs...
    power.turn_off_all_gnb_rmods

Turn on power for all SMODs
    Robot Log Step                           Powering on all SMODs...
    power.turn_on_all_gnb_smods

Wait for fault 10 to become active on all RUs
    [Arguments]                              ${bts_type}=GNB
    Robot Log Step                           Waiting for fault 10 to be visible on all RUs...
    ${count_of_rus}                          hwpta_testline.get_count_of_radios
    ...                                      bts_type=${bts_type}
    Wait for number of active alarms         expected_number_of_alarms=${count_of_rus}
    ...                                      fault_name=No connection to unit
    ...                                      fault_id=10
    ...                                      timeout=1200s

Turn on power for RMODs and wait for correct state
    [Arguments]                              ${connection}
    ${rmods_info}=                           admin_info_model.get_rmods_serial_numbers_and_runtime_dist_names
    ...                                      connection=${connection}
    FOR    ${serial_number}    IN     @{rmods_info}
                                             ${rmod_runtime_id}=  admin_info_model.get_rmod_index_from_dist_name
        ...                                  dist_name=${rmods_info}[${serial_number}]
                                             ${rmod_config_id}=  admin_info_model.translate_rmod_index_from_runtime
        ...                                  runtime_id=${rmod_runtime_id}
        ...                                  connection=${connection}
                                             Robot log step    Powering on RMOD with id ${rmod_runtime_id}
                                             power.turn_on_device
        ...                                  serial_number=${serial_number}
                                             Wait until keyword succeeds
        ...                                  20min
        ...                                  10s
        ...                                  status_check.verify_statuses_of_rmod
        ...                                  connection=${connection}
        ...                                  status_variant=online
        ...                                  rmod_id=${rmod_config_id}
                                             Wait for inactive alarm
        ...                                  timeout=60s
        ...                                  fault_id=10
        ...                                  fault_name=No connection to unit
        ...                                  hw_path=${rmods_info}[${serial_number}]
    END

    Alarms.Disallow alarm                    fault_name=No connection to unit
    ...                                      fault_id=10
    Alarms.Disallow alarm                    fault_id=1815
    Alarms.Disallow alarm                    fault_id=4589
    Alarms.Disallow alarm                    fault_id=4590
