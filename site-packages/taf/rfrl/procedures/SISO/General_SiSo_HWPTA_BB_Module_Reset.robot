*** Keywords ***
General_SiSo_HWPTA_BB_Module_Reset
    [Documentation]  ARGS:
    ...              - called_cells_distnames: CONFIGURATION distnames of cells that will be called, if not given,
    ...                                 list of all cells on testline will be determined and called
    ...              - throughputs: dict with throughput and deviation values for each cell identified by
    ...                             it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells;
    ...                             defaults to None (L3 call will not be executed).
    ...                             Example:
    ...                             {
    ...                                 '827736065':
    ...                                      {
    ...                                          'throughput':
    ...                                              {
    ...                                                  'downlink': '100 Mbits/sec',
    ...                                                  'uplink': '15 Mbits/sec'
    ...                                              },
    ...                                          'deviation': '90%'
    ...                                      },
    ...                             }
    ...              - protocol: data transfer protocol; defaults to UDP.
    ...              - udp_buffer: monitoring data buffer; defaults to 4M.
    ...              - tput_verification_via_btslog: True - throughput verification will be performed using btslog;
    ...                                              False - throughput verification will be performed using iperf; 
    ...                                              defaults to False.
    ...              - ue_network_modes: dict with UE serial numbers and desired network modes e.g. {"SN1234": "NR_only"}
    ...                                  possible UE network modes: NR_only, LTE_only, NR_LTE
    ...                                  when using more than one UE please make sure that the modes you choose are either all
    ...                                  with "_only" suffix or all "NR_LTE" as it is not yet possible to mix those.
    ...                                  mandatory for SA+NSA setups, defaults to None
    ...              - ues_and_cells: dict with UE serial numbers and lists of configuration distnames of cells to which they
    ...                               can be attached e.g. {"SN1234": ["MRBTS-50146/NRBTS-1/NRCELL-1", "MRBTS-50146/NRBTS-1/NRCELL-3"],
    ...                                                     "SN5678": ["MRBTS-50146/NRBTS-1/NRCELL-5"]}
    ...                               defaults to ${None} which means that all UEs will be attached to all cells.
    ...                               when given, listed cells will be called in pairs with specified UEs, if there are more
    ...                               cells on the setup that were not mentioned in the list, they will be called with all UEs
    ...              - ignored_cells_on_preparation: SHOULD BE USED WITH `prepare_cells_to_call` set to True!
    ...                                              list of cells CONFIGURATION distnames that should be ignored during
    ...                                              L3 Call not called cells preparation procedure and not be blocked/barred;
    ...                                              defaults to None.

    [Arguments]                                     ${called_cells_distnames}=${None}
    ...                                             ${throughputs}=${None}
    ...                                             ${protocol}=udp
    ...                                             ${udp_buffer}=4M
    ...                                             ${tput_verification_via_btslog}=${False}
    ...                                             ${ue_network_modes}=${None}
    ...                                             ${ues_and_cells}=${None}
    ...                                             ${ignored_cells_on_preparation}=${None}

    Run Keyword If                                  ${throughputs}
    ...                                             Execute L3 call
    ...                                             cells_distnames=${called_cells_distnames}
    ...                                             throughputs=${throughputs}
    ...                                             protocol=${protocol}
    ...                                             udp_buffer=${udp_buffer}
    ...                                             tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                             ue_network_modes=${ue_network_modes}
    ...                                             ues_and_cells=${ues_and_cells}
    ...                                             ignored_cells_on_preparation=${ignored_cells_on_preparation}

    ${alias}                                        connections.get_default_admin_connection_alias
    ${bts_type}=                                    hwpta_testline.get_type_of_setup
    ${is_simulated}=                                hwpta_testline.is_simulated
    ${bbmods_distnames}                             admin_info_model.get_bbmods_distnames
    ...                                             connection=${alias}

    FOR    ${bbmod_id}    IN    @{bbmods_distnames.keys()}
        ${bbmod_distnames}      Get From Dictionary    ${bbmods_distnames}    ${bbmod_id}
        ${bbmod_runtime_distname}                      Get From Dictionary
        ...                                            ${bbmod_distnames}
        ...                                            runtime
        ${connected_rmods}                             admin_info_model.get_primary_rmods_for_bbmod
        ...                                            connection=${alias}
        ...                                            bbmod_runtime_distname=${bbmod_runtime_distname}

        ${connected_rmods_count}=                      Get Length    
        ...                                            ${connected_rmods}
        Alarms.Allow alarm                             fault_id=10
        ...                                            fault_name=No connection to unit
        ...                                            bts_type=${bts_type}
        Robot Log Iteration                            Resetting BBMOD with ID: '${bbmod_id}' and distnames: '${bbmod_distnames}'
        Reset BBMOD                                    bbmod_id=${bbmod_id}

        Run Keyword If                                 ${connected_rmods_count} > 0
        ...                                            Wait for BBMOD to reach specific statuses      
        ...                                            bbmod_id=${bbmod_id}
        ...                                            status_variant=disabled
        Wait Until Keyword Succeeds                    4min
        ...                                            5s
        ...                                            Check If RMODs And Their Cells Are Disabled
        ...                                            rmods_runtime_distnames=${connected_rmods}
        status_check.verify_statuses_of_all_smods      connection=${alias}
        ...                                            status_variant=online
        status_check.verify_statuses_of_all_gnss       connection=${alias}
        ...                                            status_variant=online
        ...                                            skip_if_not_configured=${True}
        Wait for BBMOD to reach specific statuses      bbmod_id=${bbmod_id}
        ...                                            status_variant=online
        ...                                            timeout=5min
        ...                                            step=30s
        ${timeout_for_statuses_check}                  Set variable if  ${is_simulated}
        ...                                            10min
        ...                                            5min
        Wait Until Keyword Succeeds                    ${timeout_for_statuses_check}  30s
        ...                                            Check Statuses Of RMODs And Their Cells
        ...                                            rmods=${connected_rmods}
        Alarms.Disallow alarm                          fault_id=10
        ...                                            fault_name=No connection to unit
        ...                                            bts_type=${bts_type}
        Run Keyword If                                 ${throughputs}
        ...                                            Execute L3 call
        ...                                            cells_distnames=${called_cells_distnames}
        ...                                            throughputs=${throughputs}
        ...                                            protocol=${protocol}
        ...                                            udp_buffer=${udp_buffer}
        ...                                            tput_verification_via_btslog=${tput_verification_via_btslog}
        ...                                            ue_network_modes=${ue_network_modes}
        ...                                            ues_and_cells=${ues_and_cells}
        ...                                            ignored_cells_on_preparation=${ignored_cells_on_preparation}
    END


Reset BBMOD
    [Arguments]    ${bbmod_id}
    Create admin session with custom alias             connection=bbmod_reset
    ...                                                timeout=120s
    ...                                                logs_path=/tmp/api_logs/bbmod_reset
    admin_info_model.reset_bbmod_in_separate_process   connection=bbmod_reset
    ...                                                bbmod_id=${bbmod_id}


Check If RMODs And Their Cells Are Disabled
    [Arguments]    ${rmods_runtime_distnames}
    Check Statuses Of RMODs And Their Cells
    ...            rmods=${rmods_runtime_distnames}
    ...            cells_status_variant=failed
    ...            rmods_status_variant=disabled
