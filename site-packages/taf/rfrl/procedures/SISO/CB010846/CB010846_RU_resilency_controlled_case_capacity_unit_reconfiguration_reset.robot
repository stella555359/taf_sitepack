CB010846_RU_resilency_controlled_case_capacity_unit_reconfiguration_reset
    [Documentation]
    ...  Purpose of this test case is to check if RMOD did not reset during “cntrldResetMplaneBreakTime” duration after reconfiguration
    ...  which leads to BBMOD reset.
    ...
    ...  ARGS:
    ...  :param (int or str) rmod_id: (Mandatory) : RMOD configuration id of tested radio module, e.g.: 1
    ...  :param (str) target_bbmodBoardConfigType_value_for_config_bbmod: (Mandatory) : target parameter value of particular BBMOD to reconfigure,
    ...                                                                                 e.g.: LTETDD_NRTDD
    ...  :param (int or str or None) bbmod_id: (Optional) : BBMOD configuration id of capacity unit to reconfigure, e.g.: 1
    ...                                                     Defaults to None means that BBMOD with configuration link connection to particular RMOD ID
    ...                                                     (set as rmod_id argument) will be choosen to capacity unit reconfiguration.
    ...  :param (bool) revert_bbmodBoardConfigType_value_in_teardown : (Optional): True if bbmodBoardConfigType parameter for partical BBMOD
    ...                                                                should be reverted to initial value, False otherwise.
    ...                                                                Defaults to True.

    [Arguments]    ${rmod_id}
    ...            ${target_bbmodBoardConfigType_value_for_config_bbmod}
    ...            ${bbmod_id}=${None}
    ...            ${revert_bbmodBoardConfigType_value_in_teardown}=${True}

    ${bts_type}                                             hwpta_testline.get_type_of_setup
    ${connection}                                           connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}

    config_operations.connect                               alias=${connection}
    ...                                                     bts_type=${bts_type}

    ${rmod_startup_before_commissioning}                    Get DateTime of Last RMOD Startup
    ...                                                     rmod_id=${rmod_id}
    ...                                                     connection=${connection}

    ${impacted_bbmod_id}                                    Run keyword if    ${bbmod_id}==${None}
    ...                                                     Get BBMOD ID Connected to RMOD by Configuration Link
    ...                                                     rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ...                                                     ELSE
    ...                                                     Convert To Integer
    ...                                                     ${bbmod_id}
    Robot Log Result                                        BBMOD-${impacted_bbmod_id} will be reconfigured.

    ${list_with_impacted_bbmod_id}                          Create list
    ...                                                     ${impacted_bbmod_id}

    ${all_rmods_ids_connected_to_impacted_bbmod}            Get List of RMODs IDs Connected to Particular BBMOD
    ...                                                     bbmod_id=${impacted_bbmod_id}
    ...                                                     connection=${connection}

    ${impacted_rmod_ids}                                    Get impacted RMODs For Impacted BBMOD
    ...                                                     impacted_bbmod_id=${impacted_bbmod_id}
    ...                                                     connection=${connection}

    ${initial_bbmodBoardConfigType_value}                   Get bbmodBoardConfigType parameter value
    ...                                                     bbmod_id=${impacted_bbmod_id}

    Set bbmodBoardConfigType parameter on BBMOD in Background and Wait for BBMOD Reset
    ...                                                     bbmod_id=${impacted_bbmod_id}
    ...                                                     target_value=${target_bbmodBoardConfigType_value_for_config_bbmod}
    ...                                                     bts_type=${bts_type}

    Verify All BBMODs Statuses and Their Resources with Impacted BBMODs and RMODs
    ...                                                     impacted_bbmod_ids=${list_with_impacted_bbmod_id}
    ...                                                     impacted_bbmods_status_variant=initializing
    ...                                                     impacted_rmods_ids=${impacted_rmod_ids}
    ...                                                     impacted_rmods_status_variant=disabled
    ...                                                     alternative_impacted_rmods_status_variant=offline
    ...                                                     impacted_cells_status_variant=failed
    ...                                                     skip_cells_verification=${True}
    ...                                                     connection=${connection}
    ...                                                     bts_type=${bts_type}

    Verify Cells Statuses Related to Impacted BBMOD         impacted_rmods_ids=${all_rmods_ids_connected_to_impacted_bbmod}
    ...                                                     impacted_cells_variant=failed
    ...                                                     connection=${connection}
    ...                                                     bts_type=${bts_type}

    Check Statuses after Capacity Unit Reconfiguration Reset and Wait for OnAir
    ...                                                     bts_type=${bts_type}

    ${rmod_startup_after_commissioning}                     Get DateTime of Last RMOD Startup
    ...                                                     rmod_id=${rmod_id}
    ...                                                     connection=${connection}

    Robot Log Operation                                     Verifying if RMOD-${rmod_id} has been reset during commissioning...
    Verify If RMOD Has Been Reset                           reference_startup_datetime=${rmod_startup_before_commissioning}
    ...                                                     actual_startup_datetime=${rmod_startup_after_commissioning}
    ...                                                     expect_rmod_reset=${False}
    Robot Log Result                                        RMOD-${rmod_id} has not been reset during commissioning.

    [Teardown]                                              RU Resilency Capacity Unit Reconfiguration Reset Teardown
    ...                                                     bbmod_id=${impacted_bbmod_id}
    ...                                                     initial_bbmodBoardConfigType_value=${initial_bbmodBoardConfigType_value}
    ...                                                     bts_type=${bts_type}
    ...                                                     revert_bbmodBoardConfigType_value=${revert_bbmodBoardConfigType_value_in_teardown}

Set bbmodBoardConfigType parameter on BBMOD and Wait for OnAir
    [Arguments]    ${bbmod_id}
    ...            ${target_value}
    ...            ${bts_type}

    Robot Log Operation                                     Setting 'bbmodBoardConfigType' parameter to `${target_value}` on BBMOD-${bbmod_id}...

    config_operations.set_parameter_value                   dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1/BBMOD-${bbmod_id}
    ...                                                     param_name=bbmodBoardConfigType
    ...                                                     param_value=${target_value}

    timer.wait_until_keyword_succeeds_timer
    ...                                                     5min
    ...                                                     30sec
    ...                                                     Check all BBMODs RMODs and cells states for all RATs
    ...                                                     bts_type=${bts_type}
    timer.wait_until_keyword_succeeds_timer
    ...                                                     5min
    ...                                                     10s
    ...                                                     Verify BTS states
    ...                                                     status=OnAir
    ...                                                     bts_type=${bts_type}

    Robot Log Result                                        Parameter 'bbmodBoardConfigType' has been set to `${target_value}` on BBMOD-${bbmod_id}.

Set bbmodBoardConfigType parameter on BBMOD in Background and Wait for BBMOD Reset
    [Arguments]    ${bbmod_id}
    ...            ${target_value}
    ...            ${bts_type}

    Robot Log Operation                                     Setting 'bbmodBoardConfigType' parameter to `${target_value}` on BBMOD-${bbmod_id}...

    config_operations.set_parameter_value_in_separate_process
    ...                                                     dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1/BBMOD-${bbmod_id}
    ...                                                     param_name=bbmodBoardConfigType
    ...                                                     param_value=${target_value}

    Sleep                                                   30s
    ...                                                     reason=Waiting for BBMDD initializing status...

    Wait for BBMOD to reach specific statuses               bbmod_id=${bbmod_id}
    ...                                                     status_variant=initializing
    ...                                                     timeout=2min
    ...                                                     step=3s

    Robot Log Operation                                     BBMOD-${bbmod_id} goes reset.

Get bbmodBoardConfigType parameter value
    [Arguments]    ${bbmod_id}

    Robot Log Operation                                     Getting 'bbmodBoardConfigType' parameter value for BBMOD-${bbmod_id}

    ${param_value}                                          config_operations.get_parameter_value
    ...                                                     dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1/BBMOD-${bbmod_id}
    ...                                                     param_name=bbmodBoardConfigType

    Robot Log Result                                        Current parameter 'bbmodBoardConfigType' value for BBMOD-${bbmod_id} is `${param_value}`

    [Return]    ${param_value}

Check Statuses after Capacity Unit Reconfiguration Reset and Wait for OnAir
    [Arguments]    ${bts_type}

    Robot Log Operation                                     Waiting for BBMOD startup after reconfiguration reset...

    timer.wait_until_keyword_succeeds_timer                 5min
    ...                                                     30sec
    ...                                                     Check all BBMODs RMODs and cells states for all RATs
    ...                                                     bts_type=${bts_type}

    Robot Log Operation                                     Verifying BTS OnAir state...
    timer.wait_until_keyword_succeeds_timer                 5min
    ...                                                     10s
    ...                                                     Verify BTS states
    ...                                                     status=OnAir
    ...                                                     bts_type=${bts_type}

    Robot Log Result                                        BBMOD reset procedure has finished succesfully. BTS is fully operational.

RU Resilency Capacity Unit Reconfiguration Reset Teardown
    [Arguments]    ${bbmod_id}
    ...            ${initial_bbmodBoardConfigType_value}
    ...            ${bts_type}
    ...            ${revert_bbmodBoardConfigType_value}=${True}

    Robot Log Operation                                     Performing RU Resilency Capacity Unit Reconfiguration Reset Teardown...

    ${current_bbmodBoardConfigType_value}                   Get bbmodBoardConfigType parameter value
    ...                                                     bbmod_id=${bbmod_id}

    Run keyword if                                          ${revert_bbmodBoardConfigType_value} and """${initial_bbmodBoardConfigType_value}""" != """${current_bbmodBoardConfigType_value}"""
    ...                                                     Run keywords
    ...                                                     Robot Log Operation
    ...                                                     Reverting parameter 'bbmodBoardConfigType' on BBMOD-${bbmod_id} to initial value...
    ...                                                     AND
    ...                                                     wait until keyword succeeds
    ...                                                     10min
    ...                                                     2min
    ...                                                     Set bbmodBoardConfigType parameter on BBMOD and Wait for OnAir
    ...                                                     bbmod_id=${bbmod_id}
    ...                                                     target_value=${initial_bbmodBoardConfigType_value}
    ...                                                     bts_type=${bts_type}
    ...                                                     ELSE
    ...                                                     timer.wait_until_keyword_succeeds_timer
    ...                                                     5min
    ...                                                     10s
    ...                                                     Verify BTS states
    ...                                                     status=OnAir
    ...                                                     bts_type=${bts_type}

    Robot Log Result                                        Teardown performed succesfully.

Verify Cells Statuses Related to Impacted BBMOD
    [Arguments]    ${impacted_rmods_ids}
    ...            ${impacted_cells_variant}
    ...            ${connection}
    ...            ${bts_type}

    @{all_rmods_ids}                                        admin_info_model.get_rmod_indexes
    ...                                                     connection=${connection}

    FOR  ${rmod_id}  IN  @{all_rmods_ids}
       ${is_impacted}=                                      Evaluate  ${rmod_id} in ${impacted_rmods_ids}
       ${impacted_status}=                                  Run keyword if  ${is_impacted}
       ...                                                  Run keyword and return status
       ...                                                  Check statuses of cells for RMOD
       ...                                                  rmod_id=${rmod_id}
       ...                                                  connection=${connection}
       ...                                                  status_variant=${impacted_cells_variant}
       ...                                                  bts_type=${bts_type}
       ...    ELSE
       ...                                                  Set Variable  ${True}

       Run Keyword If                                       not ${is_impacted} or not ${impacted_status}
       ...                                                  Check statuses of cells for RMOD
       ...                                                  rmod_id=${rmod_id}
       ...                                                  connection=${connection}
       ...                                                  status_variant=online
       ...                                                  bts_type=${bts_type}
     END

Get List of RMODs IDs Connected to Particular BBMOD
    [Arguments]    ${bbmod_id}
    ...            ${connection}

    ${bbmod_id}                                             Convert To Integer
    ...                                                     ${bbmod_id}

    ${rmod_ids_for_bbmod}                                   admin_info_model.get_rmod_ids_by_link_modes_for_bbmod_ids
    ...                                                     bbmod_ids=${bbmod_id}
    ...                                                     connection=${connection}

    ${rmod_ids_with_impacted_cells}                         Evaluate
    ...    ${rmod_ids_for_bbmod[${bbmod_id}]["synchronization"]}+${rmod_ids_for_bbmod[${bbmod_id}]["configuration"]}+${rmod_ids_for_bbmod[${bbmod_id}]["data"]}

    [Return]    ${rmod_ids_with_impacted_cells}
