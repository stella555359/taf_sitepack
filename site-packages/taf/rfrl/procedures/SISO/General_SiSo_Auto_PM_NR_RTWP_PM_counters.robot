*** Keywords ***
General_SiSo_Auto_PM_NR_RTWP_PM_counters
    [Documentation]    Purpose of this test case is to verify values of NR RTWP counters:
    ...                    M55369C00000-M55369C00007 (minimum RTWP per special stream)
    ...                    M55369C00100-M55369C00107 (maximum RTWP per spatial stream)
    ...                    M55369C00200-M55369C00207 (average RTWP per spatial stream)
    ...                Counters are collected when no UE is attached to the cell and compared with values collected
    ...                when UE is attached to the cell and UL traffic is generated.
    ...                The maximum and average values of counters should show higher values when
    ...                the UE is connected to the network and UL traffic is generated.
    ...                Args:
    ...                    - cell_distname: configuration distname of cell to be tested (e.g. 'MRBTS-1/NRBTS-1/NRCELL-1')
    ...                    - throughput: dict with throughput and deviation values for each cell identified by
    ...                             it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells
    ...                             Example:
    ...                             {
    ...                                 '827736065':
    ...                                      {
    ...                                          'throughput':
    ...                                              {
    ...                                                  'downlink': '100 Mbits/sec',
    ...                                                  'uplink': '15 Mbits/sec'
    ...                                              },
    ...                                          'deviation': '90%'
    ...                                      },
    ...                             }
    [Arguments]        ${cell_distname}
    ...                ${throughput}
    ${bts_type}=                                  hwpta_testline.get_type_of_setup
    ${time_interval}=                             Set Variable    15min
    ${l3_call_duration}=                          Evaluate
    ...                                           str(int(str('${time_interval}'.replace('min',''))) * 60 * 2) + 's'
    ${connection}=                                connections.get_default_admin_connection_alias
    ...                                           bts_type=${bts_type}
    config_operations.connect                     alias=${connection}
    ${initial_param_value}=                       config_operations.get_parameter_value
    ...                                           dist_name=MRBTS-{}/NRBTS-{}/NRPMRNL-1
    ...                                           param_name=miNrRtwp

    Robot Log Operation                           Changing miNrRtwp parameter value to ${time_interval}
    config_operations.set_parameter_value         dist_name=MRBTS-{}/NRBTS-{}/NRPMRNL-1
    ...                                           param_name=miNrRtwp
    ...                                           param_value=${time_interval}

    ${counter_ids}=                               Get Counter Ids
    ${cell_name}=                                 Evaluate
    ...                                           str("""${cell_distname}""").split('/')[-1]

    ${counters_without_attach}=                   Wait For Counters And Save Values to Dict
    ...                                           counter_ids=${counter_ids}
    ...                                           time=${time_interval}
    ...                                           component_name=${cell_name}

    L3Call.Execute L3 Call In Background          called_cell=${cell_distname}
    ...                                           direction=UL
    ...                                           duration=${l3_call_duration}
    ...                                           throughputs=${throughput}
    ...                                           protocol=udp
    ...                                           udp_buffer=4M

    ${counters_with_attach}=                      Wait For Counters And Save Values to Dict
    ...                                           counter_ids=${counter_ids}
    ...                                           time=${time_interval}
    ...                                           component_name=${cell_name}

    bts_counters.check_if_first_counters_are_smaller
    ...                                           first_counters=${counters_without_attach}
    ...                                           second_counters=${counters_with_attach}

    L3Call.Stop And Verify Background L3 Call     called_cell=${cell_distname}

    [Teardown]                                    Run Keywords
    ...                                           Clean Up Environment
    ...                                           AND
    ...                                           config_operations.set_parameter_value
    ...                                           dist_name=MRBTS-{}/NRBTS-{}/NRPMRNL-1
    ...                                           param_name=miNrRtwp
    ...                                           param_value=${initial_param_value}

Get Counter Ids
    ${counter_ids}=        Create List            M55369C00000  M55369C00001  M55369C00002  M55369C00003
    ...                                           M55369C00004  M55369C00005  M55369C00006  M55369C00007
    ...                                           M55369C00100  M55369C00101  M55369C00102  M55369C00103
    ...                                           M55369C00104  M55369C00105  M55369C00106  M55369C00107
    ...                                           M55369C00200  M55369C00201  M55369C00202  M55369C00203
    ...                                           M55369C00204  M55369C00205  M55369C00206  M55369C00207
    [Return]                                      ${counter_ids}
