*** Keywords ***
General_SiSo_Auto_Consistent_Checking_Of_Key_Parameters_In_RFS
    [Documentation]
    ...       The purpose of this test case is to check whether changing different params on BTS with RMOD in
    ...       RF Sharing mode will cause the expected alarm to appear. Please note that it is necessary to use a
    ...       dictionary with appropriate parameters with vales, described in cells_parameters_dict argument.
    ...
    ...       ARGS:
    ...       - cells_parameters_dict: dict with at least one of parameter (e.g ulDlDataSlotRatio, pMax, chBw) with value for cells distnames, example:
    ...                                cells_parameters = {
    ...                                  "MRBTS-55196/NRBTS-55196/NRCELL-0":
    ...                                          {
    ...                                      "ulDlDataSlotRatio": "3/7",
    ...                                      "pMax": "370",
    ...                                           },
    ...                                  "MRBTS-55196/NRBTS-55196/NRCELL-2":
    ...                                         {
    ...                                      "ulDlDataSlotRatio": "3/7",
    ...                                      "pMax": "390",
    ...                                      "chBw": "100MHz",
    ...                                         },
    ...                                              }
    ...       - throughputs: dict with throughput and deviation values for all cells, example:
    ...                                    throughput_100MHz = {
    ...                                         '827736065':
    ...                                             {
    ...                                                 'throughput':
    ...                                                     {
    ...                                                         'downlink': '100 Mbits/sec',
    ...                                                         'uplink': '15 Mbits/sec'
    ...                                                     },
    ...                                                 'info': '-',
    ...                                                 'deviation': '90%'
    ...                                               },
    ...                      defaults to ${None} (L3 call will not be performed);
    ...       - l3_call_duration: duration of data transfer test in Robot time string format
    ...                        e.g. '1 minutes 42 seconds' or '1min 42s'; defaults to 30s
    ...       - protocol: data transfer protocol; defaults to udp
    ...       - udp_buffer: monitoring data buffer; defaults to 4M
    ...       - tput_verification_via_btslog: True - throughput verification will be performed using btslog,
    ...                                       False - throughput verification will be performed using iperf; defaults to True
    ...       - ue_network_modes: dictionary with pairs of UE serial number - desired network mode e.g. {"SN1234": "NR_only", "SN321": "NR_only}
    ...                           possible network modes: NR_only, LTE_only, NR_LTE (NR_LTE mode CAN NOT be used with any of the other
    ...                           two in case of more than one UE); defaults to ${None} (current modes set on UEs will be used)

    [Arguments]                                                 ${cells_parameters_dict}
    ...                                                         ${throughputs}=${None}
    ...                                                         ${l3_call_duration}=30s
    ...                                                         ${protocol}=udp
    ...                                                         ${udp_buffer}=4M
    ...                                                         ${tput_verification_via_btslog}=${True}
    ...                                                         ${ue_network_modes}=${None}

    ${bts_type}=                                                testline.get_type_of_setup
    ${connection}=                                              connections.get_default_admin_connection_alias
    ...                                                         bts_type=${bts_type}
    config_operations.connect                                   alias=${connection}

    Set Test Variable                                           ${return_to_initial_scf}
    ...                                                         ${True}

    FOR  ${cell_distname}  ${cell_parameters}  IN   &{cells_parameters_dict}
         ${cell_id}                                             Evaluate  int(str("""${cell_distname}""").split('-')[-1])
         @{cell_distname_list}                                  Create List    ${cell_distname}
         ${cell_type}                                           admin_info_model.get_cell_type_from_distname
         ...                                                    distname=${cell_distname}
         ${cell_technology}                                     admin_info_model.get_cell_technology
         ...                                                    connection=${connection}
         ...                                                    cell_type=${cell_type}
         ...                                                    cell_id=${cell_id}
         &{formated_cells_parameters_dict}                      config_operations.prepare_parameters_dict_for_tddframestructure
         ...                                                    parameters_dict=${cell_parameters}
         ...                                                    cell_technology=${cell_technology}

         FOR  ${parameter_name}  ${parameter_value}  IN   &{formated_cells_parameters_dict}

              ${current_value}                                  Get Current Parameter Value
              ...                                               dist_name=${cell_distname}
              ...                                               parameter_name=${parameter_name}
              ...                                               connection=${connection}

              Alarms.Allow alarm                                fault_id=1900
              ...                                               fault_name=RF module configuring failed
              ...                                               bts_type=${bts_type}

              ${new_parameters_values}                          Get New Parameter Value
              ...                                               parameter_name=${parameter_name}
              ...                                               parameter_value=${parameter_value}
              ...                                               current_value=${current_value}

              Set New Parameter Value                           dist_name=${cell_distname}
              ...                                               parameter_name=${parameter_name}
              ...                                               parameter_value=${new_parameters_values}
              ...                                               connection=${connection}

              Robot Log Operation                               Waiting for fault ID:1900 activation...
              Wait Until Keyword Succeeds    5min    10s        Alarms.Check if alarm is active
              ...                                               fault_id=1900
              ...                                               fault_name=RF module configuring failed
              ...                                               bts_type=${bts_type}

              Robot Log Operation                               Restoring Previous Parameter Value...

              Set New Parameter Value                           dist_name=${cell_distname}
              ...                                               parameter_name=${parameter_name}
              ...                                               parameter_value=${current_value}
              ...                                               connection=${connection}

              Robot Log Operation                               Waiting for fault ID:1900 inactivation...
              Wait Until Keyword Succeeds    5min    10s        Alarms.Check if alarm is inactive
              ...                                               fault_id=1900
              ...                                               fault_name=RF module configuring failed
              ...                                               bts_type=${bts_type}

              Wait Until Keyword Succeeds    5min    10s        Check all BBMODs RMODs and cells states for all RATs
              ...                                               bts_type=${bts_type}
              Wait Until Keyword Succeeds    2min    10s        Check BTS state and all RATs states
              ...                                               bts_type=${bts_type}

              Run Keyword If   ${throughputs}                   Execute L3 call
              ...                                               cells_distnames=${cell_distname_list}
              ...                                               throughputs=${throughputs}
              ...                                               protocol=${protocol}
              ...                                               udp_buffer=${udp_buffer}
              ...                                               duration=${l3_call_duration}
              ...                                               ue_network_modes=${ue_network_modes}
              ...                                               tput_verification_via_btslog=${tput_verification_via_btslog}
         END
    END


Get Current Parameter Value
      [Arguments]                                               ${dist_name}
      ...                                                       ${parameter_name}
      ...                                                       ${connection}
      Robot Log Operation                                       Getting current parameter ${parameter_name} value...
      ${parameter_value}                                        config_operations.get_parameter_value
      ...                                                       dist_name=${dist_name}
      ...                                                       param_name=${parameter_name}
      &{tddFrameStructure_dict}                                 Run Keyword If     '${parameter_name}'=='tddFrameStructure'
      ...                                                       Evaluate           dict(${parameter_value})
      ${tddFrameStructure_list}                                 Run Keyword If     '${parameter_name}'=='tddFrameStructure'
      ...                                                       Create List        ${tddFrameStructure_dict}
      ${current_value}                                          Set Variable If    '${parameter_name}'=='tddFrameStructure'
      ...                                                       ${tddFrameStructure_list}
      ...                                                       ${parameter_value}
      [Return]                                                  ${current_value}

Get New Parameter Value
      [Arguments]                                               ${parameter_name}
      ...                                                       ${parameter_value}
      ...                                                       ${current_value}
      Robot Log Operation                                       Getting new parameter ${parameter_name} value...
      &{new_parameters_structure}                               Run Keyword If    '${parameter_name}'=='tddFrameStructure'
      ...                                                       config_operations.create_parameters_structure_for_tddframestructure
      ...                                                       new_parameter_value=${parameter_value}
      ...                                                       current_value=${current_value}
      @{new_parameters_structure_list}                          Create List    ${new_parameters_structure}
      ${new_parameters_values}                                  Set Variable If    '${parameter_name}'=='tddFrameStructure'
      ...                                                       ${new_parameters_structure_list}
      ...                                                       ${parameter_value}
      [Return]                                                  ${new_parameters_values}
      
Set New Parameter Value
      [Arguments]                                               ${dist_name}
      ...                                                       ${parameter_name}
      ...                                                       ${parameter_value}
      ...                                                       ${connection}
      Robot Log Operation                                       Setting parameter ${parameter_name} value...
      config_operations.set_parameter_value                     dist_name=${dist_name}
      ...                                                       param_name=${parameter_name}
      ...                                                       param_value=${parameter_value}