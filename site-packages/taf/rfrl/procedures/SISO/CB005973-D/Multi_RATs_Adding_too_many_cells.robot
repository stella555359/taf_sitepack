Verify Cells Statuses For RAT With Added Cells
    [Arguments]                             ${cell_ids}
    ...                                     ${cell_type}
    ...                                     ${base_cell_ids}

    ${bts_type}=                            hwpta_testline.get_type_of_setup
    ${connection}                           connections.get_default_admin_connection_alias
    ...                                     bts_type=${bts_type}

    @{base_cells}=                          Create List
    @{added_cells}=                         Create List

    FOR  ${cell_id}  IN  @{cell_ids}
        ${is_cell_in_base_config}=          Run Keyword And Return Status
        ...                                 List Should Contain Value  ${base_cell_ids}  ${cell_id}
        Run Keyword If                      ${is_cell_in_base_config}
        ...    Append To List               ${base_cells}   ${cell_id}
        ...    ELSE
        ...    Append To List               ${added_cells}  ${cell_id}
    END

    Check statuses for specific cells       cell_ids=${base_cells}
    ...                                     cell_type=${cell_type}
    ...                                     status_variant=online
    ...                                     connection=${connection}

    Check specific statuses for specific cells
    ...                                     cell_ids=${added_cells}
    ...                                     cell_type=${cell_type}
    ...                                     connection=${connection}
    ...                                     operational_state=disabled
    ...                                     availability_status=failed
    ...                                     usage_state=Idle

Verify Cells Statuses For All RATs With Added Cells
    [Arguments]         ${cells_per_rat}

    Robot Log Step      Verifying statuses of cells from all RATs...

    ${bts_type}=                            hwpta_testline.get_type_of_setup
    ${connection}                           connections.get_default_admin_connection_alias
    ...                                     bts_type=${bts_type}

    ${rats}=                                admin_info_model.get_rats
    ...                                     connection=${connection}

    FOR  ${rat}  IN  @{rats}
        ${cell_ids}=                        admin_info_model.get_cell_ids_from_specific_rat
        ...                                 cell_type=${rat}
        ...                                 connection=${connection}
        ${cells_count}=                     Get length   ${cell_ids}
        ${base_cells_count}=                Get Length   ${cells_per_rat['${rat}']}
        Run keyword If  ${base_cells_count}!=${cells_count}
        ...    Verify Cells Statuses For RAT With Added Cells    cell_ids=${cell_ids}
        ...                                                      cell_type=${rat}
        ...                                                      base_cell_ids=${cells_per_rat['${rat}']}
        ...    ELSE
        ...    Check statuses for specific cells                 cell_ids=${cell_ids}
        ...                                                      cell_type=${rat}
        ...                                                      status_variant=online
        ...                                                      connection=${connection}
    END
    Robot Log Result     Verification completed, all cells from all RATs are in correct state!

Check All Devices And Cells States For All RATs With Added Cells
    [Arguments]         ${cells_per_rat}

    ${bts_type}=                            hwpta_testline.get_type_of_setup
    ${connection}                           connections.get_default_admin_connection_alias
    ...                                     bts_type=${bts_type}
    status_check.verify_statuses_of_all_bbmods                     connection=${connection}
    status_check.verify_statuses_of_all_rmods                      connection=${connection}

    Verify Cells Statuses For All RATs With Added Cells  cells_per_rat=${cells_per_rat}

Migrate SCF Files To New Version
    [Arguments]         ${path_to_scf}
    ...                 ${modified_scf_list}
    ...                 ${connection}

    Robot Log Operation                     Migrating SCF files to new version...

    ${file_name}=                           Evaluate    str("""${path_to_scf}""").split('/')[-1].split('.')[0]
    ${path_to_base_migrated_scf}=           Set Variable  ${logs_path}/${file_name}_migrated.xml
    coam_admin.migrate_scf                  input_scf_file=${path_to_scf}
    ...                                     output_scf_file=${path_to_base_migrated_scf}
    ...                                     connection=${connection}
    ...                                     timeout=300

    ${migrated_scf_list}=                   Create List
    FOR  ${modified_scf}  IN  @{modified_scf_list}
        ${file_name}=                       Evaluate    str("""${modified_scf}""").split('/')[-1].split('.')[0]
        ${path_to_migrated_scf}=            Set Variable   ${logs_path}/${file_name}_migrated.xml
        coam_admin.migrate_scf              input_scf_file=${modified_scf}
        ...                                 output_scf_file=${path_to_migrated_scf}
        ...                                 connection=${connection}
        ...                                 timeout=300
        Append To List                      ${migrated_scf_list}  ${path_to_migrated_scf}
    END

    Robot Log Result                        SCF files migrated successfully!

    [Return]                                ${path_to_base_migrated_scf}  ${migrated_scf_list}
