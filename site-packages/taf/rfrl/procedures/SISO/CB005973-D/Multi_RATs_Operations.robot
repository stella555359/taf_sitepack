*** Keywords ***
Multi_RATs_Operations
    [Documentation]
    ...   Based on QC test case:
    ...   47_CB005973_D_[OBSAI]_Muliti_RATs_Operations
    ...   Test verifies l3call procedure after performing Block/Unblock cells, Lock/Unlock/Reset operations on RMODs,
    ...   reset operation on BBMOD and parameter change in WebEM (that causes Site Reset and NR RAT reset).
    ...   Args
    ...       - cells_to_ues: pairs of configuration distnames of cells and serial numbers of
    ...                       UEs that will be attached to this cell e.g
    ...                       {"MRBTS-1/NRCELL-1": "SN1234", "MRBTS-1/LNCEL-1": "SN432"}
    ...       - duration: duration of data transfer test in Robot time string format
    ...                   e.g. '1 minutes 42 seconds' or '1min 42s'.
    ...       - throughputs: dict with throughput and deviation values for all cells, example:
    ...                                    throughput_100MHz = {
    ...                                         '827736065':
    ...                                             {
    ...                                                 'throughput':
    ...                                                     {
    ...                                                         'downlink': '100 Mbits/sec',
    ...                                                         'uplink': '15 Mbits/sec'
    ...                                                     },
    ...                                                 'info': '-',
    ...                                                 'deviation': '90%'
    ...                                               },
    ...       - throughputs_chbw: same structure as `throughputs` arg but it's used when chbw is changed on cells
    ...       - protocol: data transfer protocol
    ...       - udp_buffer: monitoring data buffer
    ...       - prepare_cells_to_call: True - the enviornment will be prepared so that only the called cells are notBarred and unblocked
    ...                                False - the enviornment will not be changed and L3 call will be performed as is; defaults to True
    ...       - ue_network_modes: dictionary with pairs of UE Serial Number - desired network mode e.g. {"SN1234": "NR_only", "SN321": "NR_only}
    ...                           possible network modes: NR_only, LTE_only, NR_LTE (NR_LTE mode CAN NOT be used with any of the other
    ...                           two in case of more than one UE); defaults to ${None} (current modes set on UEs will be used)
    [Arguments]                                 ${cells_to_ues}
    ...                                         ${duration}
    ...                                         ${throughputs}
    ...                                         ${throughputs_chbw}
    ...                                         ${protocol}=udp
    ...                                         ${udp_buffer}=4M
    ...                                         ${prepare_cells_to_call}=${False}
    ...                                         ${ue_network_modes}=${None}
    [Timeout]                                   120min

    Create admin session with default alias
    ${bts_type}=                                hwpta_testline.get_type_of_setup
    ${connection}=                              connections.get_default_admin_connection_alias

    ${active_rats}                              admin_info_model.get_rats
    ...                                         connection=${connection}
    ${cell_types}                               Create List
    ${current_througputs}=                      Set Variable  ${throughputs}

    Block/Unblock Cells On ABIN And Perform L3 Call
    ...                                         active_rats=${active_rats}
    ...                                         cell_types=${cell_types}
    ...                                         cells_to_ues=${cells_to_ues}
    ...                                         duration=${duration}
    ...                                         throughputs=${throughputs}
    ...                                         protocol=${protocol}
    ...                                         udp_buffer=${udp_buffer}
    ...                                         prepare_cells_to_call=${prepare_cells_to_call}
    ...                                         ue_network_modes=${ue_network_modes}

    Lock/Unlock RMOD Connected To ABIN And Perform L3 Call
    ...                                         cell_types=${cell_types}
    ...                                         cells_to_ues=${cells_to_ues}
    ...                                         duration=${duration}
    ...                                         throughputs=${throughputs}
    ...                                         protocol=${protocol}
    ...                                         udp_buffer=${udp_buffer}
    ...                                         prepare_cells_to_call=${prepare_cells_to_call}
    ...                                         ue_network_modes=${ue_network_modes}

    Reset RMOD Connected To ABIN And Perform L3 Call
    ...                                         cells_to_ues=${cells_to_ues}
    ...                                         cell_types=${cell_types}
    ...                                         duration=${duration}
    ...                                         throughputs=${throughputs}
    ...                                         protocol=${protocol}
    ...                                         udp_buffer=${udp_buffer}
    ...                                         prepare_cells_to_call=${prepare_cells_to_call}
    ...                                         ue_network_modes=${ue_network_modes}

    Reset ABIN And Perform L3 Call              cells_to_ues=${cells_to_ues}
    ...                                         duration=${duration}
    ...                                         throughputs=${throughputs}
    ...                                         protocol=${protocol}
    ...                                         udp_buffer=${udp_buffer}
    ...                                         prepare_cells_to_call=${prepare_cells_to_call}
    ...                                         ue_network_modes=${ue_network_modes}

    Change Parameter That Will Cause Site Reset And Perform L3 Call
    ...                                         cells_to_ues=${cells_to_ues}
    ...                                         duration=${duration}
    ...                                         throughputs=${throughputs}
    ...                                         protocol=${protocol}
    ...                                         udp_buffer=${udp_buffer}
    ...                                         prepare_cells_to_call=${prepare_cells_to_call}
    ...                                         ue_network_modes=${ue_network_modes}

    Change Parameter That Will Cause NR RAT Reset And Perform L3 Call
    ...                                         cells_to_ues=${cells_to_ues}
    ...                                         duration=${duration}
    ...                                         throughputs_chbw=${throughputs_chbw}
    ...                                         protocol=${protocol}
    ...                                         udp_buffer=${udp_buffer}
    ...                                         prepare_cells_to_call=${prepare_cells_to_call}
    ...                                         ue_network_modes=${ue_network_modes}

    [Teardown]                                  Run Keywords
    ...                                         Allow DSS alarms
    ...                                         AND
    ...                                         Return To Initial SCF Configuration
    ...                                         bts_type=${bts_type}
    ...                                         AND
    ...                                         Wait for inactive alarm
    ...                                         fault_id=6134
    ...                                         timeout=60
    ...                                         AND
    ...                                         Disallow DSS alarms


Block/Unblock Cells On ABIN And Perform L3 Call
    [Arguments]                                 ${active_rats}
    ...                                         ${cell_types}
    ...                                         ${cells_to_ues}
    ...                                         ${duration}
    ...                                         ${throughputs}
    ...                                         ${protocol}
    ...                                         ${udp_buffer}
    ...                                         ${prepare_cells_to_call}
    ...                                         ${ue_network_modes}

    ${connection}=                              connections.get_default_admin_connection_alias

    Allow DSS alarms
    Alarms.Allow Alarm                          fault_name=Cell blocked
    ...                                         fault_id=49

    FOR  ${cell_distname}  IN  @{cells_to_ues}
          ${runtime_distname}                   admin_info_model.translate_cell_config_distname_to_runtime_distname
          ...                                   connection=${connection}
          ...                                   cell_config_distname=${cell_distname}
          Robot Log Step                        Performing block operation on ${cell_distname}
          admin.block_cell                      dist_name=${runtime_distname}
          ...                                   connection=${connection}
          ...                                   timeout=80s
          ${cell_type}                          admin_info_model.get_cell_type_from_distname
          ...                                   distname=${cell_distname}
          Append To List                        ${cell_types}   ${cell_type}
    END

    FOR  ${rat}  IN  @{active_rats}
          ${cell_ids}                           admin_info_model.get_cell_ids_from_specific_rat
          ...                                   connection=${connection}
          ...                                   cell_type=${rat}
          Private Check Statuses For Partialy Blocked Cells
          ...                                   cell_ids=${cell_ids}
          ...                                   cell_config_distnames=${cells_to_ues.keys()}
          ...                                   cell_types=${cell_types}
          ...                                   active_rat=${rat}
    END


    FOR  ${cell_distname}  IN  @{cells_to_ues}
          ${runtime_distname}                   admin_info_model.translate_cell_config_distname_to_runtime_distname
          ...                                   connection=${connection}
          ...                                   cell_config_distname=${cell_distname}
          Robot Log Step                        Performing unblock operation on ${cell_distname}
          admin.unblock_cell                    dist_name=${runtime_distname}
          ...                                   connection=${connection}
          ...                                   timeout=80s
    END

    Wait Until Keyword Succeeds                 10min
    ...                                         10s
    ...                                         Check all BBMODs RMODs and cells states for all RATs

    Wait for inactive alarm                     fault_id=6134
    ...                                         timeout=60
    Disallow DSS alarms
    Alarms.Disallow alarm                       fault_name=Cell blocked
    ...                                         fault_id=49

    L3 Call on Selected Cells using Selected UEs
    ...                                         cells_to_ues=${cells_to_ues}
    ...                                         duration=${duration}
    ...                                         throughputs=${throughputs}
    ...                                         protocol=${protocol}
    ...                                         udp_buffer=${udp_buffer}
    ...                                         prepare_cells_to_call=${prepare_cells_to_call}
    ...                                         ue_network_modes=${ue_network_modes}


Private Check Statuses For Partialy Blocked Cells
    [Arguments]                                 ${cell_ids}
    ...                                         ${cell_config_distnames}
    ...                                         ${cell_types}
    ...                                         ${active_rat}

    ${connection}=                              connections.get_default_admin_connection_alias
    ${blocked_cell_ids}                         Create List

    FOR  ${cell_config_distname}  ${cell_type}  IN ZIP  ${cell_config_distnames}  ${cell_types}
          ${cell_id}=                           Evaluate  int(str("""${cell_config_distname}""").split('-')[-1])
          Run Keyword If                        """${cell_type}"""=="""${active_rat}"""     Run Keywords
          ...                                   Remove Values From List       ${cell_ids}      ${cell_id}
          ...                                   AND
          ...                                   Append To List     ${blocked_cell_ids}      ${cell_id}
    END

    Check statuses for specific cells           cell_ids=${blocked_cell_ids}
    ...                                         cell_type=${active_rat}
    ...                                         status_variant=blocked
    ...                                         connection=${connection}
    Check statuses for specific cells
    ...                                         cell_ids=${cell_ids}
    ...                                         cell_type=${active_rat}
    ...                                         status_variant=online
    ...                                         connection=${connection}


Lock/Unlock RMOD Connected To ABIN And Perform L3 Call
    [Arguments]                                 ${cell_types}
    ...                                         ${cells_to_ues}
    ...                                         ${duration}
    ...                                         ${throughputs}
    ...                                         ${protocol}
    ...                                         ${udp_buffer}
    ...                                         ${prepare_cells_to_call}
    ...                                         ${ue_network_modes}

    ${connection}=                              connections.get_default_admin_connection_alias
    ${related_rmods}                            Private Get Rmods Related To ABIN And Cells
    ...                                         cells_to_ues=${cells_to_ues}
    ...                                         cell_types=${cell_types}

    Allow DSS alarms
    ${rf_lock_timeout}=                         Get Timeout RMOD Lock
    ${rf_unlock_timeout}=                       Get Timeout RMOD Unlock

    FOR  ${rmod_distname}  IN  @{related_rmods}
          ${rmod_id}                            Evaluate  int(str("""${rmod_distname}""").split('-')[-1])
          Robot Log Step                        Performing lock operation on RMOD-${rmod_id}
          Lock RMOD                             runtime_rmod_id=${rmod_id}
          timer.wait_until_keyword_succeeds_timer
          ...                                   ${rf_lock_timeout}
          ...                                   5sec
          ...                                   status_check.verify_statuses_of_rmod
          ...                                   rmod_id=${rmod_id}
          ...                                   status_variant=locked
          ...                                   connection=${connection}
    END

    Wait Until Keyword Succeeds                 5min
    ...                                         20sec
    ...                                         Check statuses of cells for RMOD
    ...                                         rmod_id=${rmod_id}
    ...                                         status_variant=dependency
    ...                                         connection=${connection}

    FOR  ${rmod_distname}  IN  @{related_rmods}
          ${rmod_id}                            Evaluate  int(str("""${rmod_distname}""").split('-')[-1])
          Robot Log Step                        Performing unlock operation on RMOD-${rmod_id}
          Unlock RMOD                           runtime_rmod_id=${rmod_id}
    END

    timer.wait_until_keyword_succeeds_timer     ${rf_unlock_timeout}
    ...                                         5s
    ...                                         Check all BBMODs RMODs and cells states for all RATs

    Wait for inactive alarm                     fault_id=6134
    ...                                         timeout=60
    Disallow DSS alarms

    L3 Call on Selected Cells using Selected UEs
    ...                                         cells_to_ues=${cells_to_ues}
    ...                                         duration=${duration}
    ...                                         throughputs=${throughputs}
    ...                                         protocol=${protocol}
    ...                                         udp_buffer=${udp_buffer}
    ...                                         prepare_cells_to_call=${prepare_cells_to_call}
    ...                                         ue_network_modes=${ue_network_modes}


Reset RMOD Connected To ABIN And Perform L3 Call
    [Arguments]                                 ${cells_to_ues}
    ...                                         ${cell_types}
    ...                                         ${duration}
    ...                                         ${throughputs}
    ...                                         ${protocol}
    ...                                         ${udp_buffer}
    ...                                         ${prepare_cells_to_call}
    ...                                         ${ue_network_modes}

    ${connection}=                              connections.get_default_admin_connection_alias
    ${related_rmods}                            Private Get Rmods Related To ABIN And Cells
    ...                                         cells_to_ues=${cells_to_ues}
    ...                                         cell_types=${cell_types}

    Allow DSS alarms
    Alarms.Allow alarm                          fault_name=EN DSS Keep Alive Procedure Time out
    ...                                         fault_id=7511
    Alarms.Allow Alarm                          fault_name=Tx Failure Turn Mimo Off
    ...                                         fault_id=4003
    Alarms.Allow Alarm                          fault_name=Transmission path failure
    ...                                         fault_id=4003


    FOR  ${rmod_distname}  IN  @{related_rmods}
          ${rmod_id}                            Evaluate  int(str("""${rmod_distname}""").split('-')[-1])
          Robot Log Step                        Resseting RMOD-${rmod_id}
          admin_info_model.reset_rmod           connection=${connection}
          ...                                   runtime_rmod_id=${rmod_id}
          Wait Until Keyword Succeeds           5min
          ...                                   10s
          ...                                   Check all BBMODs RMODs and cells states for all RATs
          L3 Call on Selected Cells using Selected UEs
          ...                                   cells_to_ues=${cells_to_ues}
          ...                                   duration=${duration}
          ...                                   throughputs=${throughputs}
          ...                                   protocol=${protocol}
          ...                                   udp_buffer=${udp_buffer}
          ...                                   prepare_cells_to_call=${prepare_cells_to_call}
          ...                                   ue_network_modes=${ue_network_modes}
    END

    Wait for inactive alarm                     fault_id=6134
    ...                                         timeout=60
    Disallow DSS alarms
    Alarms.Disallow alarm                       fault_name=EN DSS Keep Alive Procedure Time out
    ...                                         fault_id=7511
    Alarms.Disallow Alarm                       fault_name=Tx Failure Turn Mimo Off
    ...                                         fault_id=4003
    Alarms.Disallow Alarm                       fault_name=Transmission path failure
    ...                                         fault_id=4003


Private Get Rmods Related To ABIN And Cells
    [Arguments]                                 ${cells_to_ues}
    ...                                         ${cell_types}

    ${connection}=                              connections.get_default_admin_connection_alias
    ${ABIN_rmods}                               admin_info_model.get_distnames_of_rmods_connected_to_bbmod
    ...                                         connection=${connection}
    ${related_rmods}                            Create List

    FOR  ${rmod_distname}  IN  @{ABIN_rmods.values()}
         ${related_rmods}                       Private Get Rmod Related To Cells
         ...                                    rmod_distname=${rmod_distname}
         ...                                    cell_types=${cell_types}
         ...                                    cells_to_ues=${cells_to_ues}
         ...                                    related_rmods=${related_rmods}
    END

    [Return]   ${related_rmods}


Private Get Rmod Related To Cells
    [Arguments]                                 ${rmod_distname}
    ...                                         ${cell_types}
    ...                                         ${cells_to_ues}
    ...                                         ${related_rmods}

    ${connection}=                              connections.get_default_admin_connection_alias

    FOR  ${cell_distname}  ${cell_type}  IN ZIP  ${cells_to_ues}  ${cell_types}
           ${rmod_id}                           Evaluate  int(str("""${rmod_distname}""").split('-')[-1])
           ${cell_id}                           Evaluate  int(str("""${cell_distname}""").split('-')[-1])
           ${rmod_cells}                        admin_info_model.get_cell_ids_for_ru_of_type
           ...                                  connection=${connection}
           ...                                  cell_type=${cell_type}
           ...                                  rmod_id=${rmod_id}
           Run Keyword If                       ${cell_id} in ${rmod_cells}   Run Keywords
           ...                                  Append To List   ${related_rmods}   ${rmod_distname}
           ...                                  AND
           ...                                  Exit For Loop
    END

    [Return]    ${related_rmods}


