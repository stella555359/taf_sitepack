*** Keywords ***
General_SiSo_Auto_UL_Test_Model_Verification
    [Documentation]
    ...  Varificates NR Uplink Test Model using selenium. Version for TDD and FDD radios.
    ...
    ...  :param str/list test_model: (Mandatory) One of following NR UL test models supported for cell configuration:
    ...                                          "G-FR1-A1-1", "G-FR1-A1-2", "G-FR1-A1-4", "G-FR1-A1-5", "G-FR1-A1-7",
    ...                                          "G-FR1-A2-1", "G-FR1-A2-2", "G-FR1-A2-4", "G-FR1-A2-5",
    ...                                          "GFR2-A1-2", "G-FR2-A1-3"
    ...                               It's possible to run many test models at once on tested cell by giving argument test_model as list of strings.
    ...                               In Robot Framework structure it's required to create list before starting Test Case, then pass the list
    ...                               as test_model parameter, e.g. :
    ...                               @{test_models}=         Create List                    G-FR1-A1-1  G-FR1-A1-2  G-FR1-A2-4
    ...                               General_SiSo_Auto_UL_Test_Model_Verification           test_model=@{test_models}
    ...  :param int cell_id: (Mandatory) : Global cell id of tested NR cell.
    ...  :param int beam_id: (Optional) : parameter beamPatternId, range <0 to 1200>, default 0.
    ...  :param float pmax: (Optional) : pmax parameter, required only for DL test model model startup in case TDD technology,
    ...                                  range <0 to 60 step=0.1>, None means default WebEM value will not be changed, default 30.
    ...  :param int rep_time_interval: (Optional) : reporting time interval (in seconds), range <0 to 4294967295>, default 2.
    ...  :param int measures: (Optional) : measures duration (in seconds) for sign analyser measurment, default 15.
    ...  :param int timeout: (Optional) : timeout (in seconds) for test model startup and termination, default 30.

    [Arguments]                                             ${test_model}
    ...                                                     ${cell_id}
    ...                                                     ${beam_id}=0
    ...                                                     ${pmax}=30
    ...                                                     ${rep_time_interval}=2
    ...                                                     ${measures}=15
    ...                                                     ${timeout}=30

    [Timeout]                                               24 hours

    Create admin session with default alias
    ${connection}                                           connections.get_default_admin_connection_alias
    ${webui_obj}                                            Create Selenium Session
    ...                                                     admin_connection=${connection}
    ...                                                     download_dir=${logs_path}

    ${local_cell}                                           scf.get_correct_local_cell_name
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    ${cell_technology}                                      admin_info_model.get_cell_technology
    ...                                                     connection=${connection}
    ...                                                     cell_type=nr
    ...                                                     cell_id=${cell_id}
    &{nrarfcn}                                              tm_setup_adm.get_nrafcn_variables_for_nr_cell_id
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}

    Remove All Test Modules Result Files                    download_dir=${logs_path}
    @{test_models_list}                                     tm_startup.create_test_models_list
    ...                                                     test_model=${test_model}
    FOR    ${tm_index}    ${tm_element}    IN ENUMERATE    @{test_models_list}
        ${test_id}                             Evaluate     ${tm_index} + 1
        Start Uplink Test                                   test_id=${test_id}
        ...                                                 test_model=${tm_element}
        ...                                                 local_cell=${local_cell}
        ...                                                 nr_cell=${cell_id}
        ...                                                 cell_technology=${cell_technology}
        ...                                                 beam_id=${beam_id}
        ...                                                 rep_time_interval=${rep_time_interval}
        ...                                                 pmax=${pmax}
        ...                                                 timeout=${timeout}
        ...                                                 &{nrarfcn}
        ${carrier_freq}                                     tm_startup.selenium_get_cell_carrier_frequency
        ...                                                 webui=${webui_obj}
        ...                                                 cell_id=${cell_id}
        ...                                                 downlink=${FALSE}
        Wait For Uplink Test Results And Stop Test          rep_time_interval=${rep_time_interval}
        ...                                                 measures=${measures}
        ...                                                 cell_technology=${cell_technology}
        ...                                                 timeout=${timeout}
        ...                                                 test_id=${test_id}
        ${webui_test_res}   ${webui_cumu_res}  ${webui_part_res}
        ...                                                 Parse and Log Uplink WebUI Tables Content
        ...                                                 test_id=${test_id}
        webui.save_5g_uplink_test_results                   test_id=${test_id}
        ${report_test_res}  ${report_cum_res}  ${report_part_res}
        ...                                                 Parse and Log Saved Report Content
        ...                                                 test_type=uplink
        ...                                                 nr_cell=${cell_id}
        ...                                                 download_dir=${logs_path}
        ...                                                 connection=${connection}
        ...                                                 report_id=${test_id}
        Verify Uplink Report and WebUI content              WebUI_test_res_table=${webui_test_res}
        ...                                                 WebUI_cumu_res_table=${webui_cumu_res}
        ...                                                 WebUI_part_res_table=${webui_part_res}
        ...                                                 report_test_res_table=${report_test_res}
        ...                                                 report_cum_res_table=${report_cum_res}
        ...                                                 report_part_res_table=${report_part_res}
        ${params_dict}=                                     table_validators.create_test_comparative_dictionary
        ...                                                 cell_name=${local_cell}
        ...                                                 carrier_freq=${carrier_freq}
        ...                                                 interval=${rep_time_interval}
        ...                                                 carrier_unit=MHz
        ...                                                 interval_unit=seconds
        ...                                                 prb_block_offset=0
        table_validators.validate_test_parameters_table     test_table=${webui_test_res}
        ...                                                 params_dict=${params_dict}
    END

    webui.refresh_page                                      wait_bar_menu_timeout=60
    Check Unavailability Of Uplink Test Module              nr_cell=${cell_id}
    ...                                                     test_model=${test_model}

    [Teardown]  Uplink Test Teardown                        cell_technology=${cell_technology}
