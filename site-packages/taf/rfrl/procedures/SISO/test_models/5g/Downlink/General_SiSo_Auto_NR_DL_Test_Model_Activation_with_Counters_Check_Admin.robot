*** Keywords ***
General_SiSo_Auto_NR_DL_Test_Model_Activation_with_Counters_Check_Admin
    [Documentation]
    ...  Activates NR Downlink Test Model using admin Api, collects energy counters and checks whether
    ...  they have changed. Default energy consumption counters checked are: M40003C2, M40002C1, M40003C4.
    ...  Version for TDD and FDD radios.
    ...  :param str test_models: (Mandatory) One of following NR DL test models supported for cell configuration:
    ...                                     "NR-FR1-TM1.1", "NR-FR1-TM1.2",
    ...                                     "NR-FR1-TM2", "NR-FR1-TM2a",
    ...                                     "NR-FR1-TM3.1", "NR-FR1-TM3.1a", "NR-FR1-TM3.2", "NR-FR1-TM3.3"
    ...                                     Default "NR-FR1-TM1.1".
    ...                                     It's possible to run many test models at once on tested cell by giving argument test_model as list of strings.
    ...                                     In Robot Framework structure it's required to create list before starting Test Case, then pass the list
    ...                                     as test_model parameter, e.g. :
    ...                                     ${test_models}=         Create List    NR-FR1-TM1.1  NR-FR1-TM1.2  NR-FR1-TM3.1
    ...                                     General_SiSo_Auto_NR_DL_Test_Model_Activation_with_Counters_Check_Admin   test_models=${test_models}
    ...  :param str test_duration: (Optional) : test duration (in minutes), default 15.
    ...  :param str counters: (Optional) : Comma separated string of counter ids to check, default M40003C2,M40002C1,M40003C4.
    ...                                    To create str of counters to check, use e.g. CATENATE keyword
    ...                                    ${counters}=            CATENATE          M40002C0,M40002C1,M40002C2,
    ...                                    ...                                       M40004C0,M40004C1,M40004C2,M40004C3,
    ...                                    ...                                       M40028C0,M40028C1,M40028C2,M40028C3,
    ...                                    ...                                       M40003C2,M40003C3,M40003C4,M40003C5
    ...                                    or in *** Variables *** section
    ...                                    ${counters}=                              M40003C2,M40002C1,M40003C4,
    ...                                    ...                                       M40004C0,M40004C1,M40004C2,M40004C3
    ...  :param str cell_id): (Optional) : Global cell id(s) of tested NR cell(s). Default None, which means that all available NR cells will be tested.
    ...  :param str beam_id: (Optional) : parameter beamPatternId, range <0 to 1200>, default 1.
    ...  :param str polarization: (Optional) : One of following: "P_plus45_or_0", "P_minus45_or_90", "P_both", default "P_both".
    ...  :param str pmax: (Optional) : pmax parameter, range <0 to 60 step=0.1>, if None, pmax will be read from current cell configuration.
    ...  :param str power_backoff: (Optional) : powerBackoff parameter, range <0 to 490>, default 0.
    ...  :param str type_of_load: (Optional) : Applicable only to test model NR-FR1-TM1.1.ETSI !!!type_of_load parameter, one of following: "flatLoad", "burstLoad", "slotWiseLoad", default None.
    ...  :param str load_level_flat: (Optional) : Applicable only to test model NR-FR1-TM1.1.ETSI and type_of_load == "flatLoad"!!!
    ...                                           loadLevelFlat parameter, one of following: "low", "medium", "busy", "full", default None.
    ...  :param str load_level_burst: (Optional) : Applicable only to test model NR-FR1-TM1.1.ETSI and type_of_load == "burstLoad" !!!
    ...                                            loadLevelBurst parameter, one of following: "burst_13_5", "burst_19_2", "burst_32_7", "burst_46_2",
    ...                                            "burst_59_6", "burst_73_1", "burst_86_5", "burst_100", default None.
    ...  :param str load_level_slot_wise: (Optional) : Applicable only to test model NR-FR1-TM1.1.ETSI and type_of_load == "slotWiseLoad" !!!
    ...                                                loadLevelSlotWise parameter, one of following: "load_0_low", "load_10", "load_30_medium", "load_50_busy_hour", "load_70", default None.
    ...  :param str num_of_ssb_beam_pattern_id: (Optional) : "ssb_4" | "ssb_8" | "ssb_32" (required only when "low" set for "load_level_flat".
    ...                                                       ssb_4 when FR1<=3GHz ssb_8 when 3 GHz<FR1<6 GHz ssb_32 when FR2. Note: 1 GHz = 1000 MHz).
    ...                                                       ssb_1 available from SBTS25R1., default None.
    ...  :param str ssb_beam_pattern_id: (Optional) : list of beam ids <0 to 1200>  (items number: 4, 8, 32 depends on value of "num_of_ssb_beam_pattern_id")
    ...  :param str lower_limit: (Optional) : lower value of difference range between counters, default 0.
    ...  :param str upper_limit: (Optional) : upper value of difference range between counters, default 300000.

    [Arguments]    ${test_models}=NR-FR1-TM1.1
    ...            ${test_duration}=15
    ...            ${counters}=M40003C2,M40002C1,M40003C4
    ...            ${cell_ids}=${None}
    ...            ${beam_pattern_id}=${None}
    ...            ${polarization}=P_both
    ...            ${p_max}=${None}
    ...            ${power_backoff}=0
    ...            ${load_type}=${None}
    ...            ${load_level_flat}=${None}
    ...            ${load_level_burst}=${None}
    ...            ${load_level_slot_wise}=${None}
    ...            ${num_of_ssb_beam_pattern_id}=${None}
    ...            ${ssb_beam_pattern_id}=${None}
    ...            ${timeout}=30
    ...            ${lower_limit}=0
    ...            ${upper_limit}=300000

    [Timeout]      24 hours

    ${bts_type}=                                            hwpta_testline.get_type_of_setup
    ${connection_alias}=                                    connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}
    Set test variable                                       ${connection}    ${connection_alias}

    ${cells_params}                                         Prepare Cells Parameters For Test
    ...                                                     cell_ids=${cell_ids}
    ...                                                     beam_pattern_id=${beam_pattern_id}
    ...                                                     polarization=${polarization}
    ...                                                     p_max=${p_max}
    ...                                                     power_backoff=${power_backoff}
    ...                                                     load_type=${load_type}
    ...                                                     load_level_flat=${load_level_flat}
    ...                                                     load_level_burst=${load_level_burst}
    ...                                                     load_level_slot_wise=${load_level_slot_wise}
    ...                                                     num_of_ssb_beam_pattern_id=${num_of_ssb_beam_pattern_id}
    ...                                                     ssb_beam_pattern_id=${ssb_beam_pattern_id}
    ...                                                     timeout=${timeout}
    ${cell_r_distnames}=                                    Evaluate  [params['distname_realtime'] for cell, params in $cells_params.items()]

    ${counter_ids}=                                         Evaluate  [c.strip() for c in $counters.split(",")]

    ${initial_counters}                                     Wait For Counters And Save Values to Dict
    ...                                                     counter_ids=${counter_ids}
    ...                                                     time=15min

    @{test_models_list}                                     tm_startup.create_test_models_list
    ...                                                     test_model=${test_models}
    FOR    ${tm_index}    ${tm_element}                     IN ENUMERATE     @{test_models_list}
        ${test_id}                                          Evaluate     ${tm_index} + 1

        Robot Log Operation                                 Performing the NR DOWNLINK: ${tm_element} test model for cell ids: ${cell_ids}
        ${admin_test_model_name}=                           Set Variable    ${tm_element.split("-")[-1].replace(".", "_").upper()}
        FOR    ${cell}    ${params}                         IN    &{cells_params}
            nr_conformance_adm.start_5g_downlink_test       connection=${connection}
            ...                                             test_model=${admin_test_model_name}
            ...                                             &{params}
            Check If Test Model Is Active                   admin_test_name=NR_DOWNLINK
            ...                                             cell_id=${params['distname_realtime'].split('-')[-1]}
            ...                                             connection=${connection}
        END

        ${latter_counters}                                  Wait For Counters And Save Values to Dict
        ...                                                 counter_ids=${counter_ids}
        ...                                                 time=${test_duration}
        
        NR Downlink Test Model Teardown                     connection=${connection}
        ...                                                 cell_r_distnames=${cell_r_distnames}
        
        Verify Difference Between Counters
        ...                                                 counters_1=${latter_counters}
        ...                                                 counters_2=${initial_counters}
        ...                                                 lower_limit=${lower_limit}
        ...                                                 upper_limit=${upper_limit}
    END

    [Teardown]                                              NR Downlink Test Model Teardown
    ...                                                     connection=${connection}
    ...                                                     cell_r_distnames=${cell_r_distnames}


Prepare Cells Parameters For Test
    [Documentation]  Prepares and returns dictionary with parameters of cells to be used in test.
    ...              If cell_ids parameter is None, then all available cells will be used.
    ...              If cell_ids parameter is given, then only those cells will be tested.
    [Arguments]      ${cell_ids}    
    ...              &{parameters}

    IF  ${cell_ids} == ${None}
        ${cell_ids}=                                       admin_info_model.get_cell_ids_from_specific_rat
        ...                                                connection=${connection}
    END
    ${cell_ids}=                                           utilities.convert_to_list    ${cell_ids}
    Set Test Variable                                      ${cell_ids}    ${cell_ids}

    &{cells_params}=                                       Create Dictionary
    FOR    ${cell_id}                                      IN    @{cell_ids}
        &{cell_arfcn}=                                     tm_setup_adm.get_nrafcn_variables_for_nr_cell_id
        ...                                                cell_id=${cell_id}
        ...                                                sep_channels_for_tdd=${True}
        ...                                                connection=${connection}
        ${cell_info}=                                      tm_setup_adm.get_cell_parameters_required_to_setup_test_model
        ...                                                cell_id=${cell_id}
        ...                                                connection=${connection}
        ${p_max}=                                          Set Variable If  '${parameters['p_max']}' == 'None'  ${cell_info['p_max']}    ${parameters['p_max']}
        ${cell_params}                                     Create Dictionary
        ...                                                distname_realtime=${cell_info['distname_runtime']}
        ...                                                phys_cell_id=${cell_info['phy_cellid']}
        ...                                                beam_id=${parameters['beam_pattern_id']}
        ...                                                power_backoff=${parameters['power_backoff']}
        ...                                                polarization=${parameters['polarization']}
        ...                                                ru_mode=NR_Only
        ...                                                codebook_2_antports=0
        ...                                                i11_codebook_4_antports=0
        ...                                                i2_codebook_4_antports=0
        ...                                                i13_codebook_4_antports=0
        ...                                                mimo_rank=1
        ...                                                vswr_monitoring=${False}
        ...                                                nrarfcn_dl=${cell_arfcn['nrarfcn_downlink']}
        ...                                                nrarfcn_ul=${cell_arfcn['nrarfcn_uplink']}
        ...                                                pmax=${p_max}
        ...                                                timeout=120
        ...                                                load_type=${parameters['load_type']}
        ...                                                load_level_flat=${parameters['load_level_flat']}
        ...                                                load_level_burst=${parameters['load_level_burst']}
        ...                                                load_level_slot_wise=${parameters['load_level_slot_wise']}
        ...                                                num_of_ssb_beam_pattern_id=${parameters['num_of_ssb_beam_pattern_id']}
        ...                                                ssb_beam_pattern_id=${parameters['ssb_beam_pattern_id']}
        ...                                                act_micro_dtx=${False}

        Set To Dictionary                                  ${cells_params}
        ...                                                NRCELL-${cell_id}=${cell_params}
    END

    [Return]                                               ${cells_params}