Library     taf.rfrl.procedures.resources.python.SCF                                   WITH NAME  scf
Library     taf.rfrl.procedures.resources.python.webui.webui                           WITH NAME  webui
Library     taf.rfrl.procedures.resources.python.test_models.StartupKeywords           WITH NAME  tm_startup
Library     taf.rfrl.procedures.resources.python.test_models.admin.SetupKeywordsAdmin  WITH NAME  tm_setup_adm
Library     taf.rfrl.procedures.resources.python.test_models.TableValidators           WITH NAME  table_validators
Library     taf.rfrl.procedures.resources.python.connections                           WITH NAME  connections

Resource    taf/rfrl/procedures/resources/robot/TestModels/Common.robot
Resource    taf/rfrl/procedures/resources/robot/Connections.robot
Resource    taf/rfrl/procedures/resources/robot/TestModels/PerformanceTestModels.robot


*** Keywords ***
General_SiSo_Auto_PUSCH_Performance_Test
    [Documentation]
    ...  PUSCH Performance Test. Version for TDD and FDD radios differs from other versions by nrarfcn argument.
    [Arguments]                                             ${cell_id}
    ...                                                     ${FRC_Index}
    ...                                                     ${ul_slots}=${None}
    ...                                                     ${rep_time_int}=1
    ...                                                     ${do_type}=SerialKeysight
    ...                                                     ${do_rate}=Bitrate_115dot2K
    ...                                                     ${beam_id}=${None}
    ...                                                     ${ru_mode}=${None}
    ...                                                     ${physical_cell_id}=${None}
    ...                                                     ${bb_selector}=${None}
    ...                                                     ${prb_offset}=${None}
    ...                                                     ${measures}=20
    ...                                                     ${uci_bits_number}=${None}
    ...                                                     ${csi_bits_payload}=${None}
    ...                                                     ${mapping_type}=${None}
    ...                                                     ${timeout}=30
    [Timeout]                                               24 hours

    Create admin session with default alias
    ${connection}=                                          connections.get_default_admin_connection_alias
    ${webui_obj}                                            Create Selenium Session
    ...                                                     admin_connection=${connection}
    ...                                                     download_dir=${logs_path}
    ${local_cell}=                                          scf.get_correct_local_cell_name
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    ${ul_slots}                      run keyword if        '${ul_slots}'=='${None}'
    ...                                                     tm_setup_adm.get_default_ul_slots_value
    ...                                                     connection=${connection}
    ...                                                     cell_id=${cell_id}
    ...                              ELSE                   set variable
    ...                                                     ${ul_slots}
    &{nrarfcn}=                                             tm_setup_adm.get_nrafcn_variables_for_nr_cell_id
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}

    Start PUSCH Performance Test                            frc_index=${FRC_Index}
    ...                                                     local_cell=${local_cell}
    ...                                                     rep_time_int=${rep_time_int}
    ...                                                     do_type=${do_type}
    ...                                                     do_rate=${do_rate}
    ...                                                     beam_id=${beam_id}
    ...                                                     mapping_type=${mapping_type}
    ...                                                     ru_mode=${ru_mode}
    ...                                                     physical_cell_id=${physical_cell_id}
    ...                                                     bb_selector=${bb_selector}
    ...                                                     prb_offset=${prb_offset}
    ...                                                     uci_bits_number=${uci_bits_number}
    ...                                                     csi_bits_payload=${csi_bits_payload}
    ...                                                     timeout=${timeout}
    ...                                                     &{nrarfcn}

    ${carrier_freq}                                         tm_startup.selenium_get_cell_carrier_frequency
    ...                                                     webui=${webui_obj}
    ...                                                     cell_id=${cell_id}
    ...                                                     downlink=${FALSE}

    Wait For Performance Test Results And Stop Test         rep_time_interval=${rep_time_int}
    ...                                                     measures=${measures}
    ...                                                     timeout=${timeout}

    webui.save_performance_test_results

    ${webui_test_res}   ${webui_cumu_res}  ${webui_part_res}
    ...                                                     Parse and Log Performance WebUI Tables Content
    ${report_test_res}  ${report_cum_res}  ${report_part_res}
    ...                                                     Parse and Log Saved Report Content
    ...                                                     download_dir=${logs_path}
    ...                                                     test_type=PUSCH
    ...                                                     nr_cell=${cell_id}
    ...                                                     connection=${connection}

    Check Unavailability Of Performance Test Module         nr_cell=${cell_id}
    ...                                                     FRC_Index=${FRC_Index}

    Compare File Report with WebUI Content                  WebUI_test_res_table=${webui_test_res}
    ...                                                     WebUI_cumu_res_table=${webui_cumu_res}
    ...                                                     WebUI_part_res_table=${webui_part_res}
    ...                                                     report_test_res_table=${report_test_res}
    ...                                                     report_cum_res_table=${report_cum_res}
    ...                                                     report_part_res_table=${report_part_res}

    ${params_dict}                                          table_validators.create_perf_comparative_dictionary
    ...                                                     cell_name=${local_cell}
    ...                                                     carrier_freq=${carrier_freq[:-3]}
    ...                                                     test_type=PUSCH
    ...                                                     interval=${rep_time_int}
    ...                                                     interval_unit=second
    ...                                                     carrier_unit=MHz

    table_validators.validate_test_parameters_table          test_table=${webui_test_res}
    ...                                                     params_dict=${params_dict}

    Validate PUSCH Performance Tables Results               WebUI_cumu_res_table=${webui_cumu_res}
    ...                                                     WebUI_part_res_table=${webui_part_res}
    ...                                                     WebUI_test_res_table=${webui_test_res}
    ...                                                     FRC_Index=${FRC_Index}
    ...                                                     ul_slots=${ul_slots}

    [Teardown]                                              Performance Test Teardown
