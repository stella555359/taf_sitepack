*** Keywords ***
General_SiSo_Auto_PRACH_Performance_Test
    [Documentation]
    ...  PRACH Performance Test. Version for TDD and FDD radios on master differs from other versions by input arguments.
    ...  Argument prach_seq_type can only be set since SBTS22R4 release.
    [Arguments]                                             ${cell_id}
    ...                                                     ${rep_time_int}=1
    ...                                                     ${ul_slots}=${None}
    ...                                                     ${beam_id}=${None}
    ...                                                     ${ru_mode}=${None}
    ...                                                     ${physical_cell_id}=${None}
    ...                                                     ${reception_slot}=1023
    ...                                                     ${expectation_slot}=341
    ...                                                     ${preamble_index}=${None}
    ...                                                     ${accepted_timing_error}=${None}
    ...                                                     ${delay_pattern_duration}=${None}
    ...                                                     ${constant_offset}=${None}
    ...                                                     ${pfa_target}=${None}
    ...                                                     ${prach_config_index}=${None}
    ...                                                     ${root_seq_index}=${None}
    ...                                                     ${zero_zone_config}=${None}
    ...                                                     ${prach_seq_type}=${None}
    ...                                                     ${measures}=20
    ...                                                     ${timeout}=30
    ...                                                     ${act_prach_format_c2_with_scs}=${False}
    [Timeout]                                               24 hours

    Create admin session with default alias
    ${connection}=                                          connections.get_default_admin_connection_alias
    ${webui_obj}                                            Create Selenium Session
    ...                                                     admin_connection=${connection}
    ...                                                     download_dir=${logs_path}
    ${local_cell}=                                          scf.get_correct_local_cell_name
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    ${ul_slots}                      run keyword if        '${ul_slots}'=='${None}'
    ...                                                     tm_setup_adm.get_default_ul_slots_value
    ...                                                     connection=${connection}
    ...                                                     cell_id=${cell_id}
    ...                              ELSE                   set variable
    ...                                                     ${ul_slots}
    &{nrarfcn}=                                             tm_setup_adm.get_nrafcn_variables_for_nr_cell_id
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    ${cell_dist_names}  ${physical_cell_id}                 Get Cell Info for Performance Test
    ...                                                     config_nr_cell_id=${cell_id}
    ...                                                     connection=${connection}
    ${technology_type}                                      admin_info_model.get_cell_technology
    ...                                                     connection=${connection}
    ...                                                     cell_type=nr
    ...                                                     cell_id=${cell_id}

    config_operations.connect                               alias=${connection}
    ${scs}=                                                 config_operations.get_parameter_value
    ...                                                     dist_name=${cell_dist_names["configuration"]}
    ...                                                     param_name=ssbScs

    Remove All Test Modules Result Files                    mode=performance
    ...                                                     download_dir=${logs_path}

    Start PRACH Performance Test                            local_cell=${local_cell}
    ...                                                     rep_time_int=${rep_time_int}
    ...                                                     beam_id=${beam_id}
    ...                                                     ru_mode=${ru_mode}
    ...                                                     physical_cell_id=${physical_cell_id}
    ...                                                     reception_slot=${reception_slot}
    ...                                                     expectation_slot=${expectation_slot}
    ...                                                     preamble_index=${preamble_index}
    ...                                                     accepted_timing_error=${accepted_timing_error}
    ...                                                     delay_pattern_duration=${delay_pattern_duration}
    ...                                                     constant_offset=${constant_offset}
    ...                                                     pfa_target=${pfa_target}
    ...                                                     prach_config_index=${prach_config_index}
    ...                                                     root_seq_index=${root_seq_index}
    ...                                                     zero_zone_config=${zero_zone_config}
    ...                                                     prach_seq_type=${prach_seq_type}
    ...                                                     activate_prach_format_c2=${act_prach_format_c2_with_scs}
    ...                                                     timeout=${timeout}
    ...                                                     &{nrarfcn}
    ${carrier_freq}                                         tm_startup.selenium_get_cell_carrier_frequency
    ...                                                     webui=${webui_obj}
    ...                                                     cell_id=${cell_id}
    Wait For Performance Test Results And Stop Test         rep_time_interval=${rep_time_int}
    ...                                                     measures=${measures}
    ...                                                     timeout=${timeout}

    webui.save_performance_test_results
    ${webui_test_res}   ${webui_cumu_res}  ${webui_part_res}
    ...                                                     Parse and Log Performance WebUI Tables Content
    ${report_test_res}  ${report_cum_res}  ${report_part_res}
    ...                                                     Parse and Log Saved Report Content
    ...                                                     download_dir=${logs_path}
    ...                                                     test_type=PRACH
    ...                                                     nr_cell=${cell_id}
    ...                                                     connection=${connection}

    ${FRC_Index}                                            tm_startup.get_prach_frc_index
    ...                                                     prach_config_index=${prach_config_index}
    Check Unavailability Of Performance Test Module         nr_cell=${cell_id}
    ...                                                     FRC_Index=${FRC_Index}

    Compare File Report with WebUI Content                  WebUI_test_res_table=${webui_test_res}
    ...                                                     WebUI_cumu_res_table=${webui_cumu_res}
    ...                                                     WebUI_part_res_table=${webui_part_res}
    ...                                                     report_test_res_table=${report_test_res}
    ...                                                     report_cum_res_table=${report_cum_res}
    ...                                                     report_part_res_table=${report_part_res}
    Validate PRACH Performance Tables Results               WebUI_test_res_table=${webui_test_res}
    ...                                                     WebUI_cumu_res_table=${webui_cumu_res}
    ...                                                     WebUI_part_res_table=${webui_part_res}
    ...                                                     expectation_slot=${expectation_slot}
    ...                                                     reception_slot=${reception_slot}
    ...                                                     technology_type=${technology_type}
    ...                                                     scs=${scs}
    [Teardown]                                              Performance Test Teardown
