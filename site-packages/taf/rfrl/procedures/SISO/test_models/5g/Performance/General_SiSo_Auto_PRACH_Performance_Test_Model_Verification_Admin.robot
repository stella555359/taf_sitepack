*** Keywords ***
General_SiSo_Auto_PRACH_Performance_Test_Admin
    [Documentation]
    ...  PRACH Performance Test. Admin API version for TDD and FDD radios.
    ...  Argument prach_seq_type can only be set since SBTS22R4 release.
    [Arguments]                                             ${cell_id}
    ...                                                     ${ul_slots}=${None}
    ...                                                     ${rep_time_int}=1
    ...                                                     ${ru_mode}=NR_Only
    ...                                                     ${act_high_speed_cell}=${False}
    ...                                                     ${prach_root_sequence_index}=0
    ...                                                     ${accepted_timing_error}=0
    ...                                                     ${prach_config_index}=0
    ...                                                     ${delay_pattern_duration}=0
    ...                                                     ${reception_slot}=1023
    ...                                                     ${prach_seq_type}=Unrestricted
    ...                                                     ${beam_id}=0
    ...                                                     ${digital_output_enable}=${False}
    ...                                                     ${zero_zone_config}=0
    ...                                                     ${constant_offset}=0
    ...                                                     ${pb_false_alarm_target}=P_None
    ...                                                     ${preamble_index}=0
    ...                                                     ${expectation_slot}=341
    ...                                                     ${act_prach_format_c2_with_scs}=${False}
    ...                                                     ${timeout}=60
    ...                                                     ${initial_measurements_to_remove}=2
    ...                                                     ${admin_test_name}=NR_CONTROL
    [Timeout]                                               24 hours

    Create admin session with default alias
    ${connection}                                           connections.get_default_admin_connection_alias
    ${cell_dist_names}  ${physical_cell_id}                 Get Cell Info for Performance Test
    ...                                                     config_nr_cell_id=${cell_id}
    ...                                                     connection=${connection}
    ${ul_slots}                  run keyword if             '${ul_slots}'=='${None}'
    ...                                                     tm_setup_adm.get_default_ul_slots_value
    ...                                                     connection=${connection}
    ...                                                     cell_id=${cell_id}
    ...                          ELSE                       set variable
    ...                                                     ${ul_slots}
    &{nrarfcn}=                                             tm_setup_adm.get_nrafcn_variables_for_nr_cell_id
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    ...                                                     sep_channels_for_tdd=${True}
    ${beam_pattern_id}                                      tm_startup.prepare_beam_id_parameter
    ...                                                     ${beam_id}
    ${technology_type}                                      admin_info_model.get_cell_technology
    ...                                                     connection=${connection}
    ...                                                     cell_type=nr
    ...                                                     cell_id=${cell_id}

    config_operations.connect                               alias=${connection}
    ${scs}=                                                 config_operations.get_parameter_value
    ...                                                     dist_name=${cell_dist_names["configuration"]}
    ...                                                     param_name=ssbScs

    Robot log operation                                     Starting NR PRACH performance test...
    ${start_test_result}                                    nr_conformance_adm.start_5g_prach_performance_test
    ...                                                     cell_dist_name=${cell_dist_names["run_time"]}
    ...                                                     interval=${rep_time_int}
    ...                                                     beam_pattern_id=${beam_pattern_id}
    ...                                                     receiving_slot=${reception_slot}
    ...                                                     expectation_slot=${expectation_slot}
    ...                                                     preamble_index=${preamble_index}
    ...                                                     prach_root_sequence_index=${prach_root_sequence_index}
    ...                                                     zero_correlation_zone_config=${zero_zone_config}
    ...                                                     accepted_timing_error=${accepted_timing_error}
    ...                                                     constant_offset=${constant_offset}
    ...                                                     delay_pattern_single_step_duration=${delay_pattern_duration}
    ...                                                     ru_mode=${ru_mode}
    ...                                                     phys_cell_id=${physical_cell_id}
    ...                                                     prach_configuration_index=${prach_config_index}
    ...                                                     pfa_target_prach_id=${pb_false_alarm_target}
    ...                                                     nrarfcn_ul=${nrarfcn['nrarfcn_uplink']}
    ...                                                     nrarfcn_dl=${nrarfcn['nrarfcn_downlink']}
    ...                                                     timeout=${timeout}
    ...                                                     prach_sequence_type=${prach_seq_type}
    ...                                                     act_high_speed_cell=${act_high_speed_cell}
    ...                                                     digital_output_enable=${digital_output_enable}
    ...                                                     act_prach_format_c2_with_scs=${act_prach_format_c2_with_scs}
    ...                                                     connection=${connection}

    Should Be Equal As Strings                              ${start_test_result['status']}
    ...                                                     Succeeded
    ...                                                     msg=NR PRACH test start failed: ${start_test_result['msg']}

    Check If Test Model Is Active                           admin_test_name=${admin_test_name}
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}

    ${admin_test_results}                                   Get Results from Performance Test
    ...                                                     cell_dist_name=${cell_dist_names["run_time"]}
    ...                                                     test_name=PRACH
    ...                                                     connection=${connection}

    Robot log operation                                     Stopping NR PRACH performance test...
    tm_nr_adm.stop_5g_performance_test                      connection=${connection}
    ...                                                     cell_dist_name=${cell_dist_names["run_time"]}
    ...                                                     test_name=${admin_test_name}
    ...                                                     timeout=${timeout}

    Robot log operation                                     Removing first ${initial_measurements_to_remove} measurements from the results...
    ${updated_admin_test_results}                           Get Slice From List    ${admin_test_results}    ${initial_measurements_to_remove}

    ${part_results}  ${cumu_results}  ${test_results}       Reformat Performance Test Results
    ...                                                     performance_test_type=PRACH
    ...                                                     admin_test_results=${updated_admin_test_results}
    ...                                                     cell_id=${cell_id}
    ...                                                     rep_time_interval=${rep_time_int}
    ...                                                     ul_slots=${ul_slots}
    ...                                                     nrarfcn_ul=${nrarfcn['nrarfcn_uplink']}

    Robot log operation                                     Validating results...
    Validate PRACH Performance Tables Results               WebUI_test_res_table=${test_results}
    ...                                                     WebUI_cumu_res_table=${cumu_results}
    ...                                                     WebUI_part_res_table=${part_results}
    ...                                                     expectation_slot=${expectation_slot}
    ...                                                     reception_slot=${reception_slot}
    ...                                                     technology_type=${technology_type}
    ...                                                     scs=${scs}

    [Teardown]                                              Terminate PRACH Performance Test
    ...                                                     cell_dist_name=${cell_dist_names["run_time"]}
    ...                                                     test_model_name=${admin_test_name}
    ...                                                     connection=${connection}
    ...                                                     timeout=${timeout}


Terminate PRACH Performance Test
    [Documentation]  Stops currently running NR PRACH performance test via admin API.
    [Arguments]    ${cell_dist_name}
    ...            ${test_model_name}
    ...            ${connection}
    ...            ${timeout}

    ${active_tests}                                         tm_common_adm.get_active_tests
    ...                                                     connection=${connection}
    Run Keyword If                                          ${active_tests} != []
    ...                                                     tm_nr_adm.stop_5g_performance_test
    ...                                                     connection=${connection}
    ...                                                     cell_dist_name=${cell_dist_name}
    ...                                                     test_name=${test_model_name}
    ...                                                     timeout=${timeout}
    Check If Any Test Model Is Active                       should_be_active=${False}
    ...                                                     connection=${connection}
    ...                                                     timeout=${timeout}
