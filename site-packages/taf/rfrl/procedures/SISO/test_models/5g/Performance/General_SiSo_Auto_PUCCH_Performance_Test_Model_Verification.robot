General_SiSo_Auto_PUCCH_Performance_Test_v3
    [Documentation]
    ...  Third version of PUCCH Performance Test Module Verificaiton TC (version [3.0] in QC).
    ...  Version for TDD and FDD radios.
    ...  Argument f3_additional_dmrs can only be set since SBTS22R3 for pucch_format=F3.
    [Arguments]                                             ${cell_id}
    ...                                                     ${beam_id}=${None}
    ...                                                     ${ru_mode}=${None}
    ...                                                     ${ul_slots}=${None}
    ...                                                     ${pucch_format}=F0
    ...                                                     ${number_of_pucch_symbol}=1
    ...                                                     ${reception_slot}=1023
    ...                                                     ${rep_time_int}=1
    ...                                                     ${prb_offset}=${None}
    ...                                                     ${f3_additional_dmrs}=${None}
    ...                                                     ${largest_prb_index}=${None}
    ...                                                     ${pucch_payload_content}=${None}
    ...                                                     ${expectation_slot}=341
    ...                                                     ${measures}=20
    ...                                                     ${timeout}=30
    ...                                                     ${download_dir}=/tmp
    [Timeout]                                               24 hours

    Create admin session with default alias
    ${connection}=                                          connections.get_default_admin_connection_alias
    Create Selenium Session                                 admin_connection=${connection}
    ...                                                     download_dir=${logs_path}
    ${local_cell}=                                          scf.get_correct_local_cell_name
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    ${cell_dist_names}  ${physical_cell_id}                 Get Cell Info for Performance Test
    ...                                                     config_nr_cell_id=${cell_id}
    ...                                                     connection=${connection}

    ${ul_slots}                      run keyword if        '${ul_slots}'=='${None}'
    ...                                                     tm_setup_adm.get_default_ul_slots_value
    ...                                                     connection=${connection}
    ...                                                     cell_id=${cell_id}
    ...                              ELSE                   set variable
    ...                                                     ${ul_slots}
    &{nrarfcn}=                                             tm_setup_adm.get_nrafcn_variables_for_nr_cell_id
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    ${technology_type}                                      admin_info_model.get_cell_technology
    ...                                                     connection=${connection}
    ...                                                     cell_type=nr
    ...                                                     cell_id=${cell_id}

    config_operations.connect                               alias=${connection}
    ${scs}=                                                 config_operations.get_parameter_value
    ...                                                     dist_name=${cell_dist_names["configuration"]}
    ...                                                     param_name=ssbScs

    Start PUCCH Performance Test                            local_cell=${local_cell}
    ...                                                     beam_id=${beam_id}
    ...                                                     ru_mode=${ru_mode}
    ...                                                     pucch_format=${pucch_format}
    ...                                                     number_of_pucch_symbol=${number_of_pucch_symbol}
    ...                                                     reception_slot=${reception_slot}
    ...                                                     rep_time_int=${rep_time_int}
    ...                                                     physical_cell_id=${physical_cell_id}
    ...                                                     prb_offset=${prb_offset}
    ...                                                     largest_prb_index=${largest_prb_index}
    ...                                                     f3_additional_dmrs=${f3_additional_dmrs}
    ...                                                     pucch_payload_content=${pucch_payload_content}
    ...                                                     expectation_slot=${expectation_slot}
    ...                                                     timeout=${timeout}
    ...                                                     &{nrarfcn}
    Wait For Performance Test Results And Stop Test         rep_time_interval=${rep_time_int}
    ...                                                     measures=${measures}
    ...                                                     timeout=${timeout}

    webui.save_performance_test_results
    ${webui_test_res}   ${webui_cumu_res}  ${webui_part_res}
    ...                                                     Parse and Log Performance WebUI Tables Content
    ${report_test_res}  ${report_cum_res}  ${report_part_res}
    ...                                                     Parse and Log Saved Report Content
    ...                                                     download_dir=${logs_path}
    ...                                                     test_type=PUCCH
    ...                                                     nr_cell=${cell_id}
    ...                                                     connection=${connection}

    Check Unavailability Of Performance Test Module         nr_cell=${cell_id}
    ...                                                     FRC_Index=${pucch_format}

    Compare File Report with WebUI Content                  WebUI_test_res_table=${webui_test_res}
    ...                                                     WebUI_cumu_res_table=${webui_cumu_res}
    ...                                                     WebUI_part_res_table=${webui_part_res}
    ...                                                     report_test_res_table=${report_test_res}
    ...                                                     report_cum_res_table=${report_cum_res}
    ...                                                     report_part_res_table=${report_part_res}
    Validate PUCCH Performance Tables Results               WebUI_cumu_res_table=${webui_cumu_res}
    ...                                                     WebUI_part_res_table=${webui_part_res}
    ...                                                     WebUI_test_res_table=${webui_test_res}
    ...                                                     test_format=${pucch_format}
    ...                                                     expectation_slot=${expectation_slot}
    ...                                                     reception_slot=${reception_slot}
    ...                                                     technology_type=${technology_type}
    ...                                                     scs=${scs}
    ...                                                     number_of_pucch_symbol=${number_of_pucch_symbol}
    ...                                                     version=3

    [Teardown]                                              Performance Test Teardown


