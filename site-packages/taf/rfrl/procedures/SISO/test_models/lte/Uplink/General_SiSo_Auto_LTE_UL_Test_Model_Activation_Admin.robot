*** Keywords ***
General_SiSo_Auto_LTE_UL_Test_Model_Activation_Admin
    [Documentation]
    ...  Activates LTE Uplink Test Model via admin API. Version for TDD and FDD radios.
    ...  If parameter activate_parallel_dl_test_for_tdd is True, parallel LTE DL Test Model E-TM1.1 will be started before Uplink test
    ...  only in case of TDD cell configuration. For FDD cell, parallel LTE DL Test Model run is not required and will be skipped.
    ...
    ...  :param str test_model: (Mandatory) One of following LTE UL test models supported for cell configuration:
    ...                                     "A1-1", "A1-2", "A1-3",
    ...                                     "A1-4", "A1-5", "A1-6",
    ...                                     "A1-7", "A2-1", "A2-2",
    ...                                     "A2-3"
    ...  :param int cell_id: (Mandatory) : Global cell id of tested LTE cell.
    ...  :param int rep_time_interval: (Optional) : reporting time interval (in seconds), range <0 to 4294967295>, default 1.
    ...  :param int resource_block_offset: (Optional) : resource block offset, range <0 to 99>, default 25.
    ...  :param str digital_output_type: (Optional) : type of digital output, One of the following:
    ...                                              "BinaryHarq", "SerialAgilent", "SerialRs", default "SerialRs".
    ...  :param int tdd_spec_subf_conf: (Optional) : parameter required for TDD configuration, range <3 to 9>, default 7.
    ...  :param int tdd_frame_conf: (Optional) : parameter required for TDD configuration, range <1 to 3>, default 1.
    ...  :param bool activate_parallel_dl_test_for_tdd: (Optional) : if True, parallel LTE DL Test Model E-TM1.1 will be
    ...   started before Uplink test only in case of TDD cell configuration. Default set True.
    ...  :param int timeout: (Optional) : timeout (in seconds) for test startup and termination, default 30.

    [Arguments]  ${test_model}
    ...          ${cell_id}
    ...          ${rep_time_interval}=1
    ...          ${resource_block_offset}=25
    ...          ${digital_output_type}=SerialRs
    ...          ${tdd_spec_subf_conf}=8
    ...          ${tdd_frame_conf}=3
    ...          ${activate_parallel_dl_test_for_tdd}=${True}
    ...          ${timeout}=60
    [Timeout]    24 hours

    ${bts_type}                                             hwpta_testline.get_type_of_setup
    ${connection}                                           connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}
    Create admin session with default alias                 bts_type=${bts_type}
    ${cells_params}                                         tm_setup_adm.get_cell_parameters_required_to_setup_test_model
    ...                                                     cell_id=${cell_id}
    ...                                                     cell_type=lte
    ...                                                     connection=${connection}
    Robot Log Variable                                      Parameters required to TM start: ${cells_params}
    &{earfcn}=                                              tm_setup_adm.get_earfcn_variables_for_lte_cell_id
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    ...                                                     sep_channels_for_tdd=${True}

    Start LTE Uplink Test                                   distname_realtime=${cells_params["distname_runtime"]}
    ...                                                     test_model=${test_model.replace('-', '_').replace('.', '_')}
    ...                                                     earfcn_ul=${earfcn['earfcn_uplink']}
    ...                                                     phy_cell_id=${cells_params["phy_cellid"]}
    ...                                                     reporting_time_interval=${rep_time_interval}
    ...                                                     resource_block_offset=${resource_block_offset}
    ...                                                     digital_output_type=${digital_output_type}
    ...                                                     tdd_spec_subf_conf=${tdd_spec_subf_conf}
    ...                                                     tdd_frame_conf=${tdd_frame_conf}
    ...                                                     activate_parallel_dl_test_for_tdd=${activate_parallel_dl_test_for_tdd}
    ...                                                     connection=${connection}
    ...                                                     timeout=${timeout}

    Sleep                                                   10s
    ...                                                     Reason=Waiting for test model ${test_model} performing...

    Stop LTE Uplink Test                                    distname_realtime=${cells_params["distname_runtime"]}
    ...                                                     test_model=${test_model.replace('-', '_').replace('.', '_')}
    ...                                                     timeout=${timeout}
    ...                                                     connection=${connection}
    ...                                                     deactivate_parallel_dl_test_for_tdd=${activate_parallel_dl_test_for_tdd}

    Check If Any Test Model Is Active                       should_be_active=${False}
    ...                                                     connection=${connection}

    [Teardown]  LTE UL Test Model Activation Teardown
    ...                                                     distname_realtime=${cells_params["distname_runtime"]}
    ...                                                     test_model=${test_model.replace('-', '_').replace('.', '_')}
    ...                                                     connection=${connection}
    ...                                                     timeout=120
