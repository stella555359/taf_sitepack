*** Keywords ***
General_SiSo_Auto_LTE_DL_Test_Model_Activation_Admin
    [Documentation]
    ...  Activates LTE Downlink Test Model via admin API. Version for TDD and FDD radios.
    ...
    ...  :param str test_model: (Mandatory) One of following LTE DL test models supported for cell configuration:
    ...                                     "E-TM1.1", "E-TM1.2", "E-TM1.3",
    ...                                     "E-TM2", "E-TM2a", "E-TM3.1a",
    ...                                     "E-TM3.1", "E-TM3.2", "E-TM3.3",
    ...                                     "MIMO-TM3.1", "E-TM1.1_EE_LOW",
    ...                                     "E-TM1.1_EE_MID", "E-TM1.1_EE_HIGH",
    ...                                     "ChirpUp", "ChirpDown"
    ...  :param int cell_id: (Mandatory) : Global cell id of tested LTE cell.
    ...  :param int tdd_spec_subf_conf: (Optional) : parameter required for TDD configuration, range <3 to 9>, default 7.
    ...  :param int tdd_frame_conf: (Optional) : parameter required for TDD configuration, range <1 to 3>, default 1.
    ...  :param int timeout: (Optional) : timeout (in seconds) for test startup and termination, default 30.

    [Arguments]  ${test_model}
    ...          ${cell_id}
    ...          ${tdd_spec_subf_conf}=7
    ...          ${tdd_frame_conf}=1
    ...          ${timeout}=30

    [Timeout]    24 hours

    ${bts_type}                                             hwpta_testline.get_type_of_setup
    ${connection}                                           connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}
    Create admin session with default alias                 bts_type=${bts_type}
    ${cells_params}                                         tm_setup_adm.get_cell_parameters_required_to_setup_test_model
    ...                                                     cell_id=${cell_id}
    ...                                                     cell_type=lte
    ...                                                     connection=${connection}
    Robot Log Variable                                      Parameters required to TM start: ${cells_params}
    ${cell_technology}=                                     admin_info_model.get_cell_technology
    ...                                                     connection=${connection}
    ...                                                     cell_type=lte
    ...                                                     cell_id=${cell_id}
    &{earfcn}                                               tm_setup_adm.get_earfcn_variables_for_lte_cell_id
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    ...                                                     sep_channels_for_tdd=${True}

    Start LTE Downlink Test                                 distname_realtime=${cells_params["distname_runtime"]}
    ...                                                     test_model=${test_model.replace('-', '_').replace('.', '_')}
    ...                                                     earfcn_dl=${earfcn['earfcn_downlink']}
    ...                                                     phy_cell_id=${cells_params["phy_cellid"]}
    ...                                                     tdd_spec_subf_conf=${tdd_spec_subf_conf}
    ...                                                     tdd_frame_conf=${tdd_frame_conf}
    ...                                                     timeout=${timeout}
    ...                                                     connection=${connection}

    Sleep                                                   10s
    ...                                                     Reason=Waiting for test model ${test_model} performing...

    Stop LTE Downlink Test                                  distname_realtime=${cells_params["distname_runtime"]}
    ...                                                     test_model=${test_model.replace('-', '_').replace('.', '_')}
    ...                                                     timeout=${timeout}
    ...                                                     connection=${connection}

    Check If Any Test Model Is Active                       should_be_active=${False}
    ...                                                     connection=${connection}

    [Teardown]  LTE DL Test Model Activation Teardown
    ...                                                     distname_realtime=${cells_params["distname_runtime"]}
    ...                                                     test_model=${test_model.replace('-', '_').replace('.', '_')}
    ...                                                     connection=${connection}
    ...                                                     timeout=120
