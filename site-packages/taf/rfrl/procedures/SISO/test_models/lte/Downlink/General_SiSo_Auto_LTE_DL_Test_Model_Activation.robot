*** Keywords ***
General_SiSo_Auto_LTE_DL_Test_Model_Activation
    [Documentation]
    ...  Activates Downlink Test Model via selenium. Version for TDD and FDD radios.
    ...
    ...  :param str/list test_model: (Mandatory) One of following LTE DL test models supported for cell configuration:
    ...                                          "E-TM1.1", "E-TM1.2", "E-TM1.3",
    ...                                          "E-TM2", "E-TM2a", "E-TM3.1a",
    ...                                          "E-TM3.1", "E-TM3.2", "E-TM3.3",
    ...                                          "MIMO-TM3.1", "E-TM1.1_EE_LOW",
    ...                                          "E-TM1.1_EE_MID", "E-TM1.1_EE_HIGH",
    ...                                          "ChirpUp", "ChirpDown", "E-TM1.1.ETSI"
    ...                               It's possible to run many test models at once on tested cell by giving argument test_model as list of strings.
    ...                               In Robot Framework structure it's required to create list before starting Test Case, then pass the list
    ...                               as test_model parameter, e.g. :
    ...                               @{test_models}=         Create List                    E-TM1.1  E-TM1.2  E-TM3.1
    ...                               General_SiSo_Auto_LTE_DL_Test_Model_Activation         test_model=@{test_models}
    ...  :param int cell_id: (Mandatory) : Global cell id of tested LTE cell.
    ...  :param int ul_dl_configuration: (Optional) : parameter exists only for TDD cell configuration, range <1 to 3>,
    ...                                               default None means default parameter value in WebEM will not be changed.
    ...  :param int timeout: (Optional) : timeout (in seconds) for test model startup and termination, default 25.
    ...  :param str level_of_load: (Optional) : loadLevel parameter, one of following: "load_0_low", "load_10", "load_30_medium",
    ...                                         "load_50_busy_hour", "load_70",
    ...                                         default None means default WebEM value will not be changed.
    [Arguments]                                             ${test_model}
    ...                                                     ${cell_id}
    ...                                                     ${ul_dl_configuration}=${None}
    ...                                                     ${timeout}=25
    ...                                                     ${level_of_load}=${None}
    [Timeout]                                               24 hours

    ${bts_type}                                             hwpta_testline.get_type_of_setup
    ${connection}                                           connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}
    Create admin session with default alias                 bts_type=${bts_type}
    ${webui_obj}                                            Create Selenium Session
    ...                                                     admin_connection=${connection}
    ...                                                     download_dir=${logs_path}
    ...                                                     bts_type=${bts_type}
    ${cells_params}                                         tm_setup_adm.get_cell_parameters_required_to_setup_test_model
    ...                                                     cell_id=${cell_id}
    ...                                                     cell_type=lte
    ...                                                     connection=${connection}
    ${local_cell}                                           scf.get_correct_local_cell_name
    ...                                                     cell_id=${cell_id}
    ...                                                     cell_type=lte
    ...                                                     connection=${connection}

    Remove All Test Modules Result Files                    download_dir=${logs_path}
    @{test_models_list}                                     tm_startup.create_test_models_list
    ...                                                     test_model=${test_model}
    FOR    ${tm_index}    ${tm_element}    IN ENUMERATE    @{test_models_list}
        ${test_id}                             Evaluate     ${tm_index} + 1
        Start Downlink Test LTE                             test_id=${test_id}
        ...                                                 test_model=${tm_element}
        ...                                                 local_cell=${local_cell}
        ...                                                 physical_cell_id=${cells_params["phy_cellid"]}
        ...                                                 ul_dl_configuration=${ul_dl_configuration}
        ...                                                 timeout=${timeout}
        ...                                                 level_of_load=${level_of_load}
        Stop Downlink Test Module LTE                       test_id=${test_id}
        ...                                                 timeout=${timeout}
    END

    webui.refresh_page                                      wait_bar_menu_timeout=60

    [Teardown]                                              Downlink Test Activation Teardown LTE
