Get RMOD Amplifier Device Voltage
    [Arguments]    ${rmod_id}
    ...            ${connection}
    ...            ${bts_type}
    ...            ${ant_tx_id}
    ${activation_create}                                    rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/ action create AmplifierDevice /CI/tx${ant_tx_id}_AmplifierDevice /rf/tx${ant_tx_id}
    ...                                                     connection=${connection}
    Should Contain Any                                      ${activation_create}
    ...                                                     done ok    Path already taken
    ...                                                     msg=Activation create AmplifierDevice is not completed.
    Robot Log Result                                        Activation create AmplifierDevice is completed.

    ${get_votlage_action}                                   rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/CI/tx${ant_tx_id}_AmplifierDevice get voltage
    ...                                                     connection=${connection}
    Should Contain                                          ${get_votlage_action}
    ...                                                     done ok
    ...                                                     msg=Activation AmplifierDevice get voltage failed.
    Robot Log Result                                        Activation AmplifierDevice get voltage is completed.

    ${voltage_value_message}                                Evaluate
    ...                                                     str("""${get_votlage_action}""").split('done ok ')[-1]
    ${splitted_string_with_voltage_value}                   Split string
    ...                                                     ${voltage_value_message}
    ...                                                     \n

    ${voltage_value}                                        Evaluate
    ...                                                     float(${splitted_string_with_voltage_value}[0])

    [Return]   ${voltage_value}

Measure Average Power Consumption for RMOD
    [Arguments]    ${rmod_id}
    ...            ${measurement_delay}
    ...            ${measurement_time}
    ...            ${measurement_interval}
    ...            ${connection}
    ${rmod_runtime_id}                                      admin_info_model.get_runtime_id_for_rmod
    ...                                                     rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ${rmod_runtime_distname}                                admin_info_model.get_runtime_distname_for_rmod
    ...                                                     runtime_rmod_id=${rmod_runtime_id}
    ...                                                     connection=${connection}
    ${overall_time}                                         Add Time To Time
    ...                                                     ${measurement_delay}
    ...                                                     ${measurement_time}
    ...                                                     result_format=verbose

    Robot Log Operation                                     Performing average power consumption measurement for RMOD-${rmod_id}. I will take ${overall_time}...
    Sleep                                                   ${measurement_delay}
    ...                                                     reason=Measurement delay: ${measurement_delay}

    ${power_measurements}                                   Create list
    Repeat Keyword                                          ${measurement_time}
    ...                                                     Run keywords
    ...                                                     Priv Get Power Consumption for RMOD and Append to List
    ...                                                     rmod_runtime_distname=${rmod_runtime_distname}
    ...                                                     connection=${connection}
    ...                                                     result_list=${power_measurements}
    ...                                                     AND
    ...                                                     Sleep
    ...                                                     ${measurement_interval}
    ...                                                     reason=Waiting for next power measurement...
    Priv Get Power Consumption for RMOD and Append to List
    ...                                                     rmod_runtime_distname=${rmod_runtime_distname}
    ...                                                     connection=${connection}
    ...                                                     result_list=${power_measurements}

    Robot Log Result                                        Power consumptiom measurements from RMOD-${rmod_id}: ${power_measurements}
    ...                                                     to_console=${True}

    ${avg_power_consumption}                                Calculate Average Value
    ...                                                     list_of_values=${power_measurements}

    [Return]    ${avg_power_consumption}

Calculate Average Value
    [Arguments]    ${list_of_values}
    ${count_of_values}                                      Get Length
    ...                                                     ${list_of_values}
    ${sum}                                                  Evaluate
    ...                                                     sum(map(float, ${list_of_values}))
    ${avg_value}                                            Evaluate
    ...                                                     ${sum}/${count_of_values}
    ${rounded_avg_value}                                    Convert To Number
    ...                                                     ${avg_value}
    ...                                                     2

    [Return]    ${rounded_avg_value}

Verify Energy Saving Results
    [Arguments]    ${value_with_enabled_feature}
    ...            ${value_with_disabled_feature}
    ...            ${unit_name}
    ...            ${unit_symbol}

    ${energy_profit_value}                                  Evaluate
    ...                                                     ${value_with_disabled_feature}-${value_with_enabled_feature}
    Should be true                                          ${energy_profit_value}>0
    ...  msg= ${unit_name} energy profit is not greater than 0! Accorging to SRAN_RU_SFS.1824 feature should allow save up to 10% of energy. Please check test preconditions first and consider to send pre-investigation before new pronto creation.
    ${energy_profit_value}                                  Convert To Number
    ...                                                     ${energy_profit_value}
    ...                                                     2

    ${energy_profit_percent}                                Evaluate
    ...                                                     ${energy_profit_value}/${value_with_disabled_feature}*100
    ${energy_profit_percent}                                Convert To Number
    ...                                                     ${energy_profit_percent}
    ...                                                     1
    Robot Log Result                                        to_console=${True}
    ...  msg=${unit_name} values validation success. ${unit_name} profit is: ${energy_profit_value}${unit_symbol} (${energy_profit_percent}%).

