*** Keywords ***
General_SiSo_Auto_NR_UL_Receiver_TM_Activation_With_BBPool_Parameters_Verification
    [Documentation]
    ...  Activates NR Uplink Test Model via selenium and captures PCAP file. PCAP file is downloaded from smod using ssh connection.
    ...
    ...  As opposite to other test models, this test case has built-in entering and exiting to TDS mode so these steps can be skiped in test
    ...  setup and teardown.
    ...
    ...  :param str test_model: (Mandatory) One NR UL test models supported for cell configuration, e.g.:
    ...                                     "G-FR1-A1-1" or "G-FR1-A1-2"
    ...  :param int cell_id: (Mandatory) : Global cell id of tested NR cell.
    ...  :param dict L2RtPoolDeployment_parameters: (Optional) Pcap parameters to check in captured tcpdump logs. Default None means default paratemers
    ...                               will be checked depending on cell technology. If user wants to check custom parameters, parameters list should be passed
    ...                               via L2RtPoolDeployment_parameters as dictionary. Example: {'connRrcPoolingAllowed': 'false', 'slowPrbPoolingFddFr1EnhAllowed': 'false'}
    ...                               In Robot Framework structure it's required to create dictionary before starting Test Case, then pass the dict
    ...                               as L2RtPoolDeployment_parameters parameter, e.g. :
    ...                               &{L2RtPoolDeployment_parameters}=          Create Dictionary
    ...                               ...                                        param1=false  param2=false  param3=false
    ...                               General_SiSo_Auto_NR_UL_Receiver_TM_Activation_With_BBPool_Parameters_Verification
    ...                               ...                                        L2RtPoolDeployment_parameters=&{L2RtPoolDeployment_parameters}
    ...  :param str pcap_filename: (Optional) : filename with extension of pcap file to collect, default "NODECPRT.pcap"
    ...  :param str pcap_remote_path: (Optional) : remote directory path to save pcap on smod, default "/tmp"
    ...  :param str pcap_local_path: (Optional) : local directory path to save pcap on vm, default location path is the same as test log collection path
    ...                                           (global variable ${logs_path})
    ...  :param bool pcap_verification: (Optional) : True if L2RtPoolDeployment parameters list should be verified based on pcap file, False if verification should be skipped.
    ...                                              Independently from argument value PCAP file is allways collected in TDS mode.
    ...                                              Defaults to True.
    ...  :param bool btslog_verification: (Optional) : True if L2RtPoolDeployment parameters list should be verified based on BTSLog file, False if verification should be skipped.
    ...                                                Defaults to True.
    ...  :param int beam_id: (Optional) : parameter beamPatternId, range <0 to 1200>, default 0.
    ...  :param float pmax: (Optional) : pmax parameter, required only for DL test model model startup in case TDD technology,
    ...                                  range <0 to 60 step=0.1>, None means default WebEM value will not be changed, default 30.
    ...  :param int rep_time_interval: (Optional) : reporting time interval (in seconds), range <0 to 4294967295>, default 2.
    ...  :param int measures: (Optional) : measures duration (in seconds) for sign analyser measurment, default 15.
    ...  :param int timeout: (Optional) : timeout (in seconds) for test model startup and termination, default 60.

    [Arguments]    ${test_model}
    ...            ${cell_id}
    ...            ${L2RtPoolDeployment_parameters}=${None}
    ...            ${pcap_filename}=NODECPRT.pcap
    ...            ${pcap_remote_path}=/tmp
    ...            ${pcap_local_path}=${logs_path}
    ...            ${pcap_verification}=${True}
    ...            ${btslog_verification}=${True}
    ...            ${beam_id}=0
    ...            ${pmax}=30
    ...            ${rep_time_interval}=2
    ...            ${measures}=15
    ...            ${timeout}=60
    [Timeout]      24 hours

    ${tcpdump_pid}      ${start_tm_timestamp}               Enter Test Dedicated State And Start Pcap Collection During BTS Startup
    ...                                                     pcap_remote_path=${pcap_remote_path}
    ...                                                     pcap_filename=${pcap_filename}

    ${bts_type}                                             hwpta_testline.get_type_of_setup
    ${connection}                                           connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}
    ${webui_obj}                                            Create Selenium Session
    ...                                                     admin_connection=${connection}
    ...                                                     download_dir=${logs_path}

    ${tested_rmod_id}                                       admin_info_model.get_rmod_ids_for_cell_id
    ...                                                     cell_id=${cell_id}
    ...                                                     cell_type=nr
    ...                                                     connection=${connection}

    ${cell_technology}                                      admin_info_model.get_cell_technology
    ...                                                     connection=${connection}
    ...                                                     cell_type=nr
    ...                                                     cell_id=${cell_id}
    ${local_cell}                                           scf.get_correct_local_cell_name
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}
    &{nrarfcn}                                              tm_setup_adm.get_nrafcn_variables_for_nr_cell_id
    ...                                                     cell_id=${cell_id}
    ...                                                     connection=${connection}

    Remove All Test Modules Result Files                    download_dir=${logs_path}
    Start Uplink Test                                       test_model=${test_model}
    ...                                                     local_cell=${local_cell}
    ...                                                     nr_cell=${cell_id}
    ...                                                     cell_technology=${cell_technology}
    ...                                                     beam_id=${beam_id}
    ...                                                     rep_time_interval=${rep_time_interval}
    ...                                                     pmax=${pmax}
    ...                                                     timeout=${timeout}
    ...                                                     &{nrarfcn}

    Robot Log Operation                                     Test model ${test_model} has started successfully
    sleep                                                   30s
    ...                                                     reason=Waiting 30s for test model performing...

    Wait For Uplink Test Results And Stop Test              rep_time_interval=${rep_time_interval}
    ...                                                     measures=${measures}
    ...                                                     cell_technology=${cell_technology}
    ...                                                     timeout=${timeout}
    webui.save_5g_uplink_test_results

    webui.refresh_page                                      wait_bar_menu_timeout=60
    Check Unavailability Of Uplink Test Module              nr_cell=${cell_id}
    ...                                                     test_model=${test_model}

    ${stop_tm_timestamp}          Get Current Date          result_format=%H:%M:%S.%f
    Stop and Download NODECPRT Pcap File                    local_path=${pcap_local_path}
    ...                                                     remote_path=${pcap_remote_path}
    ...                                                     tcpdump_filename=${pcap_filename}
    ...                                                     tcpdump_pid=${tcpdump_pid}
    ...                                                     bts_type=${bts_type}

    ${L2RtPoolDeployment_parameters}    Run keyword if      '${L2RtPoolDeployment_parameters}'=='${None}'
    ...                                                     tm_parameters.get_default_L2RtPoolDeployment_parameters
    ...                                                     cell_technology=${cell_technology}
    ...                                 ELSE                set variable
    ...                                                     ${L2RtPoolDeployment_parameters}

    Verify L2RtPoolDeployment parameters                    parameters_to_check=${L2RtPoolDeployment_parameters}
    ...                                                     verify_pcap_file=${pcap_verification}
    ...                                                     verify_btslog_file=${btslog_verification}
    ...                                                     path_to_pcap_file=${pcap_local_path}/${pcap_filename}
    ...                                                     start_timestamp=${start_tm_timestamp}
    ...                                                     stop_timestamp=${stop_tm_timestamp}

    [Teardown]                                              Run keywords
    ...                                                     Uplink Test Teardown
    ...                                                     cell_technology=${cell_technology}
    ...                                                     AND
    ...                                                     log_collection.stop_tcpdump_on_device_unit
    ...                                                     tcpdump_pid=${tcpdump_pid}
    ...                                                     AND
    ...                                                     Exit Test Dedicated State And Close Connections
