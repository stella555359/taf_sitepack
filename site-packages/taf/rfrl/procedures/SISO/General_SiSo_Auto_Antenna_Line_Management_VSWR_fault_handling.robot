*** Keywords ***
General_SiSo_Auto_Antenna_Line_Management_VSWR_fault_handling
    [Documentation]     Test case verifies if fault with ID 1838: VSWR minor alarm and fault with ID 1837: VSWR major alarm
    ...                 appear after triggering an inadmissible VSWR ratio on one of the antennas. This is made by setting
    ...                 targetTotatlLoad parameter to a maximal value and changing vswrMinorThreshold/vswrMajorThreshold
    ...                 parameters to a minimal value.
    ...                 Arguments:
    ...                 ${antennas_distnames} - list of configuration distnames of antenna lines to be tested
    ...                 ${min_value_minor} - minimal VSWR minor threshold value; defaults to 1.5
    ...                 ${min_value_major} - minimal VSWR major threshold value; defaults to 1.5
    ...                 ${default_value_major} - default VSWR major threshold value; defaults to 3.1
    ...                 ${default_value_minor} - default VSWR minor threshold value; defaults to 2.1
    ...                 ${max_target_total_load} - maximal targetTotalLoad value; defaults to 100
    ...                 ${default_target_total_load} - default targetTotalLoad value; defaults to 0
    ...                 ${start_timeout} - timeout for waiting for alarms to appear; defaults to 200 seconds
    ...                 ${cancel_timeout} -  timeout for waiting for alarms to disappear; defaults to 20 seconds
    [Arguments]         ${antennas_distnames}
    ...                 ${min_value_minor}=1.5
    ...                 ${min_value_major}=1.5
    ...                 ${default_value_major}=3.1
    ...                 ${default_value_minor}=2.1
    ...                 ${max_target_total_load}=100
    ...                 ${default_target_total_load}=0
    ...                 ${start_timeout}=220
    ...                 ${cancel_timeout}=20
    ${bts_type}=                                  hwpta_testline.get_type_of_setup
    ${connection}=                                connections.get_default_admin_connection_alias
    ...                                           bts_type=${bts_type}
    config_operations.connect                     alias=${connection}

    ${initial_parameter_values}=                  Get initial parameter values
    ...                                           antennas_distnames=${antennas_distnames}
    ...                                           connection=${connection}

    FOR    ${antenna_distname}    IN    @{antennas_distnames}
        Handle VSWR fault                         antenna_distname=${antenna_distname}
        ...                                       fault_id=1838
        ...                                       max_target_total_load=${max_target_total_load}
        ...                                       min_value=${min_value_minor}
        ...                                       default_value=${default_value_minor}
        ...                                       scope=Minor
        ...                                       connection=${connection}
        ...                                       start_timeout=${start_timeout}
        ...                                       cancel_timeout=${cancel_timeout}
        Handle VSWR fault                         antenna_distname=${antenna_distname}
        ...                                       fault_id=1837
        ...                                       max_target_total_load=${max_target_total_load}
        ...                                       min_value=${min_value_major}
        ...                                       default_value=${default_value_major}
        ...                                       scope=Major
        ...                                       connection=${connection}
        ...                                       start_timeout=${start_timeout}
        ...                                       cancel_timeout=${cancel_timeout}
    END
    [Teardown]                                    Set Initial Values And Disallow Alarms
    ...                                           initial_parameter_values=${initial_parameter_values}
    ...                                           default_target_total_load=${default_target_total_load}
    ...                                           connection=${connection}

Handle VSWR fault
    [Arguments]                                   ${antenna_distname}
    ...                                           ${fault_id}
    ...                                           ${max_target_total_load}
    ...                                           ${min_value}
    ...                                           ${default_value}
    ...                                           ${scope}
    ...                                           ${connection}
    ...                                           ${start_timeout}
    ...                                           ${cancel_timeout}
    Trigger VSWR Fault                            antenna_distname=${antenna_distname}
    ...                                           fault_id=${fault_id}
    ...                                           max_target_total_load=${max_target_total_load}
    ...                                           min_value=${min_value}
    ...                                           scope=${scope}
    ...                                           connection=${connection}
    ...                                           timeout=${start_timeout}

    Clear VSWR Fault                              antenna_distname=${antenna_distname}
    ...                                           fault_id=${fault_id}
    ...                                           default_value=${default_value}
    ...                                           scope=${scope}
    ...                                           connection=${connection}
    ...                                           timeout=${cancel_timeout}

Trigger VSWR Fault
    [Arguments]                                   ${antenna_distname}
    ...                                           ${fault_id}
    ...                                           ${max_target_total_load}
    ...                                           ${min_value}
    ...                                           ${scope}
    ...                                           ${connection}
    ...                                           ${timeout}
    Robot Log Operation                           Triggering VSWR fault with ID ${fault_id} on antenna ${antenna_distname}
    Alarms.Allow alarm                            fault_id=${fault_id}
    Set targetTotalLoad                           antenna_distname=${antenna_distname}
    ...                                           value=${max_target_total_load}
    ...                                           connection=${connection}
    Set VSWR Threshold                            antenna_distname=${antenna_distname}
    ...                                           value=${min_value}
    ...                                           scope=${scope}
    Robot Log Operation                           Waiting for fault ID ${fault_id} to appear
    ${is_alarm_active}=                           Alarms.Wait for active alarm
    ...                                           fault_id=${fault_id}
    ...                                           timeout=${timeout}
    Should be true                                ${is_alarm_active}
    ...                                           msg=VSWR fault with ID ${fault_id} did not appear during timeout!

Clear VSWR Fault
    [Arguments]                                   ${antenna_distname}
    ...                                           ${fault_id}
    ...                                           ${default_value}
    ...                                           ${scope}
    ...                                           ${connection}
    ...                                           ${timeout}
    Robot Log Operation                           Clearing VSWR fault with ID ${fault_id} on antenna ${antenna_distname}
    Set VSWR Threshold                            antenna_distname=${antenna_distname}
    ...                                           value=${default_value}
    ...                                           scope=${scope}
    Robot Log Operation                           Waiting for fault ID ${fault_id} to dissappear
    ${is_alarm_inactive}=                         Alarms.Wait for inactive alarm
    ...                                           fault_id=${fault_id}
    ...                                           timeout=${timeout}
    Should be true                                ${is_alarm_inactive}
    ...                                           msg=VSWR fault with ID ${fault_id} did not disappear during timeout!
    Alarms.Disallow alarm                         fault_id=${fault_id}

Set Initial Values and Disallow Alarms
    [Arguments]                                   ${initial_parameter_values}
    ...                                           ${default_target_total_load}
    ...                                           ${connection}
    Robot Log Operation                           Setting back the initial values of params and disallowing alarms
    FOR     ${antenna_distname}      IN     @{initial_parameter_values}
        Set targetTotalLoad                       antenna_distname=${antenna_distname}
        ...                                       value=${default_target_total_load}
        ...                                       connection=${connection}
        ${parameters}=                            Get From Dictionary
        ...                                       ${initial_parameter_values}
        ...                                       ${antenna_distname}
        Set Initial Values for Antenna            antenna_distname=${antenna_distname}
        ...                                       parameters=${parameters}
        ...                                       connection=${connection}
    END
    Alarms.Disallow alarm                         fault_id=1838
    Alarms.Disallow alarm                         fault_id=1837

Set Initial Values for Antenna
    [Arguments]                                   ${antenna_distname}
    ...                                           ${parameters}
    ...                                           ${connection}
    Set VSWR Threshold                            antenna_distname=${antenna_distname}
    ...                                           value=${parameters['minor']}
    ...                                           scope=Minor
    Set VSWR Threshold                            antenna_distname=${antenna_distname}
    ...                                           value=${parameters['major']}
    ...                                           scope=Major

Set VSWR Threshold
    [Arguments]                                   ${antenna_distname}
    ...                                           ${value}
    ...                                           ${scope}
    Robot Log Operation                           Changing vswr${scope}Threshold value to ${value}
    config_operations.set_float_parameter_value   dist_name=${antenna_distname}
    ...                                           param_name=vswr${scope}Threshold
    ...                                           param_value=${value}
    ...                                           skip_parameter_relation_errors=${True}

Set targetTotalLoad
    [Arguments]                                   ${antenna_distname}
    ...                                           ${value}
    ...                                           ${connection}
    Robot Log Operation                           Changing targetTotalLoad value to ${value}
    ${cell_distname}=                             admin_info_model.get_distname_of_cell_for_antennaline
    ...                                           antenna_distname=${antenna_distname}
    ...                                           connection=${connection}
    config_operations.set_parameter_value         dist_name=${cell_distname}
    ...                                           param_name=targetTotalLoad
    ...                                           param_value=${value}
    ...                                           skip_parameter_relation_errors=${True}

Get initial parameter values
    [Arguments]                                   ${antennas_distnames}
    ...                                           ${connection}
    ${default_parameter_values}=                  Create Dictionary
    FOR     ${antenna_distname}    IN    @{antennas_distnames}
        ${parameter_values_for_antenna}=          Get initial parameter values for antenna
        ...                                       antenna_distname=${antenna_distname}
        ...                                       connection=${connection}
        Set To Dictionary                         ${default_parameter_values}
        ...                                       ${antenna_distname}=${parameter_values_for_antenna}
    END
    [Return]                                      ${default_parameter_values}

Get initial parameter values for antenna
    [Arguments]                                   ${antenna_distname}
    ...                                           ${connection}
    ${minor}=                                     config_operations.get_float_parameter_value
    ...                                           dist_name=${antenna_distname}
    ...                                           param_name=vswrMinorThreshold
    ${major}=                                     config_operations.get_float_parameter_value
    ...                                           dist_name=${antenna_distname}
    ...                                           param_name=vswrMajorThreshold
    ${cell_distname}=                             admin_info_model.get_distname_of_cell_for_antennaline
    ...                                           antenna_distname=${antenna_distname}
    ...                                           connection=${connection}
    &{default_parameter_values}=                  Create Dictionary
    ...                                           minor=${minor}
    ...                                           major=${major}
    [Return]                                      ${default_parameter_values}
