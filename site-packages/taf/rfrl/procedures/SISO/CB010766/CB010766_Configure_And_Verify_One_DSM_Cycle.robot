*** Keywords ***
CB010766_Configure_And_Verify_One_DSM_Cycle
    [Documentation]
    ...       Based on QC test case:
    ...       CB010766-SR-A Configure and verify one DSM cycle
    ...       Test verifies if RMOD enters deep sleep mode at the start of Deep Sleep Time Window and wakes up near the end.
    ...       ARGS:
    ...       - config_rmods_id: list of configuration ID of RMODs which should be checked;
    ...                          defaults to ${None} (test will be perfomerd on all RMODS detected in current BTS configuration)
    ...       - deep_sleep_window_duration: duration of Deep Sleep Time Window in minutes
    ...                                     defaults to `35` (35 is minimum value)
    ...                                     e.g. '35', '120'.
    ...       - time_for_ru_restore: time (in minutes) in which RMOD should start wake up procedure before Deep Sleep Time Window ends
    ...                              defaults to `5` (5 is minimum value)
    ...                              e.g. '5', '20'.
    ...       When ${deep_sleep_window_duration} parameter is set to `35` that means that Deep Sleep Time Window
    ...       starts at 12:10. Setting ${time_for_ru_restore} parameter to `5` will cause RMOD to start waking up
    ...       at 12:40 (where end time of Deep Sleep Time Window is 12:45)

    [Arguments]
    ...                                                         ${config_rmods_id}=${None}
    ...                                                         ${deep_sleep_window_duration}=35
    ...                                                         ${time_for_ru_restore}=5

    ${bts_type}=                                                hwpta_testline.get_type_of_setup
    ${connection}=                                              connections.get_default_admin_connection_alias
    ...                                                         bts_type=${bts_type}
    Create Selenium Session                                     admin_connection=${connection}

    ${config_rmods_id}=                                         Run Keyword If  not ${config_rmods_id}
    ...                                                         admin_info_model.get_rmod_indexes
    ...                                                         connection=${connection}
    ...                                                         ELSE
    ...                                                         Set Variable   ${config_rmods_id}
    ${deep_sleep_time}=                                         Evaluate  ${deep_sleep_window_duration}-${time_for_ru_restore}
    Enable Coordinated 4G-5G power saving

    FOR      ${config_rmod_id}  IN  @{config_rmods_id}
         Validate Rmod Dedicated Time Windows for Deep Sleep    config_rmod_id=${config_rmod_id}
         ...                                                    deep_sleep_time=${deep_sleep_time}
         ...                                                    deep_sleep_window_duration=${deep_sleep_window_duration}
         ...                                                    time_for_ru_restore=${time_for_ru_restore}
         ...                                                    connection=${connection}
    END

    [Teardown]                                                  Run Keywords
    ...                                                         Disable Coordinated 4G-5G Power Saving
    ...                                                         AND
    ...                                                         Wait Until Keyword Succeeds    5min  10s
    ...                                                         Check BTS state and all RATs states
    ...                                                         AND
    ...                                                         config_operations.disconnect


Validate Rmod Dedicated Time Windows for Deep Sleep
    [Arguments]                                                 ${config_rmod_id}
    ...                                                         ${deep_sleep_time}
    ...                                                         ${deep_sleep_window_duration}
    ...                                                         ${time_for_ru_restore}
    ...                                                         ${connection}

    ${rmod_config_distname}=                                    admin_info_model.get_config_distname_for_rmod
    ...                                                         config_rmod_id=${config_rmod_id}
    ...                                                         connection=${connection}

    Enable EnergySaving                                         rmod_config_distname=${rmod_config_distname}
    Check EnergySaving Parameter                                rmod_config_distname=${rmod_config_distname}
    ...                                                         expected_energy_saving=DEEPSLEEP
    ...                                                         expected_power_state=AWAKE

    ${start_datetime}  ${start_time}  ${wake_datetime}          Get Deep Sleep Time Schedule and RMOD Wake Up Time
    ...                                                         deep_sleep_time=${deep_sleep_time}
    Enable Deep Sleep Time Schedule                             rmod_config_distname=${rmod_config_distname}
    ...                                                         start_time=${start_time}
    ...                                                         window_duration=${deep_sleep_window_duration}
    ...                                                         time_for_ru_restore=${time_for_ru_restore}
    Wait Until Keyword Succeeds                                 ${deep_sleep_window_duration}min  30s
    ...                                                         Time Is Reached
    ...                                                         datetime=${start_datetime}
    timer.wait_until_keyword_succeeds_timer                     7min
    ...                                                         5s
    ...                                                         Check EnergySaving Parameter
    ...                                                         rmod_config_distname=${rmod_config_distname}
    ...                                                         expected_energy_saving=DEEPSLEEP
    ...                                                         expected_power_state=SLEEP

    Wait For The End Of Deep Sleep Window                       rmod_config_distname=${rmod_config_distname}
    ...                                                         start_datetime=${start_datetime}
    ...                                                         wake_datetime=${wake_datetime}
    ...                                                         deep_sleep_time=${deep_sleep_time}

    [Teardown]                                                  Run Keywords
    ...                                                         Disable Deep Sleep Time Schedule
    ...                                                         rmod_config_distname=${rmod_config_distname}
    ...                                                         AND
    ...                                                         Disable EnergySaving
    ...                                                         rmod_config_distname=${rmod_config_distname}
