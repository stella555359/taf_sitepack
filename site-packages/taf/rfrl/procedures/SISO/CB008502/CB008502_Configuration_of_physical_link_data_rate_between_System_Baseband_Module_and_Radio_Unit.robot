*** Keywords ***
CB008502_Configuration_of_physical_link_data_rate_between_System_Baseband_Module_and_Radio_Unit
    [Documentation]
    ...       The purpose of this test is to verify if the BTS is able to detect the mismatch of the link speed that
    ...       indicated unsupported SFP data rate configuration. The test is performed by changing the link speeds of
    ...       the RMOD port to a value that is defined in the `${ports_config}` list. The link speed is changed to the
    ...       custom value and checked depending on the `is_supported` flag if the fault 4679 is visible or not.
    ...       Next the link speed of the RMOD port is changed to the default value and checked if the fault 4679 is cleared.
    ...       The test is performed for each port defined in the `${ports_config}` list.
    ...       ARGS:
    ...       - rmod_id: CONFIG_ID of the RMOD to be checked;
    ...       - ports_config: list of dictionaries of ports configuration for the RMOD with the following keys:
    ...                       * port: name of the port to be checked;
    ...                       * link_speed: link speed to be set;
    ...                       * is_supported: flag indicating if the link speed is supported by the SFP;
    ...                       e.g. [{'port': 'OPT_IF1', 'link_speed': 'eCpri25', 'is_supported': True}
    ...                             {'port': 'OPT_IF2', 'link_speed': 'eCpri10', 'is_supported': False}]

    [Arguments]                                                 ${rmod_id}
    ...                                                         ${ports_config}

    ${bts_type}=                                                hwpta_testline.get_type_of_setup
    ${connection}=                                              connections.get_default_admin_connection_alias
    ...                                                         bts_type=${bts_type}
    ${mrbts_id}=                                                hw_info.get_mrbts_id
    Get Default Cablinks Values                                 rmod_id=${rmod_id}
    ...                                                         ports_config=${ports_config}
    ...                                                         connection=${connection}

    Set Test Variable                                           ${return_to_initial_scf}
    ...                                                         ${True}

    FOR  ${port_config}  IN  @{ports_config}
        Change Link Speed To Custom Value                       link_speed=${port_config["link_speed"]}
        ...                                                     cablink_distname=${port_config["cablink_distname"]}
        ...                                                     is_supported=${port_config["is_supported"]}
        ...                                                     connection=${connection}
        Robot Log Result                                        Value of link speed changed successfully!
        ...                                                     to_console=${True}
        Run Keyword If                                          ${port_config["is_supported"]}
        ...                                                     Verify If Fault 4679 Is Not Visible
        ...                                                     bts_type=${bts_type}
        ...                                                     ELSE
        ...                                                     Verify If Fault 4679 Is Visible
        ...                                                     bts_type=${bts_type}

        Change Link Speed To Default Value                      link_speed=${port_config["default_link_speed"]}
        ...                                                     cablink_distname=${port_config["cablink_distname"]}
        ...                                                     is_supported=${port_config["is_supported"]}
        Verify If Fault 4679 Is Not Visible                     bts_type=${bts_type}
    END


Get Default Cablinks Values
    [Arguments]                                                 ${rmod_id}
    ...                                                         ${ports_config}
    ...                                                         ${connection}

    FOR  ${index}  ${port_config}  IN ENUMERATE  @{ports_config}
        ${cablink_for_rmod_port}=                               admin_info_model.get_cablink_distnames_for_rmod_port
        ...                                                     rmod_id=${rmod_id}
        ...                                                     rmod_port=${port_config["port"]}
        ...                                                     connection=${connection}
        ${link_params}=                                         admin.get_parameters
        ...                                                     dist_name=${cablink_for_rmod_port["internal"]}
        ...                                                     connection=${connection}
        Set To Dictionary                                       ${ports_config[${index}]}
        ...                                                     default_link_speed=${link_params["linkSpeed"]}
        ...                                                     cablink_distname=${cablink_for_rmod_port["configuration"]}
    END


Change Link Speed To Custom Value
    [Arguments]                                                 ${link_speed}
    ...                                                         ${cablink_distname}
    ...                                                         ${is_supported}
    ...                                                         ${connection}

    Robot Log Operation                                         Changing link speed for cablink ${cablink_distname} to ${link_speed}...

    Alarms.Allow X2 Link Alarms
    Alarms.Allow alarm                                          fault_id=10
    Alarms.Allow alarm                                          fault_id=4679
    delta.set_parameter_via_delta_recommissioning               dist_name=${cablink_distname}
    ...                                                         parameter=linkSpeed
    ...                                                         value=${link_speed}
    ...                                                         skip_parameter_relation_errors=${True}
    ...                                                         timeout=400

    [Teardown]                                                  Run Keyword If  not ${is_supported}
    ...                                                         timer.wait_until_keyword_succeeds_timer
    ...                                                         10min
    ...                                                         10s
    ...                                                         status_check.verify_statuses_of_all_bbmods
    ...                                                         connection=${connection}
    ...                                                         status_variant=online
    ...                                                         ELSE
    ...                                                         Wait Until Keyword Succeeds
    ...                                                         10min
    ...                                                         10s
    ...                                                         Check all BBMODs RMODs and cells states for all RATs


Change Link Speed To Default Value
    [Arguments]                                                 ${link_speed}
    ...                                                         ${cablink_distname}
    ...                                                         ${is_supported}

    Robot Log Operation                                         Changing link speed for cablink ${cablink_distname} to default value of ${link_speed}...

    Run Keyword If                                              not ${is_supported}
    ...                                                         Sleep
    ...                                                         10min
    ...                                                         reason=Waiting for the BTS to finish C-Plane configuration and allow recommissioning
    timer.wait_until_keyword_succeeds_timer                     15min
    ...                                                         10s
    ...                                                         delta.set_parameter_via_delta_recommissioning
    ...                                                         dist_name=${cablink_distname}
    ...                                                         parameter=linkSpeed
    ...                                                         value=${link_speed}
    ...                                                         timeout=400
    Wait Until Keyword Succeeds                                 10min
    ...                                                         10s
    ...                                                         Check all BBMODs RMODs and cells states for all RATs
    Alarms.Disallow X2 Link Alarms
    Alarms.Disallow alarm                                       fault_id=10
    Alarms.Disallow alarm                                       fault_id=4679

    Robot Log Result                                            Change of link speed to default value finished successfully!
    ...                                                         to_console=${True}


Verify If Fault 4679 Is Visible
    [Arguments]                                                 ${bts_type}

    Robot Log Operation                                         Waiting for alarms with fault ID 4679 to be raised...
    Wait for number of active alarms                            expected_number_of_alarms=1
    ...                                                         timeout=120s
    ...                                                         fault_id=4679
    ...                                                         fault_name=Nokia MN BTS transceiver configuration mismatch
    ...                                                         bts_type=${bts_type}
    Robot Log Result                                            Alarm with fault ID 4679 raised successfully.


Verify If Fault 4679 Is Not Visible
    [Arguments]                                                 ${bts_type}

    Robot Log Operation                                         Checking if alarm with fault ID 4679 is not present...
    Check if alarm is inactive                                  fault_id=4679
    ...                                                         fault_name=Nokia MN BTS transceiver configuration mismatch
    ...                                                         bts_type=${bts_type}
    Robot Log Result                                            Alarm with fault ID 4679 is not present.
