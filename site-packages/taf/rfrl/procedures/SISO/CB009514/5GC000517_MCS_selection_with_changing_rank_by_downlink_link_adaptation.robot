*** Keywords ***
5GC000517_MCS_selection_with_changing_rank_by_downlink_link_adaptation
    [Documentation]
    ...  This user scenario validates the basic feature set of the DL link adaptation. Depending on the radio link condition and
    ...  the block error rate the best suitable MCS is selected by the DL link adaptation so that the throughput is optimized
    ...  and the BLER is close to the configured BLER target.
    ...
    ...  ARGS:
    ...  :param int cell_id: (Mandatory) : configuration id of NR cell to perform throughput transission and counters check, e.g.: 1
    ...  :param dict attenuator_info: (Mandatory) : attenuator info defined as attenuator object in init file, e.g.: ${tl.attenuators[0]}
    ...  :param dict attenuator_config: (Mandatory) : attenuator configuration with all defined ports and mandatory 'DL' mode for each one, e.g.:
    ...                                 config_CB009514_NRCELL_0 = {
    ...                                               "ports": [{"antenna": "ANTL-1", "port": 1, "OFF": 63, "DL": 0, "UL": 0},
    ...                                                         {"antenna": "ANTL-2", "port": 2, "OFF": 63, "DL": 0, "UL": 0},
    ...                                                         {"antenna": "ANTL-3", "port": 3, "OFF": 63, "DL": 0, "UL": 0},
    ...                                                         {"antenna": "ANTL-4", "port": 4, "OFF": 63, "DL": 0, "UL": 0}]}
    ...  :param str max_att_lvl: (Mandatory) : value of maximum attenuation (in dB) of each antenna port for tested cell, e.g.: 40
    ...                                        Attenuation of antenna ports will increase during the test. Maximum attenuation level
    ...                                        should be as high as possible but cannot cause transmission termination and UE detach.
    ...  :param dict throughput: (Mandatory) : dict with throughput and deviation values for each cell identified by
    ...                                        it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells;
    ...                                        defaults to None (L3 call will not be executed).
    ...                                        Example:
    ...                                           {
    ...                                             '827736065':
    ...                                                   {
    ...                                                      'throughput':
    ...                                                          {
    ...                                                              'downlink': '100 Mbits/sec',
    ...                                                              'uplink': '15 Mbits/sec'
    ...                                                          },
    ...                                                      'deviation': '90%'
    ...                                                  },
    ...                                         }
    ...  :param str protocol: (Optional) : data transfer protocol; defaults to UDP.
    ...  :param str udp_buffer: (Optional) : monitoring data buffer; defaults to 4M.
    ...  :param dict ue_network_modes: (Optional) : dictionary with pairs of UE Serial Number - desired network mode e.g. {"SN1234": "NR_only", "SN321": "NR_only}
    ...                                             possible network modes: NR_only, LTE_only, NR_LTE (NR_LTE mode CAN NOT be used with any of the other
    ...                                             two in case of more than one UE); defaults to ${None} (current modes set on UEs will be used)
    ...  :param str measurement_interval: (Optional) : measurement interval defined in minutes, related to single measurement frame duration
    ...                                                set in SCF configuration. One of following values possible to set:
    ...                                                5min, 15min, 30min, or 60min, defaults to 5min.

    [Arguments]    ${cell_id}
    ...            ${attenuator_info}
    ...            ${attenuator_config}
    ...            ${max_att_value}
    ...            ${throughput}
    ...            ${protocol}=udp
    ...            ${udp_buffer}=4M
    ...            ${ue_network_modes}=${None}
    ...            ${measurement_interval}=5min

    [Timeout]      24 hours

    ${non_zero_expectation_counters}                        Create list
    ...                                                     M55301C10001  M55301C10002  M55301C10003  M55301C10004
    ${zero_expectation_counters}                            Create list
    ...                                                     M55124C00001
    &{required_scf_config_params}=                          Create Dictionary
    ...                                                     miNrDlSignalQuality=${measurement_interval}
    ...                                                     miNrRRCC=${measurement_interval}

    ${bts_type}                                             hwpta_testline.get_type_of_setup
    ${connection}                                           connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}

    Verify SCF Parameters Responsible For Counters Collection
    ...                                                     connection=${connection}
    ...                                                     expected_parameters_values_dict=${required_scf_config_params}
    ...                                                     parameters_distname=MRBTS-{}/NRBTS-{}/NRPMRNL-1

    ${cell_dist_names}                                      admin_info_model.get_dist_names_for_specific_cell
    ...                                                     connection=${connection}
    ...                                                     cell_type=nr
    ...                                                     cell_id=${cell_id}

    ${measurement_interval_in_minutes}                      measurements_timer.convert_time_parameter_from_minutes_format_to_int
    ...                                                     time_parameter=${measurement_interval}
    ${measurement_interval_in_seconds}                      Evaluate
    ...                                                     ${measurement_interval_in_minutes}*60
    ${count_of_att_steps}=                                  Evaluate
    ...                                                     ${measurement_interval_in_seconds}/20
    ${count_of_att_steps}                                   Convert To Number
    ...                                                     ${count_of_att_steps}
    ...                                                     0

    ${call_duration}=                                       Evaluate
    ...                                                     ${measurement_interval_in_seconds}*2+30

    Robot Log Operation                                     Attenuator setup preparing...
    rf_att.att_setup                                        att_info=${attenuator_info}
    ...                                                     att_config=${attenuator_config}
    ${initial_att_ports_config}                             rf_att.get_att_ports_configuration

    Robot Log Operation                                     Setting all attenuator ports to 'DL' mode...
    rf_att.set_all_attenuator_ports_to_chosen_mode          mode=DL

    Robot Log Operation                                     Starting L3 call with downlink transmission...
    Alarms.Allow Alarms Before L3 Call
    Start L3 Call In Background                             called_cell=${cell_dist_names['configuration']}
    ...                                                     direction=DL
    ...                                                     duration=${call_duration}s
    ...                                                     throughputs=${throughput}
    ...                                                     protocol=${protocol}
    ...                                                     udp_buffer=${udp_buffer}
    ...                                                     ue_network_modes=${ue_network_modes}
    ...                                                     prepare_cells_to_call=${True}

    Robot Log Operation                                     Waiting for new counters frame...
    ${counters_verification_startpoint}=                    Wait For New Counters Data Frame Generation
    ...                                                     data_frame_interval=${measurement_interval}

    ${counters_verification_endpoint}=                      measurements_timer.get_datetime_of_the_end_of_measurements
    ...                                                     measurements_start=${counters_verification_startpoint}
    ...                                                     measurement_interval=${measurement_interval}

    ${counter_ids}=                                         Evaluate
    ...                                                     ${non_zero_expectation_counters}+${zero_expectation_counters}

    ${counters_verification_startpoint}=                    Convert Date
    ...                                                     ${counters_verification_startpoint}
    ...                                                     result_format=timestamp
    ${counters_verification_endpoint}=                      Convert Date
    ...                                                     ${counters_verification_endpoint}
    ...                                                     result_format=timestamp

    Robot Log Operation                                     Increasing attenuation on all RF ports for tested cell...
    rf_att.increase_gradually_attenuation_for_all_rf_ports  att_value=${max_att_value}
    ...                                                     count_of_steps=${count_of_att_steps}
    ...                                                     timeout=${measurement_interval_in_seconds}

    Sleep                                                   60s
    ...                                                     reason=Waiting 60 seconds to prepare BTS counters...

    Robot Log Operation                                     Collecting following counters: ${counter_ids}
    ${counters_results}=                                    Save Counters Values
    ...                                                     counters_verification_startpoint=${counters_verification_startpoint}
    ...                                                     counters_verification_endpoint=${counters_verification_endpoint}
    ...                                                     counter_ids=${counter_ids}
    ...                                                     component_name=NRCELL-${cell_id}
    Robot Log Result                                        Collected counters results: ${counters_results}

    Robot Log Operation                                     Verifying downlink counters results...
    Verify MCS Counters                                     counters_results=${counters_results}
    ...                                                     non_zero_expectation_counters=${non_zero_expectation_counters}
    ...                                                     zero_expectation_counters=${zero_expectation_counters}
    Robot Log Result                                        Downlink counters results have been verified successfully.
    ...                                                     to_console=${True}

    [Teardown]    Run keywords                              Run Keyword And Ignore Error
    ...                                                     Stop Background L3 Call
    ...                                                     called_cell=${cell_dist_names['configuration']}
    ...                                                     AND
    ...                                                     Run Keyword And Continue On Failure
    ...                                                     rf_att.set_attenuation_on_ports
    ...                                                     att_ports_configuration=${initial_att_ports_config}
    ...                                                     AND
    ...                                                     Alarms.Disallow Alarms After L3 CalL
