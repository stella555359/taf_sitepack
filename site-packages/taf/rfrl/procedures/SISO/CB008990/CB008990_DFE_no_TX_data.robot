*** Keywords ***
CB008990_DFE_no_TX_data
    [Documentation]
    ...  Purpose of this test case is to check if system correctly raises alarm in WebEM accordingly to raised internal alarms
    ...  resulted from no tx data in RUs DFE.
    ...  The test is intended for the following RMODs: AAFIA*, AKQJ, AHLOA, AREA
    ...  *In case of AAFIA module (AAFB or AAIB) all frmon commands will be preformed from nahka node. Ip address of Nahka node is set
    ...  automatically according to AAFIA antennas mapping.
    ...
    ...  ARGS:
    ...  :param int rmod_id: (Mandatory) : RMOD runtime id of tested radio module, e.g.: 1
    ...  :param str dfe_name: (Mandatory) : dfe name containing dfe number, e.g.: "dfe1".
    ...                                     *It will be used as alias for frmon action activation so theoretically it could be any name.
    ...  :param str carrier_name: (Mandatory) : name of carrier from radio SOAP startup logs (search by: txArrayCarrier in PCAP startup file),
    ...                                         e.g.: "NR50183.TX_1_700_345501". The name can be found also in SYSLOG file
    ...                                         during RMOD startup (search by: txArrayCarrier).
    ...  :param str ant_path_name: (Mandatory) : antenna path name, e.g.: "antenna1a" or "antenna2b"
    ...  :param dict throughputs: (Mandatory) : dict with throughput and deviation values for each cell identified by
    ...                                         it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells;
    ...                                         defaults to None (L3 call will not be executed).
    ...                                         Example:
    ...                                            {
    ...                                              '827736065':
    ...                                                    {
    ...                                                       'throughput':
    ...                                                           {
    ...                                                               'downlink': '100 Mbits/sec',
    ...                                                               'uplink': '15 Mbits/sec'
    ...                                                           },
    ...                                                       'deviation': '90%'
    ...                                                   },
    ...                                          }
    ...  :param list called_cells_distnames: (Optional) : CONFIGURATION distnames of cells that will be called, if not given,
    ...                                                   list of all cells on testline will be determined and called
    ...  :param str protocol: (Optional) : data transfer protocol; defaults to UDP.
    ...  :param str udp_buffer: (Optional) : monitoring data buffer; defaults to 4M.
    ...  :param int tput_duration (Optional) : duration of data transfer in seconds; defaults to 30
    ...  :param bool tput_verification_via_btslog: (Optional) : True - throughput verification will be performed using btslog
    ...                                                         False - throuput verification will be performed using iperf; defaults to False
    ...  :param dict ue_network_modes: (Optional) : dict with UE serial numbers and desired network modes e.g. {"SN1234": "NR_only"}
    ...                                             possible UE network modes: NR_only, LTE_only, NR_LTE
    ...                                             when using more than one UE please make sure that the modes you choose are either all
    ...                                             with "_only" suffix or all "NR_LTE" as it is not yet possible to mix those.
    ...                                             mandatory for SA+NSA setups, defaults to None8", "ssb_32",
    ...                                             default None means default WebEM value will not be changed.
    ...  :param int recovery_fault_id: (Optional) : expected fault id of 'Radio autonomous reset as recovery action' alarm,
    ...                                             defaults to None (Default fault ID [1981 or 1907(AKQJ)] will be used).
    ...  :param int timeout: (Optional) : timeout (in seconds) for 'Radio autonomous reset as recovery action' alarm activation, defaults to 60.

    [Arguments]    ${rmod_id}
    ...            ${dfe_name}
    ...            ${carrier_name}
    ...            ${ant_path_name}
    ...            ${throughputs}
    ...            ${called_cells_distnames}=${None}
    ...            ${protocol}=udp
    ...            ${udp_buffer}=4M
    ...            ${tput_duration}=30
    ...            ${tput_verification_via_btslog}=${False}
    ...            ${ue_network_modes}=${None}
    ...            ${recovery_fault_id}=${None}
    ...            ${timeout}=60

    [Timeout]      24 hours

    ${bts_type}                                             hwpta_testline.get_type_of_setup
    ${connection}                                           connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}

    IF                                                      """${recovery_fault_id}"""=="""${None}"""
        ${recovery_fault_id}=                               Priv Get Default Recovery Fault ID
        ...                                                 rmod_id=${rmod_id}
        ...                                                 connection=${connection}
    END

    Execute L3 call
    ...                                                     throughputs=${throughputs}
    ...                                                     cells_distnames=${called_cells_distnames}
    ...                                                     protocol=${protocol}
    ...                                                     udp_buffer=${udp_buffer}
    ...                                                     duration=${tput_duration}s
    ...                                                     tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                                     ue_network_modes=${ue_network_modes}

    ${nahka_node}                                           Get Nahka Address if AAFIA
    ...                                                     rmod_id=${rmod_id}
    ...                                                     ant_path_name=${ant_path_name}
    ...                                                     connection=${connection}

    Create Action CarrierFaultInjection
    ...                                                     rmod_id=${rmod_id}
    ...                                                     dfe_name=${dfe_name}
    ...                                                     connection=${connection}
    ...                                                     nahka_node=${nahka_node}

    Perform Action TX Data Transmision Break
    ...                                                     rmod_id=${rmod_id}
    ...                                                     dfe_name=${dfe_name}
    ...                                                     carrier_name=${carrier_name}
    ...                                                     ant_path_name=${ant_path_name}
    ...                                                     connection=${connection}
    ...                                                     nahka_node=${nahka_node}

    Wait for recovery alarm with RMOD recovery reset and startup
    ...                                                     recovery_fault_id=${recovery_fault_id}
    ...                                                     rmod_id=${rmod_id}
    ...                                                     timeout_for_recovery_alarm=${timeout}
    ...                                                     connection=${connection}
    ...                                                     bts_type=${bts_type}

    Execute L3 call
    ...                                                     throughputs=${throughputs}
    ...                                                     cells_distnames=${called_cells_distnames}
    ...                                                     protocol=${protocol}
    ...                                                     udp_buffer=${udp_buffer}
    ...                                                     duration=${tput_duration}s
    ...                                                     tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                                     ue_network_modes=${ue_network_modes}


Create Action CarrierFaultInjection
    [Arguments]    ${rmod_id}
    ...            ${dfe_name}
    ...            ${nahka_node}
    ...            ${connection}

    Robot Log Step                                          Creating of action CarrierFaultInjection via FRMON on RMOD-${rmod_id}.
    ${activation_result}                                    rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/ action create CarrierFaultInjection /${dfe_name}
    ...                                                     connection=${connection}
    ...                                                     nahka_node=${nahka_node}
    Should Contain Any                                      ${activation_result}
    ...                                                     done ok    Path already taken
    ...                                                     msg=Activation is not completed.
    Robot Log Result                                        Activation is completed.


Perform Action TX Data Transmision Break
    [Arguments]    ${rmod_id}
    ...            ${dfe_name}
    ...            ${carrier_name}
    ...            ${ant_path_name}
    ...            ${nahka_node}
    ...            ${connection}

    Robot Log Step                                          Activation of TX Data Transmision Break via FRMON on RMOD-${rmod_id}.
    ${action_result}                                        rmod_ops.execute_frmon_command
    ...                                                     rmod_id=${rmod_id}
    ...                                                     command=/${dfe_name} action break_tx_data_transmission "${carrier_name}" "${ant_path_name}"
    ...                                                     connection=${connection}
    ...                                                     nahka_node=${nahka_node}
    Should Contain                                          ${action_result}
    ...                                                     done ok
    ...                                                     msg=Action performing is not completed.
    Robot Log Result                                        Action performing is completed.


Get Nahka Address if AAFIA
    [Arguments]    ${rmod_id}
    ...            ${ant_path_name}
    ...            ${connection}

    ${rmod_name}                                            admin_info_model.get_product_name_for_rmod
    ...                                                     rmod_id=${rmod_id}
    ...                                                     connection=${connection}

    Run Keyword And Return If                               "${rmod_name}"=="AAFB" or "${rmod_name}"=="AAIB"
    ...                                                     Priv Find Nahka IP for Particular Antenna Path Name
    ...                                                     ant_path_name=${ant_path_name}

    [Return]    ${None}


Priv Get Nahka Antennas Mapping
    ${antenna_paths_nahka1}                                 Create list
    ...                                                     antenna1a  antenna2a  antenna5a  antenna7a
    ${antenna_paths_nahka2}                                 Create list
    ...                                                     antenna9a  antenna11a  antenna13a  antenna15a
    ${antenna_paths_nahka3}                                 Create list
    ...                                                     antenna16a  antenna14a  antenna12a  antenna10a
    ${antenna_paths_nahka4}                                 Create list
    ...                                                     antenna8a  antenna6a  antenna4a  antenna2a

    ${nahka_mapping}                                        Create dictionary
    ...                                                     192.168.101.2=${antenna_paths_nahka1}
    ...                                                     192.168.101.3=${antenna_paths_nahka2}
    ...                                                     192.168.101.4=${antenna_paths_nahka3}
    ...                                                     192.168.101.5=${antenna_paths_nahka4}

    [Return]    ${nahka_mapping}


Priv Find Nahka IP for Particular Antenna Path Name
    [Arguments]    ${ant_path_name}
    ${nahka_mapping}                                        Priv Get Nahka Antennas Mapping
    ${keys}                                                 Get Dictionary Keys
    ...                                                     ${nahka_mapping}
    FOR    ${nahka_ip}  IN    @{keys}
        Return from keyword if    "${ant_path_name}" in ${nahka_mapping}[${nahka_ip}]
        ...                                                 ${nahka_ip}
    END

    Fail    AAFIA antennas mapping ${nahka_mapping} does not contain provided antenna name: "${ant_path_name}".


Priv Get Default Recovery Fault ID
    [Arguments]    ${rmod_id}
    ...            ${connection}

    ${rmod_name}=                                           admin_info_model.get_product_name_for_rmod
    ...                                                     rmod_id=${rmod_id}
    ...                                                     connection=${connection}

    ${recovery_fault_id}=                                   Set Variable If  "${rmod_name}"=="AKQJ"
    ...                                                     1907
    ...                                                     1981

    [Return]                                                ${recovery_fault_id}
