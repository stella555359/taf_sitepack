    ...                                                     connection=${connection}
    Robot Log Operation                                     Performing power reset on RMOD-${rmod_id}...
    power.reset_device                                      serial_number=${rmod_sn}

Priv RMOD Reset
    [Arguments]    ${rmod_id}
    ...            ${bts_type}
    ...            ${connection}
    ${runtime_id}                                           admin_info_model.translate_rmod_index_to_runtime
    ...                                                     rmod_index=${rmod_id}
    ...                                                     connection=${connection}
    ${credentials}=                                         connections.get_http_connection_credentials
    ...                                                     bts_type=${bts_type}
    ${bts_host}=                                            Set Variable   ${credentials['ip']}
    Robot Log Operation                                     Performing reset of RMOD-${rmod_id}...
    admin_info_model.reset_rmod                             connection=${connection}
    ...                                                     runtime_rmod_id=${runtime_id}

Backup Original BlackBox Logger File
    [Arguments]    ${rmod_id}
    ...            ${connection}
    ...            ${path_blackbox}
    ...            ${path_backup_blackbox}
    Robot Log Step                                          Backing up original blackbox logger file from RMOD-${rmod_id}...
    rmod_ops.execute_ssh_command                            rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ...                                                     command=sudo scp ${path_blackbox} ${path_backup_blackbox}

Modify timeBetweenSaveOnNVM Value In BlackBox Logger File
    [Arguments]    ${rmod_id}
    ...            ${timeBetweenSaveOnNVM_value}
    ...            ${connection}
    ...            ${path_blackbox}
    Robot Log Step                                          Setting new timeBetweenSaveOnNVM value in blackbox logger file on RMOD-${rmod_id}...
    rmod_ops.execute_ssh_command                            rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ...                                                     command=sudo sed -i 's/"timeBetweenSaveOnNVM":.*/"timeBetweenSaveOnNVM": ${timeBetweenSaveOnNVM_value},/g' ${path_blackbox}

Restore Original BlackBox Logger File
    [Arguments]    ${rmod_id}
    ...            ${connection}
    ...            ${path_blackbox}
    ...            ${path_backup_blackbox}
    Robot Log Step                                          Restoring original blackbox logger file on RMOD-${rmod_id}...
    rmod_ops.execute_ssh_command                            rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ...                                                     command=mv ${path_backup_blackbox} ${path_blackbox}