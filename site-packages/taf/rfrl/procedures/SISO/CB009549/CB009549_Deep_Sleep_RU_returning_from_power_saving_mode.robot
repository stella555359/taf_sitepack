*** Keywords ***
CB009549_Deep_Sleep_RU_returning_from_power_saving_mode
    [Documentation]     Test verifies EnergySaving parameter after adding an additional cell on RMOD
    ...            ARGS:
    ...              - config_rmods_id: list of configuration ID of RMODs which should be checked;
    ...                                 defaults to ${None} (test will be perfomerd on all RMODS detected in current BTS configuration)
    ...              - deltas:   List of full paths to json delta files that added new cells to existing configuration
    ...                         (please refer to generate_json_delta method in JsonDeltaCommissioning.py).
    ...                         Separate delta should be generated for each SW stream with objects under "added" key.
    ...              - path_to_scf: path to base SCF file
    [Arguments]      ${deltas}
    ...              ${path_to_scf}
    ...              ${config_rmods_id}=${None}

    ${bts_type}=                                                hwpta_testline.get_type_of_setup
    ${connection}=                                              connections.get_default_admin_connection_alias
    ...                                                         bts_type=${bts_type}
    ${sw_stream}=                                               sw_stream.get_sw_stream
    ...                                                         device=${bts_type}
    ${config_rmods_id}=                                         Run Keyword If  not ${config_rmods_id}
    ...                                                         admin_info_model.get_rmod_indexes
    ...                                                         connection=${connection}
    ...                                                         ELSE
    ...                                                         Set Variable   ${config_rmods_id}
    ${base_cells_config}                                        admin_info_model.get_cell_ids_from_configured_rats
    ...                                                         connection=${connection}

    Create Selenium Session                                     admin_connection=${connection}

    ${config_index}                                             Set Variable  ${1}
    FOR  ${config_rmod_id}  ${path_to_delta}  IN ZIP  ${config_rmods_id}  ${deltas}
          ${rmod_config_distname}=                              admin_info_model.get_config_distname_for_rmod
          ...                                                   config_rmod_id=${config_rmod_id}
          ...                                                   connection=${connection}
          ${rmod_internal_distname}=                            admin_info_model.translate_rmod_distname
          ...                                                   rmod_distname=${rmod_config_distname}
          ...                                                   output_distname_type=internal
          ...                                                   connection=${connection}

          Enable EnergySaving                                   rmod_config_distname=${rmod_config_distname}
          Check EnergySaving Parameter                          rmod_config_distname=${rmod_config_distname}
          ...                                                   expected_energy_saving=DEEPSLEEP
          ...                                                   expected_power_state=AWAKE
          Block Cells And Wait For SLEEP State On RMOD          rmod_config_distname=${rmod_config_distname}
          Start Watching Cells Parameters On RMOD In Deep Sleep
          ...                                                   rmod_config_distname=${rmod_config_distname}

          ${plan_name}=                                         Set Variable If  """${sw_stream}""">="""SBTS25R2"""
          ...                                                   CONF-${config_index}_${path_to_delta.split("/")[-1].split(".")[0]}
          ...                                                   CONF-${config_index}
          Add Cells With Plan Validation                        path_to_delta=${path_to_delta}
          ...                                                   path_to_scf=${path_to_scf}
          ...                                                   plan_to_copy_from=${plan_name}
          ...                                                   delta_operation=added
          Check If Added Cells Are Present                      base_cells_config=${base_cells_config}
          ...                                                   path_to_delta=${path_to_delta}

          timer.wait_until_keyword_succeeds_timer               5min
          ...                                                   5s
          ...                                                   Check EnergySaving Parameter
          ...                                                   rmod_config_distname=${rmod_config_distname}
          ...                                                   expected_energy_saving=DEEPSLEEP
          ...                                                   expected_power_state=AWAKE
          Stop Watching Cells Parameters On RMOD In Deep Sleep
          Unblock cells on RMOD and check statuses              connection=${connection}
          ...                                                   rmod_internal_distname=${rmod_internal_distname}
          ...                                                   bts_type=${bts_type}
          Delete Cells With Status Check                        path_to_delta=${path_to_delta}
          
          ${config_index}=                                      Evaluate  ${config_index}+1
    END

    [Teardown]                                                  Run Keywords
    ...                                                         Close Selenium Session
    ...                                                         AND
    ...                                                         Perform Commissioning And Wait For OnAir
    ...                                                         scf_path=${path_to_scf}
