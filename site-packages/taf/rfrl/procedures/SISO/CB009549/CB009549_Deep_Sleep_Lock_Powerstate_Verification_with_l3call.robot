*** Keywords ***
CB009549_Deep_Sleep_Lock_Powerstate_Verification_with_l3call
    [Documentation]
    ...       Test verifies if RMOD enters deep sleep mode after 5 minute of cells being blocked. After that the deep sleep mode is exited and l3call is checked.
    ...       ARGS:
    ...       - throughputs: dict with throughput and deviation values for all cells, example:
    ...                                    throughput_100MHz = {
    ...                                         '827736065':
    ...                                             {
    ...                                                 'throughput':
    ...                                                     {
    ...                                                         'downlink': '100 Mbits/sec',
    ...                                                         'uplink': '15 Mbits/sec'
    ...                                                     },
    ...                                                 'info': '-',
    ...                                                 'deviation': '90%'
    ...                                               },
    ...                          defaults to ${None} (call will not be performed);
    ...       - config_rmods_id: list of configuration ID of RMODs which should be checked;
    ...                          defaults to ${None} (test will be perfomerd on all RMODS detected in current BTS configuration)
    ...       - call_duration: duration of data transfer test in Robot time string format
    ...                   e.g. '1 minutes 42 seconds' or '1min 42s'.
    ...       - protocol: data transfer protocol
    ...       - udp_buffer: monitoring data buffer
    ...       - tput_verification_via_btslog: True - throughput verification will be performed using btslog
    ...                                       False - throuput verification will be performed using iperf; defaults to False
    ...       - ue_network_modes: dictionary with pairs of UE Serial Number - desired network mode e.g. {"SN1234": "NR_only", "SN321": "NR_only}
    ...                           possible network modes: NR_only, LTE_only, NR_LTE (NR_LTE mode CAN NOT be used with any of the other
    ...                           two in case of more than one UE); defaults to ${None} (current modes set on UEs will be used)
    ...       - called_cells_distnames: CONFIGURATION distnames of cells that will be called, if not given,
    ...                                 list of all cells on testline will be determined and called
    [Arguments]                                                 ${throughputs}=${None}
    ...                                                         ${config_rmods_id}=${None}
    ...                                                         ${call_duration}=30s
    ...                                                         ${protocol}=udp
    ...                                                         ${udp_buffer}=4M
    ...                                                         ${tput_verification_via_btslog}=${True}
    ...                                                         ${ue_network_modes}=${None}
    ...                                                         ${called_cells_distnames}=${None}

    ${bts_type}=                                                hwpta_testline.get_type_of_setup
    ${connection}=                                              connections.get_default_admin_connection_alias
    ...                                                         bts_type=${bts_type}

    ${config_rmods_id}=                                         Run Keyword If  not ${config_rmods_id}
    ...                                                         admin_info_model.get_rmod_indexes
    ...                                                         connection=${connection}
    ...                                                         ELSE
    ...                                                         Set Variable   ${config_rmods_id}

    FOR  ${config_rmod_id}  IN  @{config_rmods_id}
          ${rmod_config_distname}=                              admin_info_model.get_config_distname_for_rmod
          ...                                                   config_rmod_id=${config_rmod_id}
          ...                                                   connection=${connection}
          ${rmod_internal_distname}=                            admin_info_model.translate_rmod_distname
          ...                                                   rmod_distname=${rmod_config_distname}
          ...                                                   output_distname_type=internal
          ...                                                   connection=${connection}

          Enable EnergySaving                                   rmod_config_distname=${rmod_config_distname}
          Check EnergySaving Parameter                          rmod_config_distname=${rmod_config_distname}
          ...                                                   expected_energy_saving=DEEPSLEEP
          ...                                                   expected_power_state=AWAKE

          Block Cells And Wait For SLEEP State On RMOD          rmod_config_distname=${rmod_config_distname}
          Unblock Cells And Wait For AWAKE State On RMOD        rmod_config_distname=${rmod_config_distname}

          run keyword if                                        ${throughputs}
          ...                                                   Execute L3 call
          ...                                                   cells_distnames=${called_cells_distnames}
          ...                                                   throughputs=${throughputs}
          ...                                                   protocol=${protocol}
          ...                                                   udp_buffer=${udp_buffer}
          ...                                                   duration=${call_duration}
          ...                                                   tput_verification_via_btslog=${tput_verification_via_btslog}
          ...                                                   ue_network_modes=${ue_network_modes}
    END

    [Teardown]                                                  Unblock cells on RMOD and check statuses
    ...                                                         connection=${connection}
    ...                                                         rmod_internal_distname=${rmod_internal_distname}
    ...                                                         bts_type=${bts_type}
