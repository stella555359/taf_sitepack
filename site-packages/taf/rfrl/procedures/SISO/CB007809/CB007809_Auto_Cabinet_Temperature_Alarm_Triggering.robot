CB007809_Auto_Cabinet_Temperature_Alarm_Triggering
    [Documentation]
    ...  TO BE REMOVED
    ...  Verifies if cabinet temperature alarms are triggered when temperature offsets are set to specific values
    ...  and the ambient temperature measured at the sub-rack temperature sensor has been below the low ambient
    ...  temperature threshold or exceeds the high ambient temperature threshold for five consecutive samples.
    ...  The temperature is monitored every 1 minute.
    ...
    ...  ARGS:
    ...  :param int high_offset: (Optional) High temperature offset value to be set.
    ...                          If set to None then the verification will be skipped. Defaults to -25.
    ...  :param int low_offset: (Optional) Low temperature offset value to be set.
    ...                         If set to None then the verification will be skipped. Defaults to 35.
    ...  :param int alarm_activation_timeout: (Optional) Time to wait for alarm activation in seconds. Defaults to 400.
    [Arguments]                                     ${high_offset}=-25
    ...                                             ${low_offset}=35
    ...                                             ${alarm_activation_timeout}=400
    ${bts_type}                                     hwpta_testline.get_type_of_setup
    ${connection}                                   connections.get_default_admin_connection_alias
    ...                                             bts_type=${bts_type}
    config_operations.connect                       alias=${connection}

    ${default_parameters}=                          Get Default Values Of Temperature Offsets And Cabinet Monitoring Parameters

    Set Act Cabinet Temperature Monitoring Alarms Parameter

    Check Ambient Temperature Alarm                 fault_name=Ambient temperature is high
    ...                                             fault_id=4743
    ...                                             offset=${high_offset}
    ...                                             offset_name=tempHighOffset
    ...                                             bts_type=${bts_type}
    ...                                             timeout=${alarm_activation_timeout}

    Check Ambient Temperature Alarm                 fault_name=Ambient temperature is low
    ...                                             fault_id=4792
    ...                                             offset=${low_offset}
    ...                                             offset_name=tempLowOffset
    ...                                             bts_type=${bts_type}
    ...                                             timeout=${alarm_activation_timeout}

    [Teardown]                                      Auto Cabinet Temperature Alarm Triggering Teardown
    ...                                             default_parameters=${default_parameters}
    ...                                             bts_type=${bts_type}


Get Default Values Of Temperature Offsets And Cabinet Monitoring Parameters
    [Documentation]
    ...  Gets default values of temperature offsets (tempHighOffset, tempLowOffset) and cabinet temperature
    ...  monitoring alarm (actCabiTempMonAlarms) parameters.
    ${act_cabi_temp_mon_alarms}=                    config_operations.get_parameter_value
    ...                                             dist_name=MRBTS-{}/MNL-1/MNLENT-1/FMCADM-1
    ...                                             param_name=actCabiTempMonAlarms

    ${is_high_offset_set}=                          config_operations.check_if_parameter_exists
        ...                                         dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1
        ...                                         param_name=tempHighOffset
    IF    """${is_high_offset_set}"""=="""${True}"""
        ${high_offset}=                             config_operations.get_parameter_value
        ...                                         dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1
        ...                                         param_name=tempHighOffset
    ELSE
        ${high_offset}=                             Set Variable
        ...                                         ${None}
    END

    ${is_low_offset_set}=                           config_operations.check_if_parameter_exists
        ...                                         dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1
        ...                                         param_name=tempLowOffset
    IF    """${is_low_offset_set}"""=="""${True}"""
        ${low_offset}=                              config_operations.get_parameter_value
        ...                                         dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1
        ...                                         param_name=tempLowOffset
    ELSE
        ${low_offset}=                              Set Variable
        ...                                         ${None}
    END

    &{default_parameter_values}=                    Create Dictionary
    ...                                             act_cabi_temp_mon_alarms=${act_cabi_temp_mon_alarms}
    ...                                             high_offset=${high_offset}
    ...                                             low_offset=${low_offset}
    Robot Log Variable                              variable=Default parameter values: ${default_parameter_values}

    [Return]                                        ${default_parameter_values}


Set Act Cabinet Temperature Monitoring Alarms Parameter
    [Documentation]
    ...  Sets cabinet temperature monitoring alarms parameter to 'true' (actCabiTempMonAlarms).
    Robot Log Operation                             Enabling cabinet temperature monitoring alarms parameter
    config_operations.set_parameter_value           dist_name=MRBTS-{}/MNL-1/MNLENT-1/FMCADM-1
    ...                                             param_name=actCabiTempMonAlarms
    ...                                             param_value=true


Check Ambient Temperature Alarm
    [Documentation]
    ...  Sets temperature offset parameter to specified value and checks if the corresponding
    ...  ambient temperature alarm is triggered within specified timeout.
    ...
    ...  ARGS:
    ...  :param str fault_name: Fault name of the alarm to be checked; e.g. 'Ambient temperature is high'.
    ...  :param str fault_id: Fault ID of the alarm to be checked; e.g. '4743'.
    ...  :param int offset: Temperature offset value to be set; e.g. -25.
    ...  :param str offset_name: Name of the temperature offset parameter to be changed; e.g. 'tempHighOffset'.
    ...  :param str bts_type: Type of the BTS setup; e.g. 'GNB'.
    ...  :param int timeout: (Optional) Time to wait for alarm activation in seconds. Defaults to 400.
    [Arguments]                                     ${fault_name}
    ...                                             ${fault_id}
    ...                                             ${offset}
    ...                                             ${offset_name}
    ...                                             ${bts_type}
    ...                                             ${timeout}=400
    IF    """${offset}"""!="""${None}"""
        Alarms.Allow alarm                          fault_id=${fault_id}
        ...                                         fault_name=${fault_name}
        ...                                         bts_type=${bts_type}

        Robot Log Operation                         Setting temperature "${offset_name}" offset to ${offset}
        config_operations.set_parameter_value       dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1
        ...                                         param_name=${offset_name}
        ...                                         param_value=${offset}

        Robot Log Operation                         Waiting ${timeout}s for "${fault_name}" fault with ID ${fault_id} to appear...
        ${is_alarm_active}=                         Alarms.Wait for active alarm
        ...                                         fault_id=${fault_id}
        ...                                         timeout=${timeout}
        Should be true                              ${is_alarm_active}
        ...                                         msg="${fault_name}" fault with ID ${fault_id} did not appear during ${timeout}s timeout!
    ELSE
        Robot Log Operation                         Skipping verification of "${fault_name}" alarm as offset is set to None.
    END


Auto Cabinet Temperature Alarm Triggering Teardown
    [Arguments]                                     ${default_parameters}
    ...                                             ${bts_type}
    Robot Log Operation                             Cabinet temperature alarm triggering teardown...

    config_operations.set_parameter_value           dist_name=MRBTS-{}/MNL-1/MNLENT-1/FMCADM-1
    ...                                             param_name=actCabiTempMonAlarms
    ...                                             param_value=${default_parameters['act_cabi_temp_mon_alarms']}

    IF   """${default_parameters['high_offset']}"""=="""${None}"""
        Run Keyword And Ignore Error                config_operations.delete_parameter
        ...                                         dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1
        ...                                         param_name=tempHighOffset
    ELSE
        config_operations.set_parameter_value       dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1
        ...                                         param_name=tempHighOffset
        ...                                         param_value=${default_parameters['high_offset']}
    END

    IF   """${default_parameters['low_offset']}"""=="""${None}"""
        Run Keyword And Ignore Error                config_operations.delete_parameter
        ...                                         dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1
        ...                                         param_name=tempLowOffset
    ELSE
        config_operations.set_parameter_value       dist_name=MRBTS-{}/EQM-1/APEQM-1/CABINET-1
        ...                                         param_name=tempLowOffset
        ...                                         param_value=${default_parameters['low_offset']}
    END

    ${list_of_faults_names}                         Create List
    ...                                             Ambient temperature is high
    ...                                             Ambient temperature is low
    ${list_faults_ids}                              Create List
    ...                                             4743
    ...                                             4792
    Alarms.Wait and check for inactive alarms       list_of_fault_names=${list_of_faults_names}
    ...                                             list_of_fault_ids=${list_faults_ids}
    ...                                             timeout=400s
    ...                                             bts_type=${bts_type}
