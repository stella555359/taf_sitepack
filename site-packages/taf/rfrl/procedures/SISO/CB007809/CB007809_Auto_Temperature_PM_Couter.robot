*** Keywords ***
CB007809_Auto_Temperature_PM_Counters
    [Documentation]    Test case validates if cabinet temperature PM counter is working correctly

    ${mrbts_id}=                                             testline.get_mrbts_id
    ${connection}=                                           connections.get_default_admin_connection_alias

    config_operations.connect                                alias=${connection}

    ${tmp}=                                                  config_operations.get_parameter_value
    ...                                                      dist_name=MRBTS-${mrbts_id}/MNL-1/MNLENT-1/PMMNL-1
    ...                                                      param_name=mtSBTSCabiTempMonitoring

    config_operations.set_parameter_value                    dist_name=MRBTS-${mrbts_id}/MNL-1/MNLENT-1/PMMNL-1
    ...                                                      param_name=mtSBTSCabiTempMonitoring
    ...                                                      param_value=15min

    Sleep                                                    15 min
    ...                                                      Reason=Waiting for counter to appear

    counters.wait_for_next_pm_period                         interval=15min

    ${counter}=                                              counters.get_counter
    ...                                                      counter_ids=M40019C0

    Should not be empty                                      ${counter}

    counters.validate_counter_interval                       counter_id=M40019C0
    ...                                                      expected_interval=15min

    [Teardown]                                               Run keywords
    config_operations.set_parameter_value                    dist_name=MRBTS-${mrbts_id}/MNL-1/MNLENT-1/PMMNL-1
    ...                                                      param_name=mtSBTSCabiTempMonitoring
    ...                                                      param_value=${tmp}
