*** Keywords ***
Prepare RMODs Dict With Required Info
    [Documentation]  Prepares a dictionary of RMODs with all required information for the test.
    ...              Required info includes:
    ...              - runtime RMOD ID
    ...              - runtime SMOD ID to which RMOD is connected
    ...              - runtime distname of the RMOD
    ...              - serial number of the RMOD
    ...              - flag indicating whether the VM is connected to a particular SMOD (required for the Fullrack case)

    [Arguments]      ${rmod_ids}
    ...              ${connection}

    ${is_fullrack}=                                     hwpta_testline.is_full_rack
    ${rmods_info}                                       Evaluate   {key: {} for key in ${rmod_ids}}
    FOR    ${configured_rmod_id}                        IN    @{rmod_ids}

        ${runtime_rmod_id}=                             admin_info_model.translate_rmod_index_to_runtime
        ...                                             rmod_index=${configured_rmod_id}
        ...                                             connection=${connection}
        ${runtime_smod_id}=                             admin_info_model.get_smod_id_for_connected_rmod
        ...                                             rmod_id=${runtime_rmod_id}
        ...                                             connection=${connection}
        ${runtime_rmod_distname}=                       admin_info_model.translate_rmod_runtime_id_to_distname
        ...                                             runtime_rmod_id=${runtime_rmod_id}
        ...                                             connection=${connection}
        ${rmod_serial_number}=                          admin_info_model.get_serial_number_for_rmod
        ...                                             rmod_id=${configured_rmod_id}
        ...                                             connection=${connection}
        ${is_vm_connected_to_smod}                      Run Keyword If  ${is_fullrack}
        ...                                             Check If VM Connected To SMOD
        ...                                             runtime_smod_id=${runtime_smod_id}
        ...                                             connection=${connection}
        ...                                             ELSE
        ...                                             Set Variable  ${True}

        Set To Dictionary                               ${rmods_info}[${configured_rmod_id}]
        ...                                             runtime_rmod_id=${runtime_rmod_id}
        ...                                             runtime_smod_id=${runtime_smod_id}
        ...                                             runtime_rmod_distname=${runtime_rmod_distname}
        ...                                             rmod_sn=${rmod_serial_number}
        ...                                             is_vm_connected_to_smod=${is_vm_connected_to_smod}
    END
    @{all_rmods_sn}                                     Evaluate  [rmod['rmod_sn'] for rmod in ${rmods_info}.values()]
    Set To Dictionary                                   ${rmods_info}  all_rmods_sn=${all_rmods_sn}

    [Return]         ${rmods_info}


Collect Logs
    [Documentation]  Collects SOAP and PCAP logs.
    [Arguments]      ${collect_soap}
    ...              ${collect_pcap}
    ...              ${rmods_info}
    ...              ${iteration}

    IF    ${collect_soap}                               
        Collect SOAPMessageTraceCFG Logs From SMOD      rmods_sn=${rmods_info}[all_rmods_sn]
        ...                                             log_dir=${soap_logs_path}/${iteration}
    END
    IF    ${collect_pcap}
        Robot Log Operation                             - Collecting PCAP log to ${pcap_logs_path}/${iteration}
        xgen.stop_capture_pcap
    END


Verify Logs
    [Documentation]  Verifies SOAP and PCAP logs.
    [Arguments]      ${soap_analysis}
    ...              ${pcap_analysis}
    ...              ${rmods_info}
    ...              ${iteration}

    IF   ${soap_analysis}                               Perform SOAP Logs Analysis
    ...                                                 rmods_sn=${rmods_info}[all_rmods_sn]
    ...                                                 iteration=${iteration}
    IF   ${pcap_analysis}                               Perform PCAP Logs Analysis
    ...                                                 iteration=${iteration}
    ...                                                 pcap_path=${pcap_logs_path}/${iteration}/${pcap_filename}


Perform SyncStatus And DL UL Minimum Delay Validation
    [Documentation]  Performs RMOD(s) syncStatus check if changed to `Locked` and verifies parameters dlMinDelay and dlMinDelay if values are != 0.
    [Arguments]      ${rmod_ids}
    ...              ${connection}

    ${rmods_sync_status}=                               admin_info_model.get_rmods_sync_status
    ...                                                 rmod_ids=${rmod_ids}
    ...                                                 connection=${connection}
    ${rmods_dl_ul_min_delay}=                           admin_info_model.get_rmods_dl_ul_min_delay
    ...                                                 rmod_ids=${rmod_ids}
    ...                                                 connection=${connection}

    ${rmods_with_invalid_sync_s}=                       Evaluate    {rmod: sync for rmod, sync in ${rmods_sync_status}.items() if sync != 'Locked'}
    ${rmods_with_invalid_dl_ul_min_delay}               Validate DL UL Minimum Delay Values
    ...                                                 rmods_dl_ul_min_delay=${rmods_dl_ul_min_delay}

    IF                                                  ${rmods_with_invalid_sync_s} or ${rmods_with_invalid_dl_ul_min_delay}
        ${fail_msg}=                                    Run keyword if    ${rmods_with_invalid_sync_s}
        ...                                             Catenate  Configuration RMOD id(s) with syncStatus != 'Locked':\n
        ...                                             ${rmods_with_invalid_sync_s}\n
        ...                                             ELSE    Set Variable    \
        ${fail_msg}=                                    Run keyword if    ${rmods_with_invalid_dl_ul_min_delay}
        ...                                             Catenate  ${fail_msg}  Configuration RMOD id(s) with incorrect
        ...                                             dlMinDelay, ulMinDelay values:\n ${rmods_with_invalid_dl_ul_min_delay}
        ...                                             ELSE    Set Variable    ${fail_msg}
        Fail                                            ${fail_msg}
    END


Perform SOAP Logs Analysis
    [Documentation]  Performs SOAP logs analysis.
    ...              Analysis includes:
    ...              1. Checking if <managedObject> with class="SupportedFeature" has <parameterName> "feature" and
    ...                 <newValue> "ECPRI_MSG5_DELAY_MEASUREMENT" and <parameterName> "support" with <newValue> "9"
    ...              2. Checking if <managedObject> with class="ECpriDelayMeasurementSession" and <operation> "create_mo" created at least once
    ...              3. Checking if the response to the above request exists with same <managedObject> class and <operation>
    ...                 but with <parameterName> "subscribe" and <newValue> "TRUE".
    ...              4. Checking if the responses are equal to the requests

    [Arguments]      ${rmods_sn}
    ...              ${iteration}

    Robot Log Operation                                 - Starting SOAPMessageTraceCFG logs analysis...
    FOR      ${rmod_sn}                                 IN   @{rmods_sn}
        ${soap_file_names}=                             vm.find_files_in_directory_by_regex
        ...                                             directory_path=${soap_logs_path}/${iteration}
        ...                                             regex=${rmod_sn}.*

        IF                                              len(${soap_file_names}) > 1
            ${combined_file_name}=                      vm.combine_files_into_one
            ...                                         directory_path=${soap_logs_path}/${iteration}
            ...                                         file_names=${soap_file_names}
            ...                                         new_file_name=combined_${rmod_sn}_soap.xml
            ${soap_file_path}=                          Set Variable  ${soap_logs_path}/${iteration}/${combined_file_name}
        ELSE
            ${soap_file_path}=                          Set Variable  ${soap_logs_path}/${iteration}/${soap_file_names}[0]
        END

        xml_verifiers.check_if_ecipri_msg5_delay_measurement_msg_exists
        ...                                             xml_file_path=${soap_file_path}
        xml_verifiers.verify_ecipri_delay_measurement_ruquests_equal_responses
        ...                                             xml_file_path=${soap_file_path}
    END
    Robot Log Operation                                 - SOAPMessageTraceCFG log analysis completed successfully.


Perform PCAP Logs Analysis
    [Documentation]  Performs PCAP logs analysis.
    ...              Analysis includes:
    ...              To be implemented.
    ...              1. Verifies if all eCPRI one-way delay measurement sessions between the DU and RMOD contains
    ...                 the appropriate set of packets.
    ...                 Measurement session should contain the following packets:
    ...                 for DL:
    ...                   - at least one packet with Action Type: Request (0x00) (from BTS to RMOD)
    ...                   - one packet with Action Type: Response (0x02) (from RMOD to BTS)
    ...                 for UL:
    ...                   - one packet with Action Type: Request with Follow_Up (0x01) (from RMOD to BTS)
    ...                   - at least one packet with Action Type: Remote Request with Follow_up (0x04) (from BTS to RMOD)
    ...                   - one packet with Action Type: Follow_up (0x05) (from RMOD to BTS)
    ...              2. Verifies if the number of eCPRI one-way delay measurements (feature CB009301) created
    ...                 during 1 second is >= the expected number.
    ...              3. Verifies whether the 'Measurement ID' field in eCPRI one-way delay measurement sessions
    ...                 increments correctly during the first 1000 sessions.
    ...              4. Verifies whether eCPRI one-way delay measurement packets with Action Types: Response (0x02) and
    ...                 Follow_up (0x05) values that are not zero and are greater than the previous one.
    ...              5. Verifies whether the eCPRI one-way delay measurement msg type 5 packets have correct format.
    ...                 Required:
    ...                   - Frame should have max 64 bytes
    ...                   - eCPRI frame layer should have at least 24 bytes
    ...                   - eCPRI frame Header (4 bytes) should be equal '1005' + payload_size (2 bytes) and should be placed in the 1st to 4th octet
    ...                   - [eCPRI layer] Measurement ID (1 byte) should be placed in the 5th octet
    ...                   - [eCPRI layer] Action Type (1 byte) should be placed in the 6th octet
    ...                   - [eCPRI layer] TimeStamp sec (6 bytes) should start at the 7th octet and end at the 12th octet
    ...                   - [eCPRI layer] TimeStamp nanosec (4 bytes) should start at the 13th octet and end at the 16th octet
    ...                   - [eCPRI layer] Compensation value (8 bytes) should start at the 17th octet and end at the 24th octet

    [Arguments]      ${iteration}
    ...              ${pcap_path}

    Robot Log Operation                                                 - Starting PCAP logs analysis...
    ${filtered_pcap}=           pcap_parse.filter_pcap
    ...                         pcap_path=${pcap_path}
    ...                         display_filter=ecpri.type == 0x05
    ${grouped_by_sessions}=     pcap_parse.group_ecpri_delay_measurement_sessions
    ...                         pcap_capture=${filtered_pcap}
    ${vrf_1}=                   run keyword and ignore error            pcap_vrf.verify_ecpri_one_way_delay_measurement_procedure
    ...                                                                 sessions=${grouped_by_sessions}
    ...                                                                 logs_path=${logs_path}
    ${vrf_2}=                   run keyword and ignore error            pcap_vrf.verify_ecpri_one_way_delay_measurements_per_second
    ...                                                                 sessions=${grouped_by_sessions}
    ${vrf_3}=                   run keyword and ignore error            pcap_vrf.verify_ecpri_one_way_delay_measurement_incrementation_order
    ...                                                                 sessions=${grouped_by_sessions}
    ${vrf_4}=                   run keyword and ignore error            pcap_vrf.verify_ecpri_delay_measurement_packet_time_stamp
    ...                                                                 sessions=${grouped_by_sessions}
    ...                                                                 logs_path=${logs_path}

    ${filtered_pcap}=           pcap_parse.filter_pcap
    ...                         pcap_path=${pcap_path}
    ...                         display_filter=ecpri.type == 0x05
    ...                         use_ek=${True}
    ...                         include_raw=${True}
    ${vrf_5}=                   run keyword and ignore error            pcap_vrf.verify_ecpri_message_type_5_fields
    ...                                                                 pcap_capture=${filtered_pcap}
    ...                                                                 logs_path=${logs_path}

    ${results}                  create list    ${vrf_1}    ${vrf_2}    ${vrf_3}    ${vrf_4}    ${vrf_5}
    ${failed}=                  evaluate       [result[1] for result in ${results} if result[0] == 'FAIL']
    IF    ${failed}    Fail     ${\n.join(${failed})}   ELSE    Log    PASS
    Robot Log Operation                                                 - PCAP log analysis completed successfully.


Check If VM Connected To SMOD
    [Documentation]  Checks if VM is connected to SMOD.
    ...              Returns True if VM is connected to SMOD, False otherwise.
    [Arguments]      ${runtime_smod_id}
    ...              ${connection}

    ${smod_sn_connected_to_vm}=                         vm.get_smod_serial_number_connected_to_vm
    ${smod_sn_from_smod_id}=                            admin_info_model.get_serial_number_for_smod
    ...                                                 connection=${connection}
    ...                                                 smod_id=${runtime_smod_id}
    ${is_connected}=                                    Evaluate    '${smod_sn_connected_to_vm}' == '${smod_sn_from_smod_id}'

    [Return]         ${is_connected}


Set actEcpriDelayMeasurement Parameter
    [Documentation]  Set parameter 'actEcpriDelayMeasurement' to value provided in ${parameter_value}.
    [Arguments]      ${parameter_value}
    ...              ${connection}

    ${actual_parameter_value}=                          config_operations.get_parameter_value
    ...                                                 dist_name=MRBTS-{}/MNL-1/MNLENT-1/FEATCADM-1
    ...                                                 param_name=actEcpriDelayMeasurement

    IF                                                  '${actual_parameter_value}' != '${parameter_value}'
        Robot Log Operation                             Recommissioning parameter 'actEcpriDelayMeasurement' to ${parameter_value}...
        config_operations.set_parameter_value           dist_name=MRBTS-{}/MNL-1/MNLENT-1/FEATCADM-1
        ...                                             param_name=actEcpriDelayMeasurement
        ...                                             param_value=${parameter_value}
    END


Validate Test Execution Duration
    [Documentation]  Validates that the average duration of test execution with the feature activated is no more than ${kpi_threshold} 
    ...              seconds longer than the execution duration without the feature.
    [Arguments]      ${avrg_without_feature}
    ...              ${avrg_with_feature}
    ...              ${kpi_threshold}
    
    ${max_execution_time}                               Evaluate   ${avrg_without_feature} + int(${kpi_threshold})
    IF                                                  ${avrg_with_feature} > ${max_execution_time}
        ${diff}                                         Evaluate   round(${avrg_with_feature} - ${avrg_without_feature}, 1)
        ${fail_msg}                                     Catenate   Average execution duration with the feature activated exceeds allowed time.\n
        ...                                             Average of execution without feature: ${avrg_without_feature} seconds.\n
        ...                                             Average of execution with feature: ${avrg_with_feature} seconds.\n
        ...                                             Difference should not exceed ${kpi_threshold} seconds.
        ...                                             Actual difference is ${diff} seconds.
        Fail                                            ${fail_msg}
    END


Restore Parameter actEcpriDelayMeasurement To Initial
    [Documentation]  Restores the parameter actEcpriDelayMeasurement value to its initial value.
    [Arguments]      ${initial_parameter_value}
    ${parameter_value}=                                 config_operations.get_parameter_value
    ...                                                 dist_name=MRBTS-{}/MNL-1/MNLENT-1/FEATCADM-1
    ...                                                 param_name=actEcpriDelayMeasurement
    IF                                                  '${initial_parameter_value}' != '${parameter_value}'
        config_operations.set_parameter_value           dist_name=MRBTS-{}/MNL-1/MNLENT-1/FEATCADM-1
        ...                                             param_name=actEcpriDelayMeasurement
        ...                                             param_value=${initial_parameter_value}
    END


Validate DL UL Minimum Delay Values
    [Documentation]  Validates whether dlMinDelay and ulMinDelay values are != 0 and returns a list of RMODs with invalid values.
    [Arguments]      ${rmods_dl_ul_min_delay}

    ${rmods_with_invalid_dl_ul_min_delay}                Create List
    FOR    ${rmod_id}    ${cablinks}                     IN  &{rmods_dl_ul_min_delay}
        ${dl_ul_valid}=                                  Evaluate  all(0 not in v['dlMinDelay'] + v['ulMinDelay'] for v in ${cablinks}.values())
        IF                                               not ${dl_ul_valid}
            Append To List                               ${rmods_with_invalid_dl_ul_min_delay}   {${rmod_id}: ${cablinks}}
        END
    END
    [Return]         ${rmods_with_invalid_dl_ul_min_delay}