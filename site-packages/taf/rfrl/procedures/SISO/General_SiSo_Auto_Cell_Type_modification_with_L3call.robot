*** Keywords ***
General_SiSo_Auto_Cell_Type_modification_with_L3call
    [Documentation]  The purpose of this test case is to validate nrCellType modification. L3 Call procedure is performed on
    ...              all cells on base nrCellType and on modified ones.
    ...              ARGS:
    ...              - path_to_base_scf - path to the base scf file
    ...              - path_to_modified_scf - path to the scf file with modified cells types
    ...              - cell_ids - list of CONFIG cell ids that are expected to be modified
    ...              - throughputs - dict with throughput and deviation values for each cell identified by it's nrCellIdentity.
    ...                Example:
    ...                {
    ...                    '827736065':
    ...                         {
    ...                             'throughput':
    ...                                 {
    ...                                     'downlink': '100 Mbits/sec',
    ...                                     'uplink': '15 Mbits/sec'
    ...                                 },
    ...                             'deviation': '90%'
    ...                          },
    ...                }
    ...              - throughputs_modified - list of throughputs for each cell after modification
    ...              - protocol: data transfer protocol; defaults to UDP.
    ...              - udp_buffer: monitoring data buffer; defaults to 4M.
    ...              - tput_verification_via_btslog: True - throughput verification will be performed using btslog
    ...                                          False - throuput verification will be performed using iperf; defaults to False
    ...              - ue_network_modes: dict with UE serial numbers and desired network modes e.g. {"SN1234": "NR_only"}
    ...                                  possible UE network modes: NR_only, LTE_only, NR_LTE
    ...                                  when using more than one UE please make sure that the modes you choose are either all
    ...                                  with "_only" suffix or all "NR_LTE" as it is not yet possible to mix those.
    ...                                  mandatory for SA+NSA setups, defaults to None
    ...              - ignored_cells_on_preparation: SHOULD BE USED WITH `prepare_cells_to_call` set to True!
    ...                                              list of cells CONFIGURATION distnames that should be ignored during
    ...                                              L3 Call not called cells preparation procedure and not be blocked/barred

    [Arguments]                                     ${path_to_base_scf}
    ...                                             ${path_to_modified_scf}
    ...                                             ${cell_ids}
    ...                                             ${throughputs}
    ...                                             ${throughputs_modified}
    ...                                             ${protocol}=udp
    ...                                             ${udp_buffer}=4M
    ...                                             ${tput_verification_via_btslog}=${False}
    ...                                             ${ue_network_modes}=${None}
    ...                                             ${ignored_cells_on_preparation}=${None}

    ${bts_type}=                                    hwpta_testline.get_type_of_setup
    ${connection}                                   connections.get_default_admin_connection_alias
    ...                                             bts_type=${bts_type}
    config_operations.connect                       alias=${connection}

    Set Test Variable                               ${return_to_initial_scf}
    ...                                             ${True}

    Change Cell Type And Verify Params              cell_ids=${cell_ids}
    ...                                             path_to_base_scf=${path_to_base_scf}
    ...                                             path_to_modified_scf=${path_to_modified_scf}
    ...                                             bts_type=${bts_type}

    Execute L3 call                                 throughputs=${throughputs_modified}
    ...                                             protocol=${protocol}
    ...                                             udp_buffer=${udp_buffer}
    ...                                             tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                             ue_network_modes=${ue_network_modes}
    ...                                             ignored_cells_on_preparation=${ignored_cells_on_preparation}

    Change Cell Type And Verify Params              cell_ids=${cell_ids}
    ...                                             path_to_base_scf=${path_to_modified_scf}
    ...                                             path_to_modified_scf=${path_to_base_scf}
    ...                                             bts_type=${bts_type}

    Execute L3 call                                 throughputs=${throughputs}
    ...                                             protocol=${protocol}
    ...                                             udp_buffer=${udp_buffer}
    ...                                             tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                             ue_network_modes=${ue_network_modes}
    ...                                             ignored_cells_on_preparation=${ignored_cells_on_preparation}


Private Change Cell Type
    [Arguments]                                     ${path_to_base_scf}
    ...                                             ${path_to_modified_scf}
    ...                                             ${bts_type}
    Alarms.Allow alarm                              fault_id=7313
    ...                                             fault_name=NgGnbInitPartialReset
    ...                                             bts_type=${bts_type}
    Alarms.Allow alarm                              fault_id=16
    ...                                             fault_name=Unit synchronization failed
    ...                                             bts_type=${bts_type}

    Perform online delta commissioning and achieve On Air
    ...                                             path_to_base_scf=${path_to_base_scf}
    ...                                             path_to_modified_scf=${path_to_modified_scf}
    ...                                             bts_type=${bts_type}
    ...                                             check_if_bts_didnt_reset=${True}

    Alarms.Disallow alarm                           fault_id=7313
    ...                                             fault_name=NgGnbInitPartialReset
    ...                                             bts_type=${bts_type}
    ...                                             fault_id=16
    Alarms.Disallow alarm                           fault_name=Unit synchronization failed
    ...                                             bts_type=${bts_type}

Change Cell Type And Verify Params
    [Arguments]                                     ${cell_ids}
    ...                                             ${path_to_base_scf}
    ...                                             ${path_to_modified_scf}
    ...                                             ${bts_type}

    ${cell_types_before_commissioning}=             Get Cell Type Param Values
    ...                                             cell_ids=${cell_ids}

    Private Change Cell Type                        path_to_base_scf=${path_to_base_scf}
    ...                                             path_to_modified_scf=${path_to_modified_scf}
    ...                                             bts_type=${bts_type}

    ${cell_types_after_commissioning}=              Get Cell Type Param Values
    ...                                             cell_ids=${cell_ids}

    FOR   ${cell_id}  ${cell_type_before_commissioning}  ${cell_type_after_commissioning}  IN ZIP  ${cell_ids}  ${cell_types_before_commissioning}  ${cell_types_after_commissioning}
           Should Not Be Equal                      ${cell_type_before_commissioning}
           ...                                      ${cell_type_after_commissioning}
           ...                                      msg=Cell type was not changed for cell with ID: ${cell_id}.
    END

Get Cell Type Param Values
    [Arguments]                                     ${cell_ids}

    ${cell_types}=                                  Create List
    FOR   ${cell_id}    IN    @{cell_ids}
           ${param_value}=                          config_operations.get_parameter_value
           ...                                      dist_name=MRBTS-{}/NRBTS-{}/NRCELL-${cell_id}
           ...                                      param_name=nrCellType
           Append To List                           ${cell_types}    ${param_value}
    END

    [Return]                                        ${cell_types}
