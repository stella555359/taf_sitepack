*** Keywords ***
CB009105_B_Long_PUCCH_improvements_for_FR1
    [Documentation]     Test case verifies if PUCCH counters are increasing during L3 call. Purpose of this test is to
    ...                 verify,that CB007449 works properly with RF6.2 8T8R radio family.
    ...                 Arguments:
    ...                     ${cell_id}:        CONFIG ID of the NR cell to be tested, e.g. 1, 2, 3, etc.
    ...                     ${throughputs}:    dict with throughput and deviation values for each cell identified by
    ...                                        it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells.
    ...                                        Example:
    ...                                        {
    ...                                            '827736065':
    ...                                                 {
    ...                                                     'throughput':
    ...                                                         {
    ...                                                             'downlink': '100 Mbits/sec',
    ...                                                             'uplink': '15 Mbits/sec'
    ...                                                         },
    ...                                                     'deviation': '90%'
    ...                                                 },
    ...                                        }
    ...                     ${direction}:      direction of the data transfer: `UL`, `DL`, `UL_DL`; defaults to DL.
    ...                     ${protocol}:       data transfer protocol; defaults to UDP.
    ...                     ${udp_buffer}:     monitoring data buffer; defaults to 4M.
    [Arguments]                                         ${cell_id}
    ...                                                 ${throughputs}
    ...                                                 ${direction}=DL
    ...                                                 ${protocol}=udp
    ...                                                 ${udp_buffer}=4M

    ${bts_type}=                                        hwpta_testline.get_type_of_setup
    ${connection}=                                      connections.get_default_admin_connection_alias
    ...                                                 bts_type=${bts_type}
    ${called_cell_distnames}  ${distnames_of_cells_to_block}  Get Distnames Of Cells To Block
    ...                                                 cell_id=${cell_id}
    ...                                                 connection=${connection}
    ${setup_mode_based_counter}  ${counter_ids}=        Define Counters List

    Block selected cells and check statuses             connection=${connection}
    ...                                                 cells_distname=${distnames_of_cells_to_block}
    ...                                                 bts_type=${bts_type}
    Robot Log Operation                                 Waiting for the next quarter to start the L3 Call procedure...
    ${start_datetime}=                                  wait.wait_until_next_quarter
    Start L3 Call In Background                         called_cell=${called_cell_distnames['configuration']}
    ...                                                 direction=${direction}
    ...                                                 duration=300s
    ...                                                 throughputs=${throughputs}
    ...                                                 protocol=${protocol}
    ...                                                 udp_buffer=${udp_buffer}
    ...                                                 prepare_cells_to_call=${False}
    Robot Log Operation                                 Waiting to generate PM counters data...
    ${end_datetime}=                                    wait.wait_until_next_quarter
    Verify Background L3 Call Results                   called_cell=${called_cell_distnames['configuration']}

    Robot Log Operation                                 Waiting for counters data to be available...
    wait.wait_until_next_quarter
    Sleep                                               5min
    ...                                                 reason=Waiting for counters to load
    ${previous_quarter_datetime}=                       Subtract Time From Date
    ...                                                 date=${start_datetime}
    ...                                                 time=15min
    ${end_datetime}=                                    Add Time To Date
    ...                                                 date=${end_datetime}
    ...                                                 time=1min
    ${counters_values}=                                 Save Counters Values
    ...                                                 counters_verification_startpoint=${previous_quarter_datetime}
    ...                                                 counters_verification_endpoint=${end_datetime}
    ...                                                 counter_ids=${counter_ids}
    ...                                                 component_name=NRCELL-${cell_id}
    ${counters_values}=                                 Convert Counters Values To Single Dict
    ...                                                 counters_values=${counters_values}
    Verify Counter Values                               counters_values=${counters_values}
    ...                                                 setup_mode_based_counter=${setup_mode_based_counter}

    [Teardown]                                          Unblock selected cells and check statuses
    ...                                                 connection=${connection}
    ...                                                 cells_distname=${distnames_of_cells_to_block}
    ...                                                 bts_type=${bts_type}

Define Counters List
    ${bts_setup_mode}=                                  hwpta_testline.get_bts_setup_mode
    ${setup_mode_based_counter}=                        Set Variable If  """${bts_setup_mode}"""=="NSA"
    ...                                                 M55114C00010
    ...                                                 M55138C00014

    ${counter_ids}=                                     Create List
    ...                                                 ${setup_mode_based_counter}
    ...                                                 M55303C13001
    ...                                                 M55303C14001
    ...                                                 M55303C17001
    ...                                                 M55303C18001

    [Return]                                            ${setup_mode_based_counter}  ${counter_ids}


Convert Counters Values To Single Dict
    [Arguments]                                         ${counters_values}

    ${counters_values_dict}=                            Create Dictionary
    FOR  ${counter_values}  IN  @{counters_values}
        ${counter_id}=                                  Evaluate
        ...                                             list(${counter_values}.keys())[0]
        Set To Dictionary                               ${counters_values_dict}
        ...                                             ${counter_id}=${counter_values["""${counter_id}"""]}
    END

    [Return]                                            ${counters_values_dict}


Verify Counter Values
    [Arguments]                                         ${counters_values}
    ...                                                 ${setup_mode_based_counter}

    Robot Log Operation                                 Verifying counters values...

    ${peak_number_of_users}=                            Set Variable  ${counters_values["""${setup_mode_based_counter}"""]}
    ${pucch_format1_dtx}=                               Set Variable  ${counters_values["M55303C13001"]}
    ${pucch_format1_non_dtx}=                           Set Variable  ${counters_values["M55303C14001"]}
    ${pucch_format3_dtx}=                               Set Variable  ${counters_values["M55303C17001"]}
    ${pucch_format3_non_dtx}=                           Set Variable  ${counters_values["M55303C18001"]}

    Should Be True                                      ${peak_number_of_users[1]}>0
    Should Be True                                      ${pucch_format1_dtx[1]}>${pucch_format1_dtx[0]}>=0 or ${pucch_format1_non_dtx[1]}>${pucch_format1_non_dtx[0]}>=0
    Should Be True                                      ${pucch_format3_dtx[1]}>${pucch_format3_dtx[0]}>=0 or ${pucch_format3_non_dtx[1]}>${pucch_format3_non_dtx[0]}>=0

    Robot Log Result                                    Counters values verified successfully!
    ...                                                 to_console=${True}

Get Distnames Of Cells To Block
    [Arguments]                                         ${cell_id}
    ...                                                 ${connection}

    ${called_cell_dist_names}                           admin_info_model.get_dist_names_for_specific_cell
    ...                                                 connection=${connection}
    ...                                                 cell_type=nr
    ...                                                 cell_id=${cell_id}
    ${distnames_of_cells_to_block}=                     admin_info_model.get_all_cells_distnames
    ...                                                 connection=${connection}
    Remove Values From List                             ${distnames_of_cells_to_block}
    ...                                                 ${called_cell_dist_names['configuration']}

    [Return]                                            ${called_cell_dist_names}  ${distnames_of_cells_to_block}
