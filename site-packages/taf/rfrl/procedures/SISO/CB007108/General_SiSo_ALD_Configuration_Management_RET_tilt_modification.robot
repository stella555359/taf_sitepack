*** Keywords ***
General_SiSo_ALD_Configuration_Management_RET_tilt_modification
    [Documentation]
    ...   Based on QC test case:
    ...   [1][1.0] General_SiSo_ALD_Configuration_Management_RET_tilt_modification
    ...   Test verifies possibility to change RETUs tilt angles inside and outside allowed [min, max] range
    ...   for each detected RETU.

    ${connection}=                                  connections.get_default_admin_connection_alias
    config_operations.connect                       alias=${connection}
    @{retus_dist_names}=                            admin_info_model.get_retus_dist_names_for_rmods
    ...                                             connection=${connection}
    Get Current RETUs Angles Value                  retus_dist_names=@{retus_dist_names}

    FOR   ${angle_reducer}   IN RANGE  10  31  10
           Perform RETUs Tilt Modification          retus_dist_names=@{retus_dist_names}
           ...                                      angle_reducer=${angle_reducer}
    END
    
    [Teardown]                                      Run Keywords
    ...                                             Reset RETUs To Base Angles
    ...                                             retus_dist_names=@{retus_dist_names}
    ...                                             AND
    ...                                             config_operations.disconnect

Validate Current RETU Angle Value
    [Arguments]                                     ${retu_dist_name}
    ...                                             ${planned_angle}

    ${current_angle}=                               config_operations.get_parameter_value
    ...                                             dist_name=${retu_dist_name}
    ...                                             param_name=angle
    ${current_angle}=                               Evaluate  int(${current_angle})
    ${planned_angle}=                               Evaluate  int(${planned_angle})

    Should Be Equal                                 """${current_angle}"""     """${planned_angle}"""
    ...                                             msg=Current RETU angle ${current_angle} is different than planned ${planned_angle}

    Robot Log Result                                Tilt angle has been set successfully

Validate Exceeding Out Of Angle Range
    [Arguments]                                     ${retu_dist_name}
    ...                                             ${max_angle}
    ...                                             ${min_angle}

    Robot Log Operation                             Validating tilt angle exceed for values beyond [min, max] ...

    ${out_of_range_angle}=                          Evaluate    ${max_angle}+1
    Run Keyword And Expect Error    AdminApiProcedureFailureException:*Whenever RETU-*is configured, it is required that*less/equal to*
    ...                                             config_operations.set_parameter_value
    ...                                             dist_name=${retu_dist_name}
    ...                                             param_name=angle
    ...                                             param_value=${out_of_range_angle}

    ${out_of_range_angle}=                          Evaluate    ${min_angle}-1
    Run Keyword And Expect Error    AdminApiProcedureFailureException:*Whenever RETU-*is configured, it is required that*less/equal to*
    ...                                             config_operations.set_parameter_value
    ...                                             dist_name=${retu_dist_name}
    ...                                             param_name=angle
    ...                                             param_value=${out_of_range_angle}

    Robot Log Result                                System successfully prevented exceeding allowed angles

Perform RETUs Tilt Modification
    [Arguments]                                     ${retus_dist_names}
    ...                                             ${angle_reducer}

    FOR   ${retu_dist_names}   IN   @{retus_dist_names}
           ${max_angle}=                            config_operations.get_parameter_value
           ...                                      dist_name=${retu_dist_names["configuration"]}
           ...                                      param_name=maxAngle
           ${min_angle}=                            config_operations.get_parameter_value
           ...                                      dist_name=${retu_dist_names["configuration"]}
           ...                                      param_name=minAngle
           ${new_angle}=                            Evaluate  ${max_angle}-${angle_reducer}
           Robot Log Operation                      Chagning tilt angle to ${new_angle} on ${retu_dist_names["configuration"]}
           config_operations.set_parameter_value    dist_name=${retu_dist_names["configuration"]}
           ...                                      param_name=angle
           ...                                      param_value=${new_angle}
           Robot Log Operation                      Validating tilt angle on ${retu_dist_names["configuration"]} ...
           Wait Until Keyword Succeeds              2min
           ...                                      10sec
           ...                                      Validate Current RETU Angle Value
           ...                                      retu_dist_name=${retu_dist_names["runtime"]}
           ...                                      planned_angle=${new_angle}

           Validate Exceeding Out Of Angle Range    retu_dist_name=${retu_dist_names["configuration"]}
           ...                                      max_angle=${max_angle}
           ...                                      min_angle=${min_angle}

           ${new_angle}=                            Evaluate  int(${min_angle}+${angle_reducer}/2)
           Robot Log Operation                      Chagning tilt angle to ${new_angle} on ${retu_dist_names["configuration"]}
           config_operations.set_parameter_value    dist_name=${retu_dist_names["configuration"]}
           ...                                      param_name=angle
           ...                                      param_value=${new_angle}
           Robot Log Operation                      Validating tilt angle on ${retu_dist_names["configuration"]} ...
           Wait Until Keyword Succeeds              2min
           ...                                      10sec
           ...                                      Validate Current RETU Angle Value
           ...                                      retu_dist_name=${retu_dist_names["runtime"]}
           ...                                      planned_angle=${new_angle}
    END
    
Get Current RETUs Angles Value
    [Arguments]                                     ${retus_dist_names}

    FOR   ${index}   ${retu_dist_names}   IN ENUMERATE   @{retus_dist_names}
           ${current_angle}                         config_operations.get_parameter_value
           ...                                      dist_name=${retu_dist_names["configuration"]}
           ...                                      param_name=angle
           Set To Dictionary                        ${retus_dist_names[${index}]}  default_angle=${current_angle}
    END

Reset RETUs To Base Angles
    [Arguments]                                     ${retus_dist_names}

    ${base_angles_status}=                          Run Keyword And Return Status
    ...                                             Change Angles To Default  retus_dist_names=@{retus_dist_names}

    Run Keyword If  not ${base_angles_status}       Run Keywords
    ...                                             Perform recommissioning to base SCF
    ...                                             AND
    ...                                             Fail  msg=Couldn't change RETUs angles to deafult values, thus commissioning has been performed!

Change Angles To Default
    [Arguments]                                     ${retus_dist_names}
    Robot Log Operation                             Attempting to reset each RETU to base angle ...

    FOR   ${retu_dist_names}  IN  @{retus_dist_names}
           Robot Log Operation                      Chagning tilt angle to ${retu_dist_names["default_angle"]} on ${retu_dist_names["configuration"]}
           config_operations.set_parameter_value    dist_name=${retu_dist_names["configuration"]}
           ...                                      param_name=angle
           ...                                      param_value=${retu_dist_names["default_angle"]}
           Robot Log Operation                      Validating tilt angle on ${retu_dist_names["configuration"]} ...
           Wait Until Keyword Succeeds              1min
           ...                                      10sec
           ...                                      Validate Current RETU Angle Value
           ...                                      retu_dist_name=${retu_dist_names["runtime"]}
           ...                                      planned_angle=${retu_dist_names["default_angle"]}
    END