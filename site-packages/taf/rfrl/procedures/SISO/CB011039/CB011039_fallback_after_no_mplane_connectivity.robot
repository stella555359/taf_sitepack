Priv Disable All Optical links for RMOD without BTS connection
    [Arguments]      ${rmod_id}
    ...              ${rmod_optical_links_config}

    FOR  ${rmod_optical_link_config}  IN  @{rmod_optical_links_config}
        rmod_optical_switch.set_rmod_optical_link      rmod_optical_link_config=${rmod_optical_link_config}
        ...                                            destination_channel_id=${rmod_optical_link_config['channel_amount']}
    END

    Robot Log Result                               All optical links on RMOD-${rmod_id} have been enabled.

Priv Enable All Optical links for RMOD without BTS connection
    [Arguments]      ${rmod_id}
    ...              ${rmod_optical_links_config}

    FOR  ${rmod_optical_link_config}  IN  @{rmod_optical_links_config}
        rmod_optical_switch.set_rmod_optical_link      rmod_optical_link_config=${rmod_optical_link_config}
        ...                                            destination_channel_id=${rmod_optical_link_config['channel_no']}
    END

    Robot Log Result                                        All optical links on RMOD-${rmod_id} have been enabled.

