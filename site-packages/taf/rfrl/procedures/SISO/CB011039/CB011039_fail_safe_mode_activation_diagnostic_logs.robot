*** Keywords ***
CB011039_fail_safe_mode_activation_diagnostic_logs
    [Documentation]
    ...  Purpose of this test case is to check diagnostic logs after fail safe mode activation.
    ...
    ...  ARGS:
    ...  :param int rmod_id: (Mandatory) : RMOD config id of tested radio module, e.g.: 1
    ...  :param int timeout: (Optional) : timeout (in seconds) for diagnostic check report

    [Arguments]    ${rmod_id}
    ...            ${timeout}=500

    Set test variable                                       ${is_fail_safe_mode_enabled}
    ...                                                     ${False}
    ${bts_type}                                             hwpta_testline.get_type_of_setup
    ${connection}                                           connections.get_default_admin_connection_alias
    ...                                                     bts_type=${bts_type}
    ${all_rmods_ids}                                        Get all RMODs index values
    ...                                                     bts_type=${bts_type}

    Enable Fail Safe Mode and Reboot RMOD                   rmod_id=${rmod_id}
    ...                                                     bts_type=${bts_type}
    ...                                                     connection=${connection}
    Alarms.Allow X2 Link Alarms

    Priv Verify All RMODs and Cells Statuses                rmod_id_with_enabled_fail_safe_mode=${rmod_id}
    ...                                                     all_rmods_ids=${all_rmods_ids}
    ...                                                     bts_type=${bts_type}
    ...                                                     connection=${connection}

    Robot Log Operation                                     Getting RMOD diagnostic check report...
    ${diagnostic_check_report}                              Get Diagnostic Check Report
    ...                                                     connection=${connection}
    ...                                                     timeout=${timeout}
    Robot Log Result                                        Diagnostic check report: ${diagnostic_check_report}.

    Priv Verify All RMODs and Cells Statuses                rmod_id_with_enabled_fail_safe_mode=${rmod_id}
    ...                                                     all_rmods_ids=${all_rmods_ids}
    ...                                                     bts_type=${bts_type}
    ...                                                     connection=${connection}

    Robot Log Operation                                     Verifying RMOD diagnostic check report...
    Verify Check Report                                     diagnostic_check_report=${diagnostic_check_report}
    Robot Log Result                                        RMOD diagnostic check report verification finished successfully.
    ...                                                     to_console=${True}

    Disable Fail Safe Mode and Reboot RMOD                  rmod_id=${rmod_id}
    ...                                                     bts_type=${bts_type}
    ...                                                     connection=${connection}
    Wait Until Keyword Succeeds                             5min
    ...                                                     30sec
    ...                                                     Check Statuses Of RMODs And Their Cells
    ...                                                     rmods=${all_rmods_ids}
    Alarms.Disallow X2 Link Alarms

    [Teardown]  Run keywords                                Robot Log Operation
    ...                                                     Test teardown performing...
    ...         AND                                         Fail Safe Mode Activation Teardown
    ...                                                     is_fail_safe_mode_enabled=${is_fail_safe_mode_enabled}
    ...                                                     rmod_id=${rmod_id}
    ...                                                     connection=${connection}
    ...                                                     bts_type=${bts_type}

Get Diagnostic Check Report
    [Arguments]      ${connection}
    ...              ${timeout}=60

    ${diagnostic_check_report}                              diagnostic_check.get_diagnostic_check_report
    ...                                                     allow_service_impact=${True}
    ...                                                     timeout=${timeout}
    ...                                                     detailed_output=${True}
    ...                                                     connection=${connection}
    [Return]         ${diagnostic_check_report}

Verify Check Report
    [Arguments]      ${diagnostic_check_report}

    diagnostic_check.verify_if_diagnostic_check_report_contains_expected_checkpoints
    ...                                                     diagnostic_check_report=${diagnostic_check_report}
    ...                                                     expected_checkpoints=${expected_rmod_relevant_checkpoints}

Priv Verify All RMODs and Cells Statuses
    [Arguments]      ${rmod_id_with_enabled_fail_safe_mode}
    ...              ${all_rmods_ids}
    ...              ${connection}
    ...              ${bts_type}

    Robot Log Operation                                     Verifying RMODs and Their Cells statuses with impacted RMOD-${rmod_id_with_enabled_fail_safe_mode}...
    Wait Until Keyword Succeeds                             3min
    ...                                                     20sec
    ...                                                     Verify All RMODs and Their Cells Statuses with Impacted RMOD
    ...                                                     impacted_rmod_id=${rmod_id_with_enabled_fail_safe_mode}
    ...                                                     status_of_impacted_rmod=failed
    ...                                                     status_of_impacted_cells=failed
    ...                                                     all_rmods_ids=${all_rmods_ids}
    ...                                                     connection=${connection}
    ...                                                     bts_type=${bts_type}
    Robot Log Result                                        RMODs and Cells statuses validation finished successfully.
