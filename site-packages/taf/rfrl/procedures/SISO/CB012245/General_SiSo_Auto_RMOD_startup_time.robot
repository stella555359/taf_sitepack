*** Keywords ***
General_SiSo_Auto_RMOD_startup_time
    [Documentation]
    ...  This test is responsible for checking RMOD startup time. It's based on RFREQ_2255 requirement.
    ...
    ...  :param list[str] rmod_ids: (Mandatory) list of CONFIG RMOD IDs
    ...  :param str|int reset_timeout: (Optional) time in seconds to wait for RMOD reset; default is 180s

    [Arguments]                         ${rmod_ids}
    ...                                 ${reset_timeout}=180

    ${bts_type}=                        hwpta_testline.get_type_of_setup
    ${connection}=                      connections.get_default_admin_connection_alias
    ...                                 bts_type=${bts_type}
    ${credentials}                      connections.get_http_connection_credentials
    ...                                 bts_type=${bts_type}
    ${bts_host}                         Set Variable
    ...                                 ${credentials['ip']}
    ${failed_rmods}=                    Create Dictionary

    FOR   ${rmod_id}  IN  @{rmod_ids}
        ${runtime_id}                   admin_im_rfrl.translate_rmod_index_to_runtime
        ...                             rmod_index=${rmod_id}
        ...                             connection=${connection}
        ${reset_time}=                  Reset RMOD And Perform Measurement
        ...                             rmod_config_id=${rmod_id}
        ...                             rmod_runtime_id=${runtime_id}
        ...                             connection=${connection}
        ...                             bts_host=${bts_host}
        Check If Reset Time Exceeded    reset_time=${reset_time}
        ...                             expected_time=${reset_timeout}
        ...                             rmod_id=${rmod_id}
        ...                             failed_rmods=${failed_rmods}
    END

    Verify Measurements                 failed_rmods=${failed_rmods}
    ...                                 reset_time=${reset_timeout}

    [Teardown]                          Wait Until Keyword Succeeds
    ...                                 15min
    ...                                 5sec
    ...                                 Check Statuses Of All RMODs
    ...                                 bts_type=${bts_type}

Reset RMOD And Perform Measurement
    [Arguments]                         ${rmod_config_id}
    ...                                 ${rmod_runtime_id}
    ...                                 ${connection}
    ...                                 ${bts_host}

    ${rmod_runtime_distname}=           admin_im_rfrl.translate_rmod_runtime_id_to_distname
    ...                                 runtime_rmod_id=${rmod_runtime_id}
    ...                                 connection=${connection}
    ${rmod_internal_distname}=          admin_im_rfrl.translate_rmod_distname
    ...                                 rmod_distname=${rmod_runtime_distname}
    ...                                 output_distname_type=internal
    ...                                 connection=${connection}
    ${cells_per_rat}=                   admin_im_rfrl.get_cells_config_ids_for_rmod_per_rat
    ...                                 connection=${connection}
    ...                                 rmod_internal_distname=${rmod_internal_distname}

    Robot Log Operation                 Resetting RMOD-${rmod_config_id}
    admin_im_rfrl.reset_rmod_in_separate_process
    ...                                 connection=${connection}
    ...                                 runtime_rmod_id=${rmod_runtime_id}
    ...                                 connection_host=${bts_host}

    timer.wait_until_keyword_succeeds_timer
    ...                                 60s
    ...                                 3s
    ...                                 Check If Cells Are Down
    ...                                 cells_per_rat=${cells_per_rat}
    ...                                 connection=${connection}

    Robot Log Operation                 Cells are down, starting time measurement for RMOD-${rmod_config_id}
    ${start_time}=                      Get Time
    ...                                 epoch

    timer.wait_until_keyword_succeeds_timer
    ...                                 100s
    ...                                 3s
    ...                                 status_check.verify_statuses_of_rmod
    ...                                 rmod_id=${rmod_config_id}
    ...                                 status_variant=disabled
    ...                                 connection=${connection}
    timer.wait_until_keyword_succeeds_timer
    ...                                 200s
    ...                                 3s
    ...                                 status_check.verify_statuses_of_rmod
    ...                                 rmod_id=${rmod_config_id}
    ...                                 status_variant=offline
    ...                                 connection=${connection}

    ${end_time}=                        Get Time
    ...                                 epoch
    ${reset_time}=                      Evaluate
    ...                                 ${end_time} - ${start_time}
    Robot Log Result                    RMOD-${rmod_config_id} startup time: ${reset_time}s
    ...                                 to_console=${True}

    [Return]                            ${reset_time}

Check If Cells Are Down
    [Arguments]                         ${cells_per_rat}
    ...                                 ${connection}

    FOR  ${rat}  IN  @{cells_per_rat}
        Check specific statuses for specific cells
        ...                             cell_ids=${cells_per_rat['${rat}']}
        ...                             cell_type=${rat}
        ...                             connection=${connection}
        ...                             operational_state=disabled
    END

Check If Reset Time Exceeded
    [Arguments]                         ${reset_time}
    ...                                 ${expected_time}
    ...                                 ${rmod_id}
    ...                                 ${failed_rmods}

    Run Keyword If                      ${reset_time} > ${expected_time}
    ...                                 Set To Dictionary  ${failed_rmods}   RMOD-${rmod_id}   ${reset_time}s

Verify Measurements
    [Arguments]                         ${failed_rmods}
    ...                                 ${reset_time}

    ${formatted_failed_rmods}=          Evaluate  '\\n'.join([f'- {key}: {value}' for key, value in ${failed_rmods}.items()])

    Should Be Empty                     ${failed_rmods}
    ...                                 msg=Some RMODs exceeded the reset timeout of ${reset_time}s: \n${formatted_failed_rmods}

    Robot Log Result                    All RMODs successfully started up within the reset timeout of ${reset_time}s
    ...                                 to_console=${True}
