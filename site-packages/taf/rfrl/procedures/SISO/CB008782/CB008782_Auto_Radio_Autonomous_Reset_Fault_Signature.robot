Library     taf.sbts.oam.coam.admin                                                                 WITH NAME   sbts_admin

Library     taf.ul.bts_components.invoke_shell.InvokeShellHandler.InvokeSshHandler                  WITH NAME   invoke_shell
Library     taf.rfrl.procedures.resources.python.alarms.AlarmsManager.AlarmsManager                 WITH NAME   alarms_manager
Library     taf.rfrl.procedures.resources.python.testline.TestLine.TestLine                         WITH NAME   hwpta_testline
Library     taf.rfrl.procedures.resources.python.connections                                        WITH NAME   connections
Library     taf.rfrl.procedures.resources.python.admin_info_model.admin_info_model

Resource    taf/rfrl/procedures/resources/robot/Alarms.robot
Resource    taf/rfrl/procedures/resources/robot/HWPTA_Logger.robot
Resource    taf/rfrl/bts/robot/gnb.robot


*** Keywords ***
CB008782_Auto_Critical_File_Not_Found_Fault_Signature
    [Documentation]     Test case verifies appearance of "EFaultId_FrCriticalFileNotFound" alarm after deleting calibration_dlpath1.bin file.
    ...     Args:
    ...                 - container - FHNET container address to which to connect (0x1018 or 0x2018), defaults to 0x2018
    [Arguments]                                     ${container}=0x2018

    ${rmods_configs}=                               hwpta_testline.Get Radios Configs
    Alarms.Allow alarm                              fault_id=1901
    Alarms.Allow alarm                              fault_id=10

    FOR    ${rmod_config}    IN    @{rmods_configs}
        Trigger 1901                                ${rmod_config}
        ...                                         ${container}
        Wait for alarms 1901 to appear              rmod_serial_number=${rmod_config.serial_number}
        Recovery from 1901                          ${rmod_config}
        ...                                         ${container}
        Wait for alarms 1901 to disappear
    END

    [Teardown]                                      Run keywords
    ...                                             Teardown For Fault 1901
    ...                                             ${rmods_configs}
    ...                                             ${container}
    ...                                             AND
    ...                                             Wait Until Keyword Succeeds
    ...                                             9 min
    ...                                             10 sec
    ...                                             gnbcell.Verify All Cells are OnAir
    ...                                             AND
    ...                                             Alarms.Disallow alarm
    ...                                             fault_id=1901
    ...                                             AND
    ...                                             Alarms.Disallow alarm
    ...                                             fault_id=10

Teardown For Fault 1901
    [Arguments]             ${rmods_configs}
    ...                     ${container}

    @{alarm_list}=                                  alarms_manager.get_active_alarms
    ${rmods_serials_with_fid_1901}=                 Create list
    Robot Log Operation                             Teardown...

    FOR     ${alarm}            IN          @{alarm list}
        run keyword if                              ${alarm.fault_id} == 1901
        ...                                         Update List Of Rmods With Fault 1901
        ...                                         ${rmods_serials_with_fid_1901}
        ...                                         ${alarm}
    END

    FOR    ${rmod_config}    IN                     @{rmods_configs}
        ${serial_exists}=    Evaluate               $rmod_config.serial_number in $rmods_serials_with_fid_1901
        Run keyword if                              ${serial_exists}
        ...                                         Run keywords
        ...                                         Recovery from 1901
        ...                                         ${rmod_config}
        ...                                         ${container}
        ...                                         AND
        ...                                         Wait for alarms 1901 to disappear
    END

Update List Of Rmods With Fault 1901
    [Arguments]             ${rmods_serials_with_fid_1901}
    ...                     ${alarm}
    ${setup_type}=                                  hwpta_testline.get_type_of_setup
    ${connection}=                                  connections.get_default_admin_connection_alias
    ...                                             bts_type=${setup_type}
    ${serial}=                                      admin_info_model.get_serial_number_for_rmod
    ...                                             ${connection}
    ...                                             ${alarm.unit_path.split('-')[-1]}
    Append to List                                  ${rmods_serials_with_fid_1901}
    ...                                             ${serial}

Wait for alarms 1901 to appear
    [Arguments]                                     ${rmod_serial_number}
    ...                                             ${timeout}=20min
    Robot Log Operation                             Waiting for FID 1901 to appear
    ${setup_type}=                                  hwpta_testline.get_type_of_setup
    ${connection}=                                  connections.get_default_admin_connection_alias
    ${sw_version}=                                  sbts_admin.get_sw_version
    ...                                             connection=${connection}
    &{fault_signature}=                             Create Dictionary
    ...                                             category=SW_FAILURE
    ...                                             loadName=${sw_version}
    ...                                             scope=RFM
    ...                                             component=${rmod_serial_number}
    ${1901_autonomus_alarm_active}=                 Wait for active alarm
    ...                                             timeout=${timeout}
    ...                                             fault_id=1901
    ...                                             fault_name=Radio autonomous reset as recovery action
    ...                                             fault_signature=${fault_signature}
    Should be True                                  ${1901_autonomus_alarm_active}
    Verify Date and Reset Counter in Fault Signature Not Empty
    ...                                             fault_id=1901
    ...                                             fault_name=Radio autonomous reset as recovery action
    ${1901_file_not_found_alarm_active}=            Wait for active alarm
    ...                                             timeout=${timeout}
    ...                                             fault_id=1901
    ...                                             fault_name=RF Module critical file not found
    Should be True                                  ${1901_file_not_found_alarm_active}

Wait for alarms 1901 to disappear
    [Arguments]                                     ${timeout}=10min
    Robot Log Operation                             Waiting for FID 1901 to disappear
    ${1901_alarm_inactive}=                         Wait for inactive alarm
    ...                                             timeout=${timeout}
    ...                                             fault_id=1901
    Should be True                                  ${1901_alarm_inactive}

Trigger 1901
    [Arguments]                                     ${rmod_config}
    ...                                             ${container}
    Robot Log Operation                             Triggering FID 1901
    ${rmod_login_data}=                             connections.get_details_to_login_via_rmod_config
    ...                                             rmod_config=${rmod_config}
    invoke_shell.connect_to_rmod                    ip=${rmod_login_data['address']}
    ...                                             username=${rmod_login_data['username']}
    ...                                             password=${rmod_login_data['password']}
    ...                                             container=${container}
    invoke_shell.send_command_and_return_output     command=sudo mount -o remount rw /mnt/factory
    invoke_shell.send_command_and_return_output     command=sudo mv /mnt/factory/configs/unit/calibration_dlpath1.bin /mnt/factory/configs/unit/temp_filename
    Robot Log Operation                             Rebooting rmod...
    invoke_shell.send_command_and_return_output     command=sudo reboot

Recovery from 1901
    [Arguments]                                     ${rmod_config}
    ...                                             ${container}
    Robot Log Operation                             Recovering from FID 1901
    ${rmod_login_data}=                             connections.get_details_to_login_via_rmod_config
    ...                                             rmod_config=${rmod_config}
    invoke_shell.connect_to_rmod                    ip=${rmod_login_data['address']}
    ...                                             username=${rmod_login_data['username']}
    ...                                             password=${rmod_login_data['password']}
    ...                                             container=${container}
    invoke_shell.send_command_and_return_output     command=sudo mount -o remount rw /mnt/factory
    invoke_shell.send_command_and_return_output     command=sudo mv /mnt/factory/configs/unit/temp_filename /mnt/factory/configs/unit/calibration_dlpath1.bin
    invoke_shell.send_command_and_return_output     command=sudo reboot
