*** Keywords ***
Online Cell addition deletion
    [Arguments]    ${cell_id_to_delete}    ${cell_id_to_copy_from}    ${cell_group_id_to_delete}
    ...    ${tput_dl}    ${tput_ul}    ${tput_dl_without_cell}     ${tput_ul_without_cell}
    ...    ${capabilities}    ${duration}    ${ue_alias}=UE    ${protocol}=udp    ${require_ue}=True    ${deviation}=25%
    ...    ${deviation_dl}=${deviation}    ${deviation_ul}=${deviation}    ${parallel_streams_dl}=1    ${parallel_streams_ul}=1
    ...    ${size_packet}=1400B    ${size_packet_dl}=${size_packet}    ${size_packet_ul}=${size_packet}    ${buffer_client_dl}=${None}
    ...    ${buffer_client_ul}=${None}    ${buffer_server_dl}=${None}    ${buffer_server_ul}=${None}   ${interval}=1
    ...    ${linux_congestion_dl}=${None}    ${reboot_ue}=False   ${timeout_reboot_ue}=100
    custom_logger.log info to console    Online Cell addition deletion
    custom_logger.log info to console    Prepare UE for L3 call     log_hierarchy=2
    Run Keyword If    ${require_ue}==True    Prepare Ue for L3 Call    capabilities=${capabilities}    reboot_ue=${reboot_ue}
    ...    timeout_reboot_ue=${timeout_reboot_ue}    alias=${ue_alias}
    custom_logger.log info to console    Verify L3 call    log_hierarchy=2
    Verify L3 Call Data Transfer DL&UL    duration=${duration}    tput_dl=${tput_dl}    tput_ul=${tput_ul}
    ...    protocol=${protocol}    deviation_dl=${deviation_dl}    deviation_ul=${deviation_ul}
    ...    parallel_streams_dl=${parallel_streams_dl}    parallel_streams_ul=${parallel_streams_ul}
    ...    size_packet_dl=${size_packet_dl}    size_packet_ul=${size_packet_ul}    buffer_client_dl=${buffer_client_dl}
    ...    buffer_server_dl=${buffer_server_dl}    buffer_client_ul=${buffer_client_ul}    buffer_server_ul=${buffer_server_ul}
    ...    interval=${interval}  linux_congestion_dl=${linux_congestion_dl}    alias=${ue_alias}

    ${number_of_cells}    gnbcell.get_number_of_cells
    ${number_of_cells_after_removal}    get_number_of_cells_after_cell_removal    number_of_cells_before_removal=${number_of_cells}
    ...                                                                      cell_id_to_delete=${cell_id_to_delete}
    ${cell_info}=  Get Cell Parameters     cell_id=${cell_id_to_delete}
    ${power_saving_cell_list}              gnbcombinedcell.get_power_saving_cell_list

    custom_logger.log info to console    Remove CELL-${cell_id_to_delete} from configuration    log_hierarchy=2
    custom_logger.log info to console    Starting removal of cell    log_hierarchy=3
    gnbcombinedcell.Remove Cell From Configuration    cell_id=${cell_id_to_delete}
    ...                               cell_group_id=${cell_group_id_to_delete}
    ...                               power_saving_cell_list=${power_saving_cell_list}
    custom_logger.log info to console    CELL-${cell_id_to_delete} removal complete    log_hierarchy=3
    Run Keyword And Continue On Failure        gnbcell.verify_all_cells_are_onair    expected_cell_amount=${number_of_cells_after_removal}
    custom_logger.log info to console    Verifing L3 call after cell removed    log_hierarchy=3
    Run Keyword And Continue On Failure        Verify L3 Call Data Transfer DL&UL
    ...    duration=${duration}    tput_dl=${tput_dl_without_cell}    tput_ul=${tput_ul_without_cell}
    ...    protocol=${protocol}    deviation_dl=${deviation_dl}    deviation_ul=${deviation_ul}
    ...    parallel_streams_dl=${parallel_streams_dl}    parallel_streams_ul=${parallel_streams_ul}
    ...    size_packet_dl=${size_packet_dl}    size_packet_ul=${size_packet_ul}    buffer_client_dl=${buffer_client_dl}
    ...    buffer_server_dl=${buffer_server_dl}    buffer_client_ul=${buffer_client_ul}    buffer_server_ul=${buffer_server_ul}
    ...    interval=${interval}    linux_congestion_dl=${linux_congestion_dl}    alias=${ue_alias}

    custom_logger.log info to console    Add CELL-${cell_id_to_delete} to configuration    log_hierarchy=2
    custom_logger.log info to console    Starting addition of cell    log_hierarchy=3
    gnbcombinedcell.Add New Cell Based On Existing Cell To Configuration  ${cell_info}
    ...                                                   ${cell_id_to_copy_from}
    ...                                                   nrcell_include_subobject=${True}
    ...                                                   group_id=${cell_group_id_to_delete}
    ...                                                   power_saving_cell_list=${power_saving_cell_list}
    custom_logger.log info to console    Cell addition complete    log_hierarchy=2
    gnbcell.verify_all_cells_are_onair    expected_cell_amount=${number_of_cells}
    custom_logger.log info to console    Verifing L3 call after cell added    log_hierarchy=3
    Verify L3 Call Data Transfer DL&UL    duration=${duration}    tput_dl=${tput_dl}    tput_ul=${tput_ul}
    ...    protocol=${protocol}    deviation_dl=${deviation_dl}    deviation_ul=${deviation_ul}
    ...    parallel_streams_dl=${parallel_streams_dl}    parallel_streams_ul=${parallel_streams_ul}
    ...    size_packet_dl=${size_packet_dl}    size_packet_ul=${size_packet_ul}    buffer_client_dl=${buffer_client_dl}
    ...    buffer_server_dl=${buffer_server_dl}    buffer_client_ul=${buffer_client_ul}    buffer_server_ul=${buffer_server_ul}
    ...    interval=${interval}    linux_congestion_dl=${linux_congestion_dl}    alias=${ue_alias}
