Library     taf.rfrl.utilities.logger.custom_logger             WITH NAME    logger
Library     custom_resources.py


*** Keywords ***
Run ESM Measurement Procedure
    [Documentation]
    ...  Measure ESM Procedure in loop for OnAirBefore,ESM1,ESM2,OnAirAfter test states.
    ...    ESM1 enables Energy Saving Mode for all defined power groups(NRPGRP and PSGRP)
    ...    ESM2 in comparison to ESM1 additinaly enable DEEPSLEEP for all RUs(if supports DEEPSEEP mode)
    ...  :param str connection: (Mandatory) : Admin connection alias.
    ...  :param str test_states: (Optional) : Test states separated by comma, default OnAirBefore,ESM1,ESM2,OnAirAfter
    ...  :param configuration_yaml_file: path to configuration yaml file providing details parameters for ESM1 & ESM2 states.
    ...                                 Check README file for more details about configuration file structure.
    ...  :param int measurement_duration: (Optional) : duration of the test in seconds, default 75 minutes each loop.
    ...  :param bool report_kpi: (Optional) : if True, KPI will be reported after each test state loop, default True.
    ...                                       Could be set to False for quick test execution without reporting.

    [Arguments]  ${connection}
    ...          ${configuration_yaml_file}
    ...          ${test_states}=OnAirBefore,ESM1,ESM2,OnAirAfter
    ...          ${measurement_duration}=4500
    ...          ${report_kpi}=${True}
    [Timeout]    24 hours

    ${test_states}                            Evaluate      "${test_states}".split(',')

    ${detailed_bts_info}    Get Detailed BTS info           connection=${connection}
    Backup Initial SCF                                      connection=${connection}
    logger.Log Info to Console          Executing ESM Procedure with the following test modes: ${test_states}


    FOR    ${test_state}    IN    @{test_states}
        logger.Log Info to Console                          START Loop for ${test_state}
        ...                                                 log_hierarchy=2

        Go to Proper State
        ...                                                 connection=${connection}
        ...                                                 test_state=${test_state}
        ...                                                 configuration_yaml_file=${configuration_yaml_file}


        logger.Log Info to Console                          Get EE Counters before
        ...                                                 log_hierarchy=3
        ${counters_before}                                  Wait Until Keyword Succeeds    3x    1 min
        ...                                                 Get EE Counters             connection=${connection}

        logger.Log Info to Console                          Check Cells and RUs Statuses Stable during measurement period of ${measurement_duration} seconds
        ...                                                 log_hierarchy=3
        Check Cells and RUs Statuses Stable                 connection=${connection}
        ...                                                 duration=${measurement_duration}

        ${cells_statuses}    ${rus_statuses}                Get Params to Reporting
        ...                                                 connection=${connection}

        logger.Log Info to Console                          Get EE Counters after
        ...                                                 log_hierarchy=3
        ${counters_after}    Get EE Counters                connection=${connection}

        logger.Log Info to Console                          Calculate and Report EE KPI
        ...                                                 log_hierarchy=3

        IF    ${report_kpi}
            Report ESM KPI                                  esm_counters_before=${counters_before}
            ...                                             esm_counters_after=${counters_after}
            ...                                             cells_statuses=${cells_statuses}
            ...                                             rus_statuses=${rus_statuses}
            ...                                             test_state=${test_state}
            ...                                             detailed_bts_info=${detailed_bts_info}
        END

        logger.Log Info to Console                          END Loop for ${test_state}
    ...                                                     log_hierarchy=2
    END
    logger.Log Info to Console    ESM Procedure with the following test modes: ${test_states} have finished successfully.
    
    [Teardown]    Recommission to Initial State             connection=${connection}
