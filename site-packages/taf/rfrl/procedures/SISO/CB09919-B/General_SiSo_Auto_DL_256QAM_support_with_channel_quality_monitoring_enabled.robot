*** Keywords ***
General_SiSo_Auto_DL_256QAM_support_with_channel_quality_monitoring_enabled
    [Documentation]
    ...         The purpose of this test case is verification if DL 256QAM support when channel quality monitoring is enabled.
    ...         Test Case is responsible for checking attach and veryfying data transfer in one direction (DL) on LTE SA testlines.
    ...		    L3 Call is being performed on every available cell in setup two times - first with duration set in first_throughput_duration
    ...	        parameter and second set in second_throughput_duartion with tputs set in first_throughput_value and second_throughput_velue parameters.
    ...
    ...             ARGS:
    ...              - first_throuhgput_duration and second_throughput_duartion: for example 60 s
    ...              - first_throughput_value and second_throughput_value: dict with throughput and deviation values for each cell identified by
    ...                             it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells.
    ...                             Example:
    ...                             {
    ...                                 '827736065':
    ...                                      {
    ...                                          'throughput':
    ...                                              {
    ...                                                  'downlink': '100 Mbits/sec',
    ...                                                  'uplink': '0 Mbits/sec'
    ...                                              },
    ...                                          'deviation': '90%'
    ...                                      },
    ...                             }
    ...
    ...              - protocol: data transfer protocol; defaults to UDP.
    ...              - udp_buffer: monitoring data buffer; defaults to 4M.
    ...              - tput_verification_via_btslog: True - throughput verification will be performed using btslog
    ...                                              False - throuput verification will be performed using iperf; defaults to False.

    [Arguments]                                        ${first_throughput_value}
    ...                                                ${first_throughput_duration}
    ...                                                ${second_throughput_value}
    ...                                                ${second_throughput_duration}
    ...                                                ${protocol}=udp
    ...                                                ${udp_buffer}=4M
    ${bts_type}=                                       hwpta_testline.get_type_of_setup
    ${connection}=                                     connections.get_default_admin_connection_alias
    ...                                                bts_type=${bts_type}
    @{called_cells}=                                   admin_info_model.get_configuration_distnames_of_all_cells
    ...                                                connection=${connection}

    Robot Log Operation                                Starting first L3 call...

    FOR    ${called_cell}  IN  @{called_cells}
       Start L3 Call In Background                     called_cell=${called_cell}
       ...                                             direction=DL
       ...                                             duration=${first_throughput_duration}
       ...                                             throughputs=${first_throughput_value}
       ...                                             protocol=${protocol}
       ...                                             udp_buffer=${udp_buffer}
       Verify Background L3 Call Results               called_cell=${called_cell}
    END

    Robot Log Operation                                Starting second L3 call...

    FOR    ${called_cell}  IN  @{called_cells}
        Start L3 Call In Background                     called_cell=${called_cell}
        ...                                             direction=DL
        ...                                             duration=${second_throughput_duration}
        ...                                             throughputs=${second_throughput_value}
        ...                                             protocol=${protocol}
        ...                                             udp_buffer=${udp_buffer}
        Verify Background L3 Call Results               called_cell=${called_cell}
    END

    Check BTS state and all RATs states                bts_type=${bts_type}
    Wait Until Keyword Succeeds                        5min
    ...                                                5sec
    ...                                                Check all BBMODs RMODs and cells states for all RATs
    ...                                                bts_type=${bts_type}
