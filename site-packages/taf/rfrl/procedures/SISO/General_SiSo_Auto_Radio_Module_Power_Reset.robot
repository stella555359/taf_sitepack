*** Keywords ***
General_SiSo_Auto_Radio_Module_Power_Reset
    [Documentation]
    ...             !!! IMPORTANT !! When executing test case with L3 call, if your testline is connected to programmable
    ...                              attenuator please ensure that all relevant ports are unattenuated as this test case
    ...                              will not handle attenuation.
    ...              ARGS:
    ...              - called_cells_distnames: CONFIGURATION distnames of cells that will be called, if not given,
    ...                             list of all cells on testline will be determined and called
    ...              - throughputs: dict with throughput and deviation values for each cell identified by
    ...                             it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells;
    ...                             defaults to None (L3 call will not be executed).
    ...                             Example:
    ...                             {
    ...                                 '827736065':
    ...                                      {
    ...                                          'throughput':
    ...                                              {
    ...                                                  'downlink': '100 Mbits/sec',
    ...                                                  'uplink': '15 Mbits/sec'
    ...                                              },
    ...                                          'deviation': '90%'
    ...                                      },
    ...                             }
    ...              - protocol: data transfer protocol; defaults to UDP.
    ...              - udp_buffer: monitoring data buffer; defaults to 4M.
    ...              - tput_verification_via_btslog: True - throughput verification will be performed using btslog
    ...                                          False - throuput verification will be performed using iperf; defaults to False
    ...              - ue_network_modes: dict with UE serial numbers and desired network modes e.g. {"SN1234": "NR_only"}
    ...                                  possible UE network modes: NR_only, LTE_only, NR_LTE
    ...                                  when using more than one UE please make sure that the modes you choose are either all
    ...                                  with "_only" suffix or all "NR_LTE" as it is not yet possible to mix those.
    ...                                  mandatory for SA+NSA setups, defaults to None
    ...              - verify_fault_4589: boolean value; if set to True verification whether fault 4589 is present
    ...                                   after RMOD is turned ON will be performed, defaults to False
    ...              - ues_and_cells: dict with UE serial numbers and lists of configuration distnames of cells to which they
    ...                               can be attached e.g. {"SN1234": ["MRBTS-50146/NRBTS-1/NRCELL-1", "MRBTS-50146/NRBTS-1/NRCELL-3"],
    ...                                                     "SN5678": ["MRBTS-50146/NRBTS-1/NRCELL-5"]}
    ...                               defaults to ${None} which means that all UEs will be attached to all cells.
    ...                               when given, listed cells will be called in pairs with specified UEs, if there are more
    ...                               cells on the setup that were not mentioned in the list, they will be called with all UEs
    ...               - ignored_cells_on_preparation: SHOULD BE USED WITH `prepare_cells_to_call` set to True!
    ...                                               list of cells CONFIGURATION distnames that should be ignored during
    ...                                               L3 Call not called cells preparation procedure and not be blocked/barred

    [Arguments]                                         ${called_cells_distnames}=${None}
    ...                                                 ${throughputs}=${None}
    ...                                                 ${protocol}=udp
    ...                                                 ${udp_buffer}=4M
    ...                                                 ${tput_verification_via_btslog}=${False}
    ...                                                 ${ue_network_modes}=${None}
    ...                                                 ${verify_fault_4589}=${False}
    ...                                                 ${ues_and_cells}=${None}
    ...                                                 ${ignored_cells_on_preparation}=${None}

    ${bts_type}=                                        hwpta_testline.get_type_of_setup

    run keyword if                                      ${throughputs}
    ...                                                 Execute L3 call
    ...                                                 cells_distnames=${called_cells_distnames}
    ...                                                 throughputs=${throughputs}
    ...                                                 protocol=${protocol}
    ...                                                 udp_buffer=${udp_buffer}
    ...                                                 tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                                 ue_network_modes=${ue_network_modes}
    ...                                                 ues_and_cells=${ues_and_cells}
    ...                                                 ignored_cells_on_preparation=${ignored_cells_on_preparation}

    Power Off All RMODs And Verify Required States      bts_type=${bts_type}
    Power On All RMODs And Verify Required States       bts_type=${bts_type}
    ...                                                 verify_fault_4589=${verify_fault_4589}

    run keyword if                                      ${throughputs}
    ...                                                 Execute L3 call
    ...                                                 cells_distnames=${called_cells_distnames}
    ...                                                 throughputs=${throughputs}
    ...                                                 protocol=${protocol}
    ...                                                 udp_buffer=${udp_buffer}
    ...                                                 tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                                 ue_network_modes=${ue_network_modes}
    ...                                                 ues_and_cells=${ues_and_cells}
    ...                                                 ignored_cells_on_preparation=${ignored_cells_on_preparation}

    [Teardown]                                          Run Keywords
    ...                                                 Power On All RMODs And Verify Required States
    ...                                                 bts_type=${bts_type}
    ...                                                 AND
    ...                                                 Disallow DSS Alarms If DSS On Any RMOD
    ...                                                 bts_type=${bts_type}

Power Off All RMODs And Verify Required States
    [Arguments]                                         ${bts_type}
    Allow Alarms Before Power Off All Rmods             bts_type=${bts_type}
    Power off all rmods                                 bts_type=${bts_type}
    Robot Log Step                                      Waiting for 'No connection to unit' alarms to become active...
    ${is_alarm_active}                                  Wait for active alarm
    ...                                                 timeout=300
    ...                                                 fault_name=No connection to unit
    ...                                                 fault_id=10
    ...                                                 bts_type=${bts_type}
    Should Be True                                      ${is_alarm_active}
    ...                                                 msg='No connection to unit' alarm is not active
    ${count_of_rus}                                     hwpta_testline.get_count_of_radios
    ...                                                 bts_type=${bts_type}
    Wait for number of active alarms                    expected_number_of_alarms=${count_of_rus}
    ...                                                 timeout=80s
    ...                                                 fault_name=No connection to unit
    ...                                                 fault_id=10
    ...                                                 bts_type=${bts_type}

    Robot Log Step                                      Checking if all RMODs are disabled...
    ${connection}=                                      connections.get_default_admin_connection_alias
    ...                                                 bts_type=${bts_type}
    status_check.verify_statuses_of_all_rmods           connection=${connection}
    ...                                                 status_variant=disabled
    @{all_rmod_ids}=                                    Get all RMODs index values
    ...                                                 bts_type=${bts_type}
    Check statuses of all cells for powered off RMODs   all_rmod_ids=@{all_rmod_ids}
    ...                                                 bts_type=${bts_type}

Power On All RMODs And Verify Required States
    [Arguments]                                         ${bts_type}
    ...                                                 ${verify_fault_4589}=${False}
    Power on all rmods                                  bts_type=${bts_type}
    Run keyword if                                      ${verify_fault_4589}
    ...                                                 Verify 4589 Is Present
    ...                                                 bts_type=${bts_type}
    Robot Log Step                                      Waiting for 'No connection to unit' alarms to become inactive...
    ${is_alarm_inactive}                                Wait for inactive alarm    timeout=360
    ...                                                 fault_name=No connection to unit
    ...                                                 fault_id=10
    ...                                                 bts_type=${bts_type}
    Should Be True                                      ${is_alarm_inactive}
    ...                                                 msg='No connection to unit' alarm is still active
    Alarms.Disallow alarm                               fault_name=No connection to unit
    ...                                                 fault_id=10
    ...                                                 bts_type=${bts_type}
    Alarms.Disallow alarm                               fault_id=2002
    ...                                                 bts_type=${bts_type}
    Alarms.Disallow alarm                               fault_id=1972
    ...                                                 bts_type=${bts_type}
    Alarms.Wait for inactive alarm                      fault_id=4589
    ...                                                 bts_type=${bts_type}
    ...                                                 timeout=120
    Alarms.Disallow alarm                               fault_id=4589
    ...                                                 bts_type=${bts_type}
    Alarms.Disallow alarm                               fault_id=1815
    ...                                                 bts_type=GNB
    Alarms.Disallow alarm                               fault_id=1815
    ...                                                 bts_type=ENB
    Robot Log Step                                      Waiting for all RMODs to become operational...
    Wait Until Keyword Succeeds    5min    10s          Check all BBMODs RMODs and cells states for all RATs
    ...                                                 bts_type=${bts_type}
    Wait Until Keyword Succeeds    2min    10s          Check BTS state and all RATs states
    ...                                                 bts_type=${bts_type}
    Disallow Alarms After RMOD Power ON                 bts_type=${bts_type}
    

Verify 4589 Is Present
    [Arguments]                                         ${bts_type}=GNB
    ${setup_type}=                                      hwpta_testline.get_type_of_setup
    ${connection}=                                      connections.get_default_admin_connection_alias
    ${sw_version}=                                      sbts_admin.get_sw_version
    ...                                                 connection=${connection}
    &{fault_signature}=                                 Create Dictionary
    ...                                                 category=POWER_OFF
    ...                                                 loadName=${sw_version}
    ...                                                 scope=RFM
    timer.wait_until_keyword_succeeds_timer             5m
    ...                                                 20s
    ...                                                 Wait for 4589 Alarm
    ...                                                 fault_signature=${fault_signature}
    Verify Date and Reset Counter in Fault Signature Not Empty
    ...                                                 fault_id=4589

Wait for 4589 Alarm
    [Arguments]                                         ${fault_signature}
    ...                                                 ${bts_type}=GNB
    ${is_alarm_active}=                                 Wait for active alarm
    ...                                                 fault_id=4589
    ...                                                 fault_signature=${fault_signature}
    ...                                                 bts_type=${bts_type}
    should be true                                      ${is_alarm_active}
