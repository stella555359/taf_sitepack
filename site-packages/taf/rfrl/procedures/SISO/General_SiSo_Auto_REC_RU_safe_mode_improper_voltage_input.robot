Trigger faults 2920 and 2919 and clear by re-setting proper voltage
    [Arguments]                                   ${rmod_id}
    ...                                           ${connection}
    ...                                           ${too_low_voltage}
    ...                                           ${too_high_voltage}
    ...                                           ${average_voltage}
    ...                                           ${throughputs}
    ...                                           ${protocol}
    ...                                           ${udp_buffer}
    ...                                           ${tput_verification_via_btslog}
    ...                                           ${ue_network_modes}
    ...                                           ${ignored_cells_on_preparation}
    ...                                           ${switch_to_rfsw_user}

    ${fault_ids}=                                    Create List    2920    2919
    FOR    ${fault_id}    IN    @{fault_ids}
        ${voltage}=                               Set Variable If    '''${fault_id}'''=='''2919'''
        ...                                       ${too_high_voltage}
        ...                                       ${too_low_voltage}

        Trigger fault                             fault_id=${fault_id}
        ...                                       voltage=${voltage}
        ...                                       rmod_id=${rmod_id}
        ...                                       connection=${connection}
        ...                                       switch_to_rfsw_user=${switch_to_rfsw_user}

        Clear fault by setting proper voltage value
        ...                                       fault_id=${fault_id}
        ...                                       voltage=${average_voltage}
        ...                                       rmod_id=${rmod_id}
        ...                                       connection=${connection}
        ...                                       switch_to_rfsw_user=${switch_to_rfsw_user}

        Check statuses and execute L3 Call        throughputs=${throughputs}
        ...                                       protocol=${protocol}
        ...                                       udp_buffer=${udp_buffer}
        ...                                       tput_verification_via_btslog=${tput_verification_via_btslog}
        ...                                       ue_network_modes=${ue_network_modes}
        ...                                       ignored_cells_on_preparation=${ignored_cells_on_preparation}
    END


Trigger fault 2919 and 2920 then clear via WebEM parameter changing
    [Arguments]                                   ${rmod_id}
    ...                                           ${connection}
    ...                                           ${too_low_voltage}
    ...                                           ${too_high_voltage}
    ...                                           ${average_voltage}
    ...                                           ${switch_to_rfsw_user}
    ${fault_ids}=                                 Create List    2919    2920
    FOR    ${fault_id}    IN    @{fault_ids}
        Robot Log Operation                       Triggering fault ${fault_id} on RMOD-${rmod_id} and clearing it by changing parameter value in WebEM
        IF   '''${fault_id}'''=='''2919'''
            Trigger fault                         fault_id=2919
            ...                                   voltage=${too_high_voltage}
            ...                                   rmod_id=${rmod_id}
            ...                                   connection=${connection}
            ...                                   switch_to_rfsw_user=${switch_to_rfsw_user}
        ELSE
            Trigger fault                         fault_id=2920
            ...                                   voltage=${too_low_voltage}
            ...                                   rmod_id=${rmod_id}
            ...                                   connection=${connection}
            ...                                   switch_to_rfsw_user=${switch_to_rfsw_user}
        END

        rmod_operations.execute_ssh_command       rmod_id=${rmod_id}
        ...                                       command=rad -mw 0x110032 ${average_voltage}
        ...                                       connection=${connection}
        ...                                       switch_to_rfsw_user=${switch_to_rfsw_user}

        IF   '''${fault_id}'''=='''2919'''
            Robot Log Operation                       Changing alVoltHighThreshold value to 120%
            config_operations.set_parameter_value     dist_name=MRBTS-{}/EQM-1/APEQM-1/RMOD-${rmod_id}
            ...                                       param_name=alVoltHighThreshold
            ...                                       param_value=120
        ELSE
            Robot Log Operation                       Changing alVoltLowThreshold value to -120%
            config_operations.set_parameter_value     dist_name=MRBTS-{}/EQM-1/APEQM-1/RMOD-${rmod_id}
            ...                                       param_name=alVoltLowThreshold
            ...                                       param_value=-120
        END

        Robot Log Operation                       Waiting for fault ID ${fault_id} to disappear from RMOD-${rmod_id}
        ${is_alarm_inactive}=                     Alarms.Wait for inactive alarm
        ...                                       fault_id=${fault_id}
        ...                                       timeout=90
        Should be true                            ${is_alarm_inactive}
        ...                                       msg=Fault ID ${fault_id} did not disappear!

        Wait Until Keyword Succeeds               10min
        ...                                       10s
        ...                                       Check all BBMODs RMODs and cells states for all RATs
    END


