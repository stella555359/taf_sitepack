Set and return new thresholds
    [Arguments]                                   ${rmod_id}
    ...                                           ${initial_values}
    ...                                           ${mrbts_id}
    ${new_low_threshold}=                         Evaluate     ${initial_values}[alVoltLowThreshold] - 1
    ${new_high_threshold}=                        Evaluate     ${initial_values}[alVoltHighThreshold] + 1
    ${new_unstable_threshold}=                    Evaluate     ${initial_values}[alVoltUnstableThreshold] + 1

    ${new_parameters}=                            Create Dictionary
    ...                                           alVoltLowThreshold=${new_low_threshold}
    ...                                           alVoltHighThreshold=${new_high_threshold}
    ...                                           alVoltUnstableThreshold=${new_unstable_threshold}

    config_operations.set_parameters_values       dist_name=MRBTS-${mrbts_id}/EQM-1/APEQM-1/RMOD-${rmod_id}
    ...                                           alVoltLowThreshold=${new_low_threshold}
    ...                                           alVoltHighThreshold=${new_high_threshold}
    ...                                           alVoltUnstableThreshold=${new_unstable_threshold}
    [Return]                                      ${new_parameters}


