Get average voltage for RMOD
    [Arguments]                                   ${connection}
    ...                                           ${rmod_id}
    config_operations.set_parameter_value         dist_name=MRBTS-{}/MNL-1/MNLENT-1/FEATCADM-1
    ...                                           param_name=actPowerMeter
    ...                                           param_value=true
    Robot Log Operation                           Getting average voltage for RMOD-${rmod_id} from real-time measurements
    ${measurements}=                              real_time_counters.get_real_time_measurements_list
    ...                                           number_of_iterations=${3}
    ...                                           connection=${connection}

    ${average_voltage}=                           real_time_counters.get_average_value_of_real_time_measurement
    ...                                           measurements=${measurements}
    ...                                           module_name=ENERGY_EFFICIENCY/RMOD/RMOD_R-${rmod_id}
    ...                                           value_name=voltage
    ${average_voltage}=                           Evaluate    ${average_voltage} * 1000
