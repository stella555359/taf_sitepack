Trigger unstable voltage alarm and clear by RMOD reset
    [Arguments]                                   ${triggering_fault}
    ...                                           ${instability_threshold}
    ...                                           ${voltage}
    ...                                           ${average_voltage}
    ...                                           ${rmod_id}
    ...                                           ${connection}
    ...                                           ${bts_type}
    ...                                           ${throughputs}
    ...                                           ${protocol}
    ...                                           ${udp_buffer}
    ...                                           ${tput_verification_via_btslog}
    ...                                           ${ue_network_modes}
    ...                                           ${ignored_cells_on_preparation}
    ...                                           ${switch_to_rfsw_user}
    Robot Log Operation                           Triggering unstable voltage alarm (Fault ID 4680) on RMOD-${rmod_id} via fault ${triggering_fault}
    ${repetitions}=                               Evaluate    ${instability_threshold} - 1

    Alarms.Allow Alarm                            fault_id=4680
    FOR    ${i}    IN RANGE    ${repetitions}
        ${iteration}=                             Evaluate    ${i} + 1
        Robot Log Operation    Generating fault ${triggering_fault} for the ${iteration}/${instability_threshold} time
        Trigger fault                             fault_id=${triggering_fault}
        ...                                       voltage=${voltage}
        ...                                       rmod_id=${rmod_id}
        ...                                       connection=${connection}
        ...                                       switch_to_rfsw_user=${switch_to_rfsw_user}
        Clear fault by setting proper voltage value
        ...                                       fault_id=${triggering_fault}
        ...                                       voltage=${average_voltage}
        ...                                       rmod_id=${rmod_id}
        ...                                       connection=${connection}
        ...                                       switch_to_rfsw_user=${switch_to_rfsw_user}
    END

    Robot Log Operation                           Generating fault ${triggering_fault} for the ${instability_threshold}/${instability_threshold} time
    Robot Log Operation                           Triggering fault ${triggering_fault} on RMOD-${rmod_id} by setting ${voltage}mV using rad command
    Alarms.Allow Alarm                            fault_id=${triggering_fault}
    rmod_operations.execute_ssh_command           rmod_id=${rmod_id}
    ...                                           command=rad -mw 0x110032 ${voltage}
    ...                                           connection=${connection}
    ...                                           switch_to_rfsw_user=${switch_to_rfsw_user}
    Robot Log Operation                           Waiting for fault ID 4680 to appear
    Clear fault by setting proper voltage value
    ...                                           fault_id=${triggering_fault}
    ...                                           voltage=${average_voltage}
    ...                                           rmod_id=${rmod_id}
    ...                                           connection=${connection}
    ...                                           switch_to_rfsw_user=${switch_to_rfsw_user}

    ${is_alarm_active}=                           Alarms.Wait for active alarm
    ...                                           fault_id=4680
    ...                                           timeout=90
    Should be true                                ${is_alarm_active}
    ...                                           msg=Fault ID 4680 did not appear!

    Clear unstable voltage alarm                  rmod_id=${rmod_id}
    ...                                           connection=${connection}
    ...                                           bts_type=${bts_type}

    Check statuses and execute L3 Call            throughputs=${throughputs}
    ...                                           protocol=${protocol}
    ...                                           udp_buffer=${udp_buffer}
    ...                                           tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                           ue_network_modes=${ue_network_modes}
    ...                                           ignored_cells_on_preparation=${ignored_cells_on_preparation}


Clear unstable voltage alarm
