Collect snapshot and verify its content
    [Arguments]                                   ${bts_type}
    ...                                           ${rmod_id}
    Robot Log Operation                           Collecting snapshot for RMOD-${rmod_id}
    Collect snapshot                              bts_type=${bts_type}

    ${sw_version}=                                Get Software Version
    ...                                           bts_type=${bts_type}
    ${credentials}                                connections.get_http_connection_credentials
    ...                                           bts_type=${bts_type}
    ${snapshot_dir_path}=                         set variable    ${logs_path}/snapshot_${bts_type}
    ${snapshot_file_name}=                        set variable    ${snapshot_dir_path}/GNB_snapshot.zip

    snapshot.setup_snapshot_settings              snapshot_dir=${snapshot_dir_path}
    ...                                           coverage=Full
    ...                                           sw_version=${sw_version}
    ...                                           connection_host=${credentials['ip']}
    ...                                           connection_port=${credentials['port']}
    ...                                           snapshot_file_name=${snapshot_file_name}

    ${reindexed_rmod_id}=                         Evaluate    ${rmod_id} - 1
    ${rmod_serial_number}=                        hwpta_testline.get_radio_serial_number
    ...                                           ru_id=${reindexed_rmod_id}
    ${snapshot_file_path}=                        snapshot.find_file_in_snapshot_file_list
    ...                                           filename=BTS[0-9]*_${rmod_serial_number}_RMOD_L_${rmod_id}_fault_history_log.txt.gz
    ${fault_history_log_file}                     Evaluate  str("""${snapshot_file_path}""").split('/')[-1]
