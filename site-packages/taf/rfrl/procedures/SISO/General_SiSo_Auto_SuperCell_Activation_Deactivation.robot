*** Keywords ***
General_SiSo_Auto_SuperCell_Activation_Deactivation
    [Documentation]  This keyword performs automatic activation and deactivation of supercells. After each activation
    ...              and deactivation, L3 call is performed on all cells.
    ...              ARGS:
    ...              - path_to_base_scf - path to the base scf file
    ...              - path_to_modified_scf - path to the scf file with activated supercells
    ...              - supercell_ids - list of CONFIG cell ids that are expected to be supercells
    ...              - throughputs  - dict with throughput and deviation values for each cell identified by
    ...                              it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells.
    ...                              Example:
    ...                              {
    ...                                  '827736065':
    ...                                       {
    ...                                           'throughput':
    ...                                               {
    ...                                                   'downlink': '100 Mbits/sec',
    ...                                                   'uplink': '0 Mbits/sec'
    ...                                               },
    ...                                           'deviation': '90%'
    ...                                       },
    ...                              }
    ...               - protocol - data transfer protocol; defaults to UDP.
    ...               - udp_buffer - monitoring data buffer; defaults to 4M.
    ...               - tput_verification_via_btslog - True - throughput verification will be performed using btslog
    ...                                                False - throuput verification will be performed using iperf; defaults to False
    ...               - ue_network_modes - mandatory parameter for SA+NSA setups, dict with UE serial numbers and desired network modes
    ...                                    e.g. {"SN1234": "NR_only"} possible UE network modes: NR_only, LTE_only, NR_LTE
    ...                                    when using more than one UE please make sure that the modes you choose are either all
    ...                                    with "_only" suffix or all "NR_LTE" as it is not yet possible to mix those.
    ...               - ignored_cells_on_preparation: SHOULD BE USED WITH `prepare_cells_to_call` set to True!
    ...                                               list of cells CONFIGURATION distnames that should be ignored during
    ...                                               L3 Call not called cells preparation procedure and not be blocked/barred
    [Arguments]                                     ${path_to_base_scf}
    ...                                             ${path_to_modified_scf}
    ...                                             ${supercell_ids}
    ...                                             ${throughputs}
    ...                                             ${protocol}=udp
    ...                                             ${udp_buffer}=4M
    ...                                             ${tput_verification_via_btslog}=${False}
    ...                                             ${ue_network_modes}=${None}
    ...                                             ${ignored_cells_on_preparation}=${None}

    ${bts_type}=                                    hwpta_testline.get_type_of_setup
    ${connection}                                   connections.get_default_admin_connection_alias
    ...                                             bts_type=${bts_type}
    ${supercell_dist_names}=                        Create List
    ${mrbts_id}=                                    admin_info_model.get_mrbts_id_admin
    ...                                             connection=${connection}
    ${nrbts_id}=                                    admin_info_model.get_nrbts_id_admin
    ...                                             connection=${connection}

    FOR  ${cell_id}   IN   @{supercell_ids}
          Append To List                            ${supercell_dist_names}  MRBTS-${mrbts_id}/NRBTS-${nrbts_id}/NRCELL-${cell_id}
    END

    Set Test Variable                               ${return_to_initial_scf}
    ...                                             ${True}

    Activate/Deactivate SuperCell And Perform L3Call
    ...                                             path_to_base_scf=${path_to_base_scf}
    ...                                             path_to_modified_scf=${path_to_modified_scf}
    ...                                             supercell_dist_names=${supercell_dist_names}
    ...                                             should_be_active=${True}
    ...                                             connection=${connection}
    ...                                             bts_type=${bts_type}
    ...                                             throughputs=${throughputs}
    ...                                             protocol=${protocol}
    ...                                             udp_buffer=${udp_buffer}
    ...                                             tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                             ue_network_modes=${ue_network_modes}
    ...                                             ignored_cells_on_preparation=${ignored_cells_on_preparation}

    Activate/Deactivate SuperCell And Perform L3Call
    ...                                             path_to_base_scf=${path_to_modified_scf}
    ...                                             path_to_modified_scf=${path_to_base_scf}
    ...                                             supercell_dist_names=${supercell_dist_names}
    ...                                             should_be_active=${False}
    ...                                             connection=${connection}
    ...                                             bts_type=${bts_type}
    ...                                             throughputs=${throughputs}
    ...                                             protocol=${protocol}
    ...                                             udp_buffer=${udp_buffer}
    ...                                             tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                             ue_network_modes=${ue_network_modes}
    ...                                             ignored_cells_on_preparation=${ignored_cells_on_preparation}


Validate SuperCell Active/Inactive
    [Arguments]                                     ${supercell_dist_name}
    ...                                             ${connection}
    ...                                             ${should_be_active}

    ${super_cell_activated}=                        admin_info_model.is_supercell
    ...                                             connection=${connection}
    ...                                             configuration_distname=${supercell_dist_name}

    Run Keyword If                                  not ${super_cell_activated} and ${should_be_active}
    ...                                             Fail    SuperCell ${supercell_dist_name} is not activated.

    Run Keyword If                                  ${super_cell_activated} and not ${should_be_active}
    ...                                             Fail    SuperCell ${supercell_dist_name} is still active.

Activate/Deactivate SuperCell And Perform L3Call
    [Arguments]                                     ${path_to_base_scf}
    ...                                             ${path_to_modified_scf}
    ...                                             ${supercell_dist_names}
    ...                                             ${should_be_active}
    ...                                             ${connection}
    ...                                             ${bts_type}
    ...                                             ${throughputs}
    ...                                             ${protocol}
    ...                                             ${udp_buffer}
    ...                                             ${tput_verification_via_btslog}
    ...                                             ${ue_network_modes}
    ...                                             ${ignored_cells_on_preparation}

    Private Activate/Deactivate SuperCell           path_to_base_scf=${path_to_base_scf}
    ...                                             path_to_modified_scf=${path_to_modified_scf}
    ...                                             bts_type=${bts_type}

    FOR   ${dist_name}    IN    @{supercell_dist_names}
           Validate SuperCell Active/Inactive       supercell_dist_name=${dist_name}
           ...                                      connection=${connection}
           ...                                      should_be_active=${should_be_active}
    END

    Execute L3 call                                 throughputs=${throughputs}
    ...                                             protocol=${protocol}
    ...                                             udp_buffer=${udp_buffer}
    ...                                             tput_verification_via_btslog=${tput_verification_via_btslog}
    ...                                             ue_network_modes=${ue_network_modes}
    ...                                             ignored_cells_on_preparation=${ignored_cells_on_preparation}

Private Activate/Deactivate SuperCell
    [Arguments]                                     ${path_to_base_scf}
    ...                                             ${path_to_modified_scf}
    ...                                             ${bts_type}
    Alarms.Allow alarm                              fault_id=7313
    ...                                             fault_name=NgGnbInitPartialReset
    ...                                             bts_type=${bts_type}
    Alarms.Allow alarm                              fault_id=16
    ...                                             fault_name=Unit synchronization failed
    ...                                             bts_type=${bts_type}

    Perform online delta commissioning and achieve On Air
    ...                                             path_to_base_scf=${path_to_base_scf}
    ...                                             path_to_modified_scf=${path_to_modified_scf}
    ...                                             bts_type=${bts_type}
    ...                                             check_if_bts_didnt_reset=${False}

    Alarms.Disallow alarm                           fault_id=7313
    ...                                             fault_name=NgGnbInitPartialReset
    ...                                             bts_type=${bts_type}
    Alarms.Disallow alarm                           fault_id=16
    ...                                             fault_name=Unit synchronization failed
    ...                                             bts_type=${bts_type}
