*** Keywords ***
CB007012_uDTX_single_cell_operation_actCMAS
    [Documentation]         The purpose of this test case is verification of the power consumption on the RU
    ...                     after activating power saving feature and performing CMAS broadcast.
    ...                     Activation and interworking with additional parameters will be verified.
    ...                     - cell_ids       -  list of cell IDs which will be used in the CMAS verification, e.g. [1, 2, 3]
    ...                     - ue             -  single UE object from init that user wants to work on.
    ...                     - ue_reboot      -  if True, UE will be rebooted to apply resolution and pixel density settings (may not work on every UE),
    ...                                         defaults to True.
    ...                     - expected_increase  -  expected power increase (in percents %) on RU during CMAS broadcast,
    ...                                             defaults to 2.
    ...                     - expected_reduction  -  expected power reduction (in percents %) on RU after CMAS broadcast ends,
    ...                                              defaults to 2.
    [Arguments]                                        ${cell_ids}
    ...                                                ${ue}
    ...                                                ${ue_reboot}=${False}
    ...                                                ${expected_increase}=2
    ...                                                ${expected_reduction}=2

    image_recognition.setup_image_recognition_environment
    ${bts_type}=                                       hwpta_testline.get_type_of_setup
    ${connection}                                      connections.get_default_admin_connection_alias
    ...                                                bts_type=${bts_type}
    ${rat_cell_ids}=                                   admin_info_model.get_cell_ids_from_specific_rat
    ...                                                connection=${connection}
    ...                                                cell_type=lte
    &{cells_dist_names}                                Create Dictionary

    FOR  ${cell_id}  IN  @{rat_cell_ids}
        ${cell_dist_names}                             admin_info_model.get_dist_names_for_specific_cell
        ...                                            connection=${connection}
        ...                                            cell_type=lte
        ...                                            cell_id=${cell_id}
        ${str_cell_id}                                 Convert To String  ${cell_id}
        Set To Dictionary                              ${cells_dist_names}  ${str_cell_id}=${cell_dist_names}
    END


    Disable Broadcasts                                 bts_type=${bts_type}
    Configure Power Meter                              bts_type=${bts_type}
    Configure CMAS                                     bts_type=${bts_type}
    ...                                                cells_dist_names=${cells_dist_names}
    ...                                                ue=${ue}
    ...                                                ue_reboot=${ue_reboot}

    FOR  ${cell_id}  IN  @{cell_ids}
        ${rmod_id}                                     admin_info_model.get_rmod_ids_for_cell_id
        ...                                            connection=${connection}
        ...                                            cell_id=${cell_id}
        ...                                            cell_type=lte
        Ensure Power Saving Is Enabled                 cell_dist_names=${cell_dist_names}
        ...                                            bts_type=${bts_type}
        CMAS Broadcast Procedure                       bts_type=${bts_type}
        ...                                            connection=${connection}
        ...                                            cell_id=${cell_id}
        ...                                            cells_dist_names=${cells_dist_names}
        ...                                            rmod_id=${rmod_id}
        ...                                            ue=${ue}
        ...                                            ue_reboot=${ue_reboot}
        ...                                            expected_increase=${expected_increase}
        ...                                            expected_reduction=${expected_reduction}
    END

    [Teardown]                                         Run Keywords
    ...                                                Configure Power Meter
    ...                                                enable=${False}
    ...                                                bts_type=${bts_type}
    ...                                                AND
    ...                                                Clear UE Settings After Broadcast
    ...                                                ue_reboot=${ue_reboot}
    ...                                                AND
    ...                                                Clean Up Environment
    ...                                                AND
    ...                                                tempere.close_connection

Configure CMAS
    [Arguments]                                        ${bts_type}
    ...                                                ${cells_dist_names}
    ...                                                ${ue}
    ...                                                ${ue_reboot}

    Prepare UE For Receiving Broadcast                 ue=${ue}
    ...                                                resolution=480x800
    ...                                                pixel_density=100
    ...                                                ue_reboot=${ue_reboot}
    
    Robot Log Operation                                Configuring CMAS broadcasting...
    FOR  ${cell_dist_names}  IN  @{cells_dist_names.values()}
        Create SIB Object                              config_cell_dist_name=${cell_dist_names["configuration"]}
        ...                                            sibs=SIB12
        ...                                            bts_type=${bts_type}
    END
          
    Set CMAS Parameters On BTS                         bts_type=${bts_type}

CMAS Broadcast Procedure
    [Arguments]                                        ${bts_type}
    ...                                                ${connection}
    ...                                                ${cell_id}
    ...                                                ${cells_dist_names}
    ...                                                ${rmod_id}
    ...                                                ${ue}
    ...                                                ${ue_reboot}
    ...                                                ${expected_increase}
    ...                                                ${expected_reduction}

    ${eutran_cell_id}                                  admin_info_model.get_eutran_cell_id
    ...                                                connection=${connection}
    ...                                                cell_dist_name=${cells_dist_names["""${cell_id}"""]["run_time"]}
    ${ue_alias}=                                       ue.get_ue_alias
    ue.run_naa_app

    ${ru_power_usage_before_broadcast}  ${ru_power_usage_during_broadcast}  ${ru_power_usage_after_broadcast}  Get Power Usage During ETWS/CMAS Broadcast
    ...                                                broadcast=CMAS
    ...                                                broadcast_time=4080
    ...                                                cell_dist_names=${cells_dist_names["""${cell_id}"""]}
    ...                                                eutran_cell_id=${eutran_cell_id}
    ...                                                bts_type=${bts_type}
    ...                                                sleep_time=480

    ${image_path}                                      ue.get_ue_screenshot
    ...                                                file_name=CMAS_ALERT
    ...                                                logs_path=${logs_path}
    ${screenshots_folder_path}                         Evaluate  str("""${image_path}""").rsplit('/', 1)[0]

    Robot Log Operation                                Verifying if CMAS alert is visible on UE...
    ${templates_path}                                  image_recognition.get_path_to_templates
    ${custom_search_width}=                            Set Variable If  ${ue_reboot}
    ...                                                ${None}
    ...                                                480
    ${custom_search_height}=                           Set Variable If  ${ue_reboot}
    ...                                                ${None}
    ...                                                800
    ${template_image_path}=                            Set Variable If  ${ue_reboot}
    ...                                                ${templates_path}/CMAS_template.png
    ...                                                ${templates_path}/CMAS_template_auto018.png
    ${matching_percent}=                               Set Variable If  ${ue_reboot}
    ...                                                95
    ...                                                96
    image_recognition.match_template                   image_path=${image_path}
    ...                                                template_image_path=${template_image_path}
    ...                                                matching_percent=${matching_percent}
    ...                                                output_file_name=${ue_alias}_CMAS_ALERT_TEMPLATE_MATCH
    ...                                                save_path=${screenshots_folder_path}
    ...                                                custom_search_width=${custom_search_width}
    ...                                                custom_search_height=${custom_search_height}

    Robot log operation                                Validating if power usage was increased...
    power_usage.validate_power_usage_change            start_power_usage=${ru_power_usage_before_broadcast}
    ...                                                end_power_usage=${ru_power_usage_during_broadcast}
    ...                                                expected_increase=${expected_increase}
    ...                                                rmod_id=${rmod_id}

    power_usage.validate_power_usage_change            start_power_usage=${ru_power_usage_during_broadcast}
    ...                                                end_power_usage=${ru_power_usage_after_broadcast}
    ...                                                expected_reduction=${expected_reduction}
    ...                                                rmod_id=${rmod_id}
