*** Keywords ***
uDTX_single_cell_operation_varying_load
    [Documentation]   The purpose of this test case is verification of uDTX function on single cell, with varying
    ...               load (in DL direction).
    ...               - cell_id            -  ID of the cell that varying load operation test will be performed on.
    ...               - call_duration_per_load  -  duration of single data transfer test in seconds e.g. ‘300s’.
    ...               - throughputs        -  list of throughputs values of traffic loads that will be performed on
    ...                                       a cell, example:
    ...                                       [
    ...                                          {'827736065':
    ...                                                  {'throughput':
    ...                                                      {
    ...                                                       'downlink': '14 Mbits/sec',
    ...                                                       'uplink': '0 Mbits/sec'
    ...                                                      },
    ...                                                  'info': '-',
    ...                                                  'deviation': '90%'}
    ...                                          },
    ...                                          {'827736065':
    ...                                                  'throughput':
    ...                                                      {
    ...                                                       'downlink': '28 Mbits/sec',
    ...                                                       'uplink': '0 Mbits/sec'
    ...                                                      },
    ...                                                  'info': '-',
    ...                                                  'deviation': '90%'}
    ...                                       ]
    ...               - protocol - data transfer protocol; defaults to UDP.
    ...               - udp_buffer - monitoring data buffer; defaults to 4M.
    ...               - expected_increase  -  expected power increase (in percents %) on RU after disabling power saving feature.
    ...                                       Defaults to 1 as it is only required to check if usage is lower
    [Arguments]                                        ${cell_id}
    ...                                                ${throughputs}
    ...                                                ${call_duration_per_load}
    ...                                                ${protocol}=udp
    ...                                                ${udp_buffer}=4M
    ...                                                ${expected_reduction}=1

    ${bts_type}=                                       hwpta_testline.get_type_of_setup
    ${connection}                                      connections.get_default_admin_connection_alias
    ...                                                bts_type=${bts_type}
    ${cell_dist_names}                                 admin_info_model.get_dist_names_for_specific_cell
    ...                                                connection=${connection}
    ...                                                cell_type=lte
    ...                                                cell_id=${cell_id}
    ${rmod_id}                                         admin_info_model.get_rmod_ids_for_cell_id
    ...                                                connection=${connection}
    ...                                                cell_id=${cell_id}
    ...                                                cell_type=lte

    Disable Broadcasts                                 bts_type=${bts_type}
    Configure Power Saving And Power Meter             config_cell_dist_name=${cell_dist_names["configuration"]}
    ...                                                enable_power_saving=${False}
    ...                                                bts_type=${bts_type}
    Sleep                                              5 min        Reason=Waiting for changes to be noticable
    ${usages_without_power_saving}                     Get Power Usage During L3 Call With Multiple Traffic Loads
    ...                                                throughputs=${throughputs}
    ...                                                called_cell=${cell_dist_names['configuration']}
    ...                                                call_duration_per_load=${call_duration_per_load}
    ...                                                direction=DL
    ...                                                protocol=${protocol}
    ...                                                udp_buffer=${udp_buffer}
    ...                                                bts_type=${bts_type}

    Configure Power Saving                             config_cell_dist_name=${cell_dist_names["configuration"]}
    ...                                                allowTrafficConcentration=${True}
    ...                                                actMicroDtx=${True}
    ...                                                bts_type=${bts_type}
    Sleep                                              5 min        Reason=Waiting for changes to be noticable
    ${usages_with_power_saving}                        Get Power Usage During L3 Call With Multiple Traffic Loads
    ...                                                throughputs=${throughputs}
    ...                                                called_cell=${cell_dist_names['configuration']}
    ...                                                call_duration_per_load=${call_duration_per_load}
    ...                                                direction=DL
    ...                                                protocol=${protocol}
    ...                                                udp_buffer=${udp_buffer}
    ...                                                bts_type=${bts_type}

    FOR  ${without_power_saving}  ${with_power_saving}  IN ZIP  ${usages_without_power_saving}  ${usages_with_power_saving}
        power_usage.validate_power_usage_change
        ...                                            start_power_usage=${without_power_saving}
        ...                                            end_power_usage=${with_power_saving}
        ...                                            expected_reduction=${expected_reduction}
        ...                                            rmod_id=${rmod_id}
    END

    [Teardown]    Run Keywords                         Configure Power Meter
    ...                                                enable=${False}
    ...                                                bts_type=${bts_type}
    ...                                                AND
    ...                                                Ensure Power Saving Is Disabled
    ...                                                cell_dist_names=${cell_dist_names}
    ...                                                bts_type=${bts_type}
    ...                                                AND
    ...                                                Clean Up Environment
