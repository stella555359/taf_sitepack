*** Keywords ***
uDTX_single_cell_deactivation
    [Documentation]         The purpose of this test case is verification of uDTX function deactivation.
    ...                     Args:
    ...                     ru_id              -  Runtime RU id that the power increase will be checked on.
    ...                     expected_increase  -  expected power increase (in percents %) on RU after disabling
    ...                                           power saving feature.
    [Arguments]                                        ${ru_id}=1
    ...                                                ${expected_increase}=50

    Robot log operation                                Checking power increase on RU ${ru_id}...
    ${bts_type}=                                       hwpta_testline.get_type_of_setup
    ${connection}                                      connections.get_default_admin_connection_alias
    ...                                                bts_type=${bts_type}
    ${cells_dist_names}                                admin_info_model.get_cells_dist_names_for_rmod
    ...                                                connection=${connection}
    ...                                                cell_type=lte
    ...                                                rmod_id=${ru_id}
    ${cell_dist_names}                                 Set Variable    ${cells_dist_names[0]}

    Disable Broadcasts                                 bts_type=${bts_type}
    ${start_timestamp}                                 Configure Power Saving And Power Meter
    ...                                                config_cell_dist_name=${cell_dist_names["configuration"]}
    ...                                                enable_power_saving=${True}
    ...                                                bts_type=${bts_type}
    Sleep                                              5 min        Reason=Waiting for changes to be noticable
    ${ru_power_usage_at_start}                         Get Power Usage On RU
    ...                                                bts_type=${bts_type}

    Start watching for faulty behaviour on cell        runtime_cell_dist_name=${cell_dist_names["run_time"]}
    Configure Power Saving                             config_cell_dist_name=${cell_dist_names["configuration"]}
    ...                                                allowTrafficConcentration=${False}
    ...                                                actMicroDtx=${False}
    ...                                                bts_type=${bts_type}
    Sleep                                              5 min        Reason=Waiting for changes to be noticable
    Robot log operation                                Verifying if values were changed in btslog...
    btslog_parser.verify_if_params_have_expected_values
    ...                                                start_timestamp=${start_timestamp}
    ...                                                CHANGE_MICRODTX=update:
    ...                                                CHANGE_MICRODTX_=SUCCEEDED
    ${ru_power_usage_at_end}                           Get Power Usage On RU
    ...                                                bts_type=${bts_type}

    Robot log operation                                Validating if power usage was increased by ${expected_increase}%...
    validate_power_usage_change                        start_power_usage=${ru_power_usage_at_start}
    ...                                                end_power_usage=${ru_power_usage_at_end}
    ...                                                expected_increase=${expected_increase}
    ...                                                rmod_id=${ru_id}

    [Teardown]    Run Keywords                         Configure Power Meter
    ...                                                enable=${False}
    ...                                                bts_type=${bts_type}
    ...                                                AND
    ...                                                Ensure Power Saving Is Disabled
    ...                                                cell_dist_names=${cell_dist_names}
    ...                                                bts_type=${bts_type}
    ...                                                AND
    ...                                                status_watchdog.stop_watching_statuses
