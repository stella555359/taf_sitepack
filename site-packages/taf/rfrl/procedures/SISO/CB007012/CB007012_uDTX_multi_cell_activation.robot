*** Keywords ***
CB007012_uDTX_multi_cell_activation
    [Documentation]         The purpose of this test case is verification of uDTX on cells. It verifies if the power
    ...                     consumption on RMODs is reduced during parallel L3 call (when uDTX is activated on cells).
    ...                     Args:
    ...                     - cells_to_ues: pairs of configuration distnames of cells and serial numbers of
    ...                       UEs that will be attached to this cell e.g
    ...                       {"MRBTS-1/NRCELL-1": "SN1234", "MRBTS-1/LNCEL-1": "SN432"}
    ...                     - call_duration:  duration of data transfer test in seconds e.g. ‘300s’.
    ...                     - throughput:   dict with throughput and deviation values for each cell identified by
    ...                                     it's nrCellIdentity for NR cells, eutranCellId for LTE cells, wnCelId for WCDMA cells.
    ...                                     Example:
    ...                                     {
    ...                                         '827736065':
    ...                                               {
    ...                                                  'throughput':
    ...                                                      {
    ...                                                          'downlink': '100 Mbits/sec',
    ...                                                          'uplink': '0 Mbits/sec'
    ...                                                      },
    ...                                                 'deviation': '90%'
    ...                                              },
    ...                                      }
    ...                     - protocol: data transfer protocol
    ...                     - udp_buffer: monitoring data buffer
    ...                     - prepare_cells_to_call: True - the enviornment will be prepared so that only the called cells are notBarred and unblocked
    ...                                              False - the enviornment will not be changed and L3 call will be performed as is; defaults to True
    ...                     - ue_network_modes: dictionary with pairs of UE Serial Number - desired network mode e.g. {"SN1234": "NR_only", "SN321": "NR_only}
    ...                                              possible network modes: NR_only, LTE_only, NR_LTE (NR_LTE mode CAN NOT be used with any of the other
    ...                                              two in case of more than one UE); defaults to ${None} (current modes set on UEs will be used)
    ...                     - expected_reduction: expected power reduction (in percents %) on RU after enabling
    ...                                           power saving feature.
    [Arguments]                                        ${cells_to_ues}
    ...                                                ${call_duration}
    ...                                                ${throughputs}
    ...                                                ${protocol}=udp
    ...                                                ${udp_buffer}=4M
    ...                                                ${prepare_cells_to_call}=${True}
    ...                                                ${ue_network_modes}=${None}
    ...                                                ${expected_reduction}=5

    ${bts_type}=                                       hwpta_testline.get_type_of_setup
    ${connection}=                                     connections.get_default_admin_connection_alias
    ...                                                bts_type=${bts_type}

    Disable Broadcasts                                 bts_type=${bts_type}
    Configure Power Meter                              bts_type=${bts_type}

    FOR    ${cell_dist_name}  IN  @{cells_to_ues.keys()}
        Configure Power Saving                     config_cell_dist_name=${cell_dist_name}
        ...                                        allowTrafficConcentration=${False}
        ...                                        actMicroDtx=${False}
        ...                                        bts_type=${bts_type}
        Sleep                                      5 min
        ...                                        Reason=Waiting for changes to be noticeable
    END

    ${ru_power_usage_without_microdtx}=                Perform L3Call On Selected Cells And Get Power Usage
    ...                                                cells_to_ues=${cells_to_ues}
    ...                                                bts_type=${bts_type}
    ...                                                duration=${call_duration}
    ...                                                throughputs=${throughputs}
    ...                                                protocol=${protocol}
    ...                                                udp_buffer=${udp_buffer}
    ...                                                prepare_cells_to_call=${prepare_cells_to_call}
    ...                                                ue_network_modes=${ue_network_modes}

    FOR    ${cell_dist_name}  IN  @{cells_to_ues.keys()}
        Configure Power Saving                     config_cell_dist_name=${cell_dist_name}
        ...                                        bts_type=${bts_type}
        Sleep                                      5 min
        ...                                        Reason=Waiting for changes to be noticeable
    END

    ${ru_power_usage_with_microdtx}=                   Perform L3Call On Selected Cells And Get Power Usage
    ...                                                cells_to_ues=${cells_to_ues}
    ...                                                bts_type=${bts_type}
    ...                                                duration=${call_duration}
    ...                                                throughputs=${throughputs}
    ...                                                protocol=${protocol}
    ...                                                udp_buffer=${udp_buffer}
    ...                                                prepare_cells_to_call=${prepare_cells_to_call}
    ...                                                ue_network_modes=${ue_network_modes}

    Robot log operation                                Validating if power usage was reduced by ${expected_reduction}%...
    power_usage.validate_power_usage_change            start_power_usage=${ru_power_usage_without_microdtx}
    ...                                                end_power_usage=${ru_power_usage_with_microdtx}
    ...                                                expected_reduction=${expected_reduction}

    [Teardown]    Run Keywords                         Configure Power Meter
    ...                                                enable=${False}
    ...                                                bts_type=${bts_type}
    ...                                                AND
    ...                                                Ensure Energy Saving Is Enabled On All Cells
    ...                                                cells_to_ues=${cells_to_ues}
    ...                                                bts_type=${bts_type}
    ...                                                connection=${connection}
    
    
Perform L3Call On Selected Cells And Get Power Usage
    [Arguments]                                        ${cells_to_ues}
    ...                                                ${bts_type}
    ...                                                ${duration}
    ...                                                ${throughputs}
    ...                                                ${protocol}
    ...                                                ${udp_buffer}=4M
    ...                                                ${prepare_cells_to_call}=${True}
    ...                                                ${ue_network_modes}=${None}
    
    ${call_duration}=                                  Convert Time  ${duration}
    ${sleep_time}=                                     Evaluate      ${call_duration}/2
    
    Start L3 Call In Background                        cells_to_ues=${cells_to_ues}
    ...                                                duration=${duration}
    ...                                                direction=DL
    ...                                                throughputs=${throughputs}
    ...                                                protocol=${protocol}
    ...                                                udp_buffer=${udp_buffer}
    ...                                                prepare_cells_to_call=${prepare_cells_to_call}
    ...                                                ue_network_modes=${ue_network_modes}
    Sleep                                              ${sleep_time}    Reason=Waiting for change in power usage...
    ${power_usage_measurements}                        Get Power Usage On RU
    ...                                                bts_type=${bts_type}
    Verify Background L3 Call Results                  cells_to_ues=${cells_to_ues}
    
    [Return]                                           ${power_usage_measurements}
    

Ensure Energy Saving Is Enabled On All Cells
    [Arguments]                                        ${cells_to_ues}
    ...                                                ${connection}
    ...                                                ${bts_type}
    
    FOR    ${config_dist_name}   IN  @{cells_to_ues.keys()}
        ${cell_id}=                                Evaluate    ${config_dist_name.split('-')[-1]}
        ${cell_dist_names}                         admin_info_model.get_dist_names_for_specific_cell
        ...                                        connection=${connection}
        ...                                        cell_type=lte
        ...                                        cell_id=${cell_id}
        Ensure Power Saving Is Enabled             cell_dist_names=${cell_dist_names}
        ...                                        bts_type=${bts_type}
    END