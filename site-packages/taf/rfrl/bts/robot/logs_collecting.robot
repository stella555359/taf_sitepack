*** Settings ***
Library    OperatingSystem
Library    String
Library    taf.sw.reporting_portal
Library    taf.collectors.core                  WITH NAME   core
Library    taf.collectors.btslog                WITH NAME   btslog
Library    taf.rfrl.utilities.test_config
Library    taf.rfrl.utilities.tl_config
Library    taf.rfrl.bts.devices.ru.ru_serial_logs_collector.GnbRuSerialLogsCollector    WITH NAME      gnb_ru_lmi
Library    taf.rfrl.bts.parallel.operations    WITH NAME    bts_parallel
Resource   taf/rfrl/bts/robot/gnb.robot
Resource   taf/rfrl/bts/robot/enb.robot

*** Variables ***
${COLLECT_MANDATORY_LOGS}   ${True}

*** Keywords ***
Setup Logs Collectors
    Setup gNB Btslog Collector
    gnb_ru_lmi.Setup Hosts For All RU Console Collection

Teardown Logs Collectors
    Run Keyword and Ignore Error    Teardown gNB Btslog Collector
    Run Keyword and Ignore Error    gnb_ru_lmi.Teardown Hosts For All RU Console Collection

Collect Logs During Test
    [Arguments]     ${collect_syslog}=${True}
    ...             ${raise_exception_when_setup_ru_console_fail}=${True}
    ...             ${collect_ru_console_log}=${True}

    Set Test Case Log Path
    Run Keyword If    ${collect_syslog}             Start Collecting gNB BtsLog
    Run Keyword If    ${collect_ru_console_log}     gnb_ru_lmi.Setup Serial Console Connection for All RUs
    ...                                                 raise_exception=${raise_exception_when_setup_ru_console_fail}

Collect Logs After Test Finished
    [Arguments]     ${collect_syslog}=${True}
    ...             ${collect_snapshot_from_ru}=${False}
    ...             ${remove_source_snapshot_from_ru}=${True}
    ...             ${collect_ru_console_log}=${True}

    Run Keyword If  ${COLLECT_MANDATORY_LOGS}       Run Keyword and Ignore Error    Collect Mandatory Logs
    ${status}  ${syslog_path}    Run Keyword If     ${collect_syslog}
    ...                                             Run Keyword and Ignore Error
    ...                                             Stop Collecting gNB BtsLog  log_dir=${LOG_PATH}

    ${syslog_rel_path}  Run Keyword If    '${status}' == 'PASS'
    ...                     Run Keyword If    '${syslog_path}' != 'None'
    ...                         Get Relative Path to Test Results    absolute_path=${syslog_path}
    Run Keyword If    '${status}' == 'PASS' and '${syslog_rel_path}' != 'None'
    ...               taf.sw.reporting_portal.Add Syslog Link to Report    relative_path=${syslog_rel_path}
    ...                                                                    description=Syslog after test from GNB0

    IF    ${collect_snapshot_from_ru}
        Run Keyword and Ignore Error    gnb_ru_lmi.Collect Snapshot From all Setup RUs
        ...                             remove_source_file=${remove_source_snapshot_from_ru}
    END
    IF    ${collect_ru_console_log}
        gnb_ru_lmi.Collect Console Log From all Setup RUs
    END
    gnb_ru_lmi.Teardown Serial Console Connection for All Setup RUs

#    Run Keyword If Test Failed      Collect logs if Test Case Failed

Collect CU Mandatory Logs
    Download Snapshot From CU    path=${LOG_PATH}

Collect Mandatory Logs
    [Arguments]    ${log_dir}=${None}

    ${log_dir}    Run Keyword If    '${log_dir}' == 'None'
    ...                 Set Variable    ${LOG_PATH}
    ...           ELSE
    ...                 Set Variable    ${log_dir}

    Collect IM Snapshot From gNB    log_dir=${log_dir}
    Collect IMS Log From gNB        log_dir=${log_dir}

    ${snapshot_paths}=    bts_parallel.Collect Snapshot From All Btsses    log_dir=${log_dir}
    FOR    ${bts_id}    IN    @{snapshot_paths.keys()}
        ${snapshot_path}    Set Variable    ${snapshot_paths}[${bts_id}]
        ${snapshot_rel_path}    Get Relative Path to Test Results   absolute_path=${snapshot_path}
        taf.sw.reporting_portal.Add Snapshot Link to Report    relative_path=${snapshot_rel_path}
        ...                                                    description=Snapshot after test from GNB${bts_id}
    END
    ${Is_Cloud} =    taf.rfrl.utilities.tl_config.Is Testline of Cloud Type
    Run Keyword If    ${Is_Cloud}    Collect CU Mandatory Logs

Collect Logs If Test Case Failed
    Collect Mandatory Logs

Collect BtsLog From
    [Arguments]    ${keyword}    ${subdir}=BtsLog    @{args}    &{kwargs}
    Setup Logs Collectors
    Start Collecting gNB BtsLog
    Run Keyword    ${keyword}    @{args}    &{kwargs}
    [Teardown]    Run Keyword and Ignore Error    Stop Collecting gNB BtsLog    log_dir=${LOG_PATH}/${subdir}

Setup Logs Collectors For eNB Testing
    Setup eNB Btslog Collector

Teardown Logs Collectors For eNB Testing
    Run Keyword and Ignore Error    Teardown eNB Btslog Collector
