*** Settings ***
Library     BuiltIn
Library     taf.rfrl.bts.recovery.SmodFaultRecovery    WITH NAME      smodFaultRecovery
Library     taf.rfrl.bts.recovery.BbmodFaultRecovery   WITH NAME      bbmodFaultRecovery
Library     taf.rfrl.bts.recovery.RmodFaultRecovery    WITH NAME      rmodFaultRecovery
Library     taf.rfrl.bts.recovery.CuFaultRecovery      WITH NAME      cuFaultRecovery
Resource    ./gnb.robot


*** Keywords ***
Wait For onAir State
    [Documentation]   Waits 900 seconds for all cells status 'Enabled' and verifies gNB onAir state
    Wait Until Keyword Succeeds    900 sec     15 sec   Verify All Cell Status    cell_status=Enabled
    Verify gNB is onAir

Verify Du Fault Raised
    [Arguments]    ${fault_name}    ${retry}=120    ${retry_interval}=1    ${gnb_id}=0
    [Documentation]    Verify that given fault is raised
    ...     :param fault_name:    Name of the expected fault
    ...     :param retry:         Number of attempts to check if fault is active
    ...     :param retry_interval:Time between retries
    ...     :param gnb_id:    Id of gNB from test line configuration
    Wait until keyword succeeds    ${retry}      ${retry_interval}    Verify Alarm is Active on gNB    fault_name=${fault_name}

Verify Du Fault Cleared
    [Arguments]    ${fault_name}    ${retry}=120    ${retry_interval}=1    ${gnb_id}=0
    [Documentation]    Verify that given fault is cleared
    ...     :param fault_name:    Name of the expected fault
    ...     :param retry:         Number of attempts to check if fault is cleared
    ...     :param retry_interval:Time between retries
    ...     :param gnb_id:    Id of gNB from test line configuration
    Wait until keyword succeeds    ${retry}      ${retry_interval}    Verify Alarm is not Active on gNB    fault_name=${fault_name}

Wait For Recovery Reset Counter Clear
    [Documentation]    reset_counter is an entity held by OAM indicating current number of recovery resets.
    ...   60 minutes is a time after which it should be cleared
    Sleep    60 min

Verify Smod Fault Recovery With Reset
    [Arguments]    ${fault_name}    ${gnb_id}=0
    [Documentation]    Verify Smod Fault Recovery With Reset
    ...     :param fault_name:    Name of the expected fault
    ...     :param gnb_id:    Id of gNB from test line configuration
    smodFaultRecovery.trigger_fault    fault_name=${fault_name}    gnb_id=${gnb_id}
    smodFaultRecovery.verify_autonomous_reset

Verify Smod Fault Recovery With Reset Loop
    [Arguments]  ${fault_name}    ${count}=3
    [Documentation]    Verify Smod Fault Recovery With Reset followed by onAir in a loop
    ...     :param fault_name:    Name of the expected fault
    ...     :param count:    Loop count
    :FOR    ${INDEX}  IN RANGE    0   ${count}
    \   Verify Recovery Reset Counter    expected=${INDEX}
    \   Verify Smod Fault Recovery With Reset    fault_name=${fault_name}
    \   Wait For onAir State

Verify Smod Fault Recovery Without Reset
    [Arguments]    ${fault_name}    ${gnb_id}=0
    [Documentation]    Verify Smod Fault Recovery Without Reset
    ...     :param fault_name:    Name of the expected fault
    ...     :param gnb_id:    Id of gNB from test line configuration
    smodFaultRecovery.trigger_fault    fault_name=${fault_name}    gnb_id=${gnb_id}
    smodFaultRecovery.verify_no_autonomous_reset

Verify Recovery Reset Counter
    [Arguments]    ${expected}    ${gnb_id}=0
    [Documentation]    Checks if restartCounter value stored in infomodel is as expected
    ...     :param expected:    Expected counter value
    ...     :param gnb_id:    Id of gNB from test line configuration
    smodFaultRecovery.verify_recovery_reset_counter    expected=${expected}    gnb_id=${gnb_id}

Wait For Bbmod Reboot
    [Arguments]    ${gnb_id}=0    ${bbmod_id}=1   ${timeout}=120
    [Documentation]    Waits for Ru statuses indicationg reboot
    ...     :param gnb_id:    Id of gNB from test line configuration
    ...     :param bbmod_id:  Id of BBMOD from test line configuration - currently only 0 supported
    Wait Until Keyword Succeeds     ${timeout} sec     5 sec   bbmodFaultRecovery.verify_bbmod_status_during_recovery_reset
    ...    gnb_id=${gnb_id}    bbmod_id=${bbmod_id}

Verify Bbmod Fault Recovery With Reset
    [Arguments]    ${fault_name}    ${gnb_id}=0    ${common_unit_id}=0    ${capacity_unit_id}=0    ${retry}=120
    [Documentation]    Verifies BBMOD reset recovery due to critical fault
    ...     :param fault_name:    Name of the expected fault
    ...     :param gnb_id:        Id of gNB from test line configuration
    ...     :param common_unit_id:    Id of the common unit from test line configuration
    ...     :param capacity_unit_id:        Id of the capacity unit from test line configuration
    ...     :param retry:         Number of attempts to check if fault is active
    bbmodFaultRecovery.trigger_fault    fault_name=${fault_name}    gnb_id=${gnb_id}    common_unit_id=${common_unit_id}
    ...                                 capacity_unit_id=${capacity_unit_id}
    Verify Du Fault Raised    fault_name=${fault_name}    gnb_id=${gnb_id}    retry=${retry}
    Wait For Bbmod Reboot

Verify Bbmod Fault Recovery With Reset Loop
    [Arguments]    ${fault_name}    ${count}=3
    [Documentation]    Verifies BBMOD reset recovery due to critical fault in a loop
    ...     :param fault_name:    Name of the expected fault
    ...     :param count:    Loop count
    :FOR    ${INDEX}  IN RANGE    0   ${count}
    \   Verify Bbmod Fault Recovery With Reset    fault_name=${fault_name}
    \   Wait Until Keyword Succeeds    900 sec     15 sec   Verify DU Availability
    \   Wait For onAir State

Verify Bbmod Fault Recovery Without Reset
    [Arguments]    ${fault_name}    ${gnb_id}=0
    [Documentation]    Verifies BBMOD behaviour when maximum number of recovery resets has been reached
    ...     :param fault_name:    name of expected fault
    ...     :param gnb_id:    Id of gNB from test line configuration
    bbmodFaultRecovery.trigger_fault    fault_name=${fault_name}    gnb_id=${gnb_id}

Wait For Ru Reboot
    [Arguments]    ${gnb_id}=0    ${ru_id}=0
    [Documentation]    Waits for Ru statuses indicationg reboot
    ...     :param gnb_id:    Id of gNB from test line configuration
    ...     :param ru_id:     Id of Radio Unit from test line configuration
    Wait Until Keyword Succeeds     120 sec     5 sec   rmodFaultRecovery.verify_rmod_status_during_recovery_reset
    ...    gnb_id=${gnb_id}    ru_id=${ru_id}

Wait For All Radio Module Online Status
    [Documentation]    Waits for Radio Modules to become online
    Wait Until Keyword Succeeds    300 sec    15 sec   Verify All Radio Module Status   bts_state=online

Cancel Rf Fault
    [Arguments]    ${gnb_id}=0    ${ru_id}=0
    [Documentation]    Cancels Rf 1901 fault
    ...     :param gnb_id:    Id of gNB from test line configuration
    ...     :param ru_id:     Id of Radio Unit from test line configuration
    rmodFaultRecovery.cancel_fault   gnb_id=${gnb_id}    ru_id=${ru_id}

Verify Rmod Fault Recovery With Reset
    [Arguments]    ${fault_name}    ${gnb_id}=0    ${ru_id}=0
    [Documentation]    Verifies RU reset recovery due to Rf critical fault
    ...     :param fault_name:    name of expected fault
    ...     :param gnb_id:    Id of gNB from test line configuration
    ...     :param ru_id:     Id of Radio Unit from test line configuration
    rmodFaultRecovery.trigger_fault    fault_name=${fault_name}
    ...                                gnb_id=${gnb_id}
    ...                                ru_id=${ru_id}
    Verify Du Fault Raised    fault_name=${fault_name}    retry=300    gnb_id=${gnb_id}
    Wait For Ru Reboot    gnb_id=${gnb_id}    ru_id=${ru_id}
    Cancel Rf Fault   gnb_id=${gnb_id}    ru_id=${ru_id}
    Wait For All Radio Module Online Status

Verify Rmod Fault Recovery With Reset Loop
    [Arguments]    ${fault_name}    ${count}=3
    [Documentation]    Verifies RU reset recovery due to critical fault in a loop
    ...     :param fault_name:    Name of the expected fault
    ...     :param count:    Loop count
    :FOR    ${INDEX}  IN RANGE    0   ${count}
    \   Verify Rmod Fault Recovery With Reset    fault_name=${fault_name}
    \   Wait For onAir State

Verify Rmod Fault Recovery Without Reset
    [Arguments]    ${fault_name}    ${gnb_id}=0    ${ru_id}=0
    [Documentation]    Verifies RU behaviour when maximum number of recovery resets has been reached
    ...     :param fault_name:    name of expected fault
    ...     :param gnb_id:    Id of gNB from test line configuration
    ...     :param ru_id:     Id of Radio Unit from test line configuration
    rmodFaultRecovery.trigger_fault    fault_name=${fault_name}
    ...                                gnb_id=${gnb_id}
    ...                                ru_id=${ru_id}
    Verify Du Fault Raised    fault_name=${fault_name}    retry=300    gnb_id=${gnb_id}

Verify Cu Fault Recovery With Reset
    [Arguments]    ${cu_vm_name}    ${process_on_vm}    ${password}
    [Documentation]    Verifies CU reset recovery due to VNFC critical fault
    ...     :param cu_vm_name:        Name of VM (for example CPUE) for which fault will be raised
    ...     :param process_on_vm:     Name of process running on VM
    ...     :param password:          password for user to execute sudo command
    Trigger Crash on VNFC    process_name=${process_on_vm}    cu_vm_name=${cu_vm_name}    password=${password}
    Wait until keyword succeeds    30    1    Verify Alarm is Active on CU
    ...    fault_id=4350    fault_name=VNFC unavailable    alarm_id=7101

Verify Cu Fault Recovery Without Reset
    [Arguments]    ${cu_vm_name}    ${process_on_vm}    ${password}
    [Documentation]    Verifies CU recovery without reset due to VNFC critical fault
    ...     :param cu_vm_name:        Name of VM (for example CPUE) for which fault will be raised
    ...     :param password:          password for user to execute sudo command
    Trigger Crash on VNFC    process_name=${process_on_vm}    cu_vm_name=${cu_vm_name}    password=${password}
    Wait until keyword succeeds    30    1    Verify Alarm is Active on CU
    ...    fault_id=4350    fault_name=VNFC unavailable     alarm_id=7116

Verify Cu Fault Present
    [Arguments]    ${cu_ip}    ${fault_id}    ${fault_name}    ${alarm_id}
    [Documentation]    Verify given fault identified by fault_id/fault_name/alarm_id is active
    ...     :param cu_ip          CU IP address from test line configuration
    ...     :param fault_id       Id of expected fault (for example 4350)
    ...     :param fault_name:    Name of expected fault (for example 'RAP or VM unavailable for Cloud')
    ...     :param alarm_id:      Id of expected alarm (for example 7101)
    BuiltIn.Log    This kw is deprecated please use gnb_cu:    level=WARN
    cuFaultRecovery.verify_cu_fault_present    cu_ip=${cu_ip}
    ...                                        fault_id=${fault_id}
    ...                                        fault_name=${fault_name}
    ...                                        alarm_id=${alarm_id}

Verify Cu Fault Absent
    [Arguments]    ${cu_ip}    ${fault_id}
    [Documentation]    Verify given fault identified by fault_id is not active
    ...     :param cu_ip          CU IP address from test line configuration
    ...     :param fault_id       Id of expected fault (for example 4350)
    BuiltIn.Log    This kw is deprecated please use gnb_cu:    level=WARN
    cuFaultRecovery.verify_cu_fault_absent     cu_ip=${cu_ip}
    ...                                        fault_id=${fault_id}

Verify F1 Interface Restart
    [Documentation]    Verifies F1 Interface Restart by checking
    ...   that F1SctpEndpointInDu is raised and cleared
    Verify Du Fault Raised    fault_name=F1 SCTP endpoint in DU    retry=300
    Verify Du Fault Cleared   fault_name=F1 SCTP endpoint in DU    retry=300

Reboot Cu
    [Documentation]    Reboots CU
    cuFaultRecovery.reboot_cu

Cleare CU Reset Counters
    [Arguments]    ${bts_id}=0
    [Documentation]    Cleares CU reset counters by removing file where they are stored
    cuFaultRecovery.remove_reset_counter_file    bts_id=${bts_id}
