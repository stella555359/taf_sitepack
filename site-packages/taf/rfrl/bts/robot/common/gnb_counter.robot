*** Settings ***

Library    taf.rfrl.bts.devices.du.pm_counters.GnbPmCounter   WITH NAME      gnbcounter


*** Keywords ***
Save PM Interval
    [Arguments]    ${dist_name}    ${abbr_group_name}    ${gnb_id}=0    ${du_id}=${0}
    [Documentation]    Save the current PM interval
    ...    :param dist_name:    Destination name
    ...    :param abbr_group_name:    Abbreviation
    ...    :param gnb_id:    ID for BTS
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ${PM_interval_init}=  gnbcounter.get_pm_interval    dist_name=${dist_name}    abbr_group_name=${abbr_group_name}
    ...                           bts_id=${gnb_id}    du_id=${du_id}
    Set Test Variable    ${PM_interval_init}

Set PM Interval gNB
    [Arguments]    ${dist_name}    ${abbr_group_name}    ${interval}    ${gnb_id}=0    ${du_id}=${0}
    [Documentation]    Set PM interval
    ...    :param dist_name:    Destination name
    ...    :param abbr_group_name:    Abbreviation
    ...    :param interval:    Interval for PM counters
    ...    :param gnb_id:    ID for BTS
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    gnbcounter.set_pm_interval    dist_name=${dist_name}    abbr_group_name=${abbr_group_name}     interval=${interval}
    ...                           bts_id=${gnb_id}    du_id=${du_id}

Wait for PM measurements
    [Arguments]    ${interval}    ${measurements}
    [Documentation]    Wait for several intervals PM counters
    ...    :param interval:   Interval for PM counters
    ...    :param measurements:    Numbers of waiting  intervals
    gnbcounter.wait_for_pm_measurements    interval=${interval}    measurements=${measurements}

Validate intervals and values counters eCPRI
    [Arguments]    ${interval}    ${measurements}    ${gnb_id}=0    ${du_id}=${0}
    [Documentation]    Validate intervals and values counters
    ...    :param interval:    Interval for PM counter
    ...    :param measurements:    Number of validation intervals
    ...    :param gnb_id:    ID for BTS
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    gnbcounter.validate_intervals_and_value_counter_ecpri_group    interval=${interval}    measurements=${measurements}
    ...    bts_id=${gnb_id}    du_id=${du_id}

Get PM Counters File
    [Arguments]     ${local_path}   ${gnb_id}=0     ${du_id}=0
    [Documentation]  Wait for PM file to be found and downloaded
    ...    :param local_path:   Path to the saved file
    ...    :param gnb_id:       ID for BTS
    ...    :param du_id:        DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    gnbcounter.get_pm_counters_file      bts_id=${gnb_id}    du_id=${du_id}      local_path=${local_path}


Wait for next PM period
    [Arguments]   ${interval}=15
    [Documentation]  Wait for the next counter cycle, indicated by the interval
    ...    :param interval:                     Interval of the counter
    ...    :return: pm_period_start_time, pm_period_end_time
    ${return_value}  gnbcounter.wait_for_next_pm_period     interval=${interval}
     [Return]   ${return_value}

Validate counter interval
    [Arguments]   ${counter_id}    ${expected_interval}    ${timeout}
    [Documentation]  Validate interval of PM counter value
    ...    :param counter_id:                     Counter ID M...
    ...    :param expected_interval:              Expected interval in minutes
    ...    :param timeout:                        Timeout in minutes
    gnbcounter.validate_counter_interval     counter_id=${counter_id}     expected_interval=${expected_interval}    timeout=${timeout}

Wait for PM reports generation interval change
    [Arguments]   ${expected_interval}    ${timeout}
    [Documentation]  Wait for interval of generating PM reports change according to 'reportingIntervalPm' parameter value
    ...    :param expected_interval:                   Expected interval in minutes
    ...    :param timeout:                             Timeout in minutes
    gnbcounter.wait_for_pm_reports_generation_interval_change     expected_interval=${expected_interval}    timeout=${timeout}
