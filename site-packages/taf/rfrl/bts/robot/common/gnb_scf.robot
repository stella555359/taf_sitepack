*** Settings ***

Library    taf.rfrl.bts.devices.du.commissioning.GnbCommissioning    WITH NAME      gnbscf



*** Keywords ***
Verify Validation Error Active On gNB
    [Arguments]    ${gnb_id}=0    ${du_id}=${0}    ${error_name}=${None}    ${skip_parameter_relation_errors}=${False}
    [Documentation]    Verify that validation error is active on current SCF
    ...     :param gnb_id:    ID of gNB, default set to 0
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     :param error_name: Text of validation error
    ...     :param skip_parameter_relation_errors: Flag whether to skip relation errors. Default False.
    gnbscf.verify_validation_error_active    bts_id=${gnb_id}    du_id=${du_id}
    ...     error_name=${error_name}         skip_parameter_relation_errors=${skip_parameter_relation_errors}

Verify Validation Error Not Active On gNB
    [Arguments]    ${gnb_id}=0    ${du_id}=${0}    ${skip_parameter_relation_errors}=${False}
    [Documentation]    Verify that validation errors are not active on current SCF
    ...     :param gnb_id:    ID of gNB, default set to 0
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     :param skip_parameter_relation_errors: Flag whether to skip relation errors. Default False.
    gnbscf.verify_validation_error_not_active    bts_id=${gnb_id}    du_id=${du_id}
    ...     skip_parameter_relation_errors=${skip_parameter_relation_errors}

Perform Full Commissioning on gNB
    [Arguments]  ${scf_file}    ${gnb_id}=${0}    ${skip_parameter_relation_errors}=${False}    ${timeout}=${300}
    ...    ${should_activate}=${True}   ${validate_scf}=${True}    ${du_id}=${0}

    [Documentation]    Perform Full eNB commissioning.
    ...     :param scf_file:                          path to the scf file
    ...     :param gnb_id:                            GNB id - related to Test Line configuration.
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     :param skip_parameter_relation_errors:    skip parameter relation errors
    ...     :param timeout:                           timeout for the operation. It is based on observed test times
    ...     :param should_activate:                   if True it should automatically activate plan
    ...     :param validate_scf:                      if True it should automatically validate plan
    gnbscf.perform_bts_full_commissioning    scf_file=${scf_file}    bts_id=${gnb_id}    timeout=${timeout}
    ...    skip_parameter_relation_errors=${skip_parameter_relation_errors}    should_activate=${should_activate}
    ...    validate_scf=${validate_scf}    du_id=${du_id}

Perform Delta Commissioning On gNB
    [Arguments]    ${delta}    ${skip_parameter_relation_errors}=${false}    ${should_activate}=${true}   ${gnb_id}=${0}
    ...    ${timeout}=${300}    ${du_id}=${0}
    [Documentation]     Perform commissioning using given delta.
    ...     :param delta:     list of parameters to update. Sample delta:
    ...                         delta = [{
    ...                                 'distName': dist_name,
    ...                                 'operation': 'update',
    ...                                 'parameters': [{
    ...                                                'operation': operation,
    ...                                                'parameterName': parameter,
    ...                                                'value': value}]}]
    ...                  where:
    ...                    dist_name: Object dist name ie. "MRBTS-1/LNBTS-1/LNMME-0"
    ...                    parameter: Parameter name ie. "ipAddrPrim"
    ...                    operation: Parameter operation (update or delete)
    ...                    value: Parameter value ie. "10.0.1.99" or [{"eea1":0, "eea0":1, "eea3":8, "eea2":0}]
    ...     :param gnb_id:     GNB id - related to Test Line configuration.
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     :param timeout:    Timeout for the operation
    ...     :param skip_parameter_relation_errors:    if True then skip parameter relation errors, default False
    ...     :param should_activate:    if True activate plan automatically
    gnbscf.perform_bts_delta_commissioning    delta=${delta}    bts_id=${gnb_id}    timeout=${timeout}
    ...    skip_parameter_relation_errors=${skip_parameter_relation_errors}    should_activate=${should_activate}
    ...    du_id=${du_id}

Perform Configuration Parameter Recommissioning On gNB
    [Arguments]   ${dist_name}    ${param_name}    ${param_value}    ${operation}=update    ${gnb_id}=0
    ...    ${skip_parameter_relation_errors}=${false}    ${should_activate}=${true}    ${timeout}=${60}    ${du_id}=${0}
    [Documentation]    Perform recommissioning of specified configuration parameter on bts.
    ...     :param dist_name:    object dist name ie. MRBTS-{}/NRBTS-{}/NRCELL-1
    ...     :param parameter:    parameter name ie. ipAddrPrim
    ...     :param operation:    parameter operation (update or delete)
    ...     :param value:        parameter value ie. locked or unlocked
    ...     :param bts_id:       gNB id - related to Test Line configuration, default 0
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     :param skip_parameter_relation_errors:     If True then skip parameter relation errors, default False
    ...     :param should_activate:                    If True activate plan automatically, default True
    ...     :param timeout:                            Time to wait for positive procedure result, default 60
    gnbscf.perform_configuration_parameter_recommissioning    dist_name=${dist_name}    parameter=${param_name}
    ...    value=${param_value}    operation=${operation}    bts_id=${gnb_id}    timeout=${timeout}
    ...    skip_parameter_relation_errors=${skip_parameter_relation_errors}    should_activate=${should_activate}
    ...    du_id=${du_id}

Verify Configuration Rejection on gNB
    [Arguments]  ${scf_file}    ${gnb_id}=${0}    ${skip_parameter_relation_errors}=${false}    ${timeout}=${60}
    ...    ${should_activate}=${false}    ${du_id}=${0}
    [Documentation]    Verify if given configuration was rejected
    ...     :param scf_file:                          path to the scf file
    ...     :param gnb_id:                            gNB id - related to Test Line configuration.
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     :param skip_parameter_relation_errors:    skip parameter relation errors
    ...     :param timeout:                           timeout for the operation. It is based on observed test times
    ...     :param should_activate:                   if True it should automatically activate plan
    gnbscf.verify_configuration_rejection    scf_file=${scf_file}    bts_id=${gnb_id}    timeout=${timeout}
    ...    skip_parameter_relation_errors=${skip_parameter_relation_errors}    should_activate=${should_activate}
    ...    du_id=${du_id}

Perform Object Recommissioning On gNB
    [Arguments]  ${dist_name}    ${parameter}    ${operation}    ${bts_id}=${0}
    ...          ${skip_parameter_relation_errors}=${False}    ${should_activate}=${True}
    ...          ${timeout}=180    ${du_id}=${0}
    [Documentation]  Perform recommissioning of specified configuration parameter on bts.
    ...     :param dist_name:object dist name ie. "MRBTS-{}/NRBTS-{}/NRPGRP-0"
    ...     :param parameter: list of dicts ie.
    ...        [parameterName=lbpsPeriodList
    ...         operation=update
    ...         value=[{
    ...                     lbpsDayOfWeek=Mon
    ...                     lbpsDuration=10
    ...                     lbpsStartTimeHour=12
    ...                     lbpsStartTimeMinute=10
    ...                     lbpsSuspended=notSuspended}]]
    ...     :param operation: parameter operation (create, update or delete)
    ...     :param bts_id: BTS(eNB/gNB) id - related to Test Line configuration, default 0
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     param skip_parameter_relation_errors: If True then skip parameter relation errors, default False
    ...     :param should_activate: If True activate plan automatically, default True
    ...     :param timeout: Time to wait for positive procedure result, default 180
    ...     :return: dict with operation result
    gnbscf.perform_object_recommissioning    dist_name=${dist_name}    parameter=${parameter}    operation=${operation}
    ...         bts_id=${bts_id}    skip_parameter_relation_errors=${skip_parameter_relation_errors}
    ...         should_activate=${should_activate}    timeout=${timeout}    du_id=${du_id}

Reset Configuration on gNB
    [Arguments]    ${gnb_id}=${0}  ${du_id}=${0}  ${remove_operator_certificates}=${False}
    ...            ${remove_user_account_credentials}=${False}  ${repair_center_reset}=${False}
    [Documentation]    Reset configuration
    ...    :param gnb_id:    gNB id - related to Test Line configuration.
    ...    :param du_id:     DU id  - related to Test Line configuration.
    ...    :param remove_operator_certificates:    Remove operator certificates
    ...    :param remove_user_account_credentials: Remove user account credentials
    ...    :param repair_center_reset:             Remove all from both partitions
    gnbscf.reset_configuration   bts_id=${gnb_id}   du_id=${du_id}
    ...                          remove_operator_certificates=${remove_operator_certificates}
    ...                          remove_user_account_credentials=${remove_user_account_credentials}
    ...                          repair_center_reset=${repair_center_reset}

Disable Collecting All PM Counters
    [Arguments]    ${gnb_id}=${0}    ${du_id}=${0}
    [Documentation]    Disable all pm counters on gnb
    ...     :param bts_id: BTS(eNB/gNB) id - related to Test Line configuration, default 0
    ...     :param du_id: DU id - related to Test Line configuration, default 0
    gnbscf.disable_enable_all_pm_counters    bts_id=${gnb_id}    du_id=${du_id}    value=disabled

Set Collecting Interval for All PM Counters
    [Arguments]    ${gnb_id}=${0}    ${du_id}=${0}     ${value}=5min
    [Documentation]    Set collecting interval for all pm counters on gnb
    ...     :param bts_id: BTS(eNB/gNB) id - related to Test Line configuration, default 0
    ...     :param du_id: DU id - related to Test Line configuration, default 0
    ...     :param value: New value of counter parameters (5min/15min/30min/60min/360min/720min/14400min)
    gnbscf.disable_enable_all_pm_counters    bts_id=${gnb_id}    du_id=${du_id}    value=${value}

Activate lssConfig parameter
    [Arguments]   ${snap_dest}   ${lss_ip}    ${lss_port}   ${mrbts_id}=${tl.gnbs[0].instance_id}
    [Documentation]  changes lssConfig parameter value or adds a new one if it does not exist, sets remote snapshot
    ...  destination
    ...     :param snap_dest:   new value of  parameter diagSnapDestination (NetAct/lss)
    ...     :param lss_ip:      ip address of remote server
    ...     :param lss_port:    port number for lss connection
    ${list_param_to_change}=    Create Dictionary    lssIPaddress    ${lss_ip}
    Set To Dictionary    ${list_param_to_change}    lssPortNo=${lss_port}
    @{list}=    Create list    ${list_param_to_change}
    Perform Configuration Parameter Recommissioning On gNB
    ...    dist_name=MRBTS-${mrbts_id}/MNL-1/MNLENT-1/TRBLCADM-1
    ...    param_name=diagSnapDestination
    ...    param_value=${snap_dest}
    ...    operation=update
    ...    skip_parameter_relation_errors=${True}
    ...    timeout=300
    Perform Configuration Parameter Recommissioning On gNB
    ...    dist_name=MRBTS-${mrbts_id}/MNL-1/MNLENT-1/TRBLCADM-1
    ...    param_name=lssConfig
    ...    param_value=@{list}
    ...    operation=update
    ...    timeout=300
