*** Settings ***

Library    taf.rfrl.bts.devices.du.link_verification.GnbLinkVerification    WITH NAME      gnblink
Library    taf.rfrl.bts.devices.du.combined.cell_operations.GnbCombinedCellOperations    WITH NAME    gnbcombinedcell


*** Keywords ***
Break sctp connectivity between enb and gnb on gNB side
    [Arguments]    ${gnb_id}=0    ${du_id}=${0}
    [Documentation]    Verify sctp connection is active on device then block sctp protocol by firewall rule.
    ...    :param gnb_id:    GNB id - releated to test line configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    gnblink.break_sctp_connectivity_between_enb_and_gnb    bts_id=${gnb_id}    du_id=${du_id}

Restore sctp connectivity between enb and gnb on gNB side
    [Arguments]    ${gnb_id}=0    ${du_id}=${0}
    [Documentation]    Verify sctp connection is inactive on device then unblock sctp protocol by firewall rule.
    ...    :param gnb_id:    GNB id - releated to test line configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    gnblink.restore_sctp_connectivity_between_enb_and_gnb    bts_id=${gnb_id}    du_id=${du_id}

Verify sctp connection has been terminated on gNB side
    [Arguments]    ${gnb_id}=0    ${du_id}=${0}
    [Documentation]    Verify if SCTP Xp link socket stream is NOT marked as ESTAB.
    ...    :param gnb_id:    GNB id - releated to test line configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    gnblink.verify_sctp_connection_has_been_terminated    bts_id=${gnb_id}    du_id=${du_id}

Verify sctp connection on gNB is active
    [Arguments]    ${gnb_id}=0    ${du_id}=${0}
    [Documentation]    Verify if SCTP Xp link socket stream exists and it's state is marked as ESTAB.
    ...    :param gnb_id:    GNB id - releated to test line configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ${is_active}=    gnblink.verify_sctp_connection_is_active    bts_id=${gnb_id}    du_id=${du_id}
    Should Be True    ${is_active}    msg=Sctp connection on gNB is not active

Lock X2 link on gNB
    [Arguments]    ${gnb_id}=0    ${du_id}=${0}
    [Documentation]    Lock X2 link on gNB.
    ...    :param gnb_id:    GNB id - related to test line configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    gnbcombinedcell.lock_x2_link    gnb_id=${gnb_id}    du_id=${du_id}

Unlock X2 link on gNB
    [Arguments]    ${gnb_id}=0    ${du_id}=${0}
    [Documentation]    Unlock X2 link on gNB.
    ...    :param gnb_id:    GNB id - related to test line configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    gnbcombinedcell.unlock_x2_link    gnb_id=${gnb_id}    du_id=${du_id}

Verify AaShell connection on gNB is active
    [Arguments]    ${gnb_id}=0   ${bts_ip}=192.168.255.129    ${port}=15007   ${timeout}=${60}    ${du_id}=${0}
    [Documentation]    Verify if connection to AaShell is established
    ...    :param gnb_id:    GNB id - releated to test line configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...    :param bts_ip: Ip address of BTS
    ...    :param port: Port number
    ...    :param timeout: Time to wait for positive procedure result
    ${is_active}=    gnblink.verify_aashell_connection_is_active  bts_ip=${bts_ip}   port=${port}
    ...    bts_id=${gnb_id}   timeout=${timeout}    du_id=${du_id}

Verify AaShell connection on gNB is not active
    [Arguments]    ${gnb_id}=0   ${bts_ip}=192.168.255.129    ${port}=15007   ${timeout}=${60}    ${du_id}=${0}
    [Documentation]    Verify if connection to AaShell is not established
    ...    :param gnb_id:    GNB id - releated to test line configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...    :param bts_ip: Ip address of BTS
    ...    :param port: Port number
    ...    :param timeout: Time to wait for positive procedure result
    ${is_active}=   gnblink.verify_aashell_connection_is_not_active   bts_ip=${bts_ip}   port=${port}
    ...     bts_id=${gnb_id}   timeout=${timeout}    du_id=${du_id}

