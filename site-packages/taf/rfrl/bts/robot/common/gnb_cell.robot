*** Keywords ***
Verify Cell Statuses
    [Arguments]    ${gnb_id}=0    ${cell_id}=1    ${du_id}=0    ${operational_state}=${None}
    ...    ${procedural_status}=${None}    ${availability_status}=${None}
    ...    ${administrative_state}=${None}  ${blocking_state}=${None}  ${usage_state}=${None}  ${barring_status}=${None}
    ...    ${cell_type}=all
    gnbcell.verify_cell_statuses    bts_id=${gnb_id}    cell_id=${cell_id}    du_id=${du_id}
    ...    availability_status=${availability_status}    operational_state=${operational_state}
    ...    procedural_status=${procedural_status}     administrative_state=${administrative_state}
    ...    blocking_state=${blocking_state}  usage_state=${usage_state}  barring_status=${barring_status}

Verify gNB Cell is onAir
    [Arguments]    ${gnb_id}=0    ${cell_id}=1    ${du_id}=${0}
    [Documentation]    Verify 'Operational state' is 'Enabled' and 'Availability status' is 'Online'
    ...     :param gnb_id:    ID of gNB, default set to 0
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     :param cell_id:   ID of cell, num 1 to 8 can be used, default set to 1.
    gnbcell.verify_cell_is_onair    bts_id=${gnb_id}    cell_id=${cell_id}    du_id=${du_id}

Verify OAM Cell Setup
    [Arguments]    ${gnb_id}=0    ${cell_id}=1    ${du_id}=${0}    ${cell_info}=${None}    ${verify_bts_status}=${True}
    ...            ${cell_type}=nr    ${procedural_status}=configured    ${administrative_state}=unlocked
    ...            ${blocking_state}=unblocked    ${availability_status}=online    ${operational_state}=enabled
    ...            ${usage_state}=${None}    ${barring_status}=unbarred
    [Documentation]    Verify Specific Cell status and BTS Cell setup status
    ...     :param gnb_id:    Id of gNB, default 0
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     :param cell_id:   Id of cell, default 1
    ...     :param cell_info: dict - output from get_cells_info for particular cell.
    ...     :param str cell_type: Cell type of given RAT: "lte", "wcdma", "gsm", "nr" (5G). Default: "nr".
    ...     :param verify_bts_status: True/False - flag to check bts statuses
    ...     :param availability_status: Expected cell availability status
    ...     :param operational_state: Expected cell operational state
    ...     :param administrative_state: Expected cell administrative state
    ...     :param blocking_state: Expected cell blocking state
    ...     :param procedural_status: Expected cell procedural status
    ...     :param usage_state: Expected cell usage state
    ...     :param barring_status: expected cell barring status
    gnbcell.verify_cell_setup    bts_id=${gnb_id}    cell_id=${cell_id}    du_id=${du_id}    cell_info=${cell_info}
    ...                          verify_bts_status=${verify_bts_status}    cell_type=${cell_type}
    ...                          blocking_state=${blocking_state}    availability_status=${availability_status}
    ...                          operational_state=${operational_state}    procedural_status=${procedural_status}
    ...                          administrative_state=${administrative_state}   usage_state=${usage_state}
    ...                          barring_status=${barring_status}

Verify Setup Of All Cells
    [Arguments]    ${gnb_id}=0    ${du_id}=${0}    ${cell_type}=all    ${verify_bts_status}=${TRUE}
    ...            ${blocking_state}=unblocked    ${availability_status}=online    ${operational_state}=enabled
