*** Settings ***

Library    taf.collectors.core      WITH NAME   core
Library    taf.collectors.btslog    WITH NAME   btslog
Library    taf.rfrl.bts.devices.du.logs_collecting.basic_logs.EnbLog    WITH NAME      enblog
Library    taf.rfrl.bts.devices.du.logs_collecting.btslog_collector.EnbBtslogCollector    WITH NAME  enbbtslogcollector


*** Keywords ***
Collect Snapshot From eNB
    [Arguments]       ${log_dir}=${OUTPUT DIR}    ${enb_id}=${0}    ${timeout}=${900}    ${du_id}=${0}
    ...    ${snapshot_coverage}=Full
    [Documentation]    Collect snapshot via API and save to local machine.
    ...     :param log_dir:   Directory where snapshot will be collected.
    ...     :param enb_id:    ENB id - related to Test Line configuration.
    ...     :param timeout:   Timeout for the operation
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ...     :param snapshot_coverage:  Full or Minor snapshot scope

    ${snapshot_path}    enblog.collect_snapshot    bts_id=${enb_id}    log_dir=${log_dir}    timeout=${timeout}
    ...                                            du_id=${du_id}    snapshot_coverage=${snapshot_coverage}

    [Return]    ${snapshot_path}

Setup eNB Btslog Collector
    [Arguments]    ${enb_id}=0  ${du_id}=0  ${common_unit_id}=0
    [Documentation]  Setup BtsLog collector - using taf.collectors
    ...              It could be called one on Suite Setup section
    ...     :param enb_id:    ENB id - related to Test Line configuration.
    ...     :param du_id: Id of DistributionUnit
    ...     :param common_unit_id: Id of CommonUnit
    enbbtslogcollector.setup_btslog_collector    bts_id=${enb_id}  du_id=${du_id}  common_unit_id=${common_unit_id}

Teardown eNB Btslog Collector
    [Arguments]    ${enb_id}=0  ${du_id}=0
    [Documentation]  Teardown BtsLog collector - using taf.collectors
    ...              It could be called one on Suite Setup section
    ...     :param enb_id:    ENB id - related to Test Line configuration.
    ...     :param du_id: Id of DistributionUnit
    enbbtslogcollector.teardown_btslog_collector    bts_id=${enb_id}  du_id=${du_id}

Get Tcpdump logs
    [Arguments]    ${interface_enb}  ${log_file_name}  ${enb_id}=0  ${du_id}=0
    [Documentation]  Download Tcpdump from bts to local logs
    ...     :param enb_id:    ENB id - related to Test Line configuration.
    ...     :param du_id: Id of DistributionUnit
    ...     :param interface_enb: State where tcpdump was started
    ...     :param log_file_name: Name of file to download
    ${directory}    enblog.download_tcpdump_from_bts    interface=${interface_enb}  log_file_name=${log_file_name}  bts_id=${enb_id}  du_id=${du_id}
    [Return]    ${directory}
