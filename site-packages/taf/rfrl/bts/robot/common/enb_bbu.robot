*** Settings ***

Library    taf.rfrl.bts.devices.du.du_operations.EnbDuOperations    WITH NAME      enbbbu


*** Keywords ***
Get eNB Sw Version
    [Arguments]    ${enb_id}=0  ${du_id}=${0}
    [Documentation]    Get current software version provided by M-Plane
    ...    :param enb_id:    ENB id - releated to test line configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    enbbbu.get_bts_sw_version    bts_id=${enb_id}  du_id=${du_id}

Reset eNB
    [Arguments]    ${enb_id}=0  ${wait_for_reconnection}=True  ${du_id}=${0}
    [Documentation]    Reset eNB and wait for reconnection.
    ...    :param enb_id:    ENB id - releated to test line configuration.
    ...    :param wait_for_reconnection:   flag which define if admin api will wait for reconnection to bts.
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    enbbbu.reset_bts    bts_id=${enb_id}    wait_for_reconnection=${wait_for_reconnection}  du_id=${du_id}

Verify eNB is onAir
    [Arguments]    ${enb_id}=0  ${du_id}=${0}
    [Documentation]    Verify if eNB is in OnAir state.
    ...     :param enb_id:    ID of eNB, default set to 0
    ...     :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    enbbbu.verify_bts_is_onair   bts_id=${enb_id}  du_id=${du_id}

Download eNB Configuration File
    [Arguments]    ${local_dir}=/tmp    ${filename}=${None}    ${config_type}=${None}    ${enb_id}=0
    ...            ${du_id}=${0}
    [Documentation]  Download configuration file (scf) from bts to local directory on device where keyword is run.
    ...    :param local_dir: directory on local device where file is saved
    ...    :param config_type: type of configuration file, one of the type: configurationAndRuntimeObjects,
    ...           configuration, runtimeObjects. When None (default value) - default AdminAPI behavior is chosen.
    ...    :param filename: name of saved scf file. Default: current_scf.xml.
    ...    :param enb_id: eNB id related to bts configuration
    ...    :param du_id: DU id(Distributed Unit) - id related to Test Line configuration - gnb.dus[]
    ${path_to_scf}    enbbbu.get_bts_configuration_file    local_dir=${local_dir}    filename=${filename}
    ...    config_type=${config_type}    bts_id=${enb_id}    du_id=${du_id}
    [Return]    ${path_to_scf}
