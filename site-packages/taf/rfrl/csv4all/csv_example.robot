*** Settings ***
Documentation       Test suite for basic CSV4ALL Tests in loop
...                 Author: Damian Pietrzyk
...                 Contact: damian.pietrzyk@nokia.com

Library             taf/rfrl/csv4all/CSV4AllTestCases.py

*** Variables ***
# Mandatory variables to send report to Reporting Portal
# Competence Area from Force Tags will be ignored
# Allowed values: ["VRF_OAM", "VRF_ORAN", "VRF_RRM", "VRF_SiSo", "VRF_TRS", "VRF_VNF", "CIS_*"]
${RP_CA}   VRF_OAM

# Allowed values: ['VRF_BLR1', 'VRF_BLR2', 'VRF_WRO1', 'VRF_WRO2', 'VRF_WRO3', 'VRF_WRO4', 'VRF_HAZ1', 'VRF_HAZ2',
                  # 'VRF_HAZ3', 'VRF_HAZ4', 'VRF_KRK', 'VRF_NPS', 'VRF_DAL', 'VRF_ULM', 'VRF_TSR1', 'VRF_TSR2',
                  # 'VRF_ESP', 'CIS_NPI_GCHN', "CIS_*"]
${RP_LOCATION}    VRF_WRO3

# Allowed values: ${RP_LOCATION} + Team prefix
${RP_ORGANIZATION}    VRF_WRO3_T03

# Email recipients for notifications (use nokia.com or internal.nsn.com domains)
# Multiple emails can be defined by separating them with commas
# Notifications include test start/end and failures
${EMAIL_RECIPIENTS}         None

#Path to taf.hw.rf_diagnostic_card custom configuration yaml
${RDC_CONFIG}             /home/ute/config.yaml

# Software versions used in node definitions
${INITIAL_SW}               None
${TARGET_SW}                None

# Test iteration count used in keyword call
${ITERATIONS}               1

# Dictionary used for Netact tests
&{NETACT_DICT}            name=srnclab1028               username=omc     password=password_to_netact
...                       ip_version=IPv4     security_mode=no TLS

# Node definitions for the test configuration
# Single BTS or fullrack (dualcore, including Airscale + FSM3) configurations require one node
# 4G5G configurations require two nodes
# Define nodes based on logical BTS count
# Node information includes mainly VM IP and software versions; other details are fetched automatically

# UTE testline initialization (VM definition in init must have a Connection object linking VM to BTS)
&{NODE1}                    testline_object=${tl.gnbs[0]}
...                         source_sw=${INITIAL_SW}
...                         target_sw=${TARGET_SW}

# Explicit declaration of VM IP
&{NODE2}                    node_vm=10.42.21.37
...                         source_sw=${INITIAL_SW}
...                         target_sw=${TARGET_SW}

# Explicit declaration of non-UTE VM with non-standard credentials
&{vm_dict}                  host=10.42.21.38
...                         user=non_ute
...                         password=admin123

&{NODE3}                    node_vm=${vm_dict}
...                         source_sw=${INITIAL_SW}
...                         target_sw=${TARGET_SW}

# Explicit declaration of secondary VM for dual-core (fullrack) configurations
# If UTE testline init is used, secondary VM is automatically detected
&{NODE4}                    node_vm=10.42.21.38
...                         secondary_vm=10.42.21.39
...                         source_sw=${INITIAL_SW}
...                         target_sw=${TARGET_SW}


# Alias for easier identification of nodes in logs for multinode configurations
&{NODE5}                    testline_object=${tl.enbs[0]}
...                         node_alias=4gANCHOR
...                         source_sw=${INITIAL_SW}
...                         target_sw=${TARGET_SW}

# Each node can have its own set of allowed faults during test operation
# Temporary: Expected during upgrade/reset of adjacent node, will be ignored only during its downtime
# Custom: Will be ignored throughout the entire test execution
# Allowed alarms can be passed as e.g 1234,2345 or ${1234, 2345} or @{1234, 2345} or ${CUSTOM_ALLOWED}
@{CUSTOM_ALLOWED}    3456  4567
&{NODE6}                    testline_object=${tl.gnbs[1]}
...                         source_sw=${INITIAL_SW}
...                         target_sw=${TARGET_SW}
...                         temporary_allowed_alarms=${1234, 2345}
...                         custom_allowed_alarms=${CUSTOM_ALLOWED}

# List of nodes passed to test keywords
@{NODES}                    ${NODE1}    ${NODE2}    ${NODE3}
@{UPGRADE_NODES}            ${NODE2}    ${NODE1}    ${NODE3}

*** Test Cases ***
E2E_TL_SW_Upgrade_Rollback_with_OAM_KPI_single_node_upgrade
    # This testcase will upgrade and rollback only node1 in configuration consisting of 3 nodes (defined in NODES variable)
    # Nodes which are not currently upgraded will still be monitored for any impacting faults
    [Timeout]   24h
    E2E TL SW UPGRADE ROLLBACK WITH OAM KPI    ${NODES}  ${NODE1}  ${ITERATIONS}

E2E_TL_SW_Upgrade_Rollback_with_OAM_KPI_multiple_node_upgrade
    # This testcase will upgrade and rollback all nodes in configuration consisting of 3 nodes (defined in NODES variable)
    # Nodes will be upgraded in sequence provided in the UPGRADE_NODES, by changing the sequence of the list you change the upgrade sequence
    # In this example: upgrade node2, upgrade node1, upgrade node3, rollback node2, rollback node1, rollback node3
    # Nodes which are not currently upgraded will still be monitored for any impacting faults
    [Timeout]   24h
    E2E TL SW UPGRADE ROLLBACK WITH OAM KPI    ${NODES}  ${UPGRADE_NODES}  ${ITERATIONS}

E2E_TL_Parallel_SW_Upgrade_Rollback_with_OAM_KPI
    # This testcase will upgrade and rollback all nodes simultaneously
    # It will first download the software to all of them and wait for all to finish
    # Then simultaneous activation of all nodes will be performed
    [Timeout]   24h
    E2E PARALLEL SW UPGRADE ROLLBACK WITH OAM KPI    ${NODES}  ${NODES}  ${ITERATIONS}

E2E_TL_Activation_Reset_with_OAM_KPI
    # This testcase will activate sw in loops
    # Starting SW will be candidate software and will be activated alternately to candidate T1 software
    [Timeout]   24h
    E2E TL ACTIVATION RESET TEST    ${NODES}  ${NODE1}   ${ITERATIONS}

