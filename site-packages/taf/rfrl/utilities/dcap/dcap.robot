*** Settings ***
Documentation    This library provides keywords for collecting logs under DCAP in test execution.
...              Usage: DCAP preconditions should be used under [Setup] in every testcase,
...              wheras postconditions should be used in [Teardown]
...              Author: Lukasz Skoczylas

Library     taf.rfrl.utilities.dcap.ute_dcap.UteDcap    WITH NAME   dcap

*** Keywords ***
Wait Until DCAP Connection Is Established
    Wait Until Keyword Succeeds    20x    5s   dcap.connect

Start DCAP on UTE VM
    [Arguments]        ${timeout}=${300}   ${wait}=${True}
    [Documentation]    Start DCAP containers on main UTE VM

    dcap.start_dcap     timeout=${timeout}  wait=${wait}

Stop DCAP on UTE VM
    [Arguments]        ${timeout}=${120}
    [Documentation]    Stop DCAP containers on main UTE VM

    dcap.stop_dcap     timeout=${timeout}

Update DCAP on UTE VM
    [Arguments]        ${timeout}=${1800}
    [Documentation]    Update DCAP containers to latest version on main UTE VM

    dcap.update_dcap     timeout=${timeout}

DCAP Start Tracing gNB
    [Arguments]    ${bts_trace_profile}=Default tracing profile
    ...            ${gnb_trace_profile}=Default tracing profile
    ...            ${enb_trace_profile}=Default tracing profile
    ...            ${gnb_id}=0
    ...            ${gnb_ip}=${None}
    ...            ${gnb_port}=${None}
    ...            ${gnb_username}=${None}
    ...            ${gnb_password}=${None}
    [Documentation]    Start gNB trace on DCAP. It apply to any SBTS (5G, 4G, MutliRAT)
    dcap.connect
    dcap.add_gnb            gnb_ip=${gnb_ip}    gnb_id=${gnb_id}    gnb_port=${gnb_port}
    ...                     gnb_username=${gnb_username}    gnb_password=${gnb_password}
    dcap.start_trace_gnb    gnb_ip=${gnb_ip}    gnb_id=${gnb_id}    gnb_port=${gnb_port}
    ...                     gnb_username=${gnb_username}    gnb_password=${gnb_password}
    ...                     bts_trace_profile=${bts_trace_profile}
    ...                     gnb_trace_profile=${gnb_trace_profile}
    ...                     enb_trace_profile=${enb_trace_profile}
    dcap.wait_for_trace_running

DCAP Start Tracing eNB
    [Arguments]    ${bts_trace_profile}=Default tracing profile
    ...            ${enb_trace_profile}=Default tracing profile
    ...            ${enb_id}=0
    ...            ${enb_ip}=${None}
    ...            ${enb_port}=${None}
    ...            ${enb_username}=${None}
    ...            ${enb_password}=${None}
    [Documentation]    Start eNB trace on DCAP
    dcap.connect
    dcap.add_enb            enb_ip=${enb_ip}    enb_id=${enb_id}    enb_port=${enb_port}
    ...                     enb_username=${enb_username}    enb_password=${enb_password}
    dcap.start_trace_enb    enb_ip=${enb_ip}    enb_id=${enb_id}    enb_port=${enb_port}
    ...                     enb_username=${enb_username}    enb_password=${enb_password}
    ...                     bts_trace_profile=${bts_trace_profile}
    ...                     enb_trace_profile=${enb_trace_profile}
    dcap.wait_for_trace_running

DCAP Stop Tracing and Collect Results
    [Documentation]     Description: Stops DCAP tracing and collects the results
    ...                 param   trace_id (optional): stops trace by trace_id and collects the results from this trace
    ...                 param   log_dir (optional): directory to collect the results in
    ...                 param   with_name (optional): the filename of collected zip archive
    [Arguments]         ${trace_id}=None    ${log_dir}=None     ${with_name}=None
    dcap.stop_trace     trace_id=${trace_id}
    dcap.get_results    trace_id=${trace_id}   log_dir=${log_dir}   with_name=${with_name}
    dcap.delete_trace   trace_id=${trace_id}

DCAP Collect SCF from BTS
    [Documentation]     Description: Collects SCF from BTS using DCAP
    ...                 param    log_dir: Directory to collect the results in
    ...                 param    with_name:  Filename of the collected results. Example: `${TEST_NAME}_res.zip`
    ...                 returns  path to the extracted log
    [Arguments]    ${log_dir}=None     ${with_name}=None
    ...            ${gnb_ip}=${None}
    ...            ${gnb_port}=${None}
    ...            ${gnb_username}=${None}
    ...            ${gnb_password}=${None}
    ${bts_custom_profile}=            Create List     scf
    dcap.connect
    dcap.start_trace_gnb                                 gnb_ip=${gnb_ip}
    ...                                                  gnb_port=${gnb_port}
    ...                                                  gnb_username=${gnb_username}
    ...                                                  gnb_password=${gnb_password}
    ...                                                  bts_custom_profile=${bts_custom_profile}
    dcap.wait_for_trace_running
    ${filepath}=       dcap.get_results                  log_dir=${log_dir}        with_name=${with_name}
    ${log_filepath}=   dcap.extract_logfile_from_zip     path=${filepath}          log_name=scf
    ...                                                  collect_trace_logs=True   delete_zip=True
    [Return]           ${log_filepath}

DCAP Collect Snapshot from BTS
    [Documentation]     Description: Collects snapshot from BTS using DCAP
    ...                 param    log_dir: Directory to collect the results in
    ...                 param    with_name:  Filename of the collected results. Example: `${TEST_NAME}_res.zip`
    ...                 returns  path to the extracted log
    [Arguments]    ${log_dir}=None     ${with_name}=None
    ...            ${gnb_ip}=${None}
    ...            ${gnb_port}=${None}
    ...            ${gnb_username}=${None}
    ...            ${gnb_password}=${None}
    ${bts_custom_profile}=            Create List     immediateSnapshot
    ${collection_timing}=             Set Variable    Immediate
    dcap.connect
    dcap.start_trace_gnb                  gnb_ip=${gnb_ip}
    ...                                   gnb_port=${gnb_port}
    ...                                   gnb_username=${gnb_username}
    ...                                   gnb_password=${gnb_password}
    ...                                   bts_custom_profile=${bts_custom_profile}
    ...                                   collection_timing=${collection_timing}
    dcap.wait_for_trace_running
    ${filepath}=       dcap.get_results                  log_dir=${log_dir}           with_name=${with_name}
    ${log_filepath}=   dcap.extract_logfile_from_zip     path=${filepath}             log_name=snapshot
    ...                                                  collect_trace_logs=True      delete_zip=True
    [Return]           ${log_filepath}
