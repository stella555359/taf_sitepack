*** Settings ***
Documentation    This library provides keywords for collecting logs under UTF Lab (former DCAP) in test execution.
...              Usage: UTF Lab preconditions should be used under [Setup] in every testcase,
...              wheras postconditions should be used in [Teardown]
...              Author: Lukasz Skoczylas

Library     taf.rfrl.utilities.utf_lab.ute_utf_lab.UteUtfLab    WITH NAME   utf_lab

*** Keywords ***
Wait Until UTF Lab Connection Is Established
    Wait Until Keyword Succeeds    20x    5s   utf_lab.connect

Start UTF Lab on UTE VM
    [Arguments]        ${timeout}=${300}   ${wait}=${True}
    [Documentation]    Start UTF Lab containers on main UTE VM

    utf_lab.start_utf_lab     timeout=${timeout}  wait=${wait}

Stop UTF Lab on UTE VM
    [Arguments]        ${timeout}=${120}
    [Documentation]    Stop UTF Lab containers on main UTE VM

    utf_lab.stop_utf_lab     timeout=${timeout}

Update UTF Lab on UTE VM
    [Arguments]        ${timeout}=${1800}
    [Documentation]    Update UTF Lab containers to latest version on main UTE VM

    utf_lab.update_utf_lab     timeout=${timeout}

UTF Lab Start Tracing gNB
    [Arguments]    ${bts_trace_profile}=Default tracing profile
    ...            ${gnb_trace_profile}=Default tracing profile
    ...            ${enb_trace_profile}=Default tracing profile
    ...            ${gnb_id}=0
    ...            ${gnb_ip}=${None}
    ...            ${gnb_port}=${None}
    ...            ${gnb_username}=${None}
    ...            ${gnb_password}=${None}
    ...            ${timeout}=300
    [Documentation]    Start gNB trace on UTF Lab. It apply to any SBTS (5G, 4G, MutliRAT)
    utf_lab.connect
    utf_lab.add_gnb            gnb_ip=${gnb_ip}    gnb_id=${gnb_id}    gnb_port=${gnb_port}
    ...                     gnb_username=${gnb_username}    gnb_password=${gnb_password}
    utf_lab.start_trace_gnb    gnb_ip=${gnb_ip}    gnb_id=${gnb_id}    gnb_port=${gnb_port}
    ...                     gnb_username=${gnb_username}    gnb_password=${gnb_password}
    ...                     bts_trace_profile=${bts_trace_profile}
    ...                     gnb_trace_profile=${gnb_trace_profile}
    ...                     enb_trace_profile=${enb_trace_profile}
    utf_lab.wait_for_trace_running    timeout=${timeout}

UTF Lab Start Tracing eNB
    [Arguments]    ${bts_trace_profile}=Default tracing profile
    ...            ${enb_trace_profile}=Default tracing profile
    ...            ${enb_id}=0
    ...            ${enb_ip}=${None}
    ...            ${enb_port}=${None}
    ...            ${enb_username}=${None}
    ...            ${enb_password}=${None}
    ...            ${timeout}=300
    [Documentation]    Start eNB trace on UTF Lab
    utf_lab.connect
    utf_lab.add_enb            enb_ip=${enb_ip}    enb_id=${enb_id}    enb_port=${enb_port}
    ...                     enb_username=${enb_username}    enb_password=${enb_password}
    utf_lab.start_trace_enb    enb_ip=${enb_ip}    enb_id=${enb_id}    enb_port=${enb_port}
    ...                     enb_username=${enb_username}    enb_password=${enb_password}
    ...                     bts_trace_profile=${bts_trace_profile}
    ...                     enb_trace_profile=${enb_trace_profile}
    utf_lab.wait_for_trace_running    timeout=${timeout}

UTF Lab Stop Tracing and Collect Results
    [Documentation]     Description: Stops UTF Lab tracing and collects the results
    ...                 param   trace_id (optional): stops trace by trace_id and collects the results from this trace
    ...                 param   log_dir (optional): directory to collect the results in
    ...                 param   with_name (optional): the filename of collected zip archive
    [Arguments]         ${trace_id}=None    ${log_dir}=None     ${with_name}=None
    utf_lab.stop_trace     trace_id=${trace_id}
    utf_lab.get_results    trace_id=${trace_id}   log_dir=${log_dir}   with_name=${with_name}
    utf_lab.delete_trace   trace_id=${trace_id}

UTF Lab Collect SCF from BTS
    [Documentation]     Description: Collects SCF from BTS using UTF Lab
    ...                 param    log_dir: Directory to collect the results in
    ...                 param    with_name:  Filename of the collected results. Example: `${TEST_NAME}_res.zip`
    ...                 returns  path to the extracted log
    [Arguments]    ${log_dir}=None     ${with_name}=None
    ...            ${gnb_ip}=${None}
    ...            ${gnb_port}=${None}
    ...            ${gnb_username}=${None}
    ...            ${gnb_password}=${None}
    ${bts_custom_profile}=            Create List     scf
    utf_lab.connect
    utf_lab.start_trace_gnb                                 gnb_ip=${gnb_ip}
    ...                                                  gnb_port=${gnb_port}
    ...                                                  gnb_username=${gnb_username}
    ...                                                  gnb_password=${gnb_password}
    ...                                                  bts_custom_profile=${bts_custom_profile}
    utf_lab.wait_for_trace_running
    ${filepath}=       utf_lab.get_results                  log_dir=${log_dir}        with_name=${with_name}
    ${log_filepath}=   utf_lab.extract_logfile_from_zip     path=${filepath}          log_name=scf
    ...                                                  collect_trace_logs=True   delete_zip=True
    [Return]           ${log_filepath}

UTF Lab Collect Snapshot from BTS
    [Documentation]     Description: Collects snapshot from BTS using UTF Lab
    ...                 param    log_dir: Directory to collect the results in
    ...                 param    with_name:  Filename of the collected results. Example: `${TEST_NAME}_res.zip`
    ...                 returns  path to the extracted log
    [Arguments]    ${log_dir}=None     ${with_name}=None
    ...            ${gnb_ip}=${None}
    ...            ${gnb_port}=${None}
    ...            ${gnb_username}=${None}
    ...            ${gnb_password}=${None}
    ${bts_custom_profile}=            Create List     immediateSnapshot
    ${collection_timing}=             Set Variable    Immediate
    utf_lab.connect
    utf_lab.start_trace_gnb                  gnb_ip=${gnb_ip}
    ...                                   gnb_port=${gnb_port}
    ...                                   gnb_username=${gnb_username}
    ...                                   gnb_password=${gnb_password}
    ...                                   bts_custom_profile=${bts_custom_profile}
    ...                                   collection_timing=${collection_timing}
    utf_lab.wait_for_trace_running
    ${filepath}=       utf_lab.get_results                  log_dir=${log_dir}           with_name=${with_name}
    ${log_filepath}=   utf_lab.extract_logfile_from_zip     path=${filepath}             log_name=snapshot
    ...                                                  collect_trace_logs=True      delete_zip=True
    [Return]           ${log_filepath}
