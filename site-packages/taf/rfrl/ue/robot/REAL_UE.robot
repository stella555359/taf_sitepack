Start Data Transfer DL&UL and Verify Troughput for Multi Radio Bearer
    [Arguments]    ${duration}    ${tput_dl}    ${tput_ul}    ${protocol}=udp   ${parallel_streams_dl}=1    ${parallel_streams_ul}=1
    ...    ${size_packet}=1400B    ${deviation}=25%     ${deviation_dl}=${deviation}    ${deviation_ul}=${deviation}
    ...    ${size_packet_dl}=${size_packet}    ${size_packet_ul}=${size_packet}
    ...    ${buffer_client_dl}=${None}    ${buffer_server_dl}=${None}    ${buffer_client_ul}=${None}    ${buffer_server_ul}=${None}
    ...    ${interval}=1  ${qci_dl}=${None}  ${qci_ul}=${None}    ${linux_congestion_dl}=${None}    ${linux_congestion_ul}=${None}
    ...    ${alias}=UE    ${clear_source_dir}=${False}
    [Documentation]    Data Transfer DL and UL, Verification Average Troughput
    ...     :param duration:               Duration of transmision, exaple: 600s
    ...     :param tput_dl:                Expected tput for DL, example 100 Mbits/sec
    ...     :param tput_ul:                Expected tput for UL, example 100 Mbits/sec
    ...     :param protocol:               UDP or TCP
    ...     :param deviation:              Percentage of deviation in tput, example: 25%
    ...     :param paralel_streams_dl:     Number of parallel streams for DL
    ...     :param paralel_streams_ul:     Number of parallel streams for UL
    ...     :param size_packet:            Parameter -l for UDP and -M for TCP in iPerf
    ...     :param size_packet_dl:         Parameter -l for UDP and -M for TCP in iPerf (downlink)
    ...     :param size_packet_ul:         Parameter -l for UDP and -M for TCP in iPerf (uplink)
    ...     :param buffer_client_dl:       Parameter -w in iPerf for client (downlink)
    ...     :param buffer_server_dl:       Parameter -w in iPerf for server (downlink)
    ...     :param buffer_client_ul:       Parameter -w in iPerf for client (uplink)
    ...     :param buffer_server_ul:       Parameter -w in iPerf for server (uplink)
    ...     :param interval:               Parameter -i in iPerf
    ...     :param qci_dl:                 UDP/TCP port for DL
    ...     :param qci_ul:                 UDP/TCP port for UL
    ...     :param linux_congestion_dl:    TCP congestion control algorithm (Linux only) (downlink)
    ...     :param linux_congestion_ul:    TCP congestion control algorithm (Linux only) (uplink)
    ...     :param alias:                  UE connection name
    ...     :param clear_source_dir:       Clear logs source directory

    ${dl_tput_per_radio_bearer}    Calculate Tput Per Stream    parallel_streams_number=2    total_tput=${tput_dl}
    ${ul_tput_per_radio_bearer}    Calculate Tput Per Stream    parallel_streams_number=2    total_tput=${tput_ul}

    Start Data Transfer on Real UE    dt_name=DT_DL_DEFAULT    ue_alias=${alias}    direction=dl    protocol=${protocol}
    ...    duration=${duration}    tput=${dl_tput_per_radio_bearer}    parallel_streams=${parallel_streams_dl}
    ...    size_packet=${size_packet_dl}    buffer_client=${buffer_client_dl}    buffer_server=${buffer_server_dl}
    ...    interval=${interval}    qci=${qci_dl}    linux_congestion=${linux_congestion_dl}    multi_radio_bearer=${False}

    Start Data Transfer on Real UE    dt_name=DT_UL_DEFAULT    ue_alias=${alias}    direction=ul    protocol=${protocol}
    ...    duration=${duration}    tput=${ul_tput_per_radio_bearer}    parallel_streams=${parallel_streams_ul}
    ...    size_packet=${size_packet_ul}    buffer_client=${buffer_client_ul}  buffer_server=${buffer_server_ul}
    ...    interval=${interval}    qci=${qci_ul}    linux_congestion=${linux_congestion_ul}    multi_radio_bearer=${False}

    Start Data Transfer on Real UE    dt_name=DT_DL_DEDICATED    ue_alias=${alias}    direction=dl    protocol=${protocol}
    ...    duration=${duration}    tput=${dl_tput_per_radio_bearer}    parallel_streams=${parallel_streams_dl}
    ...    size_packet=${size_packet_dl}    buffer_client=${buffer_client_dl}    buffer_server=${buffer_server_dl}
    ...    interval=${interval}    qci=${qci_dl}    linux_congestion=${linux_congestion_dl}    multi_radio_bearer=${True}

    Start Data Transfer on Real UE    dt_name=DT_UL_DEDICATED    ue_alias=${alias}    direction=ul    protocol=${protocol}
    ...    duration=${duration}    tput=${ul_tput_per_radio_bearer}    parallel_streams=${parallel_streams_ul}
    ...    size_packet=${size_packet_ul}    buffer_client=${buffer_client_ul}    buffer_server=${buffer_server_ul}
    ...    interval=${interval}    qci=${qci_ul}    linux_congestion=${linux_congestion_ul}    multi_radio_bearer=${True}

    Wait for truput stabilization
    Collect logs during data transfer   direction=BOTH    is_traffic_multi_radio_bearer=${True}
    ue.Check Data Transfer is Alive     dt_name=DT_DL_DEFAULT
    ue.Check Data Transfer is Alive     dt_name=DT_DL_DEDICATED
    ue.Check Data Transfer is Alive     dt_name=DT_UL_DEFAULT
    ue.Check Data Transfer is Alive     dt_name=DT_UL_DEDICATED
    Verify Multi Radio Bearer Traffic   protocol=${protocol}
    ue.Await Data Transfer Finish       dt_name=DT_DL_DEFAULT
    ue.Await Data Transfer Finish       dt_name=DT_DL_DEDICATED
    ue.Await Data Transfer Finish       dt_name=DT_UL_DEFAULT
    ue.Await Data Transfer Finish       dt_name=DT_UL_DEDICATED
    Verify Average Throughput for Multi Radio Bearers       direction=DL    tput=${dl_tput_per_radio_bearer}
    ...    expected_tput=${tput_dl}    deviation=${deviation}
    Verify Average Throughput for Multi Radio Bearers       direction=UL    tput=${ul_tput_per_radio_bearer}
    ...    expected_tput=${tput_ul}    deviation=${deviation}

Perform Attach and Verify UE Properly Attached
    [Arguments]    ${alias}=UE    ${bts_type}=GNB    ${clear_source_dir}=${False}   ${timeout}=${20}
    [Documentation]    Perform Attach and Verify UE Properly Attached
    ...     :param alias:                  UE connection name
    ...     :param bts_type:               BTS type used in test
    ...     :param clear_source_dir:       Clear logs source directory
    ...     :param timeout                 Timeout for attach verification
    # TODO so far only collecting BIP logs from attach. In the futher need to add verification
    Run Keyword If  ${COLLECT_LOGS_DURING_DATA_TRANSFER}  Start collecting logs during attach
    Run Keyword If  ${ENABLE_RACH_OBSERVER}  Start Ue RACH Observer    bts_type=${bts_type}
    ue.Attach Ue    ${alias}    ${timeout}
    Wait for truput stabilization
    Run Keyword If  ${COLLECT_LOGS_DURING_DATA_TRANSFER}  Stop collecting logs after attach
    Run Keyword If  ${COLLECT_LOGS_DURING_DATA_TRANSFER}  Download logs from gNB    sub_dir=attach    clear_source_dir=${clear_source_dir}
    Run Keyword If  ${ENABLE_RACH_OBSERVER}  Verify RACH    bts_type=${bts_type}

Verify Multi Radio Bearer Traffic
    [Arguments]    ${pcap_dir}=${None}    ${sub_dir}=data_transfer    ${protocol}=udp    ${clear_source_dir}=${False}
    [Documentation]    Verify if Multi Radio Bearer Traffic is set properly
    ...     :param pcap_dir:                  path to S1-U tcpdump
    ...     :param sub_dir:                   indicates L3 call phase from which tcpdump was collected
    ...     :param protocol:                  UDP or TCP
    ...     :param clear_source_dir:          Clear logs source directory
    Download logs from gNB    sub_dir=${sub_dir}    clear_source_dir=${clear_source_dir}    is_traffic_multi_radio_bearer=${True}
    Verify Teid Values    pcap_dir=${pcap_dir}    protocol=${protocol}

Wait for truput stabilization
    Sleep  10

Wait for next PM period
    ${pm_interval_range}  gnbcounter.wait_for_next_pm_period
    Set Test Variable  ${PM_PERIOD_START_TIME}  ${pm_interval_range[0]}
    Set Test Variable  ${PM_PERIOD_END_TIME}  ${pm_interval_range[1]}
