Start Data Transfer and Verify Troughput
    [Arguments]    ${direction}    ${duration}    ${tput}    ${protocol}=udp    ${deviation}=25%    ${parallel_streams}=1    ${size_packet}=1400B
    ...    ${buffer_client}=${None}    ${buffer_server}=${None}    ${interval}=1    ${qci}=${None}    ${linux_congestion}=${None}  ${alias}=UE
    ...    ${clear_source_dir}=${False}
    [Documentation]    Data Transfer DL or UL and Verification Average Troughput
    ...     :param direction:           dl or ul
    ...     :param duration:            Duration of transmision, exaple: 600s
    ...     :param tput:                Expected tput, example 100 Mbits/sec
    ...     :param protocol:            udp or tcp
    ...     :param deviation:           Percentage of deviation in tput, example: 25%
    ...     :param parallel_streams:    Number of parallel streams
    ...     :param size_packet:         Parameter -l for UDP and -M for TCP in iPerf
    ...     :param buffer_client:       Parameter -w in iPerf for client
    ...     :param buffer_server_dl:    Parameter -w in iPerf for server
    ...     :param interval:            Parameter -i in iPerf
    ...     :param qci:                 UDP/TCP port
    ...     :param linux_congestion:    TCP congestion control algorithm (Linux only)
    ...     :param alias:               UE connection name
    ...     :param clear_source_dir:    Clear logs source directory

    ${direction_upper}    Convert To Upper Case  ${direction}

    Start Data Transfer on Real UE   dt_name=DT_${direction_upper}  ue_alias=${alias}  direction=${direction}  protocol=${protocol}
    ...  duration=${duration}  tput=${tput}  parallel_streams=${parallel_streams}  size_packet=${size_packet}
    ...  buffer_client=${buffer_client}  buffer_server=${buffer_server}  interval=${interval}  qci=${qci}    linux_congestion=${linux_congestion}
    Wait for truput stabilization
    Run Keyword If  ${COLLECT_LOGS_DURING_DATA_TRANSFER}  Collect logs during data transfer   direction=${direction_upper}
    ue.Check Data Transfer is Alive     dt_name=DT_${direction_upper}
    ue.Await Data Transfer Finish       dt_name=DT_${direction_upper}
    ue.Verify Average Throughput With Deviation   dt_name=DT_${direction_upper}   tput=${tput}   deviation=${deviation}
    [Teardown]  Run Keyword If  ${COLLECT_LOGS_DURING_DATA_TRANSFER}  Download logs from gNB    sub_dir=data_transfer
    ...    clear_source_dir=${clear_source_dir}

Start Data Transfer and Verify Troughput for Multi Radio Bearer
    [Arguments]    ${direction}    ${duration}    ${tput}    ${protocol}=udp    ${deviation}=25%    ${parallel_streams}=1    ${size_packet}=1400B
    ...    ${buffer_client}=${None}    ${buffer_server}=${None}    ${interval}=1    ${qci}=${None}    ${linux_congestion}=${None}  ${alias}=UE
    ...    ${clear_source_dir}=${False}
    [Documentation]    Data Transfer DL or UL and Verification Average Troughput
    ...     :param direction:           DL or UL
    ...     :param duration:            Duration of transmision, exaple: 600s
    ...     :param tput:                Expected tput, example 100 Mbits/sec
    ...     :param protocol:            UDP or TCP
    ...     :param deviation:           Percentage of deviation in tput, example: 25%
    ...     :param parallel_streams:    Number of parallel streams
    ...     :param size_packet:         Parameter -l for UDP and -M for TCP in iPerf
    ...     :param buffer_client:       Parameter -w in iPerf for client
    ...     :param buffer_server_dl:    Parameter -w in iPerf for server
    ...     :param interval:            Parameter -i in iPerf
    ...     :param qci:                 UDP/TCP port
    ...     :param linux_congestion:    TCP congestion control algorithm (Linux only)
    ...     :param alias:               UE connection name
    ...     :param clear_source_dir:    Clear logs source directory

    ${direction_upper}    Convert To Upper Case  ${direction}
    ${tput_per_radio_bearer}    Calculate Tput Per Stream    parallel_streams_number=2    total_tput=${tput}

    Start Data Transfer on Real UE    dt_name=DT_${direction_upper}_DEFAULT    ue_alias=${alias}    direction=${direction}    protocol=${protocol}
    ...    duration=${duration}    tput=${tput_per_radio_bearer}    parallel_streams=${parallel_streams}    size_packet=${size_packet}
    ...    buffer_client=${buffer_client}    buffer_server=${buffer_server}    interval=${interval}    qci=${qci}    linux_congestion=${linux_congestion}
    ...    multi_radio_bearer=${False}

    Start Data Transfer on Real UE    dt_name=DT_${direction_upper}_DEDICATED    ue_alias=${alias}    direction=${direction}    protocol=${protocol}
    ...    duration=${duration}    tput=${tput_per_radio_bearer}    parallel_streams=${parallel_streams}    size_packet=${size_packet}
    ...    buffer_client=${buffer_client}    buffer_server=${buffer_server}    interval=${interval}    qci=${qci}    linux_congestion=${linux_congestion}
    ...    multi_radio_bearer=${True}

    Wait for truput stabilization
    Collect logs during data transfer   direction=${direction_upper}    is_traffic_multi_radio_bearer=${True}
    ue.Check Data Transfer is Alive     dt_name=DT_${direction_upper}_DEFAULT
    ue.Check Data Transfer is Alive     dt_name=DT_${direction_upper}_DEDICATED
    Verify Multi Radio Bearer Traffic   protocol=${protocol}    clear_source_dir=${clear_source_dir}
    ue.Await Data Transfer Finish       dt_name=DT_${direction_upper}_DEFAULT
    ue.Await Data Transfer Finish       dt_name=DT_${direction_upper}_DEDICATED
    Verify Average Throughput for Multi Radio Bearers       direction=${direction_upper}    tput=${tput_per_radio_bearer}
    ...    expected_tput=${tput}    deviation=${deviation}

Start Data Transfer and Verify Troughput for Main RU and Extension Panel
    [Arguments]    ${duration}    ${main_tput}    ${ext_tput}    ${main_parallel_streams}=1    ${main_size_packet}=1400B
    ...    ${main_direction}=DL    ${ext_direction}=UL    ${main_buffer_client}=${None}    ${main_buffer_server}=${None}    ${UE_main_alias}=UE_MAIN
    ...    ${ext_parallel_streams}=1    ${ext_size_packet}=1400B    ${ext_buffer_client}=${None}    ${ext_buffer_server}=${None}    ${UE_ext_alias}=UE_EXT
    ...    ${interval}=1    ${qci}=${None}    ${linux_congestion}=${None}    ${protocol}=udp    ${main_deviation}=25%    ${ext_deviation}=25%
    ...    ${clear_source_dir}=${False}
    [Documentation]    Data Transfer DL or UL run simultaneously for main RU and extension panel and Verification Average Troughput
    ...     :param main_direction:           DL or UL for main radio unit
    ...     :param ext_direction:            DL or UL for extension panel
    ...     :param duration:                 Duration of transmision, exaple: 600s
    ...     :param main_tput:                Expected tput for maint radio unit, example 100 Mbits/sec
    ...     :param ext_tput:                 Expected tput for extension panel, example 100 Mbits/sec
    ...     :param protocol:                 UDP or TCP
    ...     :param deviation:                Percentage of deviation in tput, example: 25%
    ...     :param main_parallel_streams:    Number of parallel streams for maint radio unit
    ...     :param ext_parallel_streams:     Number of parallel streams for extension panel
    ...     :param main_size_packet:         Parameter -l for UDP and -M for TCP in iPerf for maint radio unit
    ...     :param ext_size_packet:          Parameter -l for UDP and -M for TCP in iPerf for extension panel
    ...     :param main_buffer_client:       Parameter -w in iPerf for client for maint radio unit
    ...     :param ext_buffer_client:        Parameter -w in iPerf for client for extension panel
    ...     :param main_buffer_server:       Parameter -w in iPerf for server for maint radio unit
    ...     :param ext_buffer_server:        Parameter -w in iPerf for server for extension panel
    ...     :param interval:                 Parameter -i in iPerf
    ...     :param qci:                      UDP/TCP port
    ...     :param linux_congestion:         TCP congestion control algorithm (Linux only)
    ...     :param UE_main_alias:               UE corelated with main RU - connection name
    ...     :param UE_ext_alias:                UE corelated with extension panel - connection name
    ...     :param clear_source_dir:         Clear logs source directory

    ${main_direction_upper}    Convert To Upper Case  ${main_direction}
    ${ext_direction_upper}     Convert To Upper Case  ${ext_direction}

    Start Data Transfer on Real UE    dt_name=DT_${main_direction_upper}_MAIN_RU    ue_alias=${UE_main_alias}    direction=${main_direction}    protocol=${protocol}
    ...    duration=${duration}    tput=${main_tput}    parallel_streams=${main_parallel_streams}    size_packet=${main_size_packet}
    ...    buffer_client=${main_buffer_client}    buffer_server=${main_buffer_server}    interval=${interval}    qci=${qci}    linux_congestion=${linux_congestion}

    Start Data Transfer on Real UE    dt_name=DT_${ext_direction_upper}_EXT_PANEL    ue_alias=${UE_ext_alias}    direction=${ext_direction}    protocol=${protocol}
    ...    duration=${duration}    tput=${ext_tput}    parallel_streams=${ext_parallel_streams}    size_packet=${ext_size_packet}
    ...    buffer_client=${ext_buffer_client}    buffer_server=${ext_buffer_server}    interval=${interval}    qci=${qci}    linux_congestion=${linux_congestion}

    Wait for truput stabilization
    Run Keyword If  ${COLLECT_LOGS_DURING_DATA_TRANSFER}  Collect logs during data transfer   direction=BOTH
    ue.Check Data Transfer is Alive     dt_name=DT_${main_direction_upper}_MAIN_RU
    ue.Check Data Transfer is Alive     dt_name=DT_${ext_direction_upper}_EXT_PANEL
    ue.Await Data Transfer Finish       dt_name=DT_${main_direction_upper}_MAIN_RU
    ue.Await Data Transfer Finish       dt_name=DT_${ext_direction_upper}_EXT_PANEL
    ue.Verify Average Throughput With Deviation   dt_name=DT_${main_direction_upper}_MAIN_RU   tput=${main_tput}   deviation=${main_deviation}
    ue.Verify Average Throughput With Deviation   dt_name=DT_${ext_direction_upper}_EXT_PANEL   tput=${ext_tput}   deviation=${ext_deviation}
    [Teardown]  Run Keyword If  ${COLLECT_LOGS_DURING_DATA_TRANSFER}  Download logs from gNB    sub_dir=data_transfer
    ...    clear_source_dir=${clear_source_dir}

