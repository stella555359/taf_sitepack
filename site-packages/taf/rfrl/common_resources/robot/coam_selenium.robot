Get Active SW release from webem
    [Documentation]   jun.8.chen@nokia-sbell.com
    [Arguments]    ${connection}=TMP_VERSION     ${gnb_index}=0
    ...            ${bts_host}=${tl.gnbs[${gnb_index}].cu.oam_ssh_connection_details.addr}
    ...            ${username}=${tl.gnbs[${gnb_index}].cu.oam_http_connection_details.username}
    ...            ${password}=${tl.gnbs[${gnb_index}].cu.oam_http_connection_details.password}
    Wait Until Keyword Succeeds    1 min    5 sec    coam.connect_to    bts_host=${bts_host}    bts_port=${443}
    ...    username=${username}    password=${password}   name=${connection}
    ${software_info}=    coam.get_software_info     connection=${connection}
    ${active_version}=       set variable    ${software_info['Active SW version']}
	${version_splitted}    Split String    ${active_version}    _
    ${sw_version}    Strip string    ${version_splitted[0]}
    [Return]  ${sw_version}
    [Teardown]    Run Keyword And Ignore Error    coam.teardown    connection=${connection}

