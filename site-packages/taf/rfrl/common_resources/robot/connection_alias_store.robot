Connect to All LTEEmuEnb
    [Documentation]    connect to all LTEEmuEnb which configred in testline_configuration.
    ...                :param ${alias}: it's part of final alias. For example: LTEEmuEnb0, LTEEmuEnb1...
    [Arguments]    ${alias}=LTEEmuEnb
    ${lteemuenbs}    testline_info.get_lteemu_enbs    ${tl}
    ${lteemuenbs_length}    Get Length    ${lteemuenbs}
    Run Keyword If    ${lteemuenbs_length} == 0    Fail    There is no LTEEmuEnb in testline.
    ${lteemuenb_index}    Set Variable    ${0}
    FOR    ${lteemuenb}    IN    @{lteemuenbs}
           ssh.Connect to    ${lteemuenb.default_ssh_connection_details.addr}
    ...                       ${lteemuenb.default_ssh_connection_details.username}
    ...                       ${lteemuenb.default_ssh_connection_details.password}
    ...                       alias=${alias}${lteemuenb_index}
           ${lteemuenb_index}    Evaluate    ${lteemuenb_index}+1
    END

