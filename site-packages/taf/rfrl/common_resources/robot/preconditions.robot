*** Variables ***
${LOG_PATH}             ${OUTPUT DIR}${/}Logs
${STACK_TEMP}           ${OUTPUT DIR}${/}stack_templates


*** Keywords ***
QT Phase 1 Setup Environment
    Create Log Directories
    Setup Connections

QT Phase 1 Teardown
    Teardown Connections

Create Log Directories
    Create Directory    ${LOG_PATH}
    Create Directory    ${STACK_TEMP}

Setup and start tshark
    [Arguments]    ${ssh_ip}
    ...            ${alias}
    ...            ${interface}
    ...            ${log_name}    ${log_dir}=/tmp
    ...            ${ssh_prompt}=\$
    ...            ${ssh_username}=ute    ${ssh_password}=ute
    ...            ${capture_filter}=''
    Setup Tshark    ssh_ip=${ssh_ip}
    ...             alias=${alias}
    ...             interface=${interface}
    ...             log_dir=${log_dir}    log_name=${log_name}
    ...             ssh_password=${ssh_password}
    Start Capturing     alias=${alias}
    ...                 capture_filter=${capture_filter}

Start EPCsim and load config file and reach active state
    [Arguments]    ${alias_edaemon}    ${alias_egate}
    ...            ${EPC_VM_IP}
    ...            ${EPCSIM_DIR}
    ...            ${EPCSIM_CFG}
    ...            ${egate_port}=20000    ${edaemon_port}=10000
    ...            ${SSH_USERNAME}=ute
    ...            ${SSH_PASSWORD}=ute
    ...            ${SSH_PORT}=22
    ...            ${SSH_PROMPT}=\$
    ...            ${TIMEOUT}=500
    Log to console    Starting EPCSim   ${EPCSIM_DIR}
    Setup egate    egate_port=${egate_port}
    ...            host_ip=${EPC_VM_IP}
    ...            tool_dir=${EPCSIM_DIR}
    ...            persistent=${True}
    ...            ssh_user=${SSH_USERNAME}
    ...            ssh_pass=${SSH_PASSWORD}
    ...            ssh_port=${SSH_PORT}
    ...            ssh_prompt=${SSH_PROMPT}
    ...            alias=${alias_egate}
    Setup edaemon  edaemon_port=${edaemon_port}
    ...            host_ip=${EPC_VM_IP}
    ...            tool_dir=${EPCSIM_DIR}
    ...            persistent=${True}
    ...            ssh_user=${SSH_USERNAME}
    ...            ssh_pass=${SSH_PASSWORD}
    ...            ssh_port=${SSH_PORT}
    ...            ssh_prompt=${SSH_PROMPT}
    ...            alias=${alias_edaemon}
    Link edaemons to egate  ${alias_edaemon}
    ...                     alias=${alias_egate}
    Start egate process  cfg_file=${EPCSIM_DIR}/${EPCSIM_CFG}
    ...                  timeout=10
    ...                  alias=${alias_egate}
    Log to console    Edeamon and egate starting!\nWait for "S1 link is Up " \nWait for max ${TIMEOUT}
    Execute egate command and wait for data  cmd=start
    ...                                      pass_regexp=S1 link is Up
    ...                                      timeout=${TIMEOUT}
    ...                                      alias=${alias_egate}

Teardown epcsim
    [Arguments]    ${alias}
    Collect egate log files    alias=${alias}
    Collect edaemon log files    alias=${alias}
    Teardown egate    alias=${alias}
    Teardown edaemon    alias=${alias}

Teardown testcase
    [Arguments]    ${tshark_alias}    ${epcsim_alias}
    Teardown Tshark    alias=${tshark_alias}
    Teardown epcsim    alias=${epcsim_alias}

Connect to EPC and kill edaemon and egate
    [Arguments]  ${epc_ip}
    ...          ${username}
    ...          ${password}
    ...          ${alias}
    ...          ${egate_port}=20000
    ...          ${edaemon_port}=10000
    csn.connect to  hostname=${epc_ip}
    ...             username=${username}
    ...             password=${password}
    ...             alias=${alias}
    csn.send command  command=fuser -k ${edaemon_port}/tcp
    ...               connection=${alias}
    csn.read output   connection=${alias}
    csn.send command  command=fuser -k ${egate_port}/tcp
    ...               connection=${alias}
    csn.read output   connection=${alias}

Setup EPCsim environment
    [Arguments]    ${EPCSIM_IP}
    ...            ${EPCSIM_DIR}
    ...            ${EPCSIM_CFG}
    ...            ${tshark_alias}=MME_side
    ...            ${epcsim_edaemon_alias}=edaemon_epcsim
    ...            ${epcsim_egate_alias}=egate_epcsim   ${ssh_ip}=${EPCSIM_IP}
    ...            ${tshark_interface}=eth1
    ...            ${log_dir}=/tmp    ${tshark_log_name}=MME_side.pcap
    ...            ${capture_filter}=sctp or arp or udp
    ...            ${ssh_username}=${EPCSIM_LOGIN}    ${SSH_PASSWORD}=${EPCSIM_PASSWORD}
    ...            ${egate_port}=20000    ${edaemon_port}=10000
    ...            ${epc_ssh_username}=root    ${epc_ssh_password}=uteadmin
    Connect to EPC and kill edaemon and egate   epc_ip=${EPCSIM_IP}
    ...                                         username=${epc_ssh_username}
    ...                                         password=${epc_ssh_password}
    ...                                         alias=epcsim
    ...                                         egate_port=${egate_port}
    ...                                         edaemon_port=${edaemon_port}
    Start EPCsim and load config file and reach active state
    ...    alias_edaemon=${epcsim_edaemon_alias}    alias_egate=${epcsim_egate_alias}
    ...    EPC_VM_IP=${EPCSIM_IP}   SSH_USERNAME=${ssh_username}  SSH_PASSWORD=${SSH_PASSWORD}
    ...    EPCSIM_DIR=${EPCSIM_DIR}     EPCSIM_CFG=${EPCSIM_CFG}
    ...    egate_port=${egate_port}    edaemon_port=${edaemon_port}

epcSim start                                                                    # Assuming lack of hops - this is the expected scenario
    [Arguments]    ${egate_port}=20000    ${edaemon_port}=10000
    Setup edaemon  edaemon_port=${edaemon_port}
    ...            host_ip=${EPCSIM_IP}
    ...            persistent=${True}
    ...            tool_dir=${LUA_CONFIG_FILEPATH}
    ...            ssh_user=${EPCSIM_LOGIN}
    ...            ssh_pass=${EPCSIM_PASSWORD}
    Setup egate  egate_port=${egate_port}
    ...          host_ip=${EPCSIM_IP}
    ...          persistent=${True}
    ...          tool_dir=${LUA_CONFIG_FILEPATH}
    ...          ssh_user=${EPCSIM_LOGIN}
    ...          ssh_pass=${EPCSIM_PASSWORD}
    Link edaemons to egate    default
    Start egate process  cfg_file=${LUA_CONFIG_FILEPATH}/${EGATE_CONFIG}  timeout=120
    Start egate services  timeout=10s

epcSim teardown
    Collect egate log files
    Collect edaemon log files
    Teardown egate
    Teardown edaemon

Download config file from EPCsim
    [Documentation]    Assumes that config file is already on EPCsim
    [Arguments]    ${config_temp_dir}=/tmp/config_file/
    ${ssh_conn_object}=    csn.Connect To    hostname=${EPCSIM_IP}
    ...                                      username=${EPCSIM_LOGIN}
    ...                                      password=${EPCSIM_PASSWORD}
    ...                                      alias=EPC_VM_SSH
    Run    mkdir ${config_temp_dir}
    csn.Download file    ${LUA_CONFIG_FILEPATH}/${EGATE_CONFIG}
    ...                  ${config_temp_dir}/${EGATE_CONFIG}
    ...                  connection=EPC_VM_SSH
    Copy File    /tmp/config_file/${EGATE_CONFIG}    ${OUTPUT_DIR}/config_file/${EGATE_CONFIG}
