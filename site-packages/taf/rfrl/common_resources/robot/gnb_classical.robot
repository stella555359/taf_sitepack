    [Arguments]    ${list_params_to_modify}    ${scf_file_on_test_pc}    ${scf_file_path}=${TS_CASE_LOG_PATH}
    Log to console    Modify scf file based on test case requirement
    commissioning.Modify Scf    input_scf=${scf_file_path}/${SCF_FILE_NAME}
