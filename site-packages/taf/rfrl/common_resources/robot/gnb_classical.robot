Start To Capture Wireshark
    [Arguments]     ${filename}=file.pcap  ${connection}=${asik}
    csn.send_command    command=tcpdump sctp -i any -s 0 -w ${gnb_tmp_log_dir}/${filename}   connection=${connection}

Stop and download Wireshark file
    [Arguments]     ${filename}=file.pcap  ${connection}=${asik}    ${ute_log_path}=${epc_tmp_log_dir}
    csn.send command        command=killall tcpdump     connection=${connection}
    sleep    5
    csn.download_file   ${gnb_tmp_log_dir}/${filename}    ${ute_log_path}/${filename}   connection=${connection}
    csn.execute    command=rm ${gnb_tmp_log_dir}/${filename}    connection=${connection}

Analysis Wireshark log
    [Arguments]    ${filename}
    ...            ${element_expression}
    ...            ${the_value_of_element}
    ...            ${element_idx}=${0}
    ...            ${default_value}=${True}
    ...            ${ute_log_path}=${epc_tmp_log_dir}
    cap.Read Cap   ${ute_log_path}/${filename}
    ${res} =    cap.Get Element Value    element_expression=${element_expression}
    ...                                  element_idx=${element_idx}
    ...                                  default_value=${default_value}
    Should be equal  ${res}  ${the_value_of_element}

