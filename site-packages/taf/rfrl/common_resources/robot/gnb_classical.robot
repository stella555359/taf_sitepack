Remove Elements From Scf
    [Arguments]    ${input_scf}    ${output_scf}    ${parameters_lists}
    scf.Load Scf    ${input_scf}
    FOR    ${parameters_list}    IN    @{parameters_lists}
        scf.Remove Element From Scf    &{parameters_list}
    END
    scf.Save Scf    ${output_scf}

Add items to list from scf
    [Arguments]    ${input_scf}    ${output_scf}    ${parameters_lists}
    scf.Load scf    ${input_scf}
    FOR    ${item}    IN    @{parameters_lists}
        scf.add item to list  dist_name=${item}[dist_name]    list_name=${item}[list_name]    elements=${item}[elements]
    END
    scf.Save scf    ${output_scf}

Add elements to scf
    [Arguments]    ${input_scf}    ${output_scf}    ${parameters_lists}
    scf.Load scf    ${input_scf}
    FOR    ${item}    IN    @{parameters_lists}
        scf.add element to scf  dist_name=${item}[dist_name]    p_name=${item}[p_name]    value=${item}[value]
    END
    scf.Save scf    ${output_scf}

Add object to scf
    [Arguments]    ${input_scf}    ${output_scf}    ${parameters_lists}
    scf.Load scf    ${input_scf}
    FOR    ${item}    IN    @{parameters_lists}
        scf.add object to scf  class_name=${item}[class_name]    dist_name=${item}[dist_name]   version=${item}[version]
    END
    scf.Save scf    ${output_scf}

Add list to scf
    [Arguments]    ${input_scf}    ${output_scf}    ${parameters_lists}
    scf.Load scf    ${input_scf}
    FOR    ${item}    IN    @{parameters_lists}
        scf.add list to scf  dist_name=${item}[dist_name]   list_name=${item}[list_name]
    END
    scf.Save scf    ${output_scf}

Get scf file name based on GNB RU type
    [Documentation]    Author: Ding Binmei HGZ_SG4
    ...                Description: SCF_FILE_NAME value default to SBTS5G18A_5g_pid12_classical.xml
    ...                             Will change to SBTS5G18A_5g_pid11_classical.xml if RU type is Above6G
    ${type} =    Convert To Uppercase    ${GNB_RU_HW_TYPE}
    ${value} =    Convert To Uppercase    Above6GHZ
    Run keyword if    '${type}' == '${value}'
    ...                Set suite variable    ${SCF_FILE_NAME}    ${scf_name}
    ...    ELSE        Set suite variable    ${SCF_FILE_NAME}    ${scf_name_below6GHz}

Modify SCF based on testline on test pc
    [Documentation]    Author: Ding Binmei HZ_SG4
    ...                Description: Modify SCF file based on test line info on test pc and return the scf local path
    ...                ${PARAMS_TO_MODIFY_SCF} and ${PARAMS_TO_DELETE} should be defined in testline init file.
    ...                ${PARAMS_TO_DELETE} is not needed when RU is above 6G
    ...                ${scf_file_path}: File path for storing the scf file on test pc. Default to ${TS_CASE_LOG_PATH}
    [Arguments]    ${asik_alias}=${ASIK}    ${scf_file_path}=${TS_CASE_LOG_PATH}
    Log to console    Start to modify SCF commission file based on test line info
    Get scf file name based on GNB RU type
    ${scf_file_on_test_pc}=    commissioning.Get scf from OAM vm    scf_remote_dir=${DEFAULT_SCF_DIR_PATH}
    ...                                                     scf_filename=${SCF_FILE_NAME}
    ...                                                     log_path=${scf_file_path}
    ...                                                     oam_connection=${asik_alias}
    # SCF config specific to test line info
    commissioning.Modify Scf    input_scf=${scf_file_path}/${SCF_FILE_NAME}
    ...                         output_scf=${scf_file_on_test_pc}
    ...                         parameters_lists=${PARAMS_TO_MODIFY_SCF}
    ${type} =    Convert To Uppercase    ${GNB_RU_HW_TYPE}
    ${value} =    Convert To Uppercase    Above6GHZ
    Run keyword if    '${type}' == '${value}'
    ...    Remove Elements From Scf    input_scf=${scf_file_path}/${SCF_FILE_NAME}
    ...                                output_scf=${scf_file_on_test_pc}
    ...                                parameters_lists=${PARAMS_TO_DELETE}
    [Return]    ${scf_file_on_test_pc}

Modify SCF based on test case on test pc
    [Documentation]    Author: Ding Binmei HGZ_SG4
    ...                Description: Modify SCF file based on test case requirement on test pc and return the scf local path
