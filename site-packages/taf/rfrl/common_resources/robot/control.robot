*** Settings ***
Documentation      [THIS FILE IS DEPRECATED]

Library  String
Library  Collections
Library  OperatingSystem
Library  taf.gnb.deployment.heat_templates  WITH NAME  heat_templates
Library  taf/rfrl/common_resources/python/yaml_operations.py
Library  taf/rfrl/common_resources/python/collections_operations.py

*** Keywords ***
Setup Connections
    ${HOP}     Create Dictionary     host=${tl.control.addr}    user=${tl.control.username}     password=${tl.control.password}
    @{HOPS}      Create List         ${HOP}
    &{OSENV}=    Create Dictionary   OS_TENANT_NAME=${tl.control.os_tenant_name}
    ...                              OS_USERNAME=${tl.control.os_username}
    ...                              OS_PASSWORD=${tl.control.os_password}
    ...                              OS_AUTH_URL=${tl.control.os_auth_url}
	Set Openstack Target	hops=${HOPS}	env=${OSENV}	name= 		endpoint_type=internal
	Initialize Openstack Libraries

Teardown Connections
    Finalize Openstack Libraries

Create Flavor Stack
    # no need to do this in Cbts configuration PoC, tested TL is the only TL on used control node
    # ta_ncir.Change Flavor Names     ${STACK_FLAVORS}     ${TL_NUMBER}
    Heat.Create stack    ${tl.cbts.flavor_name}     ${STACK_FLAVORS}       timeout=${TIMEOUT}

Create Ext Net Stack
    Heat.Create stack    ${tl.cbts.net_name}     ${STACK_EXT_NET_YAML}    environment_dict=${tl.cbts.heat.net.dict}     timeout=${TIMEOUT}

Create Deploy Stack
    Update network ids
    # Save templates
    Heat.Create stack    ${tl.cbts.bts_name}    ${STACK_DEPLOY_YAML}    environment_dict=${tl.cbts.heat.bts.dict}    timeout=${TIMEOUT}
net_dict

Update network ids
    ${oam_id}=     Neutron.Get network attribute by name     network_name=${tl.cbts.heat.net.oam_net_name}    attribute=id
    ${backhaul_id}=     Neutron.Get network attribute by name     network_name=${tl.cbts.heat.net.backhaul_net_name}    attribute=id
    ${tl.cbts.heat.bts.oam_net_id}=     Set Variable   ${oam_id}
    ${tl.cbts.heat.bts.backhaul_net_id}=     Set Variable   ${backhaul_id}

Install Latest Image From Builds
    @{image_name}=    Split string from right    ${AF_PATH}    separator=/
    ${image_name}=    Set Variable    ${image_name}[-1]
    ${image_name}=    Get Substring   ${image_name}    0    -6
    @{images_list}=     Glance.Get image names
    ${img_count}=    Get Match Count    ${images_list}      ${image_name}
    run keyword unless   ${img_count} > 0     Glance.Install Image From Remote    url=${AF_PATH}    name=${image_name}
    #${addons}=   heat_templates.download   url=${ADDONS_PATH}   destination=/tmp
    #heat_templates.define_templates_5G17   option=${DEPLOY_METHOD}
    #heat_templates.define_templates_5G17A   option=2  ueup=1
    #heat_templates.extract_templates    addons=${ADDONS}    destination=${STACK_TEMP}
    ${tl.cbts.heat.bts.image_name}=    Set Variable     ${image_name}

Save templates
    save_dict_as_yaml     ${PARAMS_EXT}      ${OUTPUT_DIR}/ext_net.env
    save_dict_as_yaml     ${PARAMS_DEPLOY}       ${OUTPUT_DIR}/deploy.env

Remove old stacks if necessary
    Run keyword and ignore error     Heat.Remove stack by name    ${tl.cbts.bts_name}    timeout=150
    Run keyword and ignore error     Heat.Remove stack by name    ${tl.cbts.net_name}
    Run keyword and ignore error     Heat.Remove stack by name    ${tl.cbts.flavor_name}

Delete The Oldest Image From Glance
    @{image_ids}=    Glance.Get Image Ids
    ${last_image}=    Get From List   ${image_ids}    index=-1
    Glance.Remove Image By Id    image_id=${last_image}

Preconditional paths creation
    create directory  ${STACK_TEMP}
    create directory  ${LOG_PATH}
