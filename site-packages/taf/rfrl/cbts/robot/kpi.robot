*** Keywords ***
Get Operation History
    [Documentation]    Description:    Get list of operations from vCU or vDU
    ...                Input:          hw_type = vCU/vDU
    ...                                remove_login_operations = True/False removes Login & Logout occurrences
    ...                                operation_name = name of the only operation to be fetched from output
    ...                                start_time = start timestamp every event started before will be ignored
    ...                                end_time = end timestamp every event ended after will be ignored
    ...                                start/end timestamps can be acquired by using Get Current Date kw.
    ...                Output:         List of dicts with operation details fetched from vCU/vDU operation history tab.
    ...                Author:         karol.sadowski@nokia.com
    [Arguments]        ${hw_type}    ${remove_login_operations}=${True}    ${operation_name}=${NONE}
    ...                ${start_time}=${NONE}    ${end_time}=${NONE}
    ${temp_conn}=      Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.connect_to
    ...                host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE IF    '${hw_type}'=='vDU'    vdu_admin.connect_to
    ...                host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ${output}=         Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.get_cu_operation_history
    ...                                                         connection=${temp_conn}
    ...                ELSE IF    '${hw_type}'=='vDU'    vdu_admin.get_vdu_operation_history
    ...                                                  vdu_connection=${temp_conn}
    ${output}=         Set Variable If    '${hw_type}'=='vCU'    ${output['created']}    ${output}
    FOR    ${element}    IN    @{output}
        IF   ${remove_login_operations} and '${operation_name}' == '${NONE}'
            Run Keyword If    '${element['name']}' == 'Login' or '${element['name']}' == 'Logout'
            ...    Remove Values From List    ${output}    ${element}
        ELSE IF   '${operation_name}' != '${NONE}'
            Run Keyword If    '${element['name']}' != '${operation_name}'
            ...    Remove Values From List    ${output}    ${element}
        END

        IF    '${start_time}' != '${NONE}'
            ${start_timestamp}=    Convert Date    ${element['start_time']}    date_format=%Y-%m-%dT%H:%M:%S.%f%z
            ${time_difference}=    Subtract Date From Date    ${start_timestamp}    ${start_time}
            Run Keyword If    ${time_difference} < 0    Remove Values From List    ${output}    ${element}
        ELSE IF        '${end_time}' != '${NONE}'
            ${end_timestamp}=    Convert Date    ${element['end_time']}    date_format=%Y-%m-%dT%H:%M:%S.%f%z
            ${time_difference}=    Subtract Date From Date    ${end_timestamp}    ${end_time}
            Run Keyword If    ${end_timestamp} > 0    Remove Values From List    ${output}    ${element}
        END
    END
    [Return]    ${output}
    [Teardown]    Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.disconnect    connection=${temp_conn}
    ...           ELSE IF           '${hw_type}'=='vDU'    vdu_admin.disconnect    vdu_connection=${temp_conn}

Get Operation Duration
    [Documentation]    Description:    Measure duration of given operation
    ...                Input:          operation = element from output of Get Operation History
    ...                                output_format = {seconds, mixed, timer} mixed= 1h 2m 3s 4ms; timer= 01:02:03.004
    ...                Output:         Duration of given operation in specified format
    ...                Author:         karol.sadowski@nokia.com
    [Arguments]        ${operation}    ${output_format}=timer
    ${start_timestamp}=    Convert Date    ${operation['start_time']}    date_format=%Y-%m-%dT%H:%M:%S.%f%z
    ${end_timestamp}=    Convert Date    ${operation['end_time']}    date_format=%Y-%m-%dT%H:%M:%S.%f%z
    ${format}=    Run Keyword If    '${output_format}'=='seconds'    Set Variable   number
    ...           ELSE IF           '${output_format}'=='mixed'      Set Variable   compact
    ...           ELSE                                               Set Variable   timer
    ${time_difference}=    Subtract Date From Date    ${end_timestamp}    ${start_timestamp}   result_format=${format}
    [Return]    ${time_difference}

Check If Operation Meets Target
    [Documentation]    Description:    Check if target is met for operation from Get Operation History
    ...                Input:          operation = element from output of Get Operation History
    ...                                target = 1 [h/hour/hours] 2 [m/min/minute/minutes] 3 [s/sec/second/seconds]
    ...                Output:         True if target is met, False otherwise. As a 2nd argument real operation duration is passed.
    ...                Author:         karol.sadowski@nokia.com
    [Arguments]        ${operation}    ${target}
    ${operation_duration}=    Get Operation Duration    operation=${operation}    output_format=mixed
    ${time_difference}=    Subtract Time From Time   ${target}    ${operation_duration}   result_format=number
    IF    ${time_difference} < 0
        ${output}=    Set Variable    ${False}
    ELSE
        ${output}=    Set Variable    ${True}
    END
    [Return]    ${output}    ${operation_duration}
