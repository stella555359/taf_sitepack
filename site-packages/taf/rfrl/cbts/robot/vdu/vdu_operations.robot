vDU Download File From Container
    [Arguments]   ${pod_name}   ${container_name}   ${local_file_path}   ${file_path_in_container}   ${conn_prompt}=${EMPTY}
    ...   ${gnb_index}=0   ${vdu_index}=0
    ${alias}    generic_utils.get_unique_id_string
    ${ns}   tl_config.get_vdu_namespace
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ssh_conn.connect_to_vdu_cloud_hosting
    ...  using_tenant=${True}
    ...  prompt=${conn_prompt}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ...  alias=${alias}
    ${time_stamp}   get_current_utc_timestamp
    ${file_path}   ${file_name}   OperatingSystem.Split Path    ${file_path_in_container}
    ${suite_name}   Replace String   ${SUITE NAME}   ${SPACE}  _
    ${remote_file_path}   ssh_conn.vdu_get_a_remote_directory  ns=${ns}   alias=${alias}
    ...   case_name=${suite_name}  time_info=${time_stamp}

    ${cmd}   Set Variable   kubectl cp ${pod_name}:${file_path_in_container} -c ${container_name} ${remote_file_path}/${file_name} -n ${ns}
    ssh_conn.execute_normal_cmd   base_command=${cmd}  alias=${alias}   check_result=${False}

    ssh_conn.download_file   remote_path=${remote_file_path}/${file_name}    local_path=${local_file_path}/${file_name}
    ...   alias=${alias}
    [Teardown]   Run Keywords   ssh_conn.execute_normal_cmd   base_command=sudo rm -rf ${remote_file_path}
    ...   alias=${alias}   check_result=${False}  AND
    ...   ssh_conn.disconnect_vdu_cloud_hosting   alias=${alias}


