VDU Get Current Build Version
    [Documentation]  This keyword is used to get vdu current build version via cmd in common setup
    ...    |    Input Parameters     | Man. | Description |
    ...    |   vdu_index             | No  | vdu index in testline configuration file. Default is 0. |
    ...    |   gnb_index             | No |  gnb index in testline configurtion file. Default is 0. |
    ...    *RETURN VALUE*
    [Arguments]  ${conn_prompt}=${EMPTY}  ${vdu_index}=0    ${gnb_index}=0
    ${alias}    generic_utils.get_unique_id_string
    ${ns}   tl_config.get_vdu_namespace
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ssh_conn.connect_to_vdu_cloud_hosting
    ...  using_tenant=${True}
    ...  prompt=${conn_prompt}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ...  alias=${alias}
    ${cmd}  set variable   helm list -a -n ${ns}|grep aic-vdu-|grep -v aic-vdu-prerequisite|grep -v aic-vdu-cluster|awk '{print $9}'
    ${output}   ssh_conn.execute_normal_cmd   base_command=${cmd}   alias=${alias}
    ${build_version}   set variable   ${output.split('-')[-1]}
    [return]   ${build_version}
    [Teardown]    ssh_conn.disconnect_vdu_cloud_hosting  alias=${alias}


