VDU Get Container PID
    [Arguments]   ${pod_abbr}   ${ctr_abbr}   ${gnb_index}=0   ${vdu_index}=0   ${conn_prompt}=${EMPTY}
    [Documentation]  This keyword is used to get container pid on vdu
    ...
    ...  *AUTHOR* rui.3.li@nokia-sbell.com
    ...
    ...    |    =Input Parameters=     | =Man.= | =Description= |
    ...    | pod_abbr               | Yes | pod abbr |
    ...    | ctr_abbr               | Yes | container abbr |
    ...    | vdu_index              | No | vdu index in testline configuration file. Default is 0. |
    ...    | gnb_index              | No | gnb index in testline configurtion file. Default is 0. |
    ...    | conn_prompt            | No | connection prompt |
    ...
    ...    *RETURN VALUE*
    ...    - container pid
    ${alias}   generic_utils.get_unique_id_string
    ${ns}   tl_config.get_vdu_namespace
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ssh_conn.connect_to_vdu_cloud_hosting
    ...  using_tenant=${True}
    ...  prompt=${conn_prompt}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ...  alias=${alias}

    ${container_id}   vdu_cli_base.vdu_get_container_id   pod_name=${pod_abbr}   container_name=${ctr_abbr}
    ...    alias=${alias}   namespace=${ns}

    ${result}   ssh_conn.execute_normal_cmd
    ...  base_command=sudo crictl inspect --output yaml ${container_id}
    ...  pipe_cmd=| grep 'pid:'|awk -F ':' '{print $2}'
    ...  alias=${alias}
    ${pid}   Set Variable  ${result.strip()}
    [Return]  ${pid}
    [Teardown]   ssh_conn.disconnect_vdu_cloud_hosting   alias=${alias}

