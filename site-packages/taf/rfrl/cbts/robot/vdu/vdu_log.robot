Start Collecting kubernetes log on specific container
    [Arguments]  ${pod_name}  ${container_name}  ${vdu_index}=0  ${gnb_index}=0
    [Documentation]  This keyword is used to start collecting k8s logs on specific container
    ...
    ...  *AUTHOR*lingting.sun@nokia-sbell.com
    ...
    ...    |    Input Parameters     | Man. | Description |
    ...    |   pod_name              | Yes | full pod name, such as po-cran1-up-0.                   |
    ...    |   container_name        | Yes | full container name, such as ctr-cran1-l2rt.            |
    ...    |   vdu_index             | No  | vdu index in testline configuration file. Default is 0. |
    ...    |   gnb_index             | No  |  gnb index in testline configurtion file. Default is 0.  |
    ...    *RETURN VALUE*
    ...   k8s_collection_alias

    ${k8s_collection_alias}   set variable    kubelog_${pod_name}_${container_name}
    ${credential}   tl_config.get_vdu_log_executor_credentials   tenant_credentials=${True}   vdu_index=${vdu_index}  gnb_index=${gnb_index}
    ${namespace}   tl_config.get_vdu_namespace   vdu_index=${vdu_index}  gnb_index=${gnb_index}
    ${executor}    Create Dictionary
    ...  host=${credential['k8s_executor_ip']}
    ...  user=${credential['k8s_executor_username']}
    ...  password=${credential['k8s_executor_password']}
    ${vdu_kubenetes_log}=   create dictionary
    ...  name=${k8s_collection_alias}
    ...  type=kubernetes
    ...  executor=${executor}
    ...  namespace=${namespace}
    ...  pod_name=${pod_name}
    ...  container=${container_name}
    ${configurations}=  create list
    ...   ${vdu_kubenetes_log}
    core_collect.create_collectors   configurations=${configurations}
    core_collect.set_test_alias   alias=${k8s_collection_alias}
    core_collect.setup_collectors    names=${k8s_collection_alias}
    core_collect.start_collectors    names=${k8s_collection_alias}
    [return]   ${k8s_collection_alias}


Stop Collecting kubernetes log on specific container
    [arguments]    ${k8s_collection_alias}   ${log_dir}   ${pod_name}  ${container_name}
    [Documentation]  This keyword is used to stop collecting k8s logs on specific container
    ...
    ...  *AUTHOR*lingting.sun@nokia-sbell.com
    ...
    ...    |    Input Parameters     | Man. | Description |
    ...    |   k8s_collection_alias  | Yes  | alias of k8s log collecting, the return value from start collecting ... |
    ...    |   log_dir               | Yes  | the log dir in local machine                                           |
    ...    |   pod_name              | Yes | full pod name, such as po-cran1-up-0.                   |
    ...    |   container_name        | Yes | full container name, such as ctr-cran1-l2rt.            |
    ...    *RETURN VALUE*
    ...
    ...   log_path
    ...
    core_collect.stop_collectors    names=${k8s_collection_alias}
    core_collect.collect_collectors    names=${k8s_collection_alias}    target_dir=${log_dir}
    core_collect.teardown_collectors    names=${k8s_collection_alias}
    ${log_path}  Set Variable   ${log_dir}kubelog_${pod_name}_${container_name}/
    run keyword and ignore error    OperatingSystem.Run   cd ${full_path};tar -xvf *
    [return]    ${log_path}


Trigger And Save Local Snapshot For vDU
    [Arguments]   ${local_snapshot_folder}=${None}  ${compressed_or_not}=${False}   ${saving_ongoing_snapshot}=${True}
    ...           ${vdu_index}=0   ${gnb_index}=0   ${webem_password}=${EMPTY}
    [Documentation]  This keyword is used to trigger and save local snapshot for vdu.
    ...              The keyword will be stuck until the snapshot collection finished.
    ...              If local snapshot folder is not set, a new folder will be created which is constructed with robot log output directory,
    ...              test name, log type and timestamp, i.e.  /home/ute/logs/TESTCASE__Test_RFRF/vdu_snapshot/2023_01_11_05_44_15
    ...
    ...  *AUTHOR* calla.wang@nokia-sbell.com
    ...
    ...    |    =Input Parameters=     | =Man.= | =Description= |
    ...    | local_snapshot_folder | No | the local folder name that snapshot files are stored.  |
    ...    | compressed_or_not | No | a zip file if True, unzip files if False |
    ...    | saving_ongoing_snapshot | No | whether saving the current ongoing snapshot. |
    ...    | vdu_index              | No  | vdu index in testline configuration file. Default is 0. |
    ...    | gnb_index              | No |  gnb index in testline configurtion file. Default is 0. |
    ...    | webem_password | No | default value is EMPTY will get from file init |
    ...
    ...    *RETURN VALUE*
    ...   snapshot file path
    ...
    ${conn_alias}    generic_utils.get_unique_id_string
    vdu_gen.login_rest   vdu_index=${vdu_index}   gnb_index=${gnb_index}   alias=${conn_alias}   webem_password=${webem_password}
    ${local_snapshot_path}=   vdu_snapshot.trigger_and_save_vdu_local_snapshot   snapshot_dir=${local_snapshot_folder}
    ...                                                                          compressed_or_not=${compressed_or_not}
    ...                                                                          save_ongoing_snapshot=${saving_ongoing_snapshot}
    ...                                                                          conn_alias=${conn_alias}
    [Teardown]    vdu_gen.logout_rest    conn_alias=${conn_alias}
    [Return]    ${local_snapshot_path}


Get k8s Logs For vDU
    [Arguments]  ${pod_list}  ${dir}  ${duration}  ${vdu_index}=0    ${gnb_index}=0  ${conn_prompt}=${EMPTY}
    ${alias}    generic_utils.get_unique_id_string
    ${namespace}   tl_config.get_vdu_namespace
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ssh_conn.connect_to_vdu_cloud_hosting
    ...  using_tenant=${True}
    ...  prompt=${conn_prompt}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ...  alias=${alias}
    FOR  ${pod}  IN   @{pod_list}
       ${function_cmd}  Set Variable   kubectl logs ${pod} --all-containers=true --since=${duration}m -n ${namespace}
       ${remote_log_file_name}  Set Variable   ${pod}_all.log
       ${cmd}   Set Variable    ${function_cmd} > ./${remote_log_file_name}
       ssh_conn.execute_normal_cmd   base_command=${cmd}   alias=${alias}
       ssh_conn.download_file   remote_path=./${remote_log_file_name}  local_path=${dir}/${remote_log_file_name}  alias=${alias}
       ssh_conn.execute_normal_cmd   base_command=rm -rf ./${remote_log_file_name}  alias=${alias}
    END
    [Teardown]    ssh_conn.disconnect_vdu_cloud_hosting  alias=${alias}


