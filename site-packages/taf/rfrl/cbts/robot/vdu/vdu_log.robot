    ...  namespace=${ns}
    ...  using_tenant=${using_tenant}
    ...  prompt=${conn_prompt}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    [Return]   ${alias}


_Stop BIP Log Collection
    [Arguments]   ${alias}
    ssh_conn.execute_bare_command
    ...  command=\x03
    ...  alias=${alias}
    Sleep   3
    ssh_conn.read_output_until_prompt   alias=${alias}

_Get BIP Log Files
    [Arguments]    ${pod_name}   ${ctr_name}   ${namespace}     ${alias}
    ${bip_logs}=   ssh_conn.execute_kubectl_exec_cmd
    ...  pod_name=${pod_name}
    ...  container_name=${ctr_name}
    ...  namespace=${namespace}
    ...  command=bash -c "find /tmp/dpdkdump -type f"
    ...  conn_alias=${alias}
    ${bip_files_list}=   Split To Lines   ${bip_logs}
    [Return]    ${bip_files_list}

_Build Pod And Container Full Name
    [Arguments]    ${pod_name}    ${ctr_name}    ${namespace}   ${gnb_index}=0    ${vdu_index}=0
    ...  ${using_tenant}=${True}  ${prompt}=${EMPTY}
    ${full_name_alias}    generic_utils.get_unique_id_string
    ssh_conn.connect_to_vdu_cloud_hosting
    ...  using_tenant=${using_tenant}
    ...  prompt=${prompt}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ...  alias=${full_name_alias}
    ${pod_full_name}  ${container_full_name}  ssh_conn.get_full_pod_and_container_name
    ...  pod_abbr=${pod_name}
    ...  namespace=${namespace}
    ...  container_abbr=${ctr_name}
    ...  alias=${full_name_alias}
    [Return]    ${pod_full_name}  ${container_full_name}
    [Teardown]    ssh_conn.disconnect_vdu_cloud_hosting   alias=${full_name_alias}



VDU Stop And Save BIP Log To Local
    [Arguments]   ${dst_log_path}    ${bip_collection_alias}    ${port_name}=all   ${pod_name}=l2rt-0   ${ctr_name}=l2rt
    ...  ${gnb_index}=0    ${vdu_index}=0   ${using_tenant}=${True}   ${conn_prompt}=${EMPTY}
    [Documentation]  This keyword is used to end bip log on vdu
    ...
    ...  *AUTHOR* rui.3.li@nokia-sbell.com
    ...
    ...    |    =Input Parameters=     | =Man.= | =Description= |
    ...    | dst_log_path           | Yes | log saved path in local. |
    ...    | handle                 | No |  handle string, get from keyword VDU Begin BIP Log |
    ...    | vdu_index              | No | vdu index in testline configuration file. Default is 0. |
    ...    | gnb_index              | No | gnb index in testline configurtion file. Default is 0. |
    ...    | conn_prompt            | No | connection prompt |
    ...
    ...    *RETURN VALUE*
    ...
    ${ns}   tl_config.get_vdu_namespace
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ${pod_full_name}  ${container_full_name}    _Build Pod And Container Full Name
    ...  pod_name=${pod_name}
    ...  ctr_name=${ctr_name}
    ...  namespace=${ns}
    ...  using_tenant=${using_tenant}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ...  prompt=${conn_prompt}

    ${host_bip_log_path}   Set Variable   /tmp/BIP_${bip_collection_alias}

    _Stop BIP Log Collection   alias=${bip_collection_alias}

    ${bip_files_list}=    _Get BIP Log Files
    ...  pod_name=${pod_name}
    ...  ctr_name=${ctr_name}
    ...  namespace=${ns}
    ...  alias=${bip_collection_alias}

    FOR  ${bip_log_path}  IN  @{bip_files_list}
        ${path}  ${big_log_name}   Split Path  ${bip_log_path}
        ${cp_cmd}   Set Variable
        ...   kubectl cp ${pod_full_name}:${bip_log_path} -c ${container_full_name} ${host_bip_log_path}/${big_log_name}
        ssh_conn.execute_normal_cmd   base_command=${cp_cmd}   namespace=${ns}  alias=${bip_collection_alias}
        ssh_conn.download_file
        ...  remote_path=${host_bip_log_path}/${big_log_name}
        ...  local_path=${dst_log_path}/${big_log_name}
        ...  alias=${bip_collection_alias}
    END
    [Teardown]   Run Keywords   ssh_conn.execute_normal_cmd   base_command=rm -rf ${host_bip_log_path}   alias=${bip_collection_alias}
    ...   AND  _Stop BIP Log Collection   alias=${bip_collection_alias}
    ...   AND   _Clean Existed BIP Log Files
    ...  pod_name=${pod_name}
    ...  ctr_name=${ctr_name}
    ...  namespace=${ns}
    ...  alias=${bip_collection_alias}
    ...   AND   ssh_conn.disconnect_vdu_cloud_hosting   alias=${bip_collection_alias}
