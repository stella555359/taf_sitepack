Begin Tcpdump Wireshark On VDU
    [Arguments]   ${interface}   ${pod_name}   ${container_name}   ${filter}=${EMPTY}   ${gnb_index}=0  ${vdu_index}=0
    ...   ${write_mode}=-w   ${conn_prompt}=${EMPTY}   ${using_tenant}=${True}
    [Documentation]  This keyword is used to begin tcpdump wireshark on vdu
    ...
    ...  *AUTHOR* rui.3.li@nokia-sbell.com
    ...
    ...    |    =Input Parameters=     | =Man.= | =Description= |
    ...    | interface              | Yes |  the interface name where wireshark log is captured |
    ...    | pod_name               | Yes | the full pod name or the abbreviation of the pod name, e.g. po-cran1-l2rt-1 or l2rt-1 |
    ...    | container_name         | Yes | the full container name or the abbreviation of the container name, e.g. ctr-cran1-l2rt or l2rt |
    ...    | filter                 | No | filter of tcpdump, e.g, tcp, sctp, etc. default is empty |
    ...    | vdu_index              | No | vdu index in testline configuration file. Default is 0. |
    ...    | gnb_index              | No | gnb index in testline configurtion file. Default is 0. |
    ...    | write_mode             | No | write mode, default value is -w |
    ...    | conn_prompt            | No | connection prompt |
    ...    | using_tenant           | No | connect to the cloud hosting by tenant or core |
    ...
    ...    *RETURN VALUE*
    ...    - file path saved in container
    ...    - tcpdump process id

    ${pcap_folder}   set variable    /tmp/tmp_wireshark
    ${alias}    generic_utils.get_unique_id_string

    ${ns}   tl_config.get_vdu_namespace
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}

    ssh_conn.connect_to_vdu_pod_located_node
    ...  pod_name=${pod_name}
    ...  namespace=${ns}
    ...  using_tenant=${using_tenant}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ...  prompt=${conn_prompt}
    ...  alias=${alias}

    ssh_conn.execute_kubectl_exec_cmd   pod_name=${pod_name}  container_name=${container_name}  command=mkdir -p ${pcap_folder}
    ...   namespace=${ns}   conn_alias=${alias}

    ${file_name_unique}   generic_utils.get_unique_id_string

    ${tmpfilenamefullpath}   Set Variable
    ...   ${pcap_folder}/VDU_${gnb_index}_${vdu_index}_${pod_name}_${container_name}_${file_name_unique}.pcap

    ${command}    Set Variable If
    ...   '${filter}'==''   sh -c "tcpdump -ni ${interface} -s 0 ${write_mode} ${tmpfilenamefullpath}"
    ...   sh -c "tcpdump -ni ${interface} ${filter} -s 0 ${write_mode} ${tmpfilenamefullpath}"
    ${pid}   VDU Get Container PID   pod_abbr=${pod_name}   ctr_abbr=${container_name}   gnb_index=${gnb_index}
    ...   vdu_index=${vdu_index}
    ${full_cmd}   set variable   sudo nsenter -m -n -t ${pid} ${command} &

    ssh_conn.execute_bare
    ...  command=${full_cmd}
    ...  alias=${alias}

    ssh_conn.execute_bare
    ...  command=\r
    ...  alias=${alias}
    ${process_id}   Check TcpDump Process Is Started Success    tmpfilenamefullpath=${tmpfilenamefullpath}   gnb_index=${gnb_index}
    ...  vdu_index=${vdu_index}
    [Return]   ${tmpfilenamefullpath}   ${process_id}
    [Teardown]   ssh_conn.disconnect_vdu_cloud_hosting   alias=${alias}

Check TcpDump Process Is Started Success
    [Arguments]   ${tmpfilenamefullpath}   ${gnb_index}=0   ${vdu_index}=0   ${conn_prompt}=${EMPTY}
    [Documentation]  This keyword is used to check tcpdump process is started success
    ...
    ...  *AUTHOR* rui.3.li@nokia-sbell.com
    ...
    ...    |    =Input Parameters=     | =Man.= | =Description= |
    ...    | tmpfilenamefullpath    | Yes | tcpdump log saved path. |
    ...    | vdu_index              | No | vdu index in testline configuration file. Default is 0. |
    ...    | gnb_index              | No | gnb index in testline configurtion file. Default is 0. |
    ...    | conn_prompt            | No | connection prompt |
    ...
    ...    *RETURN VALUE*
    ...    - tcpdump process id
    ${alias}    generic_utils.get_unique_id_string

    ssh_conn.connect_to_vdu_cloud_hosting
    ...  using_tenant=${True}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ...  prompt=${conn_prompt}
    ...  alias=${alias}

    ${result}   ssh_conn.execute_normal_cmd
    ...  base_command=ps -ef
    ...  pipe_cmd=|grep tcpdump|grep ${tmpfilenamefullpath}| grep sudo | awk '{print $2}'
    ...  alias=${alias}
    ${result}   Split String   ${result}   \n
    Run Keyword If   ${result.__len__()}<${1}    fail
    ${process_id}   Set Variable   ${result}[0]
    [Teardown]   ssh_conn.disconnect_vdu_cloud_hosting   alias=${alias}
    [Return]   ${process_id}

End Tcpdump Wireshark On VDU
    [Arguments]     ${pod_name}   ${container_name}   ${log_dst_path}    ${log_src_path}   ${process_id}
    ...    ${vdu_index}=0   ${gnb_index}=0   ${conn_prompt}=${EMPTY}   ${using_tenant}=${True}
    [Documentation]  This keyword is used to end tcpdump wireshark on vdu
    ...
    ...  *AUTHOR* rui.3.li@nokia-sbell.com
    ...
    ...    |    =Input Parameters=     | =Man.= | =Description= |
    ...    | pod_name               | Yes | the full pod name or the abbreviation of the pod name, e.g. po-cran1-l2rt-1 or l2rt-1 |
    ...    | container_name         | Yes | the full container name or the abbreviation of the container name, e.g. ctr-cran1-l2rt or l2rt |
    ...    | log_dst_path           | Yes | log saved path local |
    ...    | log_src_path           | Yes | log saved path remote |
    ...    | process_id             | Yes | process id of tcpdump |
    ...    | vdu_index              | No | vdu index in testline configuration file. Default is 0. |
    ...    | gnb_index              | No | gnb index in testline configurtion file. Default is 0. |
    ...    | conn_prompt            | No | connection prompt |
    ...    | using_tenant           | No | connect to the cloud hosting by tenant or core |
    ...
    ...    *RETURN VALUE*
    ...

    ${file_list}   Split String   ${log_src_path}   /
    ${file_name}   Set Variable   ${file_list}[-1]

    ${end_alias}    generic_utils.get_unique_id_string
    ${pcap_folder}   Set Variable   /tmp/tmp_wireshark
    ssh_conn.connect_to_vdu_cloud_hosting
    ...  using_tenant=${using_tenant}
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}
    ...  prompt=${conn_prompt}
    ...  alias=${end_alias}
    ${ns}   tl_config.get_vdu_namespace
    ...  vdu_index=${vdu_index}
    ...  gnb_index=${gnb_index}

    ${full_pod_name}  ${full_container_name}  ssh_conn.get_full_pod_and_container_name
    ...  pod_abbr=${pod_name}
    ...  namespace=${ns}
    ...  container_abbr=${container_name}
    ...  alias=${end_alias}

    ssh_conn.execute_normal_cmd   base_command=sudo kill ${process_id}   alias=${end_alias}
    ssh_conn.execute_normal_cmd   base_command=sync   alias=${end_alias}

    ${remote_log_path}   Set Variable   /tmp/tmp_wireshark/${file_name}

    ${cp_cmd}   Set Variable
    ...   oc exec -i ${full_pod_name} -c ${full_container_name} -- cat ${log_src_path} > ${remote_log_path}
    ${del_cmd}   Set Variable
    ...   kubectl exec -it ${full_pod_name} -c ${full_container_name} -n ${ns} -- bash -c "rm -rf ${log_src_path}"

    ssh_conn.execute_normal_cmd   base_command=${cp_cmd}   alias=${end_alias}
    ssh_conn.execute_normal_cmd   base_command=sync   alias=${end_alias}

    ssh_conn.download_file   remote_path=${remote_log_path}   local_path=${log_dst_path}    alias=${end_alias}

    [Teardown]   Run Keywords   ssh_conn.execute_normal_cmd   base_command=rm -rf ${remote_log_path}   alias=${end_alias}
    ...   AND   ssh_conn.execute_normal_cmd   base_command=${del_cmd}   alias=${end_alias}
    ...   AND   ssh_conn.disconnect_vdu_cloud_hosting   alias=${end_alias}



Mirror Port With Hal Cli On VDU
    [Arguments]   ${src_port_name}   ${pod_name}   ${container_name}  ${dst_port_name}=lo  ${gnb_index}=0   ${vdu_index}=0
    ...   ${conn_prompt}=${EMPTY}
    [Documentation]  This keyword is used to mirror port with hal cli on vdu
    ...
    ...  *AUTHOR* rui.3.li@nokia-sbell.com
    ...
    ...    |    =Input Parameters=     | =Man.= | =Description= |
    ...    | src_port_name          | Yes | mirror source port name, like l1up |
    ...    | pod_name               | Yes | pod abbr |
    ...    | container_name         | Yes | container abbr |
    ...    | dst_port_name          | Yes | mirror distnation port name, default value is lo. |
    ...    | vdu_index              | No | vdu index in testline configuration file. Default is 0. |
    ...    | gnb_index              | No | gnb index in testline configurtion file. Default is 0. |
    ...    | conn_prompt            | No | connection prompt |
    ...
    ...    *RETURN VALUE*
    ...
    ${alias}   VDU Connect To Container  pod_name=${pod_name}   container_name=${container_name}
    ...   vdu_index=${vdu_index}    gnb_index=${gnb_index}   conn_prompt=${conn_prompt}
    ${port_table}    ssh_conn.execute_normal_cmd
    ...  base_command=hal-cli show port table
    ...  alias=${alias}
    ssh_conn.execute_bare
    ...  command=hal-cli pdump mirror ${src_port_name} lo
    ...  alias=${alias}

    ssh_conn.execute_bare
    ...  command=\r
    ...  alias=${alias}
    Sleep   3
    [Return]    ${alias}

