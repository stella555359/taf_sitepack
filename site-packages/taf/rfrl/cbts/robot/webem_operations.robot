Delete All Certificates
    [Documentation]    Description:    Delete all certificates on vCU/vDU
    ...                Input:          hw_type = vCU/vDU
    ...                                pre-connection = preexisting connection, if not given then logged as System Admin
    ...                                                 with default username and password
    ...                Author:         patryk.tatareka@nokia.com
    [Arguments]        ${hw_type}=${NONE}    ${pre-connection}=${NONE}
    ${temp_conn}=      Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE               Set Variable      ${pre-connection}
    ${certs}=          Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.get_operator_certificate_list
    ...                                                         connection=${temp_conn}
    ...                ELSE IF           '${hw_type}'=='vDU'    vdu_admin.get_vdu_certificates
    ...                                                         vdu_connection=${temp_conn}
    ...                ELSE               FAIL                  hw_type doesn't exist
    ${length}=         Get Length    ${certs}
    FOR    ${nr}    IN RANGE    ${length}
        ${item}=          Get From List    ${certs}    ${nr}
        ${cert_id}=       Get From Dictionary    ${item}    id
        ${oper}=          Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.delete_operator_certificate
        ...                                                        certificate_id=${cert_id}    connection=${temp_conn}
        ...               ELSE IF           '${hw_type}'=='vDU'    vdu_admin.delete_certificates_by_id
        ...                                                        id=${cert_id}    vdu_connection=${temp_conn}
        Run Keyword If    '${hw_type}'=='vCU'    Should Be True    "${oper["status"]}"=="Successful"
        ...    ELSE IF    '${hw_type}'=='vDU'    Wait Until Keyword Succeeds    3min    5s
        ...                                      Check if TRS API operations ends with success on vDU
        ...                                      oper_id=${oper}    conn=${temp_conn}
    END
    [Teardown]    Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                              vcu_admin.disconnect    connection=${temp_conn}
    ...           ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                              vdu_admin.disconnect    vdu_connection=${temp_conn}

Deploy SCF
    [Documentation]    Description:    Deploy given SCF and perform commissioning
    ...                Input:          hw_type = vCU/vDU
    ...                                scf_path = local path for scf to deploy, i.e. /home/ute/scf.xml
    ...                                wait_until_done = true/false wait for operation finish
    ...                                pre-connection = preexisting connection, if not given then logged as System Admin
    ...                                                 with default username and password
    ...                Output:         List of dictionaries with values gathered during upload,
    ...                                validation and activation operations
    ...                Author:         karol.sadowski@nokia.com
    [Timeout]          15 minutes
    [Arguments]        ${hw_type}    ${scf_path}    ${wait_until_done}=${True}    ${pre-connection}=${NONE}
    ${temp_conn}=      Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE               Set Variable      ${pre-connection}
    &{upload}=         Upload SCF         hw_type=${hw_type}    scf_path=${scf_path}    plan_name=${hw_type}_plan
    ...                                   wait_until_done=${wait_until_done}    pre-connection=${temp_conn}
    &{validation}=     Validate SCF       hw_type=${hw_type}    plan_id=${upload['plan_id']}
    ...                                   wait_until_done=${wait_until_done}    pre-connection=${temp_conn}
    &{activation}=     Activate SCF       hw_type=${hw_type}    plan_id=${upload['plan_id']}
    ...                                   wait_until_done=${wait_until_done}    pre-connection=${temp_conn}
    [Return]           ${upload}    ${validation}    ${activation}
    [Teardown]         Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.disconnect    connection=${temp_conn}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.disconnect    vdu_connection=${temp_conn}

Upload SCF
    [Documentation]    Description:    Upload given SCF
    ...                Input:          hw_type = vCU/vDU
    ...                                scf_path = local path for scf to upload,
    ...                                for example: /home/ute/scf.xml
    ...                                plan_name = name of the plan on BTS
    ...                                timeout = timeout for upload in seconds
    ...                                wait_until_done = True/False wait for operation finish
    ...                                pre-connection = preexisting connection, if not given then logged as System Admin
    ...                                                 with default username and password
    ...                Output:         Dictionary with values like operation status, operation id etc:
    ...                                {'action_id': '', 'incorrect_objects_feedback': [], 'plan_id': '',
    ...                                'procedure_state': '', 'raml_parsing_errors': [], 'status': ''}
    ...                Author:         karol.sadowski@nokia.com
    [Timeout]          10 minutes
    [Arguments]        ${scf_path}     ${hw_type}    ${plan_name}=${hw_type}_plan    ${timeout}=${300}
    ...                ${wait_until_done}=${True}    ${pre-connection}=${NONE}
    ${temp_conn}=      Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE               Set Variable      ${pre-connection}
    &{output}=         Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.upload_plan_file
    ...                                                         path_to_plan_file=${scf_path}    plan_name=${plan_name}
    ...                                                         timeout=${timeout}    connection=${temp_conn}
    ...                ELSE IF           '${hw_type}'=='vDU'    vdu_admin.upload_plan
    ...                                                         path_to_plan_file=${scf_path}    plan_name=${plan_name}
    ...                                                         timeout=${timeout}    vdu_connection=${temp_conn}
    ...                ELSE               FAIL                  hw_type doesn't exist
    WHILE    ${wait_until_done}
        ${status}=    Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.get_operation_state_of_uploading_plan
        ...                                                    operation_id=${output['action_id']}
        ...                                                    connection=${temp_conn}
        ...           ELSE IF           '${hw_type}'=='vDU'    vdu_admin.get_upload_plan_operation_status
        ...                                                    operation_id=${output['action_id']}
        ...                                                    vdu_connection=${temp_conn}    timeout=${5}
        ${status}=    Get From Dictionary    ${status}    status
        Run Keyword If    '${status}'=='ongoing'    Sleep    100ms
        ...    ELSE IF    '${status}'=='fail'     Fail    Upload failed
        ...    ELSE IF    '${status}'=='success'    Set Test Variable    ${wait_until_done}    ${FALSE}
        ...    ELSE        Fail    Unknown status
    END
    [Return]           ${output}
    [Teardown]         Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.disconnect    connection=${temp_conn}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.disconnect    vdu_connection=${temp_conn}

Validate SCF
    [Documentation]    Description:    Validate given plan
    ...                Input:          hw_type = vCU/vDU
    ...                                plan_id = if of plan on BTS obtained from Upload SCF
    ...                                timeout = timeout for validation in seconds
    ...                                pre-connection = preexisting connection, if not given then logged as System Admin
    ...                                                 with default username and password
    ...                Output:         Dictionary with values like operation status, operation id etc:
    ...                                {'action_id': '', 'error_message': , 'links': , 'status': '', 'validation_id': }
    ...                Author:         karol.sadowski@nokia.com
    [Timeout]          10 minutes
    [Arguments]        ${hw_type}    ${plan_id}    ${timeout}=${300}    ${wait_until_done}=${True}
    ...                ${pre-connection}=${NONE}
    ${temp_conn}=      Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE               Set Variable      ${pre-connection}
    &{output}=         Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.plan_validation
    ...                                                         plan_id=${plan_id}    connection=${temp_conn}
    ...                ELSE IF           '${hw_type}'=='vDU'    vdu_admin.validate_plan    plan_id=${plan_id}
    ...                                                         timeout=${timeout}    vdu_connection=${temp_conn}
    ...                ELSE               FAIL                  hw_type doesn't exist
    WHILE    ${wait_until_done}
        ${status}=    Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.get_operation_state_of_validating_plan
        ...                                                    plan_id=${plan_id}    operation_id=${output['action_id']}
        ...                                                    connection=${temp_conn}
        ...           ELSE IF           '${hw_type}'=='vDU'    vdu_admin.get_validate_plan_operation_status
        ...                                                    plan_id=${plan_id}    operation_id=${output['action_id']}
        ...                                                    vdu_connection=${temp_conn}    timeout=${5}
        ${status}=    Get From Dictionary    ${status}    status
        Run Keyword If    '${status}'=='ongoing'    Sleep    100ms
        ...    ELSE IF    '${status}'=='fail'     Fail    Upload failed
        ...    ELSE IF    '${status}'=='success'    Set Test Variable    ${wait_until_done}    ${FALSE}
        ...    ELSE        Fail    Unknown status
    END
    [Return]           ${output}
    [Teardown]         Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.disconnect    connection=${temp_conn}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.disconnect    vdu_connection=${temp_conn}

Activate SCF
    [Documentation]    Description:    Activate given plan
    ...                Input:          hw_type = vCU/vDU
    ...                                plan_id = can be obtained from Upload SCF kw output
    ...                                timeout = timeout for activation in seconds
    ...                                pre-connection = preexisting connection, if not given then logged as System Admin
    ...                                                 with default username and password
    ...                Output:         Dictionary with values like operation status, operation id etc:
    ...                                {'cm_plan_id': , 'error_message': , 'id': '', 'links': , 'procedure_state': '', 'status': '' }
    ...                Author:         karol.sadowski@nokia.com
    [Timeout]          12 minutes
    [Arguments]        ${hw_type}    ${plan_id}    ${timeout}=${300}    ${wait_until_done}=${True}
    ...                ${pre-connection}=${NONE}
    ${temp_conn}=      Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE               Set Variable      ${pre-connection}
    &{output}=         Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.plan_activation
    ...                                                         plan_id=${plan_id}    connection=${temp_conn}
    ...                ELSE IF           '${hw_type}'=='vDU'    vdu_admin.activate_plan    plan_id=${plan_id}
    ...                                                         timeout=${timeout}    vdu_connection=${temp_conn}
    ...                ELSE               FAIL                  hw_type doesn't exist
    WHILE    ${wait_until_done}
        ${status}=    Run Keyword If    '${hw_type}'=='vCU'    Wait Until Keyword Succeeds    12 min    5 sec
        ...                                                    vcu_admin.get_operation_state_of_activating_plan
        ...                                                    plan_id=${plan_id}    operation_id=${output['id']}
        ...                                                    connection=${temp_conn}
        ...           ELSE IF           '${hw_type}'=='vDU'    Wait Until Keyword Succeeds    12 min    5 sec
        ...                                                    vdu_admin.get_activate_plan_operation_status
        ...                                                    plan_id=${plan_id}    operation_id=${output['id']}
        ...                                                    vdu_connection=${temp_conn}    timeout=${5}
        ${status}=    Get From Dictionary    ${status}    status
        Run Keyword If    '${status}'=='ongoing'    Sleep    100ms
        ...    ELSE IF    '${status}'=='fail'     Fail    Upload failed
        ...    ELSE IF    '${status}'=='success'    Set Test Variable    ${wait_until_done}    ${FALSE}
        ...    ELSE    Fail    Unknown status
    END
    [Return]           ${output}
    [Teardown]         Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.disconnect    connection=${temp_conn}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.disconnect    vdu_connection=${temp_conn}

Get Counters Value From WebEM on BTS
    [Documentation]      Description:    Get value of defined counter from WebEM
    ...                  Example:        counter_id=M51326C0
    ...                                  object=MRBTS-8445/TNLSVC-1/TNL-5/IPNO-1/IPIF-1/IPADDRESSV4-1/IPADDRESSV4_R-1
    ...                                  hw_type=vCU
    ...                                  pre-connection = preexisting connection, if not given then logged as System
    ...                                                   Admin with default username and password
    ...                  Input:          hw_type = vCU/vDU
    ...                  Output:         Counter value
    ...                  Author:         jagoda.kubacka@nokia.com
    [Arguments]          ${counter_id}    ${object}    ${hw_type}=${NONE}    ${pre-connection}=${NONE}
    ${temp_conn}=        Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                     vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                     username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                     alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                  ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                     vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                     username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                     connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                  ELSE               Set Variable      ${pre-connection}
    ${counter_value}=    Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.get_counter
    ...                                     counter_id=${counter_id}    dimension_dist_name=${object}
    ...                                     measurement_id=${NONE}    connection=${temp_conn}
    ...                  ELSE IF           '${hw_type}'=='vDU'    vdu_admin.get_counter_values
    ...                                     counter_id=${counter_id}    dimension_dn=${object}
    ...                                     vdu_connection=${temp_conn}
    ...                  ELSE               FAIL    hw_type doesn't exist
    ${counter_list}=     Run Keyword If    '${hw_type}'=='vCU'    Get From Dictionary    ${counter_value}    values
    ...                  ELSE IF           '${hw_type}'=='vDU'    Set Variable    ${counter_value}
    ${last_counter_value}=    Get From List    ${counter_list}    -1
    ${value}=            Get From Dictionary    ${last_counter_value}    value
    [Return]             ${value}
    [Teardown]           Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                     vcu_admin.disconnect    connection=${temp_conn}
    ...                  ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                     vdu_admin.disconnect    vdu_connection=${temp_conn}

