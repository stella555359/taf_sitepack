*** Keywords ***
Alarm Should be Active
    [Documentation]        Description:    Check if chosen alarm is active
    ...                    Input:          hw_type = vCU/vDU
    ...                                    alarm = fault_id, alarm_id, fault_name or alarm_name
    ...                                    pre-connection = preexisting connection, if not given then logged
    ...                                                     as System Admin with default username and password
    ...                    Author:         patryk.tatarek@nokia.com
    [Arguments]            ${alarm}    ${hw_type}=${NONE}    ${pre-connection}=${NONE}
    ${temp_conn}=          Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                       vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                       username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                       alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                    ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                       vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                       username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                       connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                    ELSE               Set Variable      ${pre-connection}
    ${active_alarms}=      Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.get_active_alarms
    ...                                                             connection=${temp_conn}
    ...                    ELSE IF           '${hw_type}'=='vDU'    vdu_admin.vdu_get_active_alarms
    ...                                                             vdu_connection=${temp_conn}
    ...                    ELSE               FAIL                  hw_type doesn't exist
    ${alarms_list}=        Get from Dictionary    ${active_alarms}    alarms
    @{alarms_return}=      Create List
    FOR    ${fault}    IN    @{alarms_list}
        ${fault_id}=       Get From Dictionary    ${fault}    fault_id
        ${alarm_id}=       Get From Dictionary    ${fault}    alarm_id
        ${fault_name}=     Get From Dictionary    ${fault}    fault_name
        ${alarm_name}=     Get From Dictionary    ${fault}    alarm_name
        ${new_alarm}=      Catenate    SEPARATOR=${SPACE},${SPACE}
        ...                Fault: ${fault_name} == ${fault_id}    Alarm: ${alarm_name} == ${alarm_id}
        Append to List     ${alarms_return}    ${new_alarm}
    END
    ${alarms}=        Convert to String    ${alarms_return}
    Should Contain    ${alarms}    ${alarm}
    [Teardown]    Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                              vcu_admin.disconnect    connection=${temp_conn}
    ...           ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                              vdu_admin.disconnect    vdu_connection=${temp_conn}

