*** Keywords ***
_Prepare FHGW Info For Integrating Netact
    [Arguments]  ${gnb_index}=0   ${vdu_index}=0    ${fhgw_index}=0
    ${fhgw_credentials}=    tl_config.get_fhgw_credentials   gnb_index=${gnb_index}   vdu_index=${vdu_index}  fhgw_index=${fhgw_index}
    ${fhgw_id}=    set variable   ${fhgw_credentials['fhgwid']}
    ${fghw_address}=   set variable   ${fhgw_credentials['fhgw_ipv4_addr']}
    ${fhgw_release}=   fhgw_ope.get_fhgw_release   gnb_index=${gnb_index}   vdu_index=${vdu_index}  fhgw_index=${fhgw_index}
    [Return]   FHGW-${fhgw_id}   ${fhgw_release}   ${fghw_address}

_Prepare VDU Info For Integrating Netact
    [Arguments]   ${gnb_index}=0   ${vdu_index}=0   ${fhgw_index}=0
    ${vdu_web_credentials}=  tl_config.get_vdu_webem_credentials   gnb_index=${gnb_index}   vdu_index=${vdu_index}
    ${vdu_web_ip}=    set variable   ${vdu_web_credentials['ip']}
    vdu_gen.login_rest   vdu_index=${vdu_index}   gnb_index=${gnb_index}   alias=vdu_netact
    ${vdu_sw_stream}=   vdu_ope_business.get_vdu_sw_stream   conn_alias=vdu_netact
    ${vdu_mrbts_name}=  vdu_ope_business.get_vdu_mrbts_name_by_restapi    conn_alias=vdu_netact
    [Return]   ${vdu_mrbts_name}    ${vdu_sw_stream}   ${vdu_web_ip}
    [Teardown]    vdu_gen.logout_rest    conn_alias=vdu_netact

_Prepare VCU Info For Integrating Netact
    [Arguments]   ${gnb_index}=0   ${vdu_index}=0    ${fhgw_index}=0
    ${vcu_web_credentials}=  tl_config.get_vcu_webem_credentials   gnb_index=${gnb_index}
    ${vcu_web_ip}=    set variable   ${vcu_web_credentials['ip']}
