Library           taf.rfrl.cbts.utilities.generic_utils   WITH NAME    generic_utils
Library           taf.rfrl.cbts.utilities.tl_config   WITH NAME  tl_config
Library           taf.rfrl.cbts.connections.ssh_connections.SSHConnExec   WITH NAME   ssh_conn
Library           taf.rfrl.cbts.devices.fhgw.fhgw_operations.FHGWOpe   WITH NAME   fhgw_ope


*** Keywords ***
Collect FHGW Snapshot Via Cli
    [Arguments]   ${local_snapshot_folder}=${EMPTY}   ${timeout}=${300}  ${fhgw_index}=0   ${vdu_index}=0    ${gnb_index}=0
    [Documentation]  This keyword is used to save fhgw snapshot.
    ...
    ...  *AUTHOR* calla.wang@nokia-sbell.com
    ...
    ...    |    =Input Parameters=     | =Man.= | =Description= |
    ...    | local_snapshot_folder | No | The local folder path that snapshot files are stored. |
    ...    | timeout | No | The timeout for waiting snapshot collection finished, default is 300s. |
    ...    | fhgw_index | No | fhgw_index in testline configurationf file. Default is 0. |
    ...    | vdu_index  | No  | vdu index in testline configuration file. Default is 0. |
    ...    | gnb_index  | No |  gnb index in testline configurtion file. Default is 0. |
    ...
    ...  - *local_snapshot_folder*: If not given, a directory with robot log output directory, test name, log type and timestamp will be created.
    ...
    ...    *RETURN VALUE*
    ...   snapshot file path
    ...
    ${conn_alias}    generic_utils.get_unique_id_string
    ssh_conn.ssh_connection_to_fhgw   vdu_index=${vdu_index}
    ...                               gnb_index=${gnb_index}
    ...                               fhgw_index=${fhgw_index}
    ...                               alias=${conn_alias}
    ${local_fhgw_snapshot_file}=   fhgw_ope.save_fhgw_snapshot   local_dir=${local_snapshot_folder}
    ...                                                          timeout=${timeout}
    ...                                                          conn_alias=${conn_alias}
    [Teardown]    ssh_conn.disconnect_fhgw_ssh_conn    conn_alias=${conn_alias}
    [Return]  ${local_fhgw_snapshot_file}


Get FHGW Number
    [Documentation]  This keyword is used to get fhgw number from testline configuration.
    ...
    ...  *AUTHOR* lingting.sun@nokia-sbell.com
    ...
    ...    |    =Input Parameters=     | =Man.= | =Description= |
    ...    | vdu_index  | No  | vdu index in testline configuration file. Default is 0. |
    ...    | gnb_index  | No |  gnb index in testline configurtion file. Default is 0. |
    ...
    ...    *RETURN VALUE*
    ...   fhgw_number
    ...
    [Arguments]   ${vdu_index}=0    ${gnb_index}=0
    ${fhgw_number}    tl_config.get_fhgw_number
    [Return]    ${fhgw_number}