*** Keywords ***
Get OCP Version
    [Documentation]     Description:    Get active OCP software version from vCU or vDU cluster
    ...                 Input:          ip_addr = by default ${SSH_K8S_VCU_IP}/${SSH_K8S_VDU_IP}
    ...                 Output:         OCP version i.e. : ocp-4.14.36-nokia.24.9.3
    ...                 Author:         karol.sadowski@nokia.com
    [Arguments]         ${hw_type}    ${ip_addr}=${NONE}
    ${conn_alias}       generic_utils.get_unique_id_string
    ${host_addr}=       Set Variable If    '${hw_type}'=='vCU' and '${ip_addr}'=='${NONE}'    ${SSH_K8S_VCU_IP}
    ...                 '${hw_type}'=='vDU' and '${ip_addr}'=='${NONE}'    ${SSH_K8S_VDU_IP}
    ...                 not '${ip_addr}'=='${NONE}'    ${ip_addr}
    ${temp_conn}=       SSHLibrary.Open Connection    host=${host_addr}    alias=${conn_alias}
    SSHLibrary.Login    ${SSH_K8S_USERNAME}    ${SSH_K8S_PASSWORD}
    ${data}=            SSHLibrary.Execute Command    oc get nokiaclusters.nokia.com -o yaml    connection=${temp_conn}
    ${ocp_version}=     Get Regexp Matches    ${data}    (.*nokiaRelease: )(.*)(\\n.*)    ${2}
    [Return]            ${ocp_version[0]}
    [Teardown]          SSHLibrary.Close Connection

