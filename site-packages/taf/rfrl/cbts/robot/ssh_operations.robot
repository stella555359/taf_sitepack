Get All Pods
    [Documentation]      Description:    Keyword to get all pods from vDU/vCU
    ...                  Input:          hw_type = vCU/vDU
    ...                                  ip_addr = custom ip address, usefull for vCU-2 cluster
    ...                  Output:         All pods that are in specific vCU/vDU (in form of a string,
    ...                                  could be split by \n)
    ...                  Author:         jagoda.kubacka@nokia.com
    [Arguments]          ${hw_type}=${NONE}    ${ip_addr}=${NONE}
    ${conn_alias}        generic_utils.get_unique_id_string
    ${host_addr}=        Set Variable If    '${hw_type}'=='vCU'    ${SSH_K8S_VCU_IP}
    ...                                     '${hw_type}'=='vDU'    ${SSH_K8S_VDU_IP}
    ...                                                            ${ip_addr}
    ${cran_id}=          Set Variable If    '${hw_type}'=='vCU'    ${CRAN_VCU}    ${CRAN_VDU}
    ${temp_ssh_conn}=    ssh.connect_to      ${host_addr}    ${SSH_K8S_USERNAME}    ${SSH_K8S_PASSWORD}
    ...                                      port=${DEFAULT_PORT_SSH}    alias=${conn_alias}
    ${all_pods}=         ssh.Execute         kubectl -n ${cran_id} get pods    connection=${temp_ssh_conn}
    [Return]             ${all_pods}
    [Teardown]           ssh.disconnect    connection=${temp_ssh_conn}

Get Specific Pod
    [Documentation]      Description:    Keyword to get full name of specific pod from vDU/vCU
    ...                  Input:          hw_type = vCU/vDU
    ...                                  specific_pod = short name of pod, for example oamext
    ...                                  ip_addr = custom ip address, usefull for vCU-2 cluster
    ...                  Output:         Full name of given pod (like po-oamext-0)
    ...                  Author:         jagoda.kubacka@nokia.com
    [Arguments]          ${hw_type}=${NONE}    ${specific_pod}=${NONE}    ${ip_addr}=${NONE}
    ${conn_alias}        generic_utils.get_unique_id_string
    ${host_addr}=        Set Variable If    '${hw_type}'=='vCU'    ${SSH_K8S_VCU_IP}
    ...                                     '${hw_type}'=='vDU'    ${SSH_K8S_VDU_IP}
    ...                                                            ${ip_addr}
    ${cran_id}=          Set Variable If    '${hw_type}'=='vCU'    ${CRAN_VCU}    ${CRAN_VDU}
    ${temp_ssh_conn}=    ssh.connect_to      ${host_addr}    ${SSH_K8S_USERNAME}    ${SSH_K8S_PASSWORD}
    ...                                      port=${DEFAULT_PORT_SSH}    alias=${conn_alias}
    ${specific_pod}=     ssh.Execute
    ...    kubectl -n ${cran_id} get pods | grep ${specific_pod} | awk '{print $1}' | awk '{printf "%s", $0}'
    ...    connection=${temp_ssh_conn}
    [Return]             ${specific_pod}
    [Teardown]           ssh.disconnect    connection=${temp_ssh_conn}

Get Nft Tables
    [Documentation]      Description:    Keyword to get nft tables
    ...                  Example:        nft list ruleset (to collect whole ruleset),
    ...                                  nft list chain ip filter INPUT (to collect only output from INPUT chain)
    ...                  Input:          hw_type = vCU/vDU
    ...                                  command = full nft command
    ...                                  ip_addr = custom ip address, usefull for vCU-2 cluster
    ...                  Output:         Whole nft tables or specific chain
    ...                  Author:         jagoda.kubacka@nokia.com
    [Arguments]          ${hw_type}=${NONE}    ${specific_pod}=${NONE}    ${command}=${NONE}
    ...                  ${container}=nftmgmt    ${ip_addr}=${NONE}
    ${conn_alias}=       generic_utils.get_unique_id_string
    ${host_addr}=        Set Variable If    '${hw_type}'=='vCU'    ${SSH_K8S_VCU_IP}
    ...                                     '${hw_type}'=='vDU'    ${SSH_K8S_VDU_IP}
    ...                                                            ${ip_addr}
    ${cran_id}=          Set Variable If    '${hw_type}'=='vCU'    ${CRAN_VCU}    ${CRAN_VDU}
    ${temp_ssh_conn}=    ssh.connect_to      ${host_addr}    ${SSH_K8S_USERNAME}    ${SSH_K8S_PASSWORD}
    ...                                      port=${DEFAULT_PORT_SSH}    alias=${conn_alias}
    ${pod_prefix}=       Get Pod Prefix    ${hw_type}
    ${nft_tables}=       ssh.Send Command
    ...    kubectl exec -it ${pod_prefix}-${specific_pod}-0 -n ${cran_id} -c ctr-${container} -- ${command}
    ...    connection=${temp_ssh_conn}
    ${nft_tables}=       ssh.Read Output    connection=${temp_ssh_conn}
    [Return]             ${nft_tables}
    [Teardown]           ssh.disconnect    connection=${temp_ssh_conn}

