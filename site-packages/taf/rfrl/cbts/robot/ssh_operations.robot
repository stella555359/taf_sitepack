Execute Command on Cluster
    [Documentation]      Description:    Keyword to execute command on given cluster
    ...                  Input:          hw_type = vCU/vDU
    ...                                  raw_output = if True, stdout and stderr will be combined
    ...                                  ip_addr = custom ip address, usefull for vCU-2 cluster
    ...                  Output:         Output from the command
    ...                  Author:         patryk.tatarek@nokia.com
    [Arguments]          ${command}    ${raw_output}=${False}    ${hw_type}=${NONE}    ${ip_addr}=${NONE}
    ${conn_alias}=       generic_utils.get_unique_id_string
    ${host_addr}=        Set Variable If    '${hw_type}'=='vCU'    ${SSH_K8S_VCU_IP}
    ...                                     '${hw_type}'=='vDU'    ${SSH_K8S_VDU_IP}
    ...                                                            ${ip_addr}
    ${cran_id}=          Set Variable If    '${hw_type}'=='vCU'    ${CRAN_VCU}    ${CRAN_VDU}
    ${temp_ssh_conn}=    ssh.connect_to      ${host_addr}    ${SSH_K8S_USERNAME}    ${SSH_K8S_PASSWORD}
    ...                                      port=${DEFAULT_PORT_SSH}    alias=${conn_alias}
    ssh.Send Command     ${command} -n ${cran_id}    connection=${temp_ssh_conn}    get_pty=${raw_output}
    ${output}=           ssh.Read Output    connection=${temp_ssh_conn}
    [Return]             ${output}
    [Teardown]           ssh.disconnect    connection=${temp_ssh_conn}

