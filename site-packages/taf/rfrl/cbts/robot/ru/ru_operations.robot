_collect Logs On TDD RUs Under Specified vCU And VDU
    [Arguments]    ${TDD_RUs}   ${local_dir}   ${vdu_index}=0    ${gnb_index}=0
    [Documentation]   Check there is power on all TDD RUs Under to a specified vCU/vDU
    ...    author: lingting.sun@nokia-sbell.com
    ...    | Input Parameters | Man. | Description |
    ...    |  TDD_RUs    | no |  the info list of all TDD rus  |
    ...    |  gnb_index   | no |  gnb index  |
    ...    |  vdu_index   | no |  vdu index  |
    ...
    ...    *RETURN VALUE*
    ...    None
    ...
    ...    Example
    ...    |  _Should Have Power On TDD RUs Under Specified vCU And VDU |
    ${TDD_RUS}=    Wait Until Keyword Succeeds     30s   30   ru_operations._Get Final SN IP Mapping   ${TDD_RUs}
    ...   vdu_index=${vdu_index}    gnb_index=${gnb_index}
    ${alias}   Get Unique Id
    ${ns}   tl_config.get_vdu_namespace    gnb_index=${gnb_index}    vdu_index=${vdu_index}
    Wait Until Keyword Succeeds   3x   10  ru_tdd_ope.connect_to_tdd_container   ns=${ns}   alias=${alias}
    ...   gnb_index=${gnb_index}  vdu_index=${vdu_index}
    ${length}   get length   ${TDD_RUs}
    : FOR    ${index}    IN RANGE   ${length}
    \    ${password}   set variable    ${TDD_RUS}[${index}][password]
    \    ${username}   set variable    ${TDD_RUS}[${index}][username]
    \    ${2nduser}   set variable    ${TDD_RUS}[${index}][2nduser]
    \    ${sn}     set variable    ${TDD_RUS}[${index}][sn]
    \    ${RF_ip}   set variable   ${TDD_RUS}[${index}][ru_ip]
    \    ${atten}   set variable   ${TDD_RUS}[${index}][atten]
    \    ${rf_local_ip_list}   set variable   ${TDD_RUS}[${index}][rf_local_ip]
    \    ${ru_prompt}   Set Variable    ${TDD_RUS}[${index}][prompt]
    \   log to console   Start to collect ru logs on RF:${RF_ip}
    \    Collect Logs On Specfic TDD RU  RF_ip=${RF_ip}  username=${username}  password=${password}
    ...   rf_local_ip_list=${rf_local_ip_list}   ru_prompt=${ru_prompt}   local_dir=${local_dir}
    ...   alias=${alias}
    [Teardown]    ru_tdd_ope.disconnect_vdu_cloud_hosting   alias=${alias}


Collect Logs On Specfic TDD RU
    [Arguments]    ${RF_ip}  ${username}  ${password}  ${rf_local_ip_list}   ${ru_prompt}   ${local_dir}
    ...   ${alias}   ${gnb_index}=0   ${vdu_index}=0
    ${rf_local_ip}   Set Variable   ${rf_local_ip_list[0]}
    ${ns}   tl_config.get_vdu_namespace   gnb_index=${gnb_index}    vdu_index=${vdu_index}
    ru_tdd_ope.connect_to_ru_tdd    ru_ip=${RF_ip}  username=${username}  password=${password}
    ...   ru_local_ip=${rf_local_ip}   alias=${alias}

    ${log_name}    Get Unique Id
    ${RF_Ip_string}   Replace String   ${RF_ip}   .    _
    ${log_name}    Set Variable     RRU_LOG_TDD_${RF_Ip_string}_${log_name}.zip
    ${current_prompt}   ru_tdd_ope.collect_log_tdd  ${username}    ${log_name}    ru_prompt=${ru_prompt}   alias=${alias}

    ${ru_path}  ${contianer_path}   ru_tdd_ope.download_tdd_log_to_container    rf_local_ip=${rf_local_ip}   RF_ip=${RF_ip}
    ...   log_name=${log_name}   old_prompt=${current_prompt}   password=${password}   alias=${alias}

    vDU Download File From Container    pod_name=po-cran1-oamfh-0    container_name=ctr-cran1-oamfh     file_path_in_container=tmp/${log_name}
    ...   local_file_path=${local_dir}    gnb_index=${gnb_index}    vdu_index=${vdu_index}

    ${delete_ru_cmd_1}    catenate    kubectl exec -it -n ${ns} po-${ns}-oamfh-0 -c ctr-${ns}-oamfh -- ssh
    ...  -o StrictHostKeyChecking=no serviceuser@${RF_ip} -- ssh ${rf_local_ip} -- sudo rm -rf /run/${log_name}

    ${delete_ru_cmd_2}    catenate    kubectl exec -it -n ${ns} po-${ns}-oamfh-0 -c ctr-${ns}-oamfh -- ssh
    ...  -o StrictHostKeyChecking=no serviceuser@${RF_ip} -- rm -rf /var/tmp/${log_name}

    [Teardown]   Run Keywords   ru_tdd_ope.delete_file_after_collect_tdd_log   delete_cmd1=${delete_ru_cmd_1}
    ...   delete_cmd2=${delete_ru_cmd_2}   password=${password}   alias=${alias}
    ...   AND   ru_tdd_ope.connect_to_tdd_container   ns=${ns}   alias=${alias}   gnb_index=${gnb_index}
    ...   vdu_index=${vdu_index}   need_reconnect=${False}
    [Return]    ${local_dir}/${log_name}


RMOD Status Should Be As Expected
    [Arguments]    ${rmods_id_list}  ${gnb_index}=0   ${vdu_index}=0   ${webem_password}=${EMPTY}
    ...   ${availability_status}=${None}  ${operational_state}=${None}
    ...   ${administrative_state}=${None}  ${procedural_status}=${None}
    ...   ${log_level}=DEBUG
   [Documentation]   get the rf info list including model, type, username, password, atten_list, 2nduser. etc
    ...    author: lingting.sun@nokia-sbell.com
    ...    *Change history*
    ...    modified by:
    ...     -02-03-2022, lingting.sun@nokia-sbell.com, lingtsun, Add RF_local_ip
    ...     -14-12-2023, chris.l.cao@nokia-sbell.com, set 'xxxxx_status' paramter default value to ${None}
    ...
    ...    | Input Parameters | Man. | Description |
    ...    | rmods_id_list | Yes | rmod id  list, [1, 2, 3]  |
    ...    | gnb_index  | yes  |  gnb index, default is 0  |
    ...    | vdu_index  | yes  |  gnb index, default is 0  |
    ...    | webem_password | No | default value is EMPTY will get from file init |
    ...    | availability_status  | No | Expected availability_status for cell, default is on line |
    ...    | operational_state    | No | Expected operational_state for cell, default is enabled |
    ...    | administrative_state | No | Expected administrative state for cell, default is Unlocked |
    ...    | procedural_status    | No | Expected procedural_status for cell, default is configured |
    ...
    ...    *RETURN VALUE*
    ...    None
    ...    Example
    ...    |  RMOD Status Should Be As Expected  |  [1,2,3]  |   administrative_state=Unlocked  |
    ${unexpected}  set variable  ${False}
    ${ru_model_list}=  create list
    ${conn_alias}    generic_utils.get_unique_id_string
    vdu_gen.login_rest   vdu_index=${vdu_index}   gnb_index=${gnb_index}   alias=${conn_alias}
    ${rmods_info}  vdu_ope_base.get_rmod_status  conn_alias=${conn_alias}
    FOR    ${rmod_id}    IN    @{rmods_id_list}
        ${r}  run keyword and continue on failure   generic_utils.member_should_not_contain
    ...  condition_key=id  condition_value=${rmod_id}  info_list=${rmods_info}  log_level=${log_level}
    ...  availability_status=${availability_status}   operational_state=${operational_state}
    ...  administrative_state=${administrative_state}  procedural_status=${procedural_status}
    ${unexpected}    evaluate   ${unexpected} or ${r}
    END
    Should Not Be True  ${unexpected}  msg=Has RMOD with unexpected status, please check the error message!!
    [Teardown]    vdu_gen.logout_rest    conn_alias=${conn_alias}


