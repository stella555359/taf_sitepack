    ${dn}=                Get From List     ${dist_names}    ${0}
    &{change_dict}=       Run Keyword If    ${any_true} and (${one_dist} or ${mix_dist})    Create Dictionary
    ...                                     distName=${dn}    operation=update    parameters=@{delta_dupl}
	@{delta_list}=        Run Keyword If    ${any_true} and (${one_dist} or ${mix_dist})
	...                                     Create List    ${change_dict}
	${delta_force}=       Run Keyword If    ${any_true} and ${mix_dist}    Combine Lists    ${delta}    ${delta_list}
	...                   ELSE IF           ${any_true} and ${one_dist}    Set Variable    ${delta_list}
	...                   ELSE IF           ${any_true} and not ${one_dist} and not ${mix_dist}
	...                                     Set Variable    ${delta}
    ${delta_json}=        Run Keyword If    ${any_true}    Evaluate    json.dumps(${delta_force})    json
    Run Keyword If        ${any_true} and '${hw_type}'=='vCU'    vcu_admin.perform_delta_recommissioning
    ...                   delta_file=${delta_json}    connection=${temp_conn}
    ...    ELSE IF        ${any_true} and '${hw_type}'=='vDU'    vdu_admin.perform_delta_recommissioning
    ...                   delta_file=${delta_json}    vdu_connection=${temp_conn}
    ...       ELSE        Log    All parameters already have given values    console=True
    [Teardown]            Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                      vcu_admin.disconnect    connection=${temp_conn}
    ...                   ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                      vdu_admin.disconnect    vdu_connection=${temp_conn}

Create Object with Single Parameter on BTS
    [Documentation]    Description:    Create single BTS object and fill it with single parameter value. In case that
    ...                                given object already exists and parameter has given value, keyword will end
    ...                                with PASS without execution. If object exists but parameter has different
    ...                                value, keyword will perform only parameter change.
    ...                Input:          hw_type = vCU/vDU
    ...                                pre-connection = preexisting connection, if not given then logged as System
    ...                                                 Admin with default username and password
    ...                Author:         patryk.tatarek@nokia.com
    [Arguments]        ${dist_name}    ${param_name}    ${param_value}
    ...                ${hw_type}=${NONE}    ${pre-connection}=${NONE}
    Run Keyword If    '${hw_type}'=='vCU'    Change Parameter on BTS   dist_name=${dist_name}
    ...                                      param_name=${param_name}    param_value=${param_value}
    ...                                      operation=create    pre-connection=${pre-connection}
    ...                                      hw_type=${hw_type}
    ...    ELSE IF    '${hw_type}'=='vDU'    Change Parameter on BTS    dist_name=${dist_name}
    ...                                      param_name=${param_name}    param_value=${param_value}
    ...                                      operation=create    pre-connection=${pre-connection}
    ...                                      hw_type=${hw_type}
    ...    ELSE        FAIL                  hw_type doesn't exist

Create Object with Multiple Parameters on BTS
    [Documentation]    Description:    Create single BTS object and fill it with multiple parameters values. In case
    ...                                that given object already exists and parameters have given values, keyword will
    ...                                end with PASS without execution. If object exists but parameters have different
    ...                                values, keyword will perform only parameters change.
    ...                Input:          hw_type = vCU/vDU
    ...                                pre-connection = preexisting connection, if not given then logged as System Admin
    ...                                                 with default username and password
    ...                Author:         patryk.tatarek@nokia.com
    [Arguments]        ${dist_name}    ${param_names}    ${param_values}
    ...                ${hw_type}=${NONE}    ${pre-connection}=${NONE}
    ${len}=            Get Length    ${param_names}
    ${dist_names}=     Create List
    FOR    ${i}    IN RANGE    0    ${len}
        Append to List    ${dist_names}    ${dist_name}
    END
    Run Keyword If    '${hw_type}'=='vCU'    Change Multiple Parameters on BTS    dist_names=${dist_names}
    ...                                      param_names=${param_names}    param_values=${param_values}
    ...                                      operation=create    pre-connection=${pre-connection}    hw_type=${hw_type}
    ...    ELSE IF    '${hw_type}'=='vDU'    Change Multiple Parameters on BTS    dist_names=${dist_names}
    ...                                      param_names=${param_names}    param_values=${param_values}
    ...                                      operation=create    pre-connection=${pre-connection}    hw_type=${hw_type}
    ...    ELSE        FAIL                  hw_type doesn't exist

Delete Object on BTS
    [Documentation]    Description:    Delete single BTS object. In case that given object already doesn't
    ...                                exist, keyword will end with PASS without execution.
    ...                Input:          hw_type = vCU/vDU
    ...                                pre-connection = preexisting connection, if not given then logged as System Admin
    ...                                                 with default username and password
    ...                Author:         patryk.tatarek@nokia.com
    [Arguments]        ${dist_name}    ${hw_type}=${NONE}    ${pre-connection}=${NONE}
    Run Keyword If    '${hw_type}' not in ['vCU', 'vDU']    FAIL    hw_type doesn't exist
    ${temp_conn}=      Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE               Set Variable      ${pre-connection}
    ${object_name}=    Fetch From Right    ${dist_name}    /
    ${dist}=           Remove String    ${dist_name}    /${object_name}
    ${status}=         Check if Object Exists in Scf File    dist_name=${dist}    object_name=${object_name}
    ...                                                      hw_type=${hw_type}    pre-connection=${temp_conn}
    ${delta}=          Run Keyword If    ${status}    Manage Delta File    dist_name=${dist_name}    param_name=${NONE}
    ...                dist_operation=delete    param_operation=delete
    Run Keyword If     ${status} and '${hw_type}'=='vCU'    vcu_admin.perform_delta_recommissioning
    ...                delta_file=${delta}    connection=${temp_conn}
    ...    ELSE IF     ${status} and '${hw_type}'=='vDU'    vdu_admin.perform_delta_recommissioning
    ...                delta_file=${delta}    vdu_connection=${temp_conn}
    ...       ELSE     Log    Given object already doesn't exist    console=True
    [Teardown]         Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.disconnect    connection=${temp_conn}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.disconnect    vdu_connection=${temp_conn}

Check Parameter Value
    [Documentation]    Description:    Return value of parameter with given name
    ...                Input:          hw_type = vCU/vDU
    ...                                dist_name = necessary for vDU, optional for vCU
    ...                                pre-connection = preexisting connection, if not given then logged as System Admin
    ...                                                 with default username and password
    ...                Output:         Parameter value
    ...                Author:         patryk.tatarek@nokia.com
    [Arguments]        ${param_name}    ${dist_name}=${NONE}    ${hw_type}=${NONE}    ${pre-connection}=${NONE}
    ${temp_conn}=      Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE               Set Variable      ${pre-connection}
    ${parameters}=     Run Keyword If    '${hw_type}'=='vCU'    vcu_admin.search_parameters_of_current_plan
    ...                                                         parameter_name=${param_name}    connection=${temp_conn}
    ...                ELSE IF           '${hw_type}'=='vDU'    vdu_admin.search_parameter_of_current_plan
    ...                                                         mo_dn=${dist_name}    para_name=${param_name}
    ...                                                         vdu_connection=${temp_conn}
    ...                ELSE               FAIL                  hw_type doesn't exist
    ${param_value}=    Run Keyword If    '${hw_type}'=='vCU'    Get Searched Parameter Value From Dictionary
    ...                                                         parameters=${parameters}    param_name=${param_name}
    ...                                                         dist_name=${dist_name}
    ...                ELSE IF           '${hw_type}'=='vDU'    Set Variable    ${parameters}
    [Return]           ${param_value}
    [Teardown]         Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.disconnect    connection=${temp_conn}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.disconnect    vdu_connection=${temp_conn}

Check if Object Exists in Scf File
    [Documentation]     Description:    This keyword checks in SCF if given object already exists
    ...                 Input:          hw_type = vCU/vDU
    ...                                 object_name= name of object (e.g. IPAPP-1)
    ...                                 dist_name= path to object mentioned above (e.g. MRBTS-1/TNLSVC-1/TNL-1)
    ...                                 pre-connection = preexisting connection, if not given then logged as System
    ...                                                  Admin with default username and password
    ...                 Author:         jagoda.kubacka@nokia.com
    [Arguments]         ${object_name}    ${dist_name}=${NONE}   ${hw_type}=${NONE}    ${pre-connection}=${NONE}
    Run Keyword If     '${hw_type}' not in ['vCU', 'vDU']    FAIL    hw_type doesn't exist
    ${temp_conn}=       Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                    vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                    username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                    alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                 ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                    vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                    username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                    connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                 ELSE               Set Variable      ${pre-connection}
    Create Directory    ${OUTPUT_DIR}/${TEST_NAME}
    Run Keyword If     '${hw_type}'=='vCU'    vcu_admin.get_current_plan_file
    ...                 path=${OUTPUT_DIR}/${TEST_NAME}.xml   include_runtime_data=${False}
    ...                 connection=${temp_conn}
    ...    ELSE IF     '${hw_type}'=='vDU'    vdu_admin.get_current_plan_file
    ...                 local_dir_path=${OUTPUT_DIR}/${TEST_NAME}    filename=${TEST_NAME}.xml
    ...                 include_runtime_data=${False}    vdu_connection=${temp_conn}
    Run Keyword If     '${hw_type}'=='vCU'    scf.load_scf    ${OUTPUT_DIR}/${TEST_NAME}.xml
    ...    ELSE IF     '${hw_type}'=='vDU'    scf.load_scf    ${OUTPUT_DIR}/${TEST_NAME}/${TEST_NAME}.xml
    ${value}=           scf.is_element_in_object    dist_name=${dist_name}   p_name=${object_name}
    Log                 ${object_name} exist status is: ${value}   console=true
    [Return]            ${value}
    [Teardown]    Run Keywords    Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                              vcu_admin.disconnect    connection=${temp_conn}
    ...                                  ELSE IF    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                              vdu_admin.disconnect    vdu_connection=${temp_conn}
    ...    AND    Run Keyword If    '${hw_type}'=='vCU'    Remove File    ${OUTPUT_DIR}/${TEST_NAME}.xml
    ...                  ELSE IF    '${hw_type}'=='vDU'    Remove File    ${OUTPUT_DIR}/${TEST_NAME}/${TEST_NAME}.xml

Get Searched Parameter Value From Dictionary
    [Documentation]    Description:    Search value of parameter ${param_name} using output from
    ...                                search_parameters_of_current_plan keyword (as ${parameters} variable)
    ...                Input:          parameters = output from search_parameters_of_current_plan keyword
    ...                                param_name = name of searched parameter
    ...                                dist_name = useful if searched parameter occurs repeatedly in BTS configuration
    ...                Output:         Parameter value
    ...                Author:         patryk.tatarek@nokia.com
    [Arguments]        ${parameters}    ${param_name}    ${dist_name}=${NONE}
    ${every_param}=    Get From Dictionary    ${parameters}    items
    ${parameter}=      Set Variable    ${every_param}
    FOR    ${each_param}    IN    @{every_param}
        ${dist}=         Get From Dictionary    ${each_param}    distname
        ${name}=         Get From Dictionary    ${each_param}    parameter_name
        ${status_1}=     Run Keyword and Return Status    Should be True    "${dist}"=="${dist_name}"
        ${status_2}=     Run Keyword and Return Status    Should be True    "${name}"=="${param_name}"
        ${parameter}=    Run Keyword If    ${status_1} and ${status_2}    Set Variable    ${each_param}
        ...              ELSE IF           ${status_2} and not ${status_1}    Get From List    ${every_param}    ${0}
        Exit For Loop If    ${status_1} and ${status_2}
    END
    ${parameter}=      Get From Dictionary    ${parameter}    parameter
    ${simple}=         Run Keyword and Return Status    Should Contain    ${parameter}    simple_parameter
    ${current}=        Run Keyword and Return Status    Should Contain    ${parameter}    currentValue
    ${full_value}=     Run Keyword If    ${simple}     Get From Dictionary    ${parameter}     simple_parameter
    ...                ELSE IF           ${current}    Get From Dictionary    ${parameter}     currentValue
    ${value}=          Run Keyword If    ${simple}     Get From Dictionary    ${full_value}    value
    ...                ELSE              Set Variable    ${full_value}
    ${value_list}=     Create List            ${value}
    [Return]           ${value_list}

Manage Delta File
    [Documentation]       Description:    Create or add changes to delta object
    ...                   Input:          dist_operation = operation on dist_name (update/create/delete)
    ...                                   param_operation = operation on parameter (update/create/delete)
    ...                                   delta = existing delta object (in form of a list), not needed if needs to be
    ...                                           created during this keyword
    ...                                   single_dist = True/False, True if all changes will be made in one dist_name
    ...                   Author:         patryk.tatarek@nokia.com
    [Arguments]           ${param_name}    ${param_operation}    ${dist_name}=${None}    ${dist_operation}=${None}
    ...                   ${param_value}=${None}    ${delta}=${None}    ${single_dist}=${False}
    &{param_dict}=        Run Keyword If       "${param_operation}"=="create" or "${param_operation}"=="update"
    ...                                        Create Dictionary    parameterName=${param_name}
    ...                                        value=${param_value}    operation=${param_operation}
    ...                   ELSE IF              "${param_operation}"=="delete"    Create Dictionary
    ...                                        parameterName=${param_name}    operation=${param_operation}
    @{param_list}=        Create List          ${param_dict}
    &{change_dict}=       Run Keyword If       not "${dist_name}"=="${None}"    Create Dictionary
    ...                                        distName=${dist_name}    operation=${dist_operation}
    ...                                        parameters=@{param_list}
    ...                   ELSE IF              "${dist_name}"=="${None}"    Create Dictionary
	@{delta_list}=        Run Keyword If       not "${dist_name}"=="${None}"    Create List     ${change_dict}
	...                   ELSE IF              "${dist_name}"=="${None}"     Create List    @{param_list}
	${delta}=             Run Keyword If       "${delta}"=="${NONE}"    Evaluate    json.dumps(${delta_list})    json
	...                   ELSE IF              not "${delta}"=="${NONE}"    Combine Lists    ${delta}    ${delta_list}
	[Return]              ${delta}
