Change Multiple Parameters on BTS
    [Documentation]    Description:    Update multiple BTS parameters value. In case that all parameters already
    ...                                have given values, keyword will end with PASS without execution.
    ...                Input:          hw_type = vCU/vDU
    ...                                dist_names = all dist_names must be either the same or only one of them
    ...                                             can be repeated multiple times, others can be used only once
    ...                                dist_names, param_names and param_values should be given as list
    ...                                Use BuiltIn keyword "Create List" to create those variables
    ...                                pre-connection = preexisting connection, if not given then logged as System Admin
    ...                                                 with default username and password
    ...                Author:         patryk.tatarek@nokia.com
    [Arguments]        ${dist_names}    ${param_names}    ${param_values}    ${operation}=update
    ...                ${hw_type}=${NONE}    ${pre-connection}=${NONE}
    Run Keyword If    '${hw_type}' not in ['vCU', 'vDU']    FAIL    hw_type doesn't exist
    ${temp_conn}=      Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                   vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                   vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                   username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                   connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                ELSE               Set Variable      ${pre-connection}
    ${length}=         Get Length           ${param_names}
    ${dist_rm}=        Remove Duplicates    ${dist_names}
    ${dist_nr}=        Get Length           ${dist_rm}
    ${one_dist}=       Evaluate             ${dist_nr}==${1}
    ${mix_dist}=       Evaluate             ${dist_nr}!=${length}
    ${any_true}=       Set Variable         ${FALSE}
    @{delta}=          Create List
    @{delta_dupl}=     Create List
    @{unique}=         Create List
    @{duplicate}=      Create List
    ${dupl_ind}=       Set Variable
    FOR    ${i}    IN RANGE    ${length}
        ${dn}=               Run Keyword If    ${one_dist}    Get From List    ${dist_names}    ${0}
        ...                  ELSE              Get From List    ${dist_names}      ${i}
        ${pn}=               Get From List     ${param_names}     ${i}
        ${pv}=               Get From List     ${param_values}    ${i}
        ${count}=            Get Count         ${dist_names}      ${dn}
        ${current_value}=    Run Keyword and Ignore Error    Check Parameter Value    param_name=${pn}
        ...                  dist_name=${dn}    hw_type=${hw_type}    pre-connection=${temp_conn}
        ${value_exists}=     Get From List      ${current_value}    ${0}
        ${current_value}=    Get From List      ${current_value}    ${1}
        ${status1}=          Run Keyword and Return Status    Should not be Equal as Strings    ${value_exists}    FAIL
        ${status2}=          Run Keyword and Return Status    Should not be Empty    ${current_value}
        ${status}=           Evaluate    "${status1}"=="${status2}"=="True"
        ${current_value}=    Run Keyword If    ${status} and '${hw_type}'=='vCU'
        ...                  Get From List     ${current_value}    ${0}
        ...                  ELSE              Set Variable    ${current_value}
        ${value_str}=        Convert to String    ${current_value}
        ${pv_str}=           Convert to String    ${pv}
        ${status}=           Run Keyword and Return Status    Should not be Equal    ${value_str}    ${pv_str}
        Run Keyword If       ${count}==1 and ${status}    Append To List    ${unique}       ${i}
        Run Keyword If       ${count}>1 and ${status}     Append To List    ${duplicate}    ${i}
        ${dupl_ind}=         Set Variable If    ${count}==1 and ${status}    ${i}    ${dupl_ind}
        ${any_true}=         Set Variable If    ${status}    ${status}    ${any_true}
    END
    FOR    ${i}    IN    @{unique}
        ${dn}=            Get From List     ${dist_names}      ${i}
        ${pn}=            Get From List     ${param_names}     ${i}
        ${pv}=            Get From List     ${param_values}    ${i}
        @{delta}=         Manage Delta File    dist_name=${dn}      param_name=${pn}    param_value=${pv}
        ...               dist_operation=${operation}    param_operation=${operation}    delta=${delta}
    END
    FOR    ${i}    IN    @{duplicate}
        ${dn}=            Get From List     ${dist_names}      ${i}
        ${pn}=            Get From List     ${param_names}     ${i}
        ${pv}=            Get From List     ${param_values}    ${i}
        @{delta_dupl}=    Manage Delta File    param_name=${pn}    param_value=${pv}
        ...               param_operation=${operation}    delta=${delta_dupl}
    END
    ${dn}=                Get From List     ${dist_names}    ${0}
    &{change_dict}=       Run Keyword If    ${any_true} and (${one_dist} or ${mix_dist})    Create Dictionary
    ...                                     distName=${dn}    operation=${operation}    parameters=@{delta_dupl}
	@{delta_list}=        Run Keyword If    ${any_true} and (${one_dist} or ${mix_dist})
	...                                     Create List    ${change_dict}
	${delta_force}=       Run Keyword If    ${any_true} and ${mix_dist}    Combine Lists    ${delta}    ${delta_list}
	...                   ELSE IF           ${any_true} and ${one_dist}    Set Variable    ${delta_list}
	...                   ELSE IF           ${any_true} and not ${one_dist} and not ${mix_dist}
	...                                     Set Variable    ${delta}
    ${delta_json}=        Run Keyword If    ${any_true}    Evaluate    json.dumps(${delta_force})    json
    Run Keyword If        ${any_true} and '${hw_type}'=='vCU'    vcu_admin.perform_delta_recommissioning
    ...                   delta_file=${delta_json}    connection=${temp_conn}
    ...    ELSE IF        ${any_true} and '${hw_type}'=='vDU'    vdu_admin.perform_delta_recommissioning
    ...                   delta_file=${delta_json}    vdu_connection=${temp_conn}
    ...       ELSE        Log    All parameters already have given values    console=True
    [Teardown]            Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                      vcu_admin.disconnect    connection=${temp_conn}
    ...                   ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                      vdu_admin.disconnect    vdu_connection=${temp_conn}

