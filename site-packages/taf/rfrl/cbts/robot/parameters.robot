*** Keywords ***
Change Parameter on BTS
    [Documentation]       Description:    Update single BTS parameter value. In case that given parameter already
    ...                                   has given value, keyword will end with PASS without execution.
    ...                   Input:          hw_type = vCU/vDU
    ...                                   dist_name = for example: MRBTS-${MRBTS}/MNL-1/CERTH-1/CMP-1
    ...                                   pre-connection = preexisting connection, if not given then logged as System
    ...                                                    Admin with default username and password
    ...                   Author:         patryk.tatarek@nokia.com
    [Arguments]           ${dist_name}    ${param_name}    ${param_value}    ${operation}=update
    ...                   ${hw_type}=${NONE}    ${pre-connection}=${NONE}    ${perform_logout}=${True}
    Run Keyword If       '${hw_type}' not in ['vCU', 'vDU']    FAIL    hw_type doesn't exist
    ${temp_conn}=         Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                      vcu_admin.connect_to    host=${LMP_VCU_IP}    port=${DEFAULT_PORT}
    ...                                      username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                      alias=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                   ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                      vdu_admin.connect_to    host=${LMP_VDU_IP}    port=${DEFAULT_PORT}
    ...                                      username=${WEBEM_USERNAME}    password=${WEBEM_PASSWORD}
    ...                                      connection_name=temp_admin    secure=${TRUE}    login_disabled=${FALSE}
    ...                   ELSE               Set Variable      ${pre-connection}
    ${current_value}=     Run Keyword and Ignore Error    Check Parameter Value    param_name=${param_name}
    ...                   dist_name=${dist_name}    hw_type=${hw_type}    pre-connection=${temp_conn}
    ${current_value}=     Get From List        ${current_value}    ${1}
    ${status}=            Run Keyword and Return Status    Should not be Empty    ${current_value}
    ${current_value}=     Run Keyword If    ${status} and '${hw_type}'=='vCU'
    ...                                     Get From List    ${current_value}    ${0}
    ...                   ELSE              Set Variable     ${current_value}
    ${value_str}=         Convert to String    ${current_value}
    ${pv_str}=            Convert to String    ${param_value}
    ${status}=            Run Keyword and Return Status    Should not be Equal    ${value_str}    ${pv_str}
    ${delta}=             Run Keyword If    ${status}    Manage Delta File
    ...                   dist_name=${dist_name}    param_name=${param_name}    param_value=${param_value}
    ...                   dist_operation=${operation}    param_operation=${operation}
    Run Keyword If        ${status} and '${hw_type}'=='vCU'    vcu_admin.perform_delta_recommissioning
    ...                   delta_file=${delta}    connection=${temp_conn}
    ...    ELSE IF        ${status} and '${hw_type}'=='vDU'    vdu_admin.perform_delta_recommissioning
    ...                   delta_file=${delta}    vdu_connection=${temp_conn}
    ...    ELSE           Log    Parameter already has given value    console=True
    [Teardown]            Run Keyword If    "${pre-connection}"=="${NONE}" and '${hw_type}'=='vCU'
    ...                                      vcu_admin.disconnect    connection=${temp_conn}
    ...                   ELSE IF           "${pre-connection}"=="${NONE}" and '${hw_type}'=='vDU'
    ...                                      vdu_admin.disconnect    vdu_connection=${temp_conn}

