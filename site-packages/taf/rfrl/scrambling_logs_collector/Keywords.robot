*** Settings ***
Documentation

Library   String
Library   Collections

Library   taf.rfrl.scrambling_logs_collector.resources.python.common_keywords    WITH NAME    scrambling_common_keywords
Library   taf.rfrl.scrambling_logs_collector.resources.python.utils              WITH NAME    scrambling_utils

*** Variables ***
@{DEFAULT_MANDATORY_LOG_TYPES}=        __snapshot__
${SCR_REMOTE_HOST_DEFAULT}=            192.168.255.129
${SCRAMBLING_LOG_PURPOSE}=             REGRESSION

*** Keywords ***
Collect and send logs for scrambling verification
    [Arguments]    ${team_name}    ${remote_host}=${SCR_REMOTE_HOST_DEFAULT}
    ...            ${remote_host_vDU}=${None}    ${remote_host_vCU}=${None}
    ...            ${input_logs_dir}=${None}     ${mandatory_log_types}=${DEFAULT_MANDATORY_LOG_TYPES}
    ...            ${log_purpose}=${SCRAMBLING_LOG_PURPOSE}    ${collect_NOP}=${False}
    Log Variables
    ${all_vars}=  Get Variables
    IF   '\${LSVAR}' not in $all_vars
    ...    Set Global Variable    ${LSVAR}    NOT_EXIST
    Log    ${\n}LSVAR=${LSVAR}    console=${True}
    IF    "${LSVAR}" == "SKIP"
    ...    RETURN    SKIPPED

    ${mandatory_log_types}=     IF    "${mandatory_log_types.__class__.__name__}" == "str"
    ...    scrambling_utils.get_list_from_string    string_input=${mandatory_log_types}
    ...    ELSE    Set Variable    ${mandatory_log_types}

    IF    ${collect_NOP}
        Append To List    ${mandatory_log_types}    __nop__
    END

    FOR    ${mandatory_log_type}    IN    @{mandatory_log_types}
        ${current_time_str}=    scrambling_utils.get_current_time
        IF    'vDU' in '${mandatory_log_type}' or 'nop' in '${mandatory_log_type}'
            ${remote_host}    Set Variable    ${remote_host_vDU}
            ${sw_version}=    scrambling_utils.get_sw_version_vdu    remote_host=${remote_host}
        ELSE IF    'vCU' in '${mandatory_log_type}'
            ${remote_host}    Set Variable    ${remote_host_vCU}
            ${sw_version}=    scrambling_utils.get_sw_version_vcu    remote_host=${remote_host}
        ELSE
            ${sw_version}=    scrambling_utils.get_sw_version     remote_host=${remote_host}
        END
        ${vm_hostname}=         scrambling_utils.get_hostname
        ${formatted_suite_name}=    Replace String  ${SUITE_NAME}  ${SPACE}  _
        ${pkg_prefix}=  IF    'nop' in '${mandatory_log_type}'
        ...    Set Variable  ${sw_version}_+${current_time_str}+${formatted_suite_name}_NOP_${vm_hostname}
        ...    ELSE    Set Variable  ${sw_version}_+${current_time_str}+${formatted_suite_name}_${vm_hostname}
        Log  taf.rfrl.scrambling_logs_collector:Checking for existing logs in dir: ${input_logs_dir}      console=yes
        ${logs_dict}=    scrambling_common_keywords.check_for_existing_logs_in_dir   input_logs_dir=${input_logs_dir}
        ...                                                               mandatory_log_type=${mandatory_log_type}
        ...                                                               team_name=${team_name}
        Log  taf.rfrl.scrambling_logs_collector:Collecting logs for scrambling verification from ${remote_host}...    console=yes
        ${logs_dict}=    scrambling_common_keywords.collect_logs_for_scrambling_verification    logs_dict=${logs_dict}
        ...                                                                          mandatory_log_type=${mandatory_log_type}
        ...                                                                          remote_host=${remote_host}
        Log  taf.rfrl.scrambling_logs_collector:Preparing logs for scrambling verification...    console=yes
        ${logs_dict}=    scrambling_common_keywords.prepare_logs_for_scrambling_verification    logs_dict=${logs_dict}
        ...                                                          pkg_prefix=${pkg_prefix}   log_purpose=${log_purpose}
        Log  taf.rfrl.scrambling_logs_collector:Sending logs for scrambling verification...    console=yes
        scrambling_common_keywords.send_logs_for_scrambling_verification    logs_dict=${logs_dict}    log_purpose=${mandatory_log_type}
        Log  taf.rfrl.scrambling_logs_collector:Executing proxy script on scrambling vm...   console=yes
        scrambling_common_keywords.execute_proxy_script_on_vm_for_logs      logs_dict=${logs_dict}    team_name=${team_name}
        ...                                                      processing_timestamp=${current_time_str}
    END
