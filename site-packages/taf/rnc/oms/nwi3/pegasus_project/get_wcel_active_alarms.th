<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<c:TestHierarchy xmlns:c="testConfiguration2.xml.pegasus" xmlns:j="junitReporting.testConfiguration2.xml.pegasus" xmlns:m="jaxb.message.ptp.pegasus" xmlns:ns2="jaxb.persistence2.parameter.ptp.pegasus" xmlns:v="verdictManagement.testConfiguration2.xml.pegasus" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" persistenceVersion="1">
 <c:Group name="get_wcel_active_alarms">
  <c:Parameter value="29601" type="String" dynamic="true" name="wcel_id"/>
  <c:Parameter value="296" type="String" dynamic="true" name="wbts_id"/>
  <c:Parameter value="/tmp/wcel_alarms.txt" type="String" dynamic="true" name="alarms_file_path"/>
  <c:Procedure class="pegasus.hzta.rnc.tp.TpRnc_process" sysconfig="/pegasus_project/oms_conn_config.sc" name="TpRnc_process">
   <c:Parameter value="rnc" type="String" name="_moduleName"/>
   <c:Parameter value="cell_alarm_get" type="String" name="_serviceName"/>
   <c:Parameter value="{wbts_id}" type="String" dynamic="true" description="Bulk operation is supported. Specify different BTS IDs separated by comma, for example: 1,2,5" name="btsId"/>
   <c:Parameter value="{wcel_id}" type="String" dynamic="true" description="List of cell ids against alarm,      multi cells can be joined with symbol ',', i.e. 1,3,4,6.      By default, it will fetch all cell alarms if -1 provided for this parameter.     Alarm from multiple cells can be obtained in one operation. Specify multiple cells by separating each with a comma.     For example: 1,2,5 " name="cellIds"/>
   <c:Parameter value="{alarms_file_path}" type="String" dynamic="true" description="The path of xml file saving the BTS active alarms.       For multi cell operation, output will be separate file with cell ID and bts ID appended to the filename. " name="saveFilePath"/>
   <c:Parameter value="900000" type="String" dynamic="true" description="Timeout in milliseconds, in which the procedure should be completed." name="timeout"/>
  </c:Procedure>
 </c:Group>
</c:TestHierarchy>
