<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<c:TestHierarchy xmlns:c="testConfiguration2.xml.pegasus" xmlns:j="junitReporting.testConfiguration2.xml.pegasus" xmlns:m="jaxb.message.ptp.pegasus" xmlns:ns2="jaxb.persistence2.parameter.ptp.pegasus" xmlns:v="verdictManagement.testConfiguration2.xml.pegasus" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" persistenceVersion="1">
 <c:Group name="get_wbts_active_alarms">
  <c:Parameter value="/tmp/wbts_alarms.txt" type="String" dynamic="true" name="alarms_file_path"/>
  <c:Parameter value="514" type="String" dynamic="true" name="wbts_id"/>
  <c:Procedure class="pegasus.hzta.rnc.tp.TpRnc_process" sysconfig="/pegasus_project/oms_conn_config.sc" name="TpRnc_process">
   <c:Parameter value="rnc" type="String" name="_moduleName"/>
   <c:Parameter value="bts_alarm_get" type="String" name="_serviceName"/>
   <c:Parameter value="{wbts_id}" type="String" dynamic="true" description="Bulk operation is supported. Specify different BTS IDs separated by comma, for example: 1,2,5" name="btsId"/>
   <c:Parameter value="{alarms_file_path}" type="String" dynamic="true" description="The path of xml file saving the BTS active alarms. btsId will be appended to the filename for multiple operation." name="saveFilePath"/>
   <c:Parameter value="900000" type="Integer" dynamic="true" name="timeout"/>
  </c:Procedure>
 </c:Group>
</c:TestHierarchy>
