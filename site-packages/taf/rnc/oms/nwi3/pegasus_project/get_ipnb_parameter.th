<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<c:TestHierarchy xmlns:c="testConfiguration2.xml.pegasus" xmlns:j="junitReporting.testConfiguration2.xml.pegasus" xmlns:m="jaxb.message.ptp.pegasus" xmlns:ns2="jaxb.persistence2.parameter.ptp.pegasus" xmlns:v="verdictManagement.testConfiguration2.xml.pegasus" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" persistenceVersion="1">
 <c:Group name="get_ipnb_parameter">
  <c:Parameter value="" type="String" dynamic="true" name="result"/>
  <c:Parameter value="/oms/output2.txt" type="File" dynamic="true" name="output"/>
  <c:Parameter value="296" type="String" dynamic="true" name="ipnb_id"/>
  <c:Parameter value="WBTSId" type="String" dynamic="true" name="param_short_name"/>
  <c:Extension xsi:type="j:JunitReporting"/>
  <c:Procedure class="pegasus.hzta.rnc.tp.TpRnc_process" sysconfig="/pegasus_project/oms_conn_config.sc" loglevel="LOG" name="TpRnc_process">
   <c:Parameter value="rnc" type="String" name="_moduleName"/>
   <c:Parameter value="ipnb_param_get" type="String" name="_serviceName"/>
   <c:Parameter value="{ipnb_id}" type="String" dynamic="true" description="ipnbId" name="ipnbId"/>
   <c:Parameter value="{param_short_name}" type="String" dynamic="true" description="The short name of the parameter" name="paramShortName"/>
   <c:Parameter value="{result}" type="String" dynamic="true" description="returnedValue" name="returnedValue"/>
   <c:Parameter value="180000" type="String" dynamic="true" description="Timeout in milliseconds, in which the procedure should be completed." name="timeout"/>
  </c:Procedure>
  <c:Procedure class="pegasus.testProcedure.network.node.rf.util.TpWriteToFile" name="TpWriteToFile">
   <c:Parameter value="{output}" type="File" name="_filePath"/>
   <c:Parameter value="{result}" type="String" name="_newFileEntry"/>
   <c:Parameter value="false" type="Boolean" name="_appendToExistingFile"/>
  </c:Procedure>
 </c:Group>
</c:TestHierarchy>
