<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<c:TestHierarchy xmlns:c="testConfiguration2.xml.pegasus" xmlns:j="junitReporting.testConfiguration2.xml.pegasus" xmlns:m="jaxb.message.ptp.pegasus" xmlns:ns2="jaxb.persistence2.parameter.ptp.pegasus" xmlns:v="verdictManagement.testConfiguration2.xml.pegasus" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" persistenceVersion="1">
 <c:Group name="reset_wbts">
  <c:Parameter value="296" type="String" dynamic="true" name="wbts_id"/>
  <c:Procedure class="pegasus.hzta.rnc.tp.TpRnc_process" sysconfig="/pegasus_project/oms_conn_config.sc" loglevel="LOG" name="TpRnc_process">
   <c:Parameter value="rnc" type="String" name="_moduleName"/>
   <c:Parameter value="reset_bts" type="String" name="_serviceName"/>
   <c:Parameter value="{wbts_id}" type="String" dynamic="true" description="Reset BTS from RNC and it's only available on RN5.0" name="btsId"/>
   <c:Parameter value="180000" type="String" dynamic="true" description="Timeout in milliseconds, in which the procedure should be completed." name="timeout"/>
  </c:Procedure>
 </c:Group>
</c:TestHierarchy>
