{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "StartPing",
    "description": "request of command start ping Test",
    "type": "object",
    "properties":{
      "CMD": {
        "type": "string",
        "default": "StartPing",
        "pattern": "StartPing"
      },
      "EQIndex": {
        "type": "integer",
        "minimum": -1
      },
      "Param": {
        "type": "object",
        "properties": {
            "Host": {
              "type": "string"
            },
            "PacketSize": {
              "type": "integer"
            },
            "LiveTime": {
              "type": "integer"
            },
            "TimeOut": {
              "type": "integer"
            },
            "ATPing": {
              "type": "boolean"
            }
        }
      }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
    ]
}
