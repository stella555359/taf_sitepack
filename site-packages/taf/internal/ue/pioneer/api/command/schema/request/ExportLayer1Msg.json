{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "ExportLayer1Msg",
    "description":"This cmd can be used to export the raw Layer1 Msgs to XML format, after StopLog",
    "type":"object",
    "properties":{
      "CMD": {
        "type": "string",
        "pattern":"ExportLayer1Msg"
      },
      "Param": {
        "type": "object",
        "properties": {
            "ExportFileName": {
              "type": "string"
            },
            "Logfile": {
              "type": "string"
            }
        },
        "required": [
            "ExportFileName",
            "Logfile"
          ]
      }
    },
    "required": [
        "CMD",
        "Param"
  ]
}