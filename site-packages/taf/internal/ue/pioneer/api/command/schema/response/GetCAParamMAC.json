{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "GetCAParamMAC",
    "description":"response to get the MAC layer downlink/uplink throughput under CA",
    "type":"object",
    "properties":{
        "CMD": {
            "type": "string",
            "default": "GetCAParamMAC",
            "pattern":"GetCAParamMAC"
        },
        "EQIndex": {
            "type": "integer",
            "minimum": 1,
            "not": {
            "enum": [
                        0
                    ]
            }
        },
        "Param": {
            "type": "object",
            "properties": {
                "State": {
                    "type": "integer"
                },
                "ThroughputInfoList": {
                    "type": "array",
                    "items": {
                        "type":"object",
                        "properties": {
                            "CellType": {
                                "type": "string"
                            },
                            "PCI": {
                                "type": "string"
                            },
                            "MACDL": {
                                "type": "integer"
                            },
                            "MACUL": {
                                "type": "integer"
                            },
                            "NetWorkType": {
                                "type": "string"
                            }
                        },
                        "required": [
                                "CellType", "PCI", "MACDL", "MACUL", "NetWorkType"
                        ]
                    }
                }
            },
            "required": [
                "State"
            ]
        }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
    ]
}