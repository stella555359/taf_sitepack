{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "GetParamStatisticsResult",
    "description":"request of command get the last Statistical Tag section Param Result",
    "type":"object",
    "properties":{
      "CMD": {
        "type": "string",
        "default": "GetParamStatisticsResult",
        "pattern":"GetParamStatisticsResult"
      },
      "EQIndex": {
        "type": "integer",
        "minimum": 1,
        "not": {
          "enum": [
            0
          ]
        }
      },
      "Param": {
        "type": "object",
        "properties": {
            "ParamName": {
              "type": "array",
              "items":{
                "type": "string"
              }
            }
        },
        "required": [
            "ParamName"
            ]
      }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
    ]
}
