{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "GetParamValue",
    "description":"response of get the real-time value of the specified parameter",
    "type":"object",
    "properties":{
        "CMD": {
            "type": "string",
            "default": "GetParamValue",
            "pattern":"GetParamValue"
        },
        "EQIndex": {
            "type": "integer",
            "minimum": 1,
            "not": {
                "enum": [
                    0
                ]
            }
        },
        "Param": {
            "type": "object",
            "properties": {
                "State": {
                    "type": "integer"
                },
                "Value": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "State"
            ]
        }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
    ]
}