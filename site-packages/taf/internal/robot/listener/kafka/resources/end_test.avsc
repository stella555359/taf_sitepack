{
    "type" : "record",
    "namespace" : "com.nokia.mn.trunk.repository",
    "name" : "end_test",
    "fields" :
    [
        {
            "name" : "eventType",
            "type" : "string",
            "default" : "EndTestEvent",
            "doc" : "Robot test execution lifecycle event"
        },
        {
            "name" : "execution_id",
            "type" : "string",
            "logical_type": "uuid",
            "doc" : "CM execution ID"
        },
        {
            "name" : "testline_name",
            "type" : "string",
            "doc" : "Testline name"
        },
        {
            "name" : "name",
            "type" : "string",
            "doc" : "Test case name"
        },
        {
            "name" : "longName",
            "type" : "string",
            "doc" : "Test suite name"
        },
        {
            "name" : "startTime",
            "type" : "long",
            "logicalType": "timestamp-millis",
            "doc" : "Test execution execution start time in UTC"
        },
        {
            "name" : "endTime",
            "type" : "long",
            "logicalType": "timestamp-millis",
            "doc" : "Test execution execution end time in UTC"
        },
        {
            "name" : "elapsedTime",
            "type" : "int",
            "doc" : "Total execution time in milliseconds"
        },
        {
            "name" : "result",
            "type" : {
                "name" : "result",
                "type" : "enum",
                "symbols" : ["PASS", "FAIL"]
            },
            "doc" : "Test result"
        },
	{
            "name" : "test_case_id",
            "type" : "string",
            "doc" : "Test case ID"
        }
    ]
}