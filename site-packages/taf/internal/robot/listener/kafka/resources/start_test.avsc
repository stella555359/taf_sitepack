{
    "type" : "record",
    "namespace" : "com.nokia.mn.trunk.repository",
    "name" : "start_test",
    "fields" :
    [
        {
            "name" : "eventType",
            "type" : "string",
            "default" : "StartTestEvent",
            "doc" : "Robot test execution lifecycle event"
        },
        {
            "name" : "execution_id",
            "type" : "string",
            "logical_type": "uuid",
            "doc" : "CM execution ID"
        },
        {
            "name" : "testline_name",
            "type" : "string",
            "doc" : "Testline name"
        },
        {
            "name" : "name",
            "type" : "string",
            "doc" : "Test case name"
        },
        {
            "name" : "longName",
            "type" : "string",
            "doc" : "Test suite name"
        },
        {
            "name" : "startTime",
            "type" : "long",
            "logicalType": "timestamp-millis",
            "doc" : "Test execution start time in UTC"
        },
	{
            "name" : "test_case_id",
            "type" : "string",
            "doc" : "Test case ID"
        }
    ]
}