{
    "type" : "record",
    "namespace" : "com.nokia.mn.trunk.repository",
    "name" : "start_suite",
    "fields" :
    [
        {
            "name" : "eventType",
            "type" : "string",
            "default" : "StartSuiteEvent",
            "doc" : "Robot test execution lifecycle event"
        },
        {
            "name" : "execution_id",
            "type" : "string",
            "logical_type": "uuid",
            "doc" : "CM execution ID"
        },
        {
            "name" : "testline_name",
            "type" : "string",
            "doc" : "Testline name"
        },
        {
            "name" : "name",
            "type" : "string",
            "doc" : "Robot test suite name"
        },
        {
            "name" : "startTime",
            "type" : "long",
            "logicalType": "timestamp-millis",
            "doc" : "Suite execution start time in UTC"
        }
    ]
}