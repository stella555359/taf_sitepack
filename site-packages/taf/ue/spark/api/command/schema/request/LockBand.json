    "title": "LockBand",
    "description":"request of command LockBand",
    "type":"object",
    "properties":{
      "CMD": {
        "type": "string",
        "pattern":"LockBand"
      },
      "EQIndex": {
        "type": "integer",
        "minimum": 1
      },
      "Param": {
        "type": "object",
        "properties": {
            "BandStr": {
              "type": "string",
              "pattern": "^\\d(,\\d)*$"
            },
            "NetType": {
              "type": "integer",
              "enum":[
                0,
                1,
                2,
                3,
                8,
                11
              ]
            }
        },
        "required": [
            "BandStr"
          ]
      }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
  ]
}