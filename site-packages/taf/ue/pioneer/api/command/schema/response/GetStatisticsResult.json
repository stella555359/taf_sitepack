{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "GetStatisticsResult",
    "description":"response of command get the last Statistical Tag section Result",
    "type":"object",
    "properties":{
        "CMD": {
            "type": "string",
            "default": "GetStatisticsResult",
            "pattern": "GetStatisticsResult"
        },
        "EQIndex": {
            "type": "integer",
            "minimum": 1,
            "not": {
                "enum": [
                    0
                ]
            }
        },
       "Param": {
            "type": "object",
            "properties": {
                "State": {
                    "type": "integer"
                },
                "SS-RSRP": {
                    "type": "array",
                    "items": {
                        "type":"object",
                        "properties": {
                            "Rage": {
                                "type": "string"
                            },
                            "Count": {
                                "type": "string"
                            },
                            "CDF": {
                                "type": "string"
                            },
                            "PDF": {
                                "type": "string"
                            }
                        },
                        "required": [
                                "Rage", "Count", "CDF", "PDF"
                        ]
                    }
                }
            },
            "required": [
                "State"
            ]
        }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
    ]
}