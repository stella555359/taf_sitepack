{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "StartStatistics",
    "description":"response of command Inter Start Statistics Tag",
    "type":"object",
    "properties":{
        "CMD": {
            "type": "string",
            "default": "StartStatistics",
            "pattern":"StartStatistics"
        },
        "EQIndex": {
            "type": "array",
            "items":{
                "type": "integer"
            }
        },
        "Param": {
            "type": "object",
            "properties": {
                "State": {
                    "type": "integer"
                }
            },
            "required": [
                "State"
                ]
        }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
        ]
}