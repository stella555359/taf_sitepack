{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "StartFTPDL",
    "description": "request of command start FTP DL Test",
    "type": "object",
    "properties":{
      "CMD": {
        "type": "string",
        "default": "StartFTPDL",
        "pattern": "StartFTPDL"
      },
      "EQIndex": {
        "type": "integer",
        "minimum": -1
      },
      "Param": {
        "type": "object",
        "properties": {
            "Host": {
              "type": "string"
            },
            "Port": {
              "type": "integer"
            },
            "Username": {
              "type": "string"
            },
            "Password": {
              "type": "string"
            },
            "ModeType": {
              "type": "integer"
            },
            "SaveFile": {
              "type": "boolean"
            },
            "HostDir": {
              "type": "string"
            },
            "LocalDir": {
              "type": "string"
            },
            "Duration": {
              "type": "integer"
            },
            "ThreadCount": {
              "type": "integer"
            },
            "FtpType": {
              "type": "string"
            }
        }
      }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
    ]
}
