{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "SetupPDUBean",
    "description":"request of command SetupPDU",
    "type":"object",
    "properties":{
      "CMD": {
        "type": "string",
        "default": "SetupPDU",
        "pattern":"SetupPDU"
      },
      "EQIndex": {
        "type": "integer",
        "minimum": 1
      },
      
      "Param": {
        "type": "object",
        "properties": {
            "ID": {
              "type": "integer"
            },
            "Type": {
              "type": "string",
              "enum": ["IP", "IPV6","IPV4V6"]
            },
	    "APN": {
              "type": "string"
            },
            "SSC_mode": {
              "type": "integer",
              "enum": [
              0,
              1
              ]
            },
            "S_NSSAI": {
                "type": "string"
            }
        },
        "required": [
            "ID",
            "Type",
	    "APN"
          ]
      }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
  ]
}