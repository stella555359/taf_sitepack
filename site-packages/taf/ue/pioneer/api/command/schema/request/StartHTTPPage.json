{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "StartHTTPPage",
    "description": "request of command start HTTP Page Test",
    "type": "object",
    "properties":{
      "CMD": {
        "type": "string",
        "default": "StartHTTPPage",
        "pattern": "StartHTTPPage"
      },
      "EQIndex": {
        "type": "integer",
        "minimum": -1
      },
      "Param": {
        "type": "object",
        "properties": {
            "TestMode": {
              "type": "integer"
            },
            "ClearCache": {
              "type": "boolean"
            },
            "TimeOut": {
              "type": "integer"
            },
            "WebSiteDuration": {
              "type": "integer"
            },
            "DoRandomWebSiteCount": {
              "type": "integer"
            },
            "RequiredWebSiteList": {
              "type": "array",
              "items":{
                "type": "object",
                "properties": {
                  "WebSiteName": {
                    "type": "string"
                  },
                  "WebSite": {
                    "type": "string"
                  },
                  "IsChecked": {
                    "type": "boolean"
                  }
                }
              }
            },
            "RandomWebSiteList": {
              "type": "array",
              "items":{
                "type": "object",
                "properties": {
                  "WebSiteName": {
                    "type": "string"
                  },
                  "WebSite": {
                    "type": "string"
                  },
                  "IsChecked": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
    ]
}
