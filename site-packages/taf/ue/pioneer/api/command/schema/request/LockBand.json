{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "title": "LockBand",
    "description":"request of command LockBand",
    "type":"object",
    "properties":{
      "CMD": {
        "type": "string",
        "pattern":"LockBand"
      },
      "EQIndex": {
        "type": "integer",
        "minimum": 1
      },
      "Param": {
        "type": "object",
        "properties": {
            "BandStr": {
              "type": "string",
              "pattern": "^\\d+(,\\d+)*$"
            }
        },
        "required": [
            "BandStr"
          ]
      }
    },
    "required": [
        "CMD",
        "EQIndex",
        "Param"
  ]
}